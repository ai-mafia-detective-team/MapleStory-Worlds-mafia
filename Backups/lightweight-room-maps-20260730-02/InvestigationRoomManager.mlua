@Logic
script InvestigationRoomManager extends Logic

	property string REGISTRY_MEMORY = "InvestigationRoomRegistry"

	property string REGISTRY_VARIABLE = "RoomsV1"

	property string ROOM_RETURN_PENDING_KEY = "pending_static_lobby_return_v1"

	-- 3 proved thin for an 8-player room where joins and leaves collide on the same ETag.
	property integer MAX_WRITE_RETRIES = 5

	property any userLeaveHandler = nil

	property table pendingInstanceMoves = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Subscribes to user-leave so departed players are purged from the room registry (no ghosts).
		self.pendingInstanceMoves = {}
		self.userLeaveHandler = _UserService:ConnectEvent(UserLeaveEvent, self.OnUserLeft)
		log("[InvestigationRoomManager] server shared registry ready")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Releases the user-leave subscription.
		if self.userLeaveHandler ~= nil then
			_UserService:DisconnectEvent(UserLeaveEvent, self.userLeaveHandler)
			self.userLeaveHandler = nil
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUserLeft(UserLeaveEvent event)
		-- On permanent exit, removes the user from every room (host migrates; empty rooms deleted).
		local userId = tostring(event.UserId)
		if userId == nil or userId == "" then return end
		-- Moving from the static room to an Instance Room also emits UserLeaveEvent in the
		-- source room. It is a room transition, not a disconnect, so the Registry membership
		-- must survive and become the authoritative membership of the destination room.
		if self.pendingInstanceMoves ~= nil and self.pendingInstanceMoves[userId] == true then
			self.pendingInstanceMoves[userId] = nil
			log("[InvestigationRoomManager] User-left cleanup skipped for instance transition userId=" .. userId)
			return
		end
		for attempt = 1, self.MAX_WRITE_RETRIES do
			local snapshot = self:ReadRegistrySnapshot()
			if snapshot.Ok == false then
				log_warning("[InvestigationRoomManager] User-left cleanup read failed userId=" .. userId)
				return
			end
			local removedCount = self:RemoveUserFromAllRooms(snapshot.Rooms, userId)
			if removedCount <= 0 then return end
			local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
			if writeCode == SharedMemoryResultCode.OK then
				log("[InvestigationRoomManager] User-left cleanup done userId=" .. userId .. " rooms=" .. tostring(removedCount))
				self:BroadcastRoomListToMembers(snapshot.Rooms)
				return
			end
			if writeCode ~= SharedMemoryResultCode.PreconditionFailed then
				log_warning("[InvestigationRoomManager] User-left cleanup write failed userId=" .. userId .. " code=" .. tostring(writeCode))
				return
			end
			log_warning("[InvestigationRoomManager] User-left cleanup retry attempt=" .. tostring(attempt) .. " userId=" .. userId)
		end
	end

	@ExecSpace("ServerOnly")
	method table ReadRegistrySnapshot()
		-- Loads the room registry and its ETag from RoomSharedMemory.
		local memoryCode, memory = _RoomService:GetSharedMemory(self.REGISTRY_MEMORY)
		if memoryCode ~= SharedMemoryResultCode.OK or memory == nil then
			return { Ok = false, ErrorCode = tostring(memoryCode), Rooms = {} }
		end
		
		local getResult = memory:GetVariableAndWait(self.REGISTRY_VARIABLE)
		if getResult.Code == SharedMemoryResultCode.NotFound then
			return {
				Ok = true,
				Exists = false,
				ETag = "",
				Memory = memory,
				Rooms = {},
			}
		end
		if getResult.Code ~= SharedMemoryResultCode.OK or getResult.Info == nil then
			return { Ok = false, ErrorCode = tostring(getResult.Code), Rooms = {} }
		end
		
		local rooms = {}
		local encoded = getResult.Info.Value
		if encoded ~= nil and encoded ~= "" then
			local decoded = _HttpService:JSONDecode(encoded)
			if decoded ~= nil and decoded.rooms ~= nil then
				rooms = decoded.rooms
			end
		end
		
		return {
			Ok = true,
			Exists = true,
			ETag = getResult.Info.ETag,
			Memory = memory,
			Rooms = rooms,
		}
	end

	@ExecSpace("ServerOnly")
	method any WriteRegistrySnapshot(table snapshot, table rooms)
		-- Writes the modified registry using optimistic ETag concurrency control.
		-- JSONEncode raises LuaTableToJsonType.UnknownType on a nested empty table, so an
		-- emptied registry (last room deleted) is written as an explicit JSON literal.
		local encoded = "{\"version\":1,\"rooms\":[]}"
		if rooms ~= nil and #rooms > 0 then
			encoded = _HttpService:JSONEncode({ version = 1, rooms = rooms })
		end
		if snapshot.Exists == false then
			local createResult = snapshot.Memory:CreateVariableAndWait(self.REGISTRY_VARIABLE, encoded)
			return createResult.Code
		end
		
		local keyInfo = SharedVariableKeyInfo(self.REGISTRY_VARIABLE, snapshot.ETag)
		local updateResult = snapshot.Memory:UpdateVariableAndWait(keyInfo, encoded)
		return updateResult.Code
	end

	@ExecSpace("ServerOnly")
	method integer FindRoomIndex(table rooms, string roomId)
		-- Returns the one-based index of a room, or zero when it is absent.
		for index, room in ipairs(rooms) do
			if room.roomId == roomId then
				return index
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method table EnsureMemberNicknames(table room)
		-- Nicknames live in a side map keyed by userId, so memberUserIds stays a plain string
		-- array (no schema migration, no mixed-type rows). The __schema sentinel keeps the map a
		-- JSON object even while empty — JSONEncode cannot serialize a nested empty table.
		if room.memberNicknames == nil then room.memberNicknames = {} end
		room.memberNicknames.__schema = true
		return room.memberNicknames
	end

	@ExecSpace("ServerOnly")
	method string GetMemberNickname(table room, string userId)
		-- Falls back to the live profile when the row predates the nickname map.
		local names = self:EnsureMemberNicknames(room)
		local stored = names[userId]
		if stored ~= nil and stored ~= "" and userId ~= "__schema" then return tostring(stored) end
		return self:GetUserNickname(userId)
	end

	@ExecSpace("ServerOnly")
	method string GetUserNickname(string userId)
		-- Authoritative nickname from the platform. Never trust a client-supplied display name.
		local user = _UserService.Users[userId]
		if user ~= nil and user.Nickname ~= nil and user.Nickname ~= "" then
			return tostring(user.Nickname)
		end
		return "수사관"
	end

	@ExecSpace("ServerOnly")
	method boolean IsUserConnected(string userId)
		-- Whether the user is currently connected to this world instance.
		for _, uid in ipairs(_UserService.Users.Keys) do
			if tostring(uid) == userId then return true end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method integer PruneDisconnectedMembers(table room)
		-- Self-heals ghosts left behind when UserLeaveEvent is missed (force quit, network drop)
		-- or when a leave write exhausted its ETag retries.
		-- NOTE: assumes one world instance. If rooms are ever split across instances, replace the
		-- connection test with a per-member lastSeen timestamp — otherwise members legitimately
		-- sitting in another instance would be pruned.
		if room.memberUserIds == nil then
			room.memberUserIds = {}
			return 0
		end
		local removed = 0
		for index = #room.memberUserIds, 1, -1 do
			if self:IsUserConnected(tostring(room.memberUserIds[index])) == false then
				table.remove(room.memberUserIds, index)
				removed += 1
			end
		end
		if removed > 0 then
			log("[InvestigationRoomManager] Pruned ghost members roomId=" .. tostring(room.roomId) .. " count=" .. tostring(removed))
		end
		return removed
	end

	@ExecSpace("ServerOnly")
	method boolean ContainsUser(table room, string userId)
		-- Returns whether the user is already a member of the room.
		if room.memberUserIds == nil then return false end
		for _, memberId in ipairs(room.memberUserIds) do
			if tostring(memberId) == userId then
				return true
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method integer RecalculateRoomStatus(table room)
		-- Keeps currentPlayers and WAITING/FULL status consistent with membership.
		-- Ghost members are dropped first so the count reflects who is actually present.
		-- Returns how many ghost members were pruned, so callers can decide whether the
		-- in-memory cleanup needs to be persisted back to the shared registry.
		if room.memberUserIds == nil then room.memberUserIds = {} end
		local removed = self:PruneDisconnectedMembers(room)
		room.currentPlayers = #room.memberUserIds
		if room.status ~= "PLAYING" then
			if room.currentPlayers >= room.maxPlayers then
				room.status = "FULL"
			else
				room.status = "WAITING"
			end
		end
		return removed
	end

	@ExecSpace("ServerOnly")
	method void SelfHealRegistry(table snapshot)
		-- Persists read-time ghost pruning back to the shared registry, so a room that never gets
		-- touched by an explicit join/leave/create write does not keep showing stale members (or
		-- linger forever at 0/maxPlayers once every member has disconnected).
		-- Best-effort, single attempt: on an ETag conflict the next read simply repeats the heal.
		local changed = false
		for index = #snapshot.Rooms, 1, -1 do
			local room = snapshot.Rooms[index]
			local removed = self:RecalculateRoomStatus(room)
			if removed > 0 then changed = true end
			if room.currentPlayers <= 0 then
				table.remove(snapshot.Rooms, index)
				changed = true
				log("[InvestigationRoomManager] Self-heal removed empty ghost room roomId=" .. tostring(room.roomId))
			end
		end
		if changed == false then return end
		local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
		if writeCode == SharedMemoryResultCode.OK then
			log("[InvestigationRoomManager] Self-heal persisted pruned registry")
		else
			log_warning("[InvestigationRoomManager] Self-heal write skipped code=" .. tostring(writeCode))
		end
	end

	@ExecSpace("ServerOnly")
	method table ToPublicRoom(table room)
		-- Copies room metadata without password or private membership data.
		return {
			roomId = room.roomId,
			roomName = room.roomName,
			mode = room.mode,
			hostUserId = room.hostUserId,
			hostNickname = room.hostNickname,
			currentPlayers = room.currentPlayers,
			maxPlayers = room.maxPlayers,
			status = room.status,
			isPrivate = room.isPrivate,
			hasPassword = room.hasPassword,
			createdAt = room.createdAt,
		}
	end

	@ExecSpace("ServerOnly")
	method string EncodePublicRooms(table rooms)
		-- Serializes a password-free room list for delivery to a client.
		local publicRooms = {}
		for _, room in ipairs(rooms) do
			self:RecalculateRoomStatus(room)
			table.insert(publicRooms, self:ToPublicRoom(room))
		end
		table.sort(publicRooms, function(left, right)
			return (left.createdAt or 0) > (right.createdAt or 0)
		end)
		-- Preserves an empty room list as a valid JSON array; JSONEncode returns "" for an empty table.
		if #publicRooms == 0 then return "[]" end
		return _HttpService:JSONEncode(publicRooms)
	end

	@ExecSpace("ServerOnly")
	method void BroadcastRoomListToMembers(table rooms)
		-- Membership changes must reach the members who did NOT make the request, otherwise their
		-- room view keeps showing someone who already left. This project uses no Multicast, so the
		-- existing per-user targeted RPC idiom is applied once per connected member.
		-- Encoding first also prunes ghosts, so the loop below walks the cleaned lists.
		local encoded = self:EncodePublicRooms(rooms)
		local notified = 0
		for _, room in ipairs(rooms) do
			if room.memberUserIds ~= nil then
				for _, memberId in ipairs(room.memberUserIds) do
					local id = tostring(memberId)
					if self:IsUserConnected(id) then
						self:DeliverRoomList(true, encoded, "", id)
						notified += 1
					end
				end
			end
		end
		log("[InvestigationRoomManager] Room list pushed to members count=" .. tostring(notified))
	end

	@ExecSpace("ServerOnly")
	method string MakeRoomId(string userId)
		-- Builds a collision-resistant room id from server time, user id, and randomness.
		return "room_" .. _UtilLogic:NewGuid()
	end

	@ExecSpace("ServerOnly")
	method void SendRoomListTo(string userId, string message)
		-- Reads and sends the latest password-free room list to one client.
		local snapshot = self:ReadRegistrySnapshot()
		if snapshot.Ok == false then
			log_warning("[InvestigationRoomManager] Room list refresh failed code=" .. tostring(snapshot.ErrorCode))
			self:DeliverRoomList(false, "[]", "수사방 목록을 불러오지 못했습니다.", userId)
			return
		end
		self:SelfHealRegistry(snapshot)
		local encoded = self:EncodePublicRooms(snapshot.Rooms)
		log("[InvestigationRoomManager] Room list refreshed count=" .. tostring(#snapshot.Rooms))
		self:DeliverRoomList(true, encoded, message or "", userId)
	end

	@ExecSpace("Server")
	method void CreateRoom(string roomName, string mode, integer maxPlayers, boolean isPrivate, string password, string hostNickname)
		-- Validates and creates a shared investigation room for the requesting user.
		local userId = tostring(senderUserId)
		roomName = string.match(roomName or "", "^%s*(.-)%s*$") or ""
		mode = string.match(mode or "", "^%s*(.-)%s*$") or ""
		password = string.match(password or "", "^%s*(.-)%s*$") or ""
		-- The display name is resolved server-side. A client-supplied nickname would let a caller
		-- impersonate another player or an operator, so the argument is deliberately ignored.
		hostNickname = self:GetUserNickname(userId)
		log("[InvestigationRoomManager] Room creation requested userId=" .. userId .. " roomName=" .. roomName)
		
		if roomName == "" then
			self:DeliverCreateResult(false, "방 이름을 입력하세요.", "", userId)
			return
		end
		if string.len(roomName) > 48 then
			self:DeliverCreateResult(false, "방 이름이 너무 깁니다.", "", userId)
			return
		end
		if maxPlayers < 6 or maxPlayers > 8 then
			self:DeliverCreateResult(false, "최대 인원은 6~8명만 가능합니다.", "", userId)
			return
		end
		if isPrivate and string.match(password, "^%d%d%d%d$") == nil then
			self:DeliverCreateResult(false, "비밀번호는 숫자 4자리로 입력하세요.", "", userId)
			return
		end
		if mode ~= "기본 수사" and mode ~= "심화 수사" then mode = "기본 수사" end
		
		for attempt = 1, self.MAX_WRITE_RETRIES do
			local snapshot = self:ReadRegistrySnapshot()
			if snapshot.Ok == false then
				log_warning("[InvestigationRoomManager] Room creation failed readCode=" .. tostring(snapshot.ErrorCode))
				self:DeliverCreateResult(false, "수사방 저장소를 불러오지 못했습니다.", "", userId)
				return
			end
		
			self:RemoveUserFromOtherRooms(snapshot.Rooms, userId, "")
		
			for _, room in ipairs(snapshot.Rooms) do
				if string.lower(room.roomName or "") == string.lower(roomName) then
					log_warning("[InvestigationRoomManager] Room creation failed duplicateName=" .. roomName)
					self:DeliverCreateResult(false, "이미 같은 이름의 수사방이 있습니다.", "", userId)
					return
				end
			end
		
			local room = {
				roomId = self:MakeRoomId(userId),
				roomName = roomName,
				mode = mode,
				hostUserId = userId,
				hostNickname = hostNickname,
				currentPlayers = 1,
				maxPlayers = maxPlayers,
				status = "WAITING",
				isPrivate = isPrivate,
				hasPassword = isPrivate and password ~= "",
				password = isPrivate and password or "",
				createdAt = _UtilLogic.ServerElapsedSeconds,
				memberUserIds = { userId },
				-- __schema keeps this map a JSON object while it holds a single entry or none.
				memberNicknames = { __schema = true, [userId] = hostNickname },
			}
			table.insert(snapshot.Rooms, room)
			local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
			if writeCode == SharedMemoryResultCode.OK then
				local publicJson = _HttpService:JSONEncode(self:ToPublicRoom(room))
				log("[InvestigationRoomManager] Room created successfully roomId=" .. room.roomId)
				-- 이전 게임이 PHASE_GAME_OVER 상태로 남아있으면 새 게임을 위해 리셋
				if _MafiaGameLogic ~= nil and _MafiaGameLogic.CurrentPhase == _MafiaGameLogic.PHASE_GAME_OVER then
					_MafiaGameLogic:ResetRoomState()
					log("[InvestigationRoomManager] Reset Mafia room state from PHASE_GAME_OVER for new room")
				end
				self:DeliverCreateResult(true, "수사방을 만들었습니다.", publicJson, userId)
				return
			end
			if writeCode ~= SharedMemoryResultCode.PreconditionFailed and writeCode ~= SharedMemoryResultCode.AlreadyExists then
				log_warning("[InvestigationRoomManager] Room creation failed writeCode=" .. tostring(writeCode))
				self:DeliverCreateResult(false, "수사방 생성에 실패했습니다.", "", userId)
				return
			end
			log_warning("[InvestigationRoomManager] Room creation retry attempt=" .. tostring(attempt))
		end
		
		self:DeliverCreateResult(false, "동시에 많은 요청이 발생했습니다. 다시 시도하세요.", "", userId)
	end

	@ExecSpace("Server")
	method void GetRoomList()
		-- Sends the complete room list to the requesting client.
		self:SendRoomListTo(tostring(senderUserId), "")
	end

	@ExecSpace("Server")
	method void RefreshRooms()
		-- Refreshes the complete room list for the requesting client.
		self:SendRoomListTo(tostring(senderUserId), "목록을 새로고침했습니다.")
	end

	@ExecSpace("Server")
	method void SearchRooms(string keyword, string modeFilter, string statusFilter, boolean hidePrivate)
		-- Filters room metadata on the server and sends matching rooms to the requester.
		local userId = tostring(senderUserId)
		keyword = string.lower(string.match(keyword or "", "^%s*(.-)%s*$") or "")
		local snapshot = self:ReadRegistrySnapshot()
		if snapshot.Ok == false then
			self:DeliverRoomList(false, "[]", "수사방 검색에 실패했습니다.", userId)
			return
		end
		self:SelfHealRegistry(snapshot)

		local filtered = {}
		for _, room in ipairs(snapshot.Rooms) do
			local keywordOk = keyword == "" or string.find(string.lower(room.roomName or ""), keyword, 1, true) ~= nil
			local modeOk = modeFilter == "" or modeFilter == "ALL" or room.mode == modeFilter
			local statusOk = statusFilter == "" or statusFilter == "ALL" or room.status == statusFilter
			local privateOk = hidePrivate == false or room.isPrivate == false
			if keywordOk and modeOk and statusOk and privateOk then
				table.insert(filtered, room)
			end
		end
		self:DeliverRoomList(true, self:EncodePublicRooms(filtered), "", userId)
	end

	@ExecSpace("ServerOnly")
	method boolean ValidatePassword(string roomId, string password)
		-- Checks a room password without exposing the stored password to clients.
		local snapshot = self:ReadRegistrySnapshot()
		if snapshot.Ok == false then return false end
		local index = self:FindRoomIndex(snapshot.Rooms, roomId)
		if index <= 0 then return false end
		local room = snapshot.Rooms[index]
		if room.hasPassword ~= true then return true end
		return room.password == password
	end

	@ExecSpace("ServerOnly")
	method void RemoveMemberFromRoom(table rooms, integer roomIndex, string userId)
		-- Removes one member; promotes the next member to host, or deletes the room when it becomes empty.
		local room = rooms[roomIndex]
		if room.memberUserIds == nil then room.memberUserIds = {} end
		for memberIndex = #room.memberUserIds, 1, -1 do
			if tostring(room.memberUserIds[memberIndex]) == userId then
				table.remove(room.memberUserIds, memberIndex)
			end
		end
		local leaveNames = self:EnsureMemberNicknames(room)
		leaveNames[userId] = nil
		if #room.memberUserIds == 0 then
			table.remove(rooms, roomIndex)
			return
		end
		if room.hostUserId == userId then
			-- Promote the first member that is actually connected, so a ghost never becomes host.
			local newHostId = ""
			for _, memberId in ipairs(room.memberUserIds) do
				if self:IsUserConnected(tostring(memberId)) then
					newHostId = tostring(memberId)
					break
				end
			end
			if newHostId == "" then newHostId = tostring(room.memberUserIds[1]) end
			room.hostUserId = newHostId
			room.hostNickname = self:GetMemberNickname(room, newHostId)
			log("[InvestigationRoomManager] Host migrated roomId=" .. tostring(room.roomId) ..
				" newHost=" .. newHostId .. " nickname=" .. room.hostNickname)
		end
		self:RecalculateRoomStatus(room)
	end

	@ExecSpace("ServerOnly")
	method void RemoveUserFromOtherRooms(table rooms, string userId, string exceptRoomId)
		-- Removes a user from previous rooms so one user belongs to at most one room (host migrates).
		for roomIndex = #rooms, 1, -1 do
			local room = rooms[roomIndex]
			if room.roomId ~= exceptRoomId and self:ContainsUser(room, userId) then
				self:RemoveMemberFromRoom(rooms, roomIndex, userId)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method integer RemoveUserFromAllRooms(table rooms, string userId)
		-- Removes the user from every room (host migrates; empty rooms deleted). Returns rooms affected.
		local removedCount = 0
		for roomIndex = #rooms, 1, -1 do
			local room = rooms[roomIndex]
			if self:ContainsUser(room, userId) then
				self:RemoveMemberFromRoom(rooms, roomIndex, userId)
				removedCount += 1
			end
		end
		return removedCount
	end

	@ExecSpace("ServerOnly")
	method void ProcessJoin(string userId, string roomId, string password, boolean quickJoin)
		-- Atomically validates capacity/password and joins a user to a room.
		for attempt = 1, self.MAX_WRITE_RETRIES do
			local snapshot = self:ReadRegistrySnapshot()
			if snapshot.Ok == false then
				self:DeliverJoinResult(false, "ROOM_STORE_ERROR", "수사방 목록을 불러오지 못했습니다.", "", userId)
				return
			end
			local roomIndex = self:FindRoomIndex(snapshot.Rooms, roomId)
			if roomIndex <= 0 then
				self:DeliverJoinResult(false, "NOT_FOUND", "수사방을 찾을 수 없습니다.", "", userId)
				return
			end
		
			local room = snapshot.Rooms[roomIndex]
			self:RecalculateRoomStatus(room)
			if room.status == "PLAYING" then
				log_warning("[InvestigationRoomManager] Room already playing roomId=" .. roomId)
				self:DeliverJoinResult(false, "PLAYING", "이미 진행 중인 수사방입니다.", "", userId)
				return
			end
			if room.status == "FULL" or room.currentPlayers >= room.maxPlayers then
				log_warning("[InvestigationRoomManager] Room full roomId=" .. roomId)
				self:DeliverJoinResult(false, "FULL", "인원이 가득 찬 수사방입니다.", "", userId)
				return
			end
			if room.hasPassword == true and (password == nil or password == "") then
				log_warning("[InvestigationRoomManager] Password required roomId=" .. roomId)
				self:DeliverJoinResult(false, "PASSWORD_REQUIRED", "비밀번호를 입력하세요.", "", userId)
				return
			end
			if room.hasPassword == true and room.password ~= password then
				log_warning("[InvestigationRoomManager] Password invalid roomId=" .. roomId)
				self:DeliverJoinResult(false, "PASSWORD_INVALID", "비밀번호가 올바르지 않습니다.", "", userId)
				return
			end
		
			if self:ContainsUser(room, userId) then
				self:DeliverJoinResult(true, "OK", "이미 입장한 수사방입니다.", _HttpService:JSONEncode(self:ToPublicRoom(room)), userId)
				return
			end
		
			self:RemoveUserFromOtherRooms(snapshot.Rooms, userId, roomId)
			table.insert(room.memberUserIds, userId)
			-- Record the joiner's nickname so host migration can name the promoted member.
			local joinNames = self:EnsureMemberNicknames(room)
			joinNames[userId] = self:GetUserNickname(userId)
			self:RecalculateRoomStatus(room)
			local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
			if writeCode == SharedMemoryResultCode.OK then
				log("[InvestigationRoomManager] Join room success roomId=" .. roomId .. " quick=" .. tostring(quickJoin))
				self:BroadcastRoomListToMembers(snapshot.Rooms)
				self:DeliverJoinResult(true, "OK", "수사방에 입장했습니다.", _HttpService:JSONEncode(self:ToPublicRoom(room)), userId)
				return
			end
			if writeCode ~= SharedMemoryResultCode.PreconditionFailed then
				self:DeliverJoinResult(false, "WRITE_FAILED", "수사방 입장에 실패했습니다.", "", userId)
				return
			end
			log_warning("[InvestigationRoomManager] Join retry attempt=" .. tostring(attempt))
		end
		self:DeliverJoinResult(false, "BUSY", "입장 요청이 많습니다. 다시 시도하세요.", "", userId)
	end

	@ExecSpace("Server")
	method void JoinRoom(string roomId, string password)
		-- Processes a direct join request for the selected room.
		log("[InvestigationRoomManager] Join room requested roomId=" .. tostring(roomId))
		self:ProcessJoin(tostring(senderUserId), roomId, password or "", false)
	end

	@ExecSpace("Server")
	method void QuickJoin()
		-- Finds a random public waiting room with capacity and joins it.
		local userId = tostring(senderUserId)
		log("[InvestigationRoomManager] Quick join requested userId=" .. userId)
		local snapshot = self:ReadRegistrySnapshot()
		local candidates = {}
		if snapshot.Ok == false then
			self:DeliverJoinResult(false, "ROOM_STORE_ERROR", "수사방 목록을 불러오지 못했습니다.", "", userId)
			return
		end
		for _, room in ipairs(snapshot.Rooms) do
			self:RecalculateRoomStatus(room)
			if room.status == "WAITING" and room.isPrivate ~= true and room.currentPlayers < room.maxPlayers then
				table.insert(candidates, room)
			end
		end
		if #candidates > 0 then
			local selectedIndex = _UtilLogic:RandomIntegerRange(1, #candidates)
			local selectedRoom = candidates[selectedIndex]
			log("[InvestigationRoomManager] Quick join selected roomId=" .. tostring(selectedRoom.roomId))
			self:ProcessJoin(userId, selectedRoom.roomId, "", true)
			return
		end
		self:DeliverJoinResult(false, "NO_ROOM", "빠르게 입장할 수 있는 공개 수사방이 없습니다.", "", userId)
	end

	@ExecSpace("Server")
	method void EnterJoinedInstanceRoom(string roomId)
		-- Never trust the client roomId by itself. The authenticated sender must already be a
		-- Registry member before the server creates/enters the matching instance room.
		local userId = tostring(senderUserId)
		roomId = roomId or ""
		local snapshot = self:ReadRegistrySnapshot()
		if snapshot.Ok == false then
			self:DeliverInstanceRoomEnterResult(false, "수사방 정보를 확인하지 못했습니다.", userId)
			return
		end
		local roomIndex = self:FindRoomIndex(snapshot.Rooms, roomId)
		if roomIndex <= 0 or self:ContainsUser(snapshot.Rooms[roomIndex], userId) == false then
			log_warning("[InvestigationRoomManager] Instance entry rejected: membership mismatch roomId=" ..
				tostring(roomId) .. " userId=" .. userId)
			self:DeliverInstanceRoomEnterResult(false, "수사방 참가 정보가 일치하지 않습니다.", userId)
			return
		end
		if _RoomService:IsInstanceRoom() then
			log_warning("[InvestigationRoomManager] Instance entry rejected: request did not originate in static room" ..
				" roomKey=" .. tostring(_RoomService.RoomKey) .. " userId=" .. userId)
			self:DeliverInstanceRoomEnterResult(false, "메인 로비에서 다시 입장해 주세요.", userId)
			return
		end
		-- Explicitly name map02. Maker play can return nil from GetOrCreateInstanceRoom when it
		-- cannot infer the instance-map set, while CreateInstanceRoom with a map list is the
		-- documented test path. Reuse an active room before attempting a unique creation.
		local instanceRoom = _RoomService.InstanceRooms[roomId]
		if instanceRoom == nil then
			log("[InvestigationRoomManager] Creating instance room roomId=" .. roomId .. " map=map02")
			instanceRoom = _RoomService:CreateInstanceRoom(roomId, {"map02"}, 200)
		end
		if instanceRoom == nil then
			log_error("[InvestigationRoomManager] Instance room creation failed roomId=" .. roomId)
			self:RollbackFailedInstanceEntry(userId, roomId)
			self:DeliverInstanceRoomEnterResult(false, "게임방을 생성하지 못했습니다.", userId)
			return
		end
		-- Mark before moving because the source-room UserLeaveEvent can fire synchronously.
		if self.pendingInstanceMoves == nil then self.pendingInstanceMoves = {} end
		self.pendingInstanceMoves[userId] = true
		local moved = _RoomService:MoveUserToInstanceRoom(roomId, userId, "map02")
		if moved == false then
			self.pendingInstanceMoves[userId] = nil
			log_error("[InvestigationRoomManager] Instance room move failed roomId=" .. roomId .. " userId=" .. userId)
			self:RollbackFailedInstanceEntry(userId, roomId)
			self:DeliverInstanceRoomEnterResult(false, "게임방으로 이동하지 못했습니다.", userId)
			return
		end
		log("[InvestigationRoomManager] Instance room move success roomId=" .. roomId .. " userId=" .. userId)
	end

	@ExecSpace("ServerOnly")
	method void RollbackFailedInstanceEntry(string userId, string roomId)
		for attempt = 1, self.MAX_WRITE_RETRIES do
			local snapshot = self:ReadRegistrySnapshot()
			if snapshot.Ok == false then return end
			local roomIndex = self:FindRoomIndex(snapshot.Rooms, roomId)
			if roomIndex <= 0 or self:ContainsUser(snapshot.Rooms[roomIndex], userId) == false then return end
			self:RemoveMemberFromRoom(snapshot.Rooms, roomIndex, userId)
			local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
			if writeCode == SharedMemoryResultCode.OK then
				log_warning("[InvestigationRoomManager] Rolled back failed instance entry roomId=" ..
					roomId .. " userId=" .. userId)
				return
			end
			if writeCode ~= SharedMemoryResultCode.PreconditionFailed then return end
		end
		log_error("[InvestigationRoomManager] Failed to roll back instance entry roomId=" ..
			roomId .. " userId=" .. userId)
	end

	@ExecSpace("ServerOnly")
	method table GetRuntimeRoomConfig(string roomId)
		local snapshot = self:ReadRegistrySnapshot()
		if snapshot.Ok == false then return nil end
		local roomIndex = self:FindRoomIndex(snapshot.Rooms, roomId)
		if roomIndex <= 0 then return nil end
		local room = snapshot.Rooms[roomIndex]
		return {
			roomTitle = room.roomName or "커닝시티 마피아",
			isPrivate = room.isPrivate == true,
			password = room.password or "",
			maxPlayers = room.maxPlayers or 8,
			mafiaCount = 2,
		}
	end

	@ExecSpace("ServerOnly")
	method boolean SetRoomPlayingByMember(string userId, boolean playing)
		-- Locks the room a member belongs to while its game runs, so it stops accepting joins,
		-- and unlocks it when the game ends. Without this the status never leaves WAITING and an
		-- in-progress room keeps showing up as joinable.
		for attempt = 1, self.MAX_WRITE_RETRIES do
			local snapshot = self:ReadRegistrySnapshot()
			if snapshot.Ok == false then return false end
			local target = nil
			for _, room in ipairs(snapshot.Rooms) do
				if self:ContainsUser(room, userId) then
					target = room
					break
				end
			end
			if target == nil then return false end
			if playing then
				target.status = "PLAYING"
			else
				-- Clear PLAYING first; RecalculateRoomStatus deliberately never overwrites it.
				target.status = "WAITING"
				self:RecalculateRoomStatus(target)
			end
			local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
			if writeCode == SharedMemoryResultCode.OK then
				log("[InvestigationRoomManager] Room playing=" .. tostring(playing) ..
					" roomId=" .. tostring(target.roomId) .. " status=" .. tostring(target.status))
				self:BroadcastRoomListToMembers(snapshot.Rooms)
				return true
			end
			if writeCode ~= SharedMemoryResultCode.PreconditionFailed then return false end
		end
		log_warning("[InvestigationRoomManager] SetRoomPlaying retries exhausted userId=" .. userId)
		return false
	end

	@ExecSpace("Server")
	method void LeaveRoom(string roomId)
		-- Removes the requesting user from every room. Because a user may belong to at most one
		-- room, "every room" and "the room" are the same set; the sweep also reclaims rows left
		-- behind by an earlier failed leave. roomId is only used to detect a client/server
		-- disagreement, never to select what gets removed.
		local userId = tostring(senderUserId)
		roomId = roomId or ""
		for attempt = 1, self.MAX_WRITE_RETRIES do
			local snapshot = self:ReadRegistrySnapshot()
			if snapshot.Ok == false then
				self:DeliverLeaveResult(false, "수사방 나가기에 실패했습니다.", userId)
				return
			end
			if roomId ~= "" then
				local inRequested = false
				for _, room in ipairs(snapshot.Rooms) do
					if room.roomId == roomId and self:ContainsUser(room, userId) then
						inRequested = true
						break
					end
				end
				if inRequested == false then
					log_warning("[InvestigationRoomManager] Leave roomId mismatch: caller believes roomId=" ..
						roomId .. " but is not a member of it userId=" .. userId)
				end
			end
			local removedCount = self:RemoveUserFromAllRooms(snapshot.Rooms, userId)
			if removedCount <= 0 then
				log("[InvestigationRoomManager] Leave room requested but no membership found roomId=" .. tostring(roomId) .. " userId=" .. userId)
				-- Registry cleanup is idempotent, but returning from an Instance Room is a
				-- separate obligation. Never strand the client in map02 merely because an
				-- earlier cleanup already removed its membership.
				if _RoomService:IsInstanceRoom() then
					self:SetStaticLobbyReturnPending(userId, true)
					-- This request always moves exactly one authenticated caller. Use the
					-- single-user API so RoomService returns a definitive boolean result.
					local moved = _RoomService:MoveUserToStaticRoom(userId, "map01")
					log("[InvestigationRoomManager] Static lobby return without membership userId=" .. userId ..
						" success=" .. tostring(moved))
					if moved ~= true then
						self:SetStaticLobbyReturnPending(userId, false)
						self:DeliverLeaveResult(false, "메인 로비 이동에 실패했습니다. 다시 시도해 주세요.", userId)
						return
					end
					-- The successful Room move destroys the old Instance Room client. Do not
					-- send a Client RPC to that invalid target after the yielding move returns.
					log("[InvestigationRoomManager] Leave completed by static room transfer userId=" .. userId)
					return
				end
				self:DeliverLeaveResult(true, "이미 종료된 수사방입니다.", userId)
				return
			end
			local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
			if writeCode == SharedMemoryResultCode.OK then
				log("[InvestigationRoomManager] Leave room success roomId=" .. tostring(roomId) .. " removedCount=" .. tostring(removedCount))
				self:BroadcastRoomListToMembers(snapshot.Rooms)
				if _RoomService:IsInstanceRoom() then
					self:SetStaticLobbyReturnPending(userId, true)
					-- LeaveRoom handles one authenticated caller, so use the matching
					-- single-user RoomService operation and explicit static lobby map.
					local moved = _RoomService:MoveUserToStaticRoom(userId, "map01")
					log("[InvestigationRoomManager] Static lobby return userId=" .. userId ..
						" success=" .. tostring(moved))
					if moved ~= true then
						self:SetStaticLobbyReturnPending(userId, false)
						self:DeliverLeaveResult(false, "메인 로비 이동에 실패했습니다. 다시 시도해 주세요.", userId)
						return
					end
					-- MoveUserToStaticRoom resumes after the previous client has left this Room.
					-- The new Static Room client owns all UI initialization from this point.
					log("[InvestigationRoomManager] Leave completed by static room transfer userId=" .. userId)
					return
				end
				self:DeliverLeaveResult(true, "수사방에서 나왔습니다.", userId)
				return
			end
			if writeCode ~= SharedMemoryResultCode.PreconditionFailed then
				self:DeliverLeaveResult(false, "수사방 나가기에 실패했습니다.", userId)
				return
			end
		end
		self:DeliverLeaveResult(false, "나가기 요청이 많습니다. 다시 시도하세요.", userId)
	end

	@ExecSpace("ServerOnly")
	method void SetStaticLobbyReturnPending(string userId, boolean pending)
		-- UserDataStorage survives the RoomService client replacement and is scoped per user,
		-- so simultaneous rooms cannot consume one another's return handoff.
		local userStorage = _DataStorageService:GetUserDataStorage(userId)
		local value = ""
		if pending then value = "true" end
		local errorCode = userStorage:SetAndWait(self.ROOM_RETURN_PENDING_KEY, value)
		if errorCode ~= 0 then
			log_warning("[InvestigationRoomManager] Static lobby return marker write failed userId=" ..
				userId .. " pending=" .. tostring(pending) .. " code=" .. tostring(errorCode))
			return
		end
		log("[InvestigationRoomManager] Static lobby return marker pending=" ..
			tostring(pending) .. " userId=" .. userId)
	end

	@ExecSpace("ServerOnly")
	method void UpdateRoomStatus(string roomId, string userId)
		-- Recalculates a room's WAITING/FULL state and persists the result.
		-- ServerOnly: as a client-reachable entry this allowed unlimited writes to any roomId,
		-- which could starve other users' join/leave attempts on the shared ETag.
		for attempt = 1, self.MAX_WRITE_RETRIES do
			local snapshot = self:ReadRegistrySnapshot()
			if snapshot.Ok == false then return end
			local roomIndex = self:FindRoomIndex(snapshot.Rooms, roomId)
			if roomIndex <= 0 then return end
			self:RecalculateRoomStatus(snapshot.Rooms[roomIndex])
			local writeCode = self:WriteRegistrySnapshot(snapshot, snapshot.Rooms)
			if writeCode == SharedMemoryResultCode.OK then
				self:SendRoomListTo(userId, "")
				return
			end
			if writeCode ~= SharedMemoryResultCode.PreconditionFailed then return end
		end
	end

	@ExecSpace("Client")
	method void DeliverRoomList(boolean success, string roomListJson, string message)
		-- Forwards a room-list response to the existing lobby UI controller.
		local lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		if lobby == nil or isvalid(lobby) == false then return end
		---@type LobbyController
		local controller = lobby:GetComponent("script.LobbyController")
		if controller ~= nil then
			controller:OnRoomListReceived(success, roomListJson, message)
		end
	end

	@ExecSpace("Client")
	method void DeliverCreateResult(boolean success, string message, string roomJson)
		-- Forwards a room-creation result to the existing lobby UI controller.
		if success and _MafiaUIFlow ~= nil then
			_MafiaUIFlow:ShowRoomTransition("수사방으로 이동 중입니다...")
			-- Give the client renderer one frame to present the transition HUD before
			-- OnRoomCreateResult immediately requests the yielding Room transfer.
			wait(0.1)
		end
		local lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		if lobby == nil or isvalid(lobby) == false then return end
		---@type LobbyController
		local controller = lobby:GetComponent("script.LobbyController")
		if controller ~= nil then
			controller:OnRoomCreateResult(success, message, roomJson)
		end
	end

	@ExecSpace("Client")
	method void DeliverJoinResult(boolean success, string reason, string message, string roomJson)
		-- Forwards a room-join result to the existing lobby UI controller.
		if success and _MafiaUIFlow ~= nil then
			_MafiaUIFlow:ShowRoomTransition("수사방으로 이동 중입니다...")
			wait(0.1)
		end
		local lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		if lobby == nil or isvalid(lobby) == false then return end
		---@type LobbyController
		local controller = lobby:GetComponent("script.LobbyController")
		if controller ~= nil then
			controller:OnRoomJoinResult(success, reason, message, roomJson)
		end
	end

	@ExecSpace("Client")
	method void DeliverInstanceRoomEnterResult(boolean success, string message)
		if success == false and _MafiaUIFlow ~= nil then
			_MafiaUIFlow:HideRoomTransition()
		end
		local lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		if lobby == nil or isvalid(lobby) == false then return end
		---@type LobbyController
		local controller = lobby:GetComponent("script.LobbyController")
		if controller ~= nil then
			controller:OnInstanceRoomEnterResult(success, message)
		end
	end

	@ExecSpace("Client")
	method void DeliverLeaveResult(boolean success, string message)
		-- MafiaUIFlow is a @Logic, so on a client it is never nil. The previous `if _MafiaUIFlow
		-- ~= nil then ... else <LobbyController fallback> end` therefore never took the fallback
		-- branch — it only looked like a safety net. MafiaUIFlow owns the room HUD and already
		-- clears LobbyController.joinedRoomId, so it is the single correct receiver.
		if _MafiaUIFlow == nil then
			log_warning("[InvestigationRoomManager] MafiaUIFlow missing; leave result dropped")
			return
		end
		_MafiaUIFlow:OnInvestigationRoomLeaveResult(success, message)
	end

end
