@Component
script NicknameSetupController extends Component

	property boolean DEBUG_SHOW_NICKNAME_SETUP = false

	property any clickHandlerConfirm = nil

	property any clickHandlerRandom = nil

	property any textChangeHandler = nil

	method void OnBeginPlay()
		-- Pre-attached to UI_NicknameSetup entity. Wires events at world start.
		-- ShowNicknameSetup() is called explicitly by IntroFlowController, not here.
		log("[NicknameSetupController] UI_NicknameSetup ready (pre-attached)")
		log("[NicknameSetupController] DEBUG_SHOW_NICKNAME_SETUP=" .. tostring(self.DEBUG_SHOW_NICKNAME_SETUP))
		self:ApplyNicknameBackgroundVisuals()
		self:VerifyEntities()
		self:WireButtonEvents()
		if self.DEBUG_SHOW_NICKNAME_SETUP then
			self:ShowNicknameSetup()
		end
	end

	method void VerifyEntities()
		-- Logs entity existence for verification.
		local base = "/ui/UI_NicknameSetup/NicknameRoot"
		local bg = _EntityService:GetEntityByPath(base .. "/NicknameBackground")
		log("[NicknameSetupController] NicknameBackground found=" .. tostring(bg ~= nil and isvalid(bg)))
		local panel = _EntityService:GetEntityByPath(base .. "/CenterPanel")
		log("[NicknameSetupController] CenterPanel found=" .. tostring(panel ~= nil and isvalid(panel)))
		local title = _EntityService:GetEntityByPath(base .. "/CenterPanel/TitleText")
		log("[NicknameSetupController] TitleText found=" .. tostring(title ~= nil and isvalid(title)))
		local desc = _EntityService:GetEntityByPath(base .. "/CenterPanel/DescriptionText")
		log("[NicknameSetupController] DescriptionText found=" .. tostring(desc ~= nil and isvalid(desc)))
		local input = _EntityService:GetEntityByPath(base .. "/CenterPanel/NicknameInput")
		log("[NicknameSetupController] NicknameInput found=" .. tostring(input ~= nil and isvalid(input)))
		local rndBtn = _EntityService:GetEntityByPath(base .. "/CenterPanel/Buttons/RandomButton")
		log("[NicknameSetupController] RandomButton found=" .. tostring(rndBtn ~= nil and isvalid(rndBtn)))
		local confBtn = _EntityService:GetEntityByPath(base .. "/CenterPanel/Buttons/ConfirmButton")
		log("[NicknameSetupController] ConfirmButton found=" .. tostring(confBtn ~= nil and isvalid(confBtn)))
		local preview = _EntityService:GetEntityByPath(base .. "/CenterPanel/PreviewNameText")
		log("[NicknameSetupController] PreviewNameText found=" .. tostring(preview ~= nil and isvalid(preview)))
		local err = _EntityService:GetEntityByPath(base .. "/CenterPanel/ErrorText")
		log("[NicknameSetupController] ErrorText found=" .. tostring(err ~= nil and isvalid(err)))
	end

	method void WireButtonEvents()
		-- Connects click and text-change events. Matching disconnection in OnEndPlay.
		local base = "/ui/UI_NicknameSetup/NicknameRoot/CenterPanel"
		local confBtn = _EntityService:GetEntityByPath(base .. "/Buttons/ConfirmButton")
		if confBtn ~= nil and isvalid(confBtn) then
			self.clickHandlerConfirm = confBtn:ConnectEvent(ButtonClickEvent, self.OnConfirmClicked)
		end
		local rndBtn = _EntityService:GetEntityByPath(base .. "/Buttons/RandomButton")
		if rndBtn ~= nil and isvalid(rndBtn) then
			self.clickHandlerRandom = rndBtn:ConnectEvent(ButtonClickEvent, self.OnRandomClicked)
		end
		local inputEnt = _EntityService:GetEntityByPath(base .. "/NicknameInput")
		if inputEnt ~= nil and isvalid(inputEnt) then
			self.textChangeHandler = inputEnt:ConnectEvent(TextInputValueChangeEvent, self.OnTextChanged)
		end
	end

	method void ShowNicknameSetup()
		-- Called by IntroFlowController (Client RPC) to show and reset the nickname UI.
		log("[NicknameSetupController] ShowNicknameSetup called")
		local nicknameRoot = _EntityService:GetEntityByPath("/ui/UI_NicknameSetup/NicknameRoot")
		if nicknameRoot ~= nil and isvalid(nicknameRoot) then
			nicknameRoot:SetEnable(true)
			nicknameRoot.Visible = true
			log("[NicknameSetupController] NicknameRoot visible=true enable=true")
		else
			log_warning("[NicknameSetupController] NicknameRoot not found or invalid")
		end
		self:ApplyNicknameBackgroundVisuals()
		local base = "/ui/UI_NicknameSetup/NicknameRoot/CenterPanel"
		local inputEnt = _EntityService:GetEntityByPath(base .. "/NicknameInput")
		if inputEnt ~= nil and isvalid(inputEnt) and inputEnt.TextInputComponent ~= nil then
			inputEnt.TextInputComponent.Text = ""
		end
		local preview = _EntityService:GetEntityByPath(base .. "/PreviewNameText")
		if preview ~= nil and isvalid(preview) and preview.TextComponent ~= nil then
			preview.TextComponent.Text = ""
		end
		local errText = _EntityService:GetEntityByPath(base .. "/ErrorText")
		if errText ~= nil and isvalid(errText) and errText.TextComponent ~= nil then
			errText.TextComponent.Text = ""
		end
		log("[NicknameSetupController] Nickname setup shown")
	end

	method void ApplyNicknameBackgroundVisuals()
		-- ImageRUID는 UI_NicknameSetup.ui에서만 관리합니다 (mlua에서 덮어쓰지 않음).
		-- 여기서는 transform 정렬, 가시성, 알파만 설정합니다.
		local bg = _EntityService:GetEntityByPath("/ui/UI_NicknameSetup/NicknameRoot/NicknameBackground")
		if bg == nil or isvalid(bg) == false then
			log_warning("[NicknameSetupController] NicknameBackground applied failed: entity missing")
			return
		end

		bg:SetEnable(true)
		bg.Visible = true

		local transform = bg.UITransformComponent
		if transform ~= nil then
			transform.AlignmentOption = AlignmentType.StretchAll
			transform.AnchorsMin = Vector2(0, 0)
			transform.AnchorsMax = Vector2(1, 1)
			transform.OffsetMin = Vector2(0, 0)
			transform.OffsetMax = Vector2(0, 0)
			transform.RectSize = Vector2(1920, 1080)
			transform.anchoredPosition = Vector2(0, 0)
		end

		if bg.SpriteGUIRendererComponent ~= nil then
			bg.SpriteGUIRendererComponent.Enable = false
			bg.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
			bg.SpriteGUIRendererComponent.RaycastTarget = false
			bg.SpriteGUIRendererComponent.Enable = true
			bg.SpriteGUIRendererComponent:SetAlpha(1)
		else
			log_warning("[NicknameSetupController] NicknameBackground applied failed: SpriteGUIRendererComponent missing")
			return
		end

		log("[NicknameSetupController] NicknameBackground visible=true alpha=1")
		log("[NicknameSetupController] NicknameBackground applied success")
	end

	method void HideNicknameSetup()
		-- Disables NicknameRoot. Called by IntroFlowController after lobby transition.
		local nicknameRoot = _EntityService:GetEntityByPath("/ui/UI_NicknameSetup/NicknameRoot")
		if nicknameRoot ~= nil and isvalid(nicknameRoot) then
			nicknameRoot:SetEnable(false)
			nicknameRoot.Visible = false
		end
		log("[NicknameSetupController] Nickname setup hidden")
	end

	method void ShowError(string message)
		-- Displays a validation or save error in ErrorText.
		local errText = _EntityService:GetEntityByPath("/ui/UI_NicknameSetup/NicknameRoot/CenterPanel/ErrorText")
		if errText ~= nil and isvalid(errText) and errText.TextComponent ~= nil then
			errText.TextComponent.Text = message
		end
	end

	method void OnTextChanged(TextInputValueChangeEvent event)
		-- Updates PreviewNameText as the user types.
		local preview = _EntityService:GetEntityByPath("/ui/UI_NicknameSetup/NicknameRoot/CenterPanel/PreviewNameText")
		if preview ~= nil and isvalid(preview) and preview.TextComponent ~= nil then
			if event.text ~= nil and event.text ~= "" then
				preview.TextComponent.Text = "미리보기: " .. event.text
			else
				preview.TextComponent.Text = ""
			end
		end
	end

	method void OnConfirmClicked(ButtonClickEvent event)
		-- Reads input, validates, and sends to server for saving.
		local base = "/ui/UI_NicknameSetup/NicknameRoot/CenterPanel"
		local inputEnt = _EntityService:GetEntityByPath(base .. "/NicknameInput")
		if inputEnt == nil or isvalid(inputEnt) == false then return end
		local inputComp = inputEnt.TextInputComponent
		if inputComp == nil then return end
		local raw = inputComp.Text
		local nickname = string.match(raw, "^%s*(.-)%s*$")
		if not self:ValidateNickname(nickname) then return end
		log("[NicknameSetupController] Nickname validation success: " .. nickname)
		_IntroFlowController:OnNicknameSetupFinished(nickname)
	end

	method boolean ValidateNickname(string nickname)
		-- Returns false and shows ErrorText if invalid.
		if nickname == nil or nickname == "" then
			self:ShowError("코드명을 입력해주세요.")
			return false
		end
		local charCount = self:CountUtf8Chars(nickname)
		if charCount < 2 then
			self:ShowError("코드명은 2자 이상이어야 합니다.")
			return false
		end
		self:ShowError("")
		return true
	end

	method integer CountUtf8Chars(string s)
		-- Counts Unicode code points in a UTF-8 string.
		local count = 0
		local i = 1
		local len = #s
		while i <= len do
			local byte = string.byte(s, i)
			if byte < 128 then
				i += 1
			elseif byte < 224 then
				i += 2
			elseif byte < 240 then
				i += 3
			else
				i += 4
			end
			count += 1
		end
		return count
	end

	method void OnRandomClicked(ButtonClickEvent event)
		-- Generates a random nickname and fills the input and preview.
		local nickname = self:GenerateRandomNickname()
		local base = "/ui/UI_NicknameSetup/NicknameRoot/CenterPanel"
		local inputEnt = _EntityService:GetEntityByPath(base .. "/NicknameInput")
		if inputEnt ~= nil and isvalid(inputEnt) and inputEnt.TextInputComponent ~= nil then
			inputEnt.TextInputComponent.Text = nickname
		end
		local preview = _EntityService:GetEntityByPath(base .. "/PreviewNameText")
		if preview ~= nil and isvalid(preview) and preview.TextComponent ~= nil then
			preview.TextComponent.Text = "미리보기: " .. nickname
		end
		self:ShowError("")
	end

	method string GenerateRandomNickname()
		-- Simple random Korean-style nickname for the Mafia investigation theme.
		local prefixes = {"붉은", "푸른", "검은", "금빛", "은빛", "새벽", "밤의", "정의의", "어둠의", "비밀"}
		local suffixes = {"마피아", "탐정", "형사", "요원", "조사관", "수사관", "감시자", "추적자"}
		local pi = _UtilLogic:RandomIntegerRange(1, #prefixes)
		local si = _UtilLogic:RandomIntegerRange(1, #suffixes)
		return prefixes[pi] .. suffixes[si]
	end

	method void OnEndPlay()
		-- Disconnects all event handlers.
		local base = "/ui/UI_NicknameSetup/NicknameRoot/CenterPanel"
		if self.clickHandlerConfirm ~= nil then
			local btn = _EntityService:GetEntityByPath(base .. "/Buttons/ConfirmButton")
			if btn ~= nil and isvalid(btn) then
				btn:DisconnectEvent(ButtonClickEvent, self.clickHandlerConfirm)
			end
			self.clickHandlerConfirm = nil
		end
		if self.clickHandlerRandom ~= nil then
			local btn = _EntityService:GetEntityByPath(base .. "/Buttons/RandomButton")
			if btn ~= nil and isvalid(btn) then
				btn:DisconnectEvent(ButtonClickEvent, self.clickHandlerRandom)
			end
			self.clickHandlerRandom = nil
		end
		if self.textChangeHandler ~= nil then
			local inputEnt = _EntityService:GetEntityByPath(base .. "/NicknameInput")
			if inputEnt ~= nil and isvalid(inputEnt) then
				inputEnt:DisconnectEvent(TextInputValueChangeEvent, self.textChangeHandler)
			end
			self.textChangeHandler = nil
		end
	end

end