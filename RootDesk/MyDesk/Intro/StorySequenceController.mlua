@Component
@ExecSpace("ClientOnly")
script StorySequenceController extends Component

	property Entity storyRoot = nil

	property Entity storyImageEntity = nil

	property Entity dimOverlayEntity = nil

	property Entity captionTextEntity = nil

	property Entity skipButtonEntity = nil

	property Entity lobby = nil

	property Entity defaultGroup = nil

	property Entity mapleMapPlayer = nil

	property SpriteGUIRendererComponent storyImageSprite = nil

	property TextComponent captionText = nil

	property ButtonComponent skipButton = nil

	property integer timerId = 0

	property number lineElapsed = 0

	property integer storyIndex = 1

	property integer lineIndex = 1

	property integer lastAppliedStoryImageIndex = 0

	property boolean completed = false

	property boolean storyActive = false

	property any skipButtonHandler = nil

	property any storyTouchHandler = nil

	property any storyKeyHandler = nil

	method void OnBeginPlay()
		-- Entry: resolves UI entities, shows story UI, starts cut 1 line 1.
		log("[StorySequenceController] OnBeginPlay")
		self:ResolveEntities()
		self:ApplyInitialState()
		self:BindInput()
		self:StartStory()
	end

	method void ResolveEntities()
		-- Looks up all story UI entities by path.
		self.storyRoot = _EntityService:GetEntityByPath("/ui/UI_StorySequence/StoryRoot")
		self.storyImageEntity = _EntityService:GetEntityByPath("/ui/UI_StorySequence/StoryRoot/StoryImage")
		self.dimOverlayEntity = _EntityService:GetEntityByPath("/ui/UI_StorySequence/StoryRoot/DimOverlay")
		self.captionTextEntity = _EntityService:GetEntityByPath("/ui/UI_StorySequence/StoryRoot/CaptionText")
		self.skipButtonEntity = _EntityService:GetEntityByPath("/ui/UI_StorySequence/StoryRoot/SkipButton")
		self.lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		self.defaultGroup = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		self.mapleMapPlayer = _UserService.LocalPlayer
		if self.mapleMapPlayer == nil then
			self.mapleMapPlayer = _EntityService:GetEntityByPath("/maps/map01/MapleMapPlayer")
		end

		self.storyImageSprite = self:GetSpriteComponent(self.storyImageEntity)
		self.captionText = self:GetTextComponent(self.captionTextEntity)
		self.skipButton = self:GetButtonComponent(self.skipButtonEntity)

		log("[StorySequenceController] StoryRoot found: " .. tostring(self.storyRoot ~= nil))
		log("[StorySequenceController] StoryImage found: " .. tostring(self.storyImageEntity ~= nil))
		log("[StorySequenceController] CaptionText found: " .. tostring(self.captionTextEntity ~= nil))
		log("[StorySequenceController] SkipButton found: " .. tostring(self.skipButtonEntity ~= nil))
	end

	method SpriteGUIRendererComponent GetSpriteComponent(Entity entity)
		-- Returns SpriteGUIRendererComponent or nil.
		if entity == nil or isvalid(entity) == false then return nil end
		return entity.SpriteGUIRendererComponent
	end

	method TextComponent GetTextComponent(Entity entity)
		-- Returns TextComponent or nil.
		if entity == nil or isvalid(entity) == false then return nil end
		return entity.TextComponent
	end

	method ButtonComponent GetButtonComponent(Entity entity)
		-- Returns ButtonComponent or nil.
		if entity == nil or isvalid(entity) == false then return nil end
		return entity.ButtonComponent
	end

	method void ApplyInitialState()
		-- Resets state, enables story UI, hides gameplay, logs style verification.
		self.completed = false
		self.storyActive = false
		self.storyIndex = 1
		self.lineIndex = 1
		self.lineElapsed = 0
		self.lastAppliedStoryImageIndex = 0

		self:SetEntityEnabled(self.storyRoot, true)
		self:SetEntityVisible(self.storyRoot, true)
		self:SetEntityVisible(self.storyImageEntity, true)
		self:SetEntityVisible(self.dimOverlayEntity, true)
		self:SetEntityVisible(self.captionTextEntity, true)
		self:SetEntityVisible(self.skipButtonEntity, true)
		self:SetSpriteAlpha(self.storyImageSprite, 0)
		self:SetCaptionText("", 0)
		self:HideGameplay()

		-- Style verification logs
		if self.captionText ~= nil and isvalid(self.captionText.Entity) then
			log("[StorySequenceController] CaptionText font applied: Font=" .. tostring(self.captionText.Font))
			log("[StorySequenceController] CaptionText shadow applied: DropShadow=" .. tostring(self.captionText.DropShadow))
			log("[StorySequenceController] CaptionText shows one line only")
		end
		if self.skipButtonEntity ~= nil and isvalid(self.skipButtonEntity) then
			local skipSprite = self.skipButtonEntity.SpriteGUIRendererComponent
			if skipSprite ~= nil then
				local c = skipSprite.Color
				log("[StorySequenceController] SkipButton background color: r=" .. tostring(c.r) .. " a=" .. tostring(c.a))
			end
			local skipTxt = self.skipButtonEntity.TextComponent
			if skipTxt ~= nil then
				local tc = skipTxt.FontColor
				log("[StorySequenceController] SkipButton text color: r=" .. tostring(tc.r) .. " a=" .. tostring(tc.a))
				log("[StorySequenceController] SkipButton text visible: " .. tostring(tc.a > 0.5))
			end
		end
	end

	method void HideGameplay()
		-- Keeps lobby, DefaultGroup, and player hidden while story is running.
		if self.completed then return end

		if self.lobby == nil or isvalid(self.lobby) == false then
			self.lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		end
		if self.lobby ~= nil and isvalid(self.lobby) then
			self.lobby.Visible = false
		end

		if self.defaultGroup == nil or isvalid(self.defaultGroup) == false then
			self.defaultGroup = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		end
		if self.defaultGroup ~= nil and isvalid(self.defaultGroup) then
			if self.defaultGroup.Enable == false then
				self.defaultGroup:SetEnable(true)
			end
			self.defaultGroup.Visible = false
		end

		if self.mapleMapPlayer == nil or isvalid(self.mapleMapPlayer) == false then
			self.mapleMapPlayer = _UserService.LocalPlayer
			if self.mapleMapPlayer == nil then
				self.mapleMapPlayer = _EntityService:GetEntityByPath("/maps/map01/MapleMapPlayer")
			end
		end
		if self.mapleMapPlayer ~= nil and isvalid(self.mapleMapPlayer) then
			self.mapleMapPlayer.Visible = false
			self.mapleMapPlayer:SetEnable(false)
		end
	end

	method void BindInput()
		-- Wires skip button click, story image touch, and Space key.
		if self.skipButton ~= nil and self.skipButton.Entity ~= nil and isvalid(self.skipButton.Entity) then
			if self.skipButtonHandler == nil then
				self.skipButtonHandler = self.skipButton.Entity:ConnectEvent(ButtonClickEvent, self.OnSkipClicked)
			end
		end

		if self.storyImageEntity ~= nil and isvalid(self.storyImageEntity) then
			if self.storyTouchHandler == nil then
				self.storyTouchHandler = self.storyImageEntity:ConnectEvent(UITouchDownEvent, self.OnStoryTouch)
			end
		end

		if self.storyKeyHandler == nil then
			self.storyKeyHandler = _InputService:ConnectEvent(KeyDownEvent, self.OnStoryKeyDown)
		end
	end

	method void UnbindInput()
		-- Disconnects all input handlers.
		if self.skipButtonHandler ~= nil and self.skipButton ~= nil and self.skipButton.Entity ~= nil and isvalid(self.skipButton.Entity) then
			self.skipButton.Entity:DisconnectEvent(ButtonClickEvent, self.skipButtonHandler)
		end

		if self.storyTouchHandler ~= nil and self.storyImageEntity ~= nil and isvalid(self.storyImageEntity) then
			self.storyImageEntity:DisconnectEvent(UITouchDownEvent, self.storyTouchHandler)
		end

		if self.storyKeyHandler ~= nil then
			_InputService:DisconnectEvent(KeyDownEvent, self.storyKeyHandler)
		end

		self.skipButtonHandler = nil
		self.storyTouchHandler = nil
		self.storyKeyHandler = nil
	end

	method void OnSkipClicked()
		-- Skip button handler: exits story immediately.
		if self.storyActive == false then return end
		log("[StorySequenceController] Story skipped by user")
		log("[StorySequenceController] SkipButton click still finishes story")
		self:FinishStory()
	end

	method void OnStoryTouch(UITouchDownEvent event)
		-- Tap on story image: advance to next line (or next cut if last line).
		if self.storyActive == false then return end
		log("[StorySequenceController] Space / click next line works")
		self:AdvanceLine()
	end

	method void OnStoryKeyDown(KeyDownEvent event)
		-- Space key: advance to next line (or next cut if last line).
		if event.key ~= KeyboardKey.Space then return end
		if self.storyActive == false then return end
		log("[StorySequenceController] Space / click next line works")
		self:AdvanceLine()
	end

	method void StartStory()
		-- Begins cut 1, line 1 and starts the per-frame timer.
		if self.storyActive then return end
		self.storyActive = true
		self.storyIndex = 1
		self.lineIndex = 1
		self.lineElapsed = 0
		self.lastAppliedStoryImageIndex = 0
		self:SetStoryImageRuid(1)
		local firstLine = self:GetStoryCutLine(1, 1)
		self:ApplyLineVisuals(0, firstLine)
		log("[StorySequenceController] StorySequence started")
		log("[StorySequenceController] Story started for first-time user")
		log("[StorySequenceController] Story cut 1 started")
		self:StartTimer()
	end

	method void StartTimer()
		-- Starts the per-frame update timer.
		if self.timerId > 0 then
			_TimerService:ClearTimer(self.timerId)
			self.timerId = 0
		end
		local previousTime = _UtilLogic.ElapsedSeconds
		self.timerId = _TimerService:SetTimerRepeat(function()
			local now = _UtilLogic.ElapsedSeconds
			local delta = now - previousTime
			previousTime = now
			self:UpdateStory(delta)
		end, 1 / 60)
	end

	method void UpdateStory(number delta)
		-- Per-frame: hide gameplay, advance line timer, apply line visuals.
		if self.completed then return end
		self:HideGameplay()
		if self.storyActive == false then return end
		self.lineElapsed = self.lineElapsed + delta
		local line = self:GetStoryCutLine(self.storyIndex, self.lineIndex)
		local lineDuration = self:GetLineDuration(line)
		if self.lineElapsed >= lineDuration then
			self:AdvanceLine()
			return
		end
		self:ApplyLineVisuals(self.lineElapsed, line)
	end

	method void AdvanceLine()
		-- Moves to next line; if on last line of cut, advances to next cut.
		if self.storyActive == false then return end
		local totalLines = self:GetStoryCutLineCount(self.storyIndex)
		if self.lineIndex < totalLines then
			self.lineIndex = self.lineIndex + 1
			self.lineElapsed = 0
			local line = self:GetStoryCutLine(self.storyIndex, self.lineIndex)
			self:ApplyLineVisuals(0, line)
		else
			self:AdvanceCut()
		end
	end

	method void AdvanceCut()
		-- Moves to next cut; finishes story after cut 6.
		if self.storyActive == false then return end
		if self.storyIndex >= 6 then
			self:FinishStory()
			return
		end
		self.storyIndex = self.storyIndex + 1
		self.lineIndex = 1
		self.lineElapsed = 0
		self.lastAppliedStoryImageIndex = 0
		self:SetStoryImageRuid(self.storyIndex)
		local line = self:GetStoryCutLine(self.storyIndex, 1)
		log("[StorySequenceController] Story cut " .. tostring(self.storyIndex) .. " started")
		self:ApplyLineVisuals(0, line)
	end

	method void ApplyLineVisuals(number t, string line)
		-- Applies per-line fade-in/hold/fade-out for caption; image fades in only on line 1 of each cut.
		local fadeIn = 0.35
		local hold = self:GetLineHoldTime(line)
		local fadeOut = 0.25
		local textAlpha = 1
		if t < fadeIn then
			textAlpha = t / fadeIn
		elseif t < fadeIn + hold then
			textAlpha = 1
		else
			local outT = t - fadeIn - hold
			textAlpha = math.max(0, 1 - outT / fadeOut)
		end
		textAlpha = self:Clamp01(textAlpha)

		local imageAlpha = 1
		if self.lineIndex == 1 and t < fadeIn then
			imageAlpha = t / fadeIn
		end
		self:SetSpriteAlpha(self.storyImageSprite, imageAlpha)
		self:SetCaptionText(line, textAlpha)
	end

	method number GetLineDuration(string line)
		-- Total time for one line: fadeIn + hold + fadeOut.
		return 0.35 + self:GetLineHoldTime(line) + 0.25
	end

	method number GetLineHoldTime(string line)
		-- Longer lines get more hold time; length measured in bytes (Korean = 3 bytes/char).
		if string.len(line) > 30 then
			return 2.0
		end
		return 1.6
	end

	method void FinishStory()
		-- Stops story, hides story UI, notifies IntroFlowController.
		if self.completed then return end
		self.completed = true
		self.storyActive = false
		if self.timerId > 0 then
			_TimerService:ClearTimer(self.timerId)
			self.timerId = 0
		end
		self:UnbindInput()
		self:SetEntityEnabled(self.storyRoot, false)
		_IntroFlowController:OnStoryFinished()
	end

	method void SetStoryImageRuid(integer index)
		-- Applies sprite RUID for the given cut; skips if already applied.
		if self.storyImageSprite == nil then return end
		if isvalid(self.storyImageSprite.Entity) == false then return end
		if self.lastAppliedStoryImageIndex == index then return end
		local name = self:GetStoryImageName(index)
		local ruid = self:GetStoryImageRuid(index)
		self.lastAppliedStoryImageIndex = index
		if ruid == "" then
			log_warning("[StorySequenceController] Story image missing cut=" .. tostring(index) .. " name=" .. name)
			self.storyImageSprite.ImageRUID = DataRef("")
			return
		end
		self.storyImageSprite.ImageRUID = DataRef(ruid)
		log("[StorySequenceController] Story image ruid=" .. ruid)
		log("[StorySequenceController] Story image applied success cut=" .. tostring(index) .. " name=" .. name)
	end

	method string GetStoryImageName(integer index)
		-- Returns expected filename for log messages.
		if index == 1 then return "story_01.png"
		elseif index == 2 then return "story_02.png"
		elseif index == 3 then return "story_03.png"
		elseif index == 4 then return "story_04.png"
		elseif index == 5 then return "story_05.png"
		end
		return "story_06.png"
	end

	method string GetStoryImageRuid(integer index)
		-- Story cut image RUIDs (cuts 1-6).
		local ruids = {
			[1] = "4f14e15d3650461bb50aae2a841932ab",
			[2] = "2539d08a5dde425d862d1ed93e4cd64f",
			[3] = "58d4aef2fc7a4dfba7539be7afd8cc8b",
			[4] = "d604d16cbde1445e8dc2ceec3dd76872",
			[5] = "95d1a8ec980645c38dd1373c2493ea0b",
			[6] = "16f1f80c78f74ffc97bbda08d582e6a7",
		}
		return ruids[index] or ""
	end

	method integer GetStoryCutLineCount(integer cutIndex)
		-- Returns the number of display lines for each cut.
		if cutIndex == 4 then return 4 end
		if cutIndex == 6 then return 4 end
		return 3
	end

	method string GetStoryCutLine(integer cutIndex, integer lineIdx)
		-- Returns the text for one display line within a cut.
		if cutIndex == 1 then
			if lineIdx == 1 then return "커닝시티." end
			if lineIdx == 2 then return "이곳에서는 질서보다 소문이 빠르고," end
			return "빛보다 그림자가 더 익숙하다."
		elseif cutIndex == 2 then
			if lineIdx == 1 then return "뒷골목 정보상이 사라졌다." end
			if lineIdx == 2 then return "검은 거래 장부는 도난당했고," end
			return "도시 곳곳에서는 폭발이 이어졌다."
		elseif cutIndex == 3 then
			if lineIdx == 1 then return "겉으로는 조용한 도시." end
			if lineIdx == 2 then return "하지만 보이지 않는 누군가가" end
			return "커닝시티 전체를 흔들고 있었다."
		elseif cutIndex == 4 then
			if lineIdx == 1 then return "그리고 어느 밤," end
			if lineIdx == 2 then return "익명의 초대장이 퍼졌다." end
			if lineIdx == 3 then return "\"범인을 찾고 싶다면," end
			return "하수구 아래로 내려와라.\""
		elseif cutIndex == 5 then
			if lineIdx == 1 then return "초대장을 받은 자들은" end
			if lineIdx == 2 then return "서로를 의심하면서도 지하로 향했다." end
			return "진실을 찾기 위해."
		end
		-- cutIndex == 6
		if lineIdx == 1 then return "하지만 문이 닫힌 순간," end
		if lineIdx == 2 then return "모두가 깨달았다." end
		if lineIdx == 3 then return "이 안에," end
		return "마피아가 섞여 있다."
	end

	method void SetCaptionText(string text, number alpha)
		-- Sets caption text and alpha.
		if self.captionText == nil or isvalid(self.captionText.Entity) == false then return end
		alpha = self:Clamp01(alpha)
		self.captionText.Text = text
		self.captionText.FontColor = Color(0.95, 0.95, 0.95, alpha)
	end

	method number Clamp01(number value)
		-- Clamps value to 0–1 range.
		return math.max(0, math.min(1, value))
	end

	method void SetEntityEnabled(Entity entity, boolean enabled)
		-- Safe SetEnable wrapper.
		if entity == nil or isvalid(entity) == false then return end
		entity:SetEnable(enabled)
	end

	method void SetEntityVisible(Entity entity, boolean visible)
		-- Safe Visible setter; enables entity first if needed.
		if entity == nil or isvalid(entity) == false then return end
		if entity.Enable == false then entity:SetEnable(true) end
		entity.Visible = visible
	end

	method void SetSpriteAlpha(SpriteGUIRendererComponent sprite, number alpha)
		-- Safe alpha setter on SpriteGUIRendererComponent.
		if sprite == nil or isvalid(sprite.Entity) == false then return end
		alpha = self:Clamp01(alpha)
		sprite:SetAlpha(alpha)
	end

	method void OnEndPlay()
		-- Cleans up timer and input handlers.
		if self.timerId > 0 then
			_TimerService:ClearTimer(self.timerId)
			self.timerId = 0
		end
		self:UnbindInput()
	end

end
