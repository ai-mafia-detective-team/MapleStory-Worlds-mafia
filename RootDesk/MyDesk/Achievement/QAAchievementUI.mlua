@Component
script QAAchievementUI extends Component

	property Entity popupRoot = "01a4c1cd-0b0e-4f3e-ba6f-35c9c5fb9c9d"
	property ButtonComponent closeButton = "ca172943-cb0a-4398-9105-1f27b0eec0cc"
	property ButtonComponent dailyTabButton = "afa3f9da-757e-4aa6-8354-9d1fdf75220e"
	property ButtonComponent weeklyTabButton = "72ccddce-a143-428d-9ada-7747eb29e80e"
	property ButtonComponent monthlyTabButton = "14e65093-e1d7-4f4e-88ca-4c98ffb33ec4"
	property ButtonComponent claimAllButton = "38ed5c69-ede5-4d95-ad9b-8f1edb5f15d0"
	property TextComponent balanceText = "fa2521c5-fa67-47b6-b354-ff613a427d08"
	property TextComponent statusText = "d3619e56-df87-423a-8106-2c20cf44a9fb"
	property table serverItems = {}
	property table rowAchievementIds = {}
	property string currentPeriod = "DAILY"
	property any closeHandler = nil
	property any dailyHandler = nil
	property any weeklyHandler = nil
	property any monthlyHandler = nil
	property any claimAllHandler = nil
	property table rowHandlers = {}

	method void OnBeginPlay()
		if self.Entity.Path ~= "/ui/UI_Lobby/LobbyRoot/ButtonGroup/Controller" then
			log("[QAAchievementUI] Legacy standalone controller skipped path=" .. self.Entity.Path)
			return
		end
		log("[QAAchievementUI] OnBeginPlay")
		local titleEntity = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/PopupRoot/Window/TitleText")
		if titleEntity ~= nil and titleEntity.TextComponent ~= nil then titleEntity.TextComponent.Text = "업적 수첩" end
		self.closeButton.Entity.TextComponent.Text = "닫기"
		self.claimAllButton.Entity.TextComponent.Text = "모두 받기"
		self:WireEvents()
		if self.popupRoot ~= nil and isvalid(self.popupRoot) then
			self.popupRoot:SetEnable(false)
		end
	end

	method void WireEvents()
		if self.closeHandler ~= nil then return end
		self.closeHandler = self.closeButton.Entity:ConnectEvent(ButtonClickEvent, function(event)
			self:Close()
		end)
		self.dailyHandler = self.dailyTabButton.Entity:ConnectEvent(ButtonClickEvent, function(event)
			self:SetPeriod("DAILY")
		end)
		self.weeklyHandler = self.weeklyTabButton.Entity:ConnectEvent(ButtonClickEvent, function(event)
			self:SetPeriod("WEEKLY")
		end)
		self.monthlyHandler = self.monthlyTabButton.Entity:ConnectEvent(ButtonClickEvent, function(event)
			self:SetPeriod("MONTHLY")
		end)
		self.claimAllHandler = self.claimAllButton.Entity:ConnectEvent(ButtonClickEvent, function(event)
			_QAAchievementManager:ClaimAll(self.currentPeriod)
		end)

		for i = 1, 4 do
			local index = i
			local buttonEntity = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/PopupRoot/Window/List/Row" .. tostring(index) .. "/ClaimButton")
			if buttonEntity ~= nil and isvalid(buttonEntity) then
				self.rowHandlers[index] = buttonEntity:ConnectEvent(ButtonClickEvent, function(event)
					local achievementId = self.rowAchievementIds[index]
					if achievementId ~= nil and achievementId ~= "" then
						_QAAchievementManager:ClaimReward(achievementId)
					end
				end)
			end
		end
	end

	method void Open()
		if self.popupRoot == nil or isvalid(self.popupRoot) == false then return end
		self.popupRoot:SetEnable(true)
		self.currentPeriod = "DAILY"
		self.statusText.Text = "업적 정보를 불러오는 중입니다..."
		_QAAchievementManager:RequestData()
		log("[QAAchievementUI] Open")
	end

	method void Close()
		if self.popupRoot ~= nil and isvalid(self.popupRoot) then
			self.popupRoot:SetEnable(false)
		end
		log("[QAAchievementUI] Close")
	end

	method void SetPeriod(string period)
		self.currentPeriod = period
		self:Render()
		log("[QAAchievementUI] Tab=" .. period)
	end

	method void SetSummaryText(string nodeName, string value)
		local path = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/PopupRoot/Window/SummaryPanel/" .. nodeName
		local entity = _EntityService:GetEntityByPath(path)
		if entity == nil or isvalid(entity) == false then return end

		if entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.Text = value
		elseif entity.TextComponent ~= nil then
			entity.TextComponent.Text = value
		end
	end

	method void UpdateSummary(number rewardBalance)
		local totalCount = 0
		local completedCount = 0
		local claimableCount = 0
		local periodTotals = { DAILY = 0, WEEKLY = 0, MONTHLY = 0 }
		local periodCompleted = { DAILY = 0, WEEKLY = 0, MONTHLY = 0 }

		for _, item in ipairs(self.serverItems) do
			totalCount = totalCount + 1
			local period = item.period or ""
			if periodTotals[period] ~= nil then
				periodTotals[period] = periodTotals[period] + 1
			end

			local completed = (item.progress or 0) >= math.max(1, item.target or 1)
			if completed then
				completedCount = completedCount + 1
				if periodCompleted[period] ~= nil then
					periodCompleted[period] = periodCompleted[period] + 1
				end
				if item.claimed ~= true then
					claimableCount = claimableCount + 1
				end
			end
		end

		local percent = 0
		if totalCount > 0 then
			percent = math.floor((completedCount / totalCount) * 100 + 0.5)
		end

		self:SetSummaryText("PercentText", tostring(percent) .. "%")
		self:SetSummaryText("CompletionText", tostring(completedCount) .. " / " .. tostring(totalCount))
		self:SetSummaryText("DailyValue", tostring(periodCompleted.DAILY) .. " / " .. tostring(periodTotals.DAILY))
		self:SetSummaryText("WeeklyValue", tostring(periodCompleted.WEEKLY) .. " / " .. tostring(periodTotals.WEEKLY))
		self:SetSummaryText("MonthlyValue", tostring(periodCompleted.MONTHLY) .. " / " .. tostring(periodTotals.MONTHLY))
		self:SetSummaryText("ClaimableValue", tostring(claimableCount) .. "개")
		self:SetSummaryText("CoinValue", tostring(rewardBalance))
	end

	method void ApplyServerState(string payloadJson, string message)
		local payload = _HttpService:JSONDecode(payloadJson)
		if payload == nil then
			self.statusText.Text = "업적 정보를 읽을 수 없습니다."
			return
		end
		self.serverItems = payload.items or {}
		self.balanceText.Text = "보유 메소  " .. tostring(payload.rewardBalance or 0)
		self:UpdateSummary(payload.rewardBalance or 0)
		self.statusText.Text = message or ""
		self:Render()
		if message ~= nil and message ~= "" and _UIToast ~= nil then
			_UIToast:ShowMessage(message)
		end
	end

	method void Render()
		local filtered = {}
		for _, item in ipairs(self.serverItems) do
			if item.period == self.currentPeriod then filtered[#filtered + 1] = item end
		end

		for i = 1, 4 do
			local row = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/PopupRoot/Window/List/Row" .. tostring(i))
			local item = filtered[i]
			if row == nil or isvalid(row) == false then continue end
			if item == nil then
				row:SetEnable(false)
				self.rowAchievementIds[i] = ""
				continue
			end
			row:SetEnable(true)
			self.rowAchievementIds[i] = item.id
			self:SetRowText(i, "Title", item.title)
			self:SetRowText(i, "Description", item.description)
			self:SetRowText(i, "ProgressText", tostring(item.progress) .. " / " .. tostring(item.target))
			self:SetRowText(i, "RewardText", "메소 " .. tostring(item.reward))

			local fill = _EntityService:GetEntityByPath(row.Path .. "/ProgressBar/Fill")
			if fill ~= nil and isvalid(fill) and fill.UITransformComponent ~= nil then
				local ratio = math.min(1, (item.progress or 0) / math.max(1, item.target or 1))
				fill.UITransformComponent.RectSize = Vector2(390 * ratio, 14)
			end

			local claimEntity = _EntityService:GetEntityByPath(row.Path .. "/ClaimButton")
			if claimEntity ~= nil and isvalid(claimEntity) then
				local completed = (item.progress or 0) >= (item.target or 1)
				claimEntity.ButtonComponent.Enable = completed and item.claimed ~= true
				if item.claimed == true then
					self:ApplyClaimButtonLayout(claimEntity, false)
					claimEntity.UITransformComponent.anchoredPosition = Vector2(-25, -5.165)
					claimEntity.UITransformComponent.RectSize = Vector2(180, 70)
					claimEntity.SpriteGUIRendererComponent.ImageRUID = DataRef("28b4995597af40d4a79601a3eab742c7")
					claimEntity.TextComponent.Text = ""
				elseif completed then
					self:ApplyClaimButtonLayout(claimEntity, true)
					claimEntity.SpriteGUIRendererComponent.ImageRUID = DataRef("8d808a399e75441b8e4e876d8cb3b061")
					claimEntity.TextComponent.Text = ""
				else
					self:ApplyClaimButtonLayout(claimEntity, false)
					claimEntity.SpriteGUIRendererComponent.ImageRUID = DataRef("fde1486b3a5b46a988b5cb6955d8265c")
					claimEntity.TextComponent.Text = ""
				end
			end
		end
		self:UpdateTabLabels()
	end

	method void ApplyClaimButtonLayout(Entity claimEntity, boolean rewardLayout)
		if claimEntity == nil or isvalid(claimEntity) == false or claimEntity.UITransformComponent == nil then return end
		if rewardLayout then
			claimEntity.UITransformComponent.anchoredPosition = Vector2(-9.522194, -0.552899957)
			claimEntity.UITransformComponent.RectSize = Vector2(221.946854, 87.02048)
		else
			claimEntity.UITransformComponent.anchoredPosition = Vector2(-15.1710815, -5.165)
			claimEntity.UITransformComponent.RectSize = Vector2(212.733459, 107.922943)
		end
	end

	method void SetRowText(integer rowIndex, string childName, string value)
		local entity = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/PopupRoot/Window/List/Row" .. tostring(rowIndex) .. "/" .. childName)
		if entity ~= nil and isvalid(entity) and entity.TextComponent ~= nil then
			entity.TextComponent.Text = value
		end
	end

	method void UpdateTabLabels()
		self:ApplyTabVisual(self.dailyTabButton.Entity, "일일", self.currentPeriod == "DAILY")
		self:ApplyTabVisual(self.weeklyTabButton.Entity, "주간", self.currentPeriod == "WEEKLY")
		self:ApplyTabVisual(self.monthlyTabButton.Entity, "월간", self.currentPeriod == "MONTHLY")
	end

	method void ApplyTabVisual(Entity tabEntity, string label, boolean active)
		if tabEntity == nil or isvalid(tabEntity) == false then return end
		if tabEntity.TextComponent ~= nil then
			tabEntity.TextComponent.Text = label
		end
		if tabEntity.SpriteGUIRendererComponent ~= nil then
			local ruid = active and "1bbac083829c4c738b351ea238bef7fd" or "10c10be2edab40e0a5be2c78492f8ab9"
			tabEntity.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
		end
	end

	method void OnEndPlay()
		if self.closeHandler ~= nil then self.closeHandler:Disconnect() end
		if self.dailyHandler ~= nil then self.dailyHandler:Disconnect() end
		if self.weeklyHandler ~= nil then self.weeklyHandler:Disconnect() end
		if self.monthlyHandler ~= nil then self.monthlyHandler:Disconnect() end
		if self.claimAllHandler ~= nil then self.claimAllHandler:Disconnect() end
		for _, connection in pairs(self.rowHandlers) do
			if connection ~= nil then connection:Disconnect() end
		end
	end

end
