@Component
script MafiaNightCinematic extends Component

property integer lastPhase = -1
property boolean actionSubmitted = false
property string CachedLocalId = ""
property string LastRoleData = ""
property integer MyRole = -1

@ExecSpace("ClientOnly")
method void OnBeginPlay()
    log("[NightCinematic] 초기화 완료")
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
    -- RoleData 변경 감지 → 내 역할 갱신
    local rd = _MafiaGameLogic.RoleData
    if rd ~= self.LastRoleData then
        self.LastRoleData = rd
        self.MyRole = self:ParseRole(rd)
    end

    local phase = _MafiaGameLogic.CurrentPhase

    -- 페이즈 변화 감지
    if phase ~= self.lastPhase then
        self.lastPhase = phase

        if phase == _MafiaGameLogic.PHASE_NIGHT then
            self.actionSubmitted = false
            local role = self.MyRole
            if role == _MafiaGameLogic.ROLE_MAFIA or
               role == _MafiaGameLogic.ROLE_POLICE or
               role == _MafiaGameLogic.ROLE_DOCTOR then
                self:SetTouchZonesActive(true)
                log("[NightCinematic] 밤 행동 활성화, 역할=" .. role)
            end
        else
            self:SetTouchZonesActive(false)
        end
    end
end

@ExecSpace("ClientOnly")
method void SetTouchZonesActive(boolean active)
    for i = 1, 8 do
        local zone = _EntityService:GetEntityByPath("/maps/map01/RoomZone_" .. i)
        if zone ~= nil then
            local zoneScript = zone.RoomTouchZone
            if zoneScript ~= nil then
                zoneScript.isActive = active
            end
        end
    end
end

@ExecSpace("ClientOnly")
method void OnRoomSelected(integer roomIndex)
    if self.actionSubmitted then
        log("[NightCinematic] 이미 행동 완료")
        return
    end
    local role = self.MyRole
    if role ~= _MafiaGameLogic.ROLE_MAFIA and
       role ~= _MafiaGameLogic.ROLE_POLICE and
       role ~= _MafiaGameLogic.ROLE_DOCTOR then
        return
    end

    self.actionSubmitted = true
    self:SetTouchZonesActive(false)

    log("[NightCinematic] 방 " .. roomIndex .. " 선택됨, 역할=" .. role)

    local actorId = self:GetLocalUserId()
    if actorId ~= "" then
        _MafiaGameLogic:SubmitNightAction(actorId, roomIndex)
    end
end

@ExecSpace("ClientOnly")
method table ParseCsv(string csv)
    local list = {}
    if csv == nil or csv == "" then return list end
    local i = 1
    for item in string.gmatch(csv, "([^,]+)") do
        list[i] = item
        i = i + 1
    end
    return list
end

@ExecSpace("ClientOnly")
method integer ParseRole(string roleData)
    if roleData == nil or roleData == "" then return -1 end
    local localId = self:GetLocalUserId()
    if localId == "" then return -1 end
    local parts = self:ParseCsv(roleData)
    local i = 1
    while i < #parts do
        if parts[i] == localId then
            return tonumber(parts[i + 1])
        end
        i = i + 2
    end
    return -1
end

@ExecSpace("ClientOnly")
method string GetLocalUserId()
    if self.CachedLocalId ~= "" then return self.CachedLocalId end
    local localPlayer = _UserService.LocalPlayer
    if localPlayer == nil then return "" end
    local keys = _UserService.Users.Keys
    for _, uid in ipairs(keys) do
        local ent = _UserService:GetUserEntityByUserId(tostring(uid))
        if ent ~= nil and ent == localPlayer then
            self.CachedLocalId = tostring(uid)
            return self.CachedLocalId
        end
    end
    return ""
end

end
