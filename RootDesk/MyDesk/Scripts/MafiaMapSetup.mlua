@Logic
script MafiaMapSetup extends Logic

	property table roomMinX = {}
	property table roomMaxX = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		log("[MafiaMapSetup] 방 경계 초기화 시작")

		-- 2026-06-29 기준: 각 방 투명 발판의 양끝 X 좌표
		self.roomMinX[1] = -5.400  self.roomMaxX[1] = -2.427
		self.roomMinX[2] = 2.497   self.roomMaxX[2] = 5.406
		self.roomMinX[3] = -5.314  self.roomMaxX[3] = -2.513
		self.roomMinX[4] = 2.411   self.roomMaxX[4] = 5.288
		self.roomMinX[5] = -5.433  self.roomMaxX[5] = -2.405
		self.roomMinX[6] = 2.454   self.roomMaxX[6] = 5.439
		self.roomMinX[7] = -5.368  self.roomMaxX[7] = -2.437
		self.roomMinX[8] = 2.422   self.roomMaxX[8] = 5.406

		log("[MafiaMapSetup] 방 경계 초기화 완료 (8개 방, 2026-06-29 좌표)")
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if _MafiaGameLogic == nil then return end

		local userKeys = _UserService.Users.Keys
		for _, userId in ipairs(userKeys) do
		    local ent = _UserService:GetUserEntityByUserId(tostring(userId))
		    if ent ~= nil then
		        local roomId = _MafiaGameLogic:GetLobbyRoom(userId)
		        if roomId >= 1 and roomId <= 8 then
		            local minX = self.roomMinX[roomId]
		            local maxX = self.roomMaxX[roomId]
		            if minX ~= nil and maxX ~= nil then
		                local pos = ent.TransformComponent.Position
		                if pos.x < minX then
		                    ent.TransformComponent.Position = Vector3(minX, pos.y, pos.z)
		                    local rb = ent.RigidbodyComponent
		                    if rb ~= nil then rb.MoveVelocity = Vector2(0, rb.MoveVelocity.y) end
		                elseif pos.x > maxX then
		                    ent.TransformComponent.Position = Vector3(maxX, pos.y, pos.z)
		                    local rb = ent.RigidbodyComponent
		                    if rb ~= nil then rb.MoveVelocity = Vector2(0, rb.MoveVelocity.y) end
		                end
		            end
		        end
		    end
		end
	end

end
