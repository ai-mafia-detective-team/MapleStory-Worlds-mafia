@Logic
script MafiaGameLogic extends Logic

	property boolean DebugMode = true

	property integer PHASE_LOBBY = 0

	property integer PHASE_FREE_ROAM = 1

	property integer PHASE_NIGHT = 2

	property integer PHASE_MORNING = 3

	property integer PHASE_MEETING = 4

	property integer PHASE_MEETING_RESULT = 5

	property integer PHASE_GAME_OVER = 6

	property integer PHASE_NIGHT_MAFIA = 21

	property integer PHASE_NIGHT_POLICE = 22

	property integer PHASE_NIGHT_DOCTOR = 23

	property integer ROLE_CITIZEN = 0

	property integer ROLE_MAFIA = 1

	property integer ROLE_POLICE = 2

	property integer ROLE_DOCTOR = 3

	property integer MAX_PLAYERS = 8

	property integer MIN_PLAYERS = 6

	property string RoomTitle = "커닝시티 마피아"

	property boolean IsPrivateRoom = true

	property string RoomPassword = ""

	property integer RoomMaxPlayers = 8

	property integer MafiaPlayerCount = 2

	property integer CurrentPhase = 0

	property integer RoundResetVersion = 0

	property number PhaseTimer = 0.0

	property number MaxPhaseTime = 0.0

	property integer DayCount = 0

	property integer WinnerRole = -1

	property boolean PoliceResult = false

	property string ExecuteTarget = ""

	property string MorningKilled = ""

	property boolean DoctorSaved = false

	property integer LocalPlayerRole = -1

	property string RoleData = ""

	property string AlivePlayersList = ""

	property integer NightSubPhase = 0

	property integer NightStageVersion = 0

	property string MafiaDeciderId = ""

	property string VoteStatusList = ""

	property string ChatLog = ""

	property string MafiaChatLog = ""

	property string DeadChatLog = ""

	property integer LobbyPlayerCount = 0

	property integer ReadyCount = 0

	property string ReadyStatusList = ""

	property string LobbySeatOrder = ""

	property string LobbySeatNicknames = ""

	property string DayAvatarMotionData = ""

	property string DaySkipStatusList = ""

	property boolean GameStarted = false

	property string activeRoomEntityId = ""

	property string activeRoomId = ""

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if _InvestigationRoomManager == nil then return end
		local entityId = _InvestigationRoomManager.currentLogicalRoomEntityId or ""
		local roomId = _InvestigationRoomManager.currentLogicalRoomId or ""
		if entityId == "" or roomId == "" then return end
		local entity = _EntityService:GetEntity(entityId)
		if entity == nil or isvalid(entity) == false then return end
		local room = entity:GetComponent("script.MafiaRoomGameLogic")
		if room == nil or room.RoomId ~= roomId then return end
		self.activeRoomEntityId = entityId
		self.activeRoomId = roomId
		self:CopyRoomState(room)
	end

	@ExecSpace("ClientOnly")
	method void CopyRoomState(any room)
		self.DebugMode = room.DebugMode
		self.MAX_PLAYERS = room.MAX_PLAYERS
		self.MIN_PLAYERS = room.MIN_PLAYERS
		self.RoomTitle = room.RoomTitle
		self.IsPrivateRoom = room.IsPrivateRoom
		self.RoomPassword = room.RoomPassword
		self.RoomMaxPlayers = room.RoomMaxPlayers
		self.MafiaPlayerCount = room.MafiaPlayerCount
		self.CurrentPhase = room.CurrentPhase
		self.RoundResetVersion = room.RoundResetVersion
		self.PhaseTimer = room.PhaseTimer
		self.MaxPhaseTime = room.MaxPhaseTime
		self.DayCount = room.DayCount
		self.WinnerRole = room.WinnerRole
		self.PoliceResult = room.PoliceResult
		self.ExecuteTarget = room.ExecuteTarget
		self.MorningKilled = room.MorningKilled
		self.DoctorSaved = room.DoctorSaved
		self.RoleData = room.RoleData
		self.AlivePlayersList = room.AlivePlayersList
		self.NightSubPhase = room.NightSubPhase
		self.NightStageVersion = room.NightStageVersion
		self.MafiaDeciderId = room.MafiaDeciderId
		self.VoteStatusList = room.VoteStatusList
		self.ChatLog = room.ChatLog
		self.MafiaChatLog = room.MafiaChatLog
		self.DeadChatLog = room.DeadChatLog
		self.LobbyPlayerCount = room.LobbyPlayerCount
		self.ReadyCount = room.ReadyCount
		self.ReadyStatusList = room.ReadyStatusList
		self.LobbySeatOrder = room.LobbySeatOrder
		self.LobbySeatNicknames = room.LobbySeatNicknames
		self.DayAvatarMotionData = room.DayAvatarMotionData
		self.DaySkipStatusList = room.DaySkipStatusList
		self.GameStarted = room.GameStarted
	end

	@ExecSpace("ServerOnly")
	method any GetRoomLogicForUser(string userId)
		if _InvestigationRoomManager == nil then return nil end
		return _InvestigationRoomManager:GetLogicalRoomLogicForUser(userId)
	end

	@ExecSpace("Server")
	method void EnterRoomLobby()
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:EnterRoomLobbyForUser(tostring(senderUserId)) end
	end

	@ExecSpace("Server")
	method void SetReady(string userId, boolean ready)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:SetReady(tostring(senderUserId), ready) end
	end

	@ExecSpace("Server")
	method void RequestLeaveRoom()
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:RemoveMember(tostring(senderUserId)) end
	end

	@ExecSpace("Server")
	method void SetRoomSettings(string roomTitle, boolean isPrivate, string password, integer maxPlayers, integer mafiaCount)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:SetRoomSettings(roomTitle, isPrivate, password, maxPlayers, mafiaCount) end
	end

	@ExecSpace("Server")
	method void SetDayAvatarMotion(string userId, number avatarX, boolean flipX, string actionState)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:SetDayAvatarMotion(tostring(senderUserId), avatarX, flipX, actionState) end
	end

	@ExecSpace("Server")
	method void RequestSkipToMeeting(string requesterId)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:RequestSkipToMeeting(tostring(senderUserId)) end
	end

	@ExecSpace("Server")
	method void SubmitVote(string voterId, string targetId)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:SubmitVote(tostring(senderUserId), targetId) end
	end

	@ExecSpace("Server")
	method void MafiaChooseTarget(string mafiaId, string targetId)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:MafiaChooseTarget(tostring(senderUserId), targetId) end
	end

	@ExecSpace("Server")
	method void PoliceInvestigate(string policeId, string targetId)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:PoliceInvestigate(tostring(senderUserId), targetId) end
	end

	@ExecSpace("Server")
	method void DoctorProtect(string doctorId, string targetId)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:DoctorProtect(tostring(senderUserId), targetId) end
	end

	@ExecSpace("Server")
	method void RestartGame()
		local userId = tostring(senderUserId)
		local room = self:GetRoomLogicForUser(userId)
		if room ~= nil then room:RestartGameForUser(userId) end
	end

	@ExecSpace("Server")
	method void SubmitNightAction(string actorId, integer targetRoom)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:SubmitNightAction(tostring(senderUserId), targetRoom) end
	end

	@ExecSpace("Server")
	method void SendChat(string userId, string message)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:SendChat(tostring(senderUserId), message) end
	end

	@ExecSpace("Server")
	method void SendMafiaChat(string userId, string message)
		local room = self:GetRoomLogicForUser(tostring(senderUserId))
		if room ~= nil then room:SendMafiaChat(tostring(senderUserId), message) end
	end

	@ExecSpace("ServerOnly")
	method integer GetLobbyRoom(string userId)
		if _InvestigationRoomManager == nil then return -1 end
		local room = _InvestigationRoomManager:GetLogicalRoomLogicForUser(userId)
		if room == nil then return -1 end
		return room:GetLobbyRoom(userId)
	end

	@ExecSpace("Client")
	method void ResetLocalRole()
		self.LocalPlayerRole = -1
	end

	@ExecSpace("ServerOnly")
	method void ResetRoomState()
		-- Compatibility entry used by registry cleanup. Per-room instances own real state.
	end

end