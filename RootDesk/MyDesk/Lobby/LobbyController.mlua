	method void OnSettingsMuteClicked(ButtonClickEvent event)
		-- Toggles the main flow BGM and updates the settings sound button image.
		self.isSettingsSoundOn = self.isSettingsSoundOn == false
		if _MainFlowBgmController ~= nil then
			_MainFlowBgmController:SetBgmEnabled(self.isSettingsSoundOn)
		end
		self:UpdateSettingsSoundToggleImage()
		log("[LobbyController] Settings sound toggle clicked enabled=" .. tostring(self.isSettingsSoundOn))
	end

