	method void OnBeginPlay()
		-- Fires when UI_Lobby is enabled by IntroFlowController (SetEnable → OnBeginPlay).
		-- ShowLobby(nickname) is called immediately after.
		log("[LobbyController] OnBeginPlay")
		log("[LobbyController] self.Entity.Path=" .. tostring(self.Entity.Path))
		self:SetInvestigationRoomSearchVisible(false)
		self:WireKeyboardInput()
	end

	method void ShowLobby(string nickname)
		-- Enables LobbyRoot, configures avatar renderer, applies nickname, wires buttons.
		log("[LobbyController] ShowLobby called nickname=" .. nickname)
		log("[LobbyController] Avatar constants GROUND_Y=" .. tostring(self.GROUND_Y) .. " MIN_X=" .. tostring(self.MIN_X) .. " MAX_X=" .. tostring(self.MAX_X))
		log("[LobbyController] Avatar SD ratio adjusted=true")
		log("[LobbyController] LobbyAvatar size=" .. tostring(self.AVATAR_WIDTH) .. "x" .. tostring(self.AVATAR_HEIGHT))
		log("[LobbyController] Avatar foot realigned after ratio change=true")
		log("[LobbyController] Nickname position adjusted=true")
		log("[LobbyController] Walk visual fallback enabled=" .. tostring(self.WALK_VISUAL_FALLBACK_ENABLED))
		log("[LobbyController] Walk bob amplitude=" .. tostring(self.WALK_BOB_AMOUNT))
		log("[LobbyController] Jump visual fallback enabled=" .. tostring(self.JUMP_VISUAL_FALLBACK_ENABLED))
		log("[LobbyController] Move range adjusted MIN_X=" .. tostring(self.MIN_X) .. " MAX_X=" .. tostring(self.MAX_X))
		log("[LobbyController] AvatarNameText offset adjusted to " .. tostring(self.NAME_OFFSET_Y))

		local lobbyRoot = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot")
		if lobbyRoot ~= nil and isvalid(lobbyRoot) then
			lobbyRoot:SetEnable(true)
			lobbyRoot.Visible = true
			log("[LobbyController] LobbyRoot visible=true enable=true")
		else
			log_warning("[LobbyController] LobbyRoot not found")
		end

		self:ApplyLobbyBackgroundVisuals()
		self:DisableBlackOverlayBlockers()

		-- Hide world LocalPlayer character: IntroFlowController.ShowLobby() makes it visible,
		-- so we override here. Lobby uses UI Avatar only.
		local worldPlayer = _UserService.LocalPlayer
		if worldPlayer ~= nil and isvalid(worldPlayer) then
			log("[LobbyController] LocalPlayer found=true")
			worldPlayer.Visible = false
			local spriteComp = worldPlayer.SpriteRendererComponent
			if spriteComp ~= nil then
				spriteComp.Enable = false
			end
			local skeletonComp = worldPlayer.SkeletonRendererComponent
			if skeletonComp ~= nil then
				skeletonComp.Enable = false
			end
			log("[LobbyController] World character hidden for lobby")
		else
			log_warning("[LobbyController] LocalPlayer not found — cannot hide world character")
		end

		self:HideBottomChatPanel()
		self:HideLegacyLobbyButtons()
		self:HideMatchmakingPopup()
		self:HideSettingsPopup()
		self:HideExternalPopups()
		self:CloseCollectionPopup()
		self:CloseBagPopup()
		self:SetCreateRoomModalVisible(false)
		self:CloseCommonPopup()
		self:WireCommonPopupEvents()

		-- Cache fallback entity (disabled by default)
		local fallbackEnt = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarFallback")
		if fallbackEnt ~= nil and isvalid(fallbackEnt) then
			self.fallbackCache = fallbackEnt
			self:HideAvatarFallback()
		end

		-- Diagnose and configure LobbyAvatar
		local avatarPath = "/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/LobbyAvatar"
		log("[LobbyController] Avatar renderer target path=" .. avatarPath)
		local avatarEntity = _EntityService:GetEntityByPath(avatarPath)
		local avatarFound = avatarEntity ~= nil and isvalid(avatarEntity)
		log("[LobbyController] LobbyAvatar found=" .. tostring(avatarFound))

		if avatarFound then
			log("[LobbyController] LobbyAvatar visible=" .. tostring(avatarEntity.Visible) .. " enable=" .. tostring(avatarEntity.Enable))
			log("[LobbyController] LobbyAvatar displayOrder=80")
			self.avatarCache = avatarEntity

			local avatarComp = avatarEntity.AvatarGUIRendererComponent
			log("[LobbyController] AvatarGUIRendererComponent found=" .. tostring(avatarComp ~= nil))
			self.avatarAnimationApiFound = avatarComp ~= nil
			log("[LobbyController] Avatar animation API found=" .. tostring(self.avatarAnimationApiFound))

			-- LocalPlayer identity needed by CostumeManagerComponent
			local player = _UserService.LocalPlayer
			local playerFound = player ~= nil and isvalid(player)
			log("[LobbyController] LocalPlayer found=" .. tostring(playerFound))

			if playerFound then
				-- Set DefaultEquipUserId so CostumeManagerComponent mirrors LocalPlayer's avatar
				local playerComp = player.PlayerComponent
				local costumeComp = avatarEntity.CostumeManagerComponent
				if playerComp ~= nil and costumeComp ~= nil then
					costumeComp.DefaultEquipUserId = playerComp.UserId
					costumeComp.UseCustomEquipOnly = false
					log("[LobbyController] Avatar renderer configured userId=" .. tostring(playerComp.UserId))
				elseif costumeComp ~= nil then
					-- Fallback: empty DefaultEquipUserId → engine may default to LocalPlayer
					costumeComp.UseCustomEquipOnly = false
					log("[LobbyController] Avatar renderer configured (PlayerComponent nil, using empty userId)")
				end
			end

			self.currentAvatarState = ""
			self.currentAvatarDirection = "left"
			self.walkBobTime = 0
			self.walkBobLogTimer = 0
			self.walkBobEnabledLogged = false
			log("[LobbyController] Avatar action API sample found=true")
			log("[LobbyController] Avatar action apply method=ActionStateChangedEvent")
			log("[LobbyController] Avatar action map idle=stand1 walk=walk1 jump=jump")
			log("[LobbyController] Avatar facing direction=left")
			self:ApplyAvatarState("idle")
			log("[LobbyController] Avatar renderer applied success=true")
			self:HideAvatarFallback()
		else
			self.avatarAnimationApiFound = false
			log("[LobbyController] Avatar animation API found=false")
		end

		self:ConfigureProfilePortrait()

		-- Cache AvatarNameText
		local nameText = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarNameText")
		if nameText ~= nil and isvalid(nameText) then
			self.nameTextCache = nameText
			log("[LobbyController] AvatarNameText cached")
		else
			log_warning("[LobbyController] AvatarNameText not found")
		end

		self:ResetAvatarPosition()
		self:ApplyNickname(nickname)
		self:WireButtonEvents()
		if _MoneyManager ~= nil then
			_MoneyManager:LoadMoney()
		end
		if _QAAchievementManager ~= nil then
			_QAAchievementManager:ReportLobbyAction("LOBBY_ENTER", "")
		end
	end

	method void ConfigureProfilePortrait()
		-- Applies default profile image and requests saved RUID from server DataStorage.
		log("[LobbyController] ConfigureProfilePortrait: applying default + requesting saved profile")
		self:ApplyProfileImage(self.selectedProfileRuid)
		_ProfileStorageLogic:RequestLoadAllProfile()
	end

	method void ApplyLobbyBackgroundVisuals()
		-- Applies the lobby background RUID and restores full-screen stretch at runtime.
		local bg = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyBackground")
		if bg == nil or isvalid(bg) == false then
			log_warning("[LobbyController] LobbyBackground not found")
			return
		end

		bg:SetEnable(true)
		bg.Visible = true

		local transform = bg.UITransformComponent
		if transform ~= nil then
			transform.AlignmentOption = AlignmentType.StretchAll
			transform.AnchorsMin = Vector2(0, 0)
			transform.AnchorsMax = Vector2(1, 1)
			transform.OffsetMin = Vector2(0, 0)
			transform.OffsetMax = Vector2(0, 0)
			transform.RectSize = Vector2(1920, 1080)
			transform.anchoredPosition = Vector2(0, 0)
		end

		-- ImageRUID는 UI_Lobby.ui에서만 관리합니다 (mlua에서 덮어쓰지 않음).
		local bgComp = bg.SpriteGUIRendererComponent
		if bgComp ~= nil then
			bgComp.Enable = false
			bgComp.Color = Color(1, 1, 1, 1)
			bgComp.RaycastTarget = false
			bgComp.Enable = true
			bgComp:SetAlpha(1)
		end

		local fullStretch = false
		local rectText = "nil"
		if transform ~= nil then
			fullStretch = transform.AlignmentOption == AlignmentType.StretchAll and transform.OffsetMin.x == 0 and transform.OffsetMin.y == 0 and transform.OffsetMax.x == 0 and transform.OffsetMax.y == 0
			rectText = tostring(transform.RectSize.x) .. "x" .. tostring(transform.RectSize.y)
		end

		log("[LobbyController] LobbyBackground found=true")
		log("[LobbyController] LobbyBackground visible=true alpha=1")
		log("[LobbyController] LobbyBackground applied success")
		log("[LobbyController] LobbyBackground full stretch=" .. tostring(fullStretch))
		log("[LobbyController] LobbyBackground rect=" .. rectText)
	end

	method void DisableBlackOverlayBlockers()
		-- Disables only large dark sprite overlays that can cover the lobby background.
		local found = false
		local disabled = false
		local paths = {
			"/ui/UI_Lobby/LobbyRoot",
			"/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea",
			"/ui/UI_Lobby/LobbyRoot/TopHud",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons",
			"/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarFallback"
		}

		for _, path in ipairs(paths) do
			local ent = _EntityService:GetEntityByPath(path)
			if ent ~= nil and isvalid(ent) then
				local sprite = ent.SpriteGUIRendererComponent
				local transform = ent.UITransformComponent
				if sprite ~= nil and transform ~= nil then
					local color = sprite.Color
					local isDark = color.r <= 0.08 and color.g <= 0.08 and color.b <= 0.08 and color.a > 0.1
					local isLarge = transform.RectSize.x >= 500 or transform.RectSize.y >= 500
					if isDark and isLarge then
						found = true
						sprite:SetAlpha(0)
						sprite.Enable = false
						disabled = true
					end
				end
			end
		end

		log("[LobbyController] black overlay blocker found=" .. tostring(found))
		log("[LobbyController] black overlay blocker disabled=" .. tostring(disabled))
	end

	method void HideBottomChatPanel()
		-- Keeps the unused chat panel and its children hidden.
		local paths = {
			"/ui/UI_Lobby/LobbyRoot/BottomChatPanel",
			"/ui/UI_Lobby/LobbyRoot/BottomChatPanel/ChatInput",
			"/ui/UI_Lobby/LobbyRoot/BottomChatPanel/ChatLogArea"
		}
		for _, path in ipairs(paths) do
			local ent = _EntityService:GetEntityByPath(path)
			if ent ~= nil and isvalid(ent) then
				ent:SetEnable(false)
				ent.Visible = false
			end
		end
		log("[LobbyController] BottomChatPanel hidden")
	end

	method void SetEntityActive(string path, boolean active)
		local ent = _EntityService:GetEntityByPath(path)
		if ent ~= nil and isvalid(ent) then
			ent:SetEnable(active)
			ent.Visible = active
		end
	end

	method void HideLegacyLobbyButtons()
		-- The new Maple-style ButtonGroup replaces the old placeholder button containers.
		local paths = {
			"/ui/UI_Lobby/LobbyRoot/LeftMenu",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu/CodexButton",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu/BagButton",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu/AchievementButton",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons/StartButton",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons/CreateRoomButton",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons/FindRoomButton",
			"/ui/UI_Lobby/LobbyRoot/TopHud/FriendButton",
			"/ui/UI_Lobby/LobbyRoot/TopHud/MenuButton"
		}
		for _, path in ipairs(paths) do
			self:SetEntityActive(path, false)
		end
		log("[LobbyController] Legacy placeholder lobby buttons hidden")
	end

	method void SetMatchmakingPopup(boolean active)
		-- Shows or hides the matchmaking modal entity tree.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking")
		if popup ~= nil and isvalid(popup) then
			popup:SetEnable(active)
			popup.Visible = active
			local canvas = popup.CanvasGroupComponent
			if canvas ~= nil then
				canvas.GroupAlpha = active and 1 or 0
				canvas.Interactable = active
				canvas.BlocksRaycasts = active
			end
			local dimmer = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Dimmer")
			if dimmer ~= nil and isvalid(dimmer) then
				dimmer:SetEnable(active)
				dimmer.Visible = active
			end
		end
		log("[LobbyController] Matchmaking popup active=" .. tostring(active))
	end

	method void HideMatchmakingPopup()
		-- Hides matchmaking without emitting cancel-specific logs during lobby setup.
		self:CloseMatchmakingModal()
	end

	method string FormatMatchmakingTime(integer elapsedSeconds)
		-- Converts elapsed seconds to mm:ss text.
		if elapsedSeconds < 0 then elapsedSeconds = 0 end
		local minutes = math.floor(elapsedSeconds / 60)
		local seconds = elapsedSeconds - minutes * 60
		local minuteText = tostring(minutes)
		local secondText = tostring(seconds)
		if minutes < 10 then minuteText = "0" .. minuteText end
		if seconds < 10 then secondText = "0" .. secondText end
		return minuteText .. ":" .. secondText
	end

	method void SetMatchmakingElapsedText(string text)
		-- Writes the elapsed timer label when the text entity exists.
		local elapsed = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Box/Elapsed")
		if elapsed ~= nil and isvalid(elapsed) and elapsed.TextComponent ~= nil then
			elapsed.TextComponent.Text = text
		end
	end

	method void SetMatchmakingDotAlpha(string path, number alpha)
		-- Applies alpha to one loading dot.
		local dot = _EntityService:GetEntityByPath(path)
		if dot ~= nil and isvalid(dot) and dot.SpriteGUIRendererComponent ~= nil then
			local color = dot.SpriteGUIRendererComponent.Color
			dot.SpriteGUIRendererComponent.Color = Color(color.r, color.g, color.b, alpha)
		end
	end

	method void SetMatchmakingDotScale(string path, number scale)
		-- Applies uniform XY scale to one loading dot for the pulse highlight effect.
		local dot = _EntityService:GetEntityByPath(path)
		if dot ~= nil and isvalid(dot) and dot.UITransformComponent ~= nil then
			dot.UITransformComponent.UIScale = Vector3(scale, scale, 1)
		end
	end

	method void ResetMatchmakingDots()
		-- Restores all loading dots to their idle alpha and default scale.
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Box/"
		self:SetMatchmakingDotAlpha(base .. "Dot1", 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot2", 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot3", 0.35)
		self:SetMatchmakingDotScale(base .. "Dot1", 1.0)
		self:SetMatchmakingDotScale(base .. "Dot2", 1.0)
		self:SetMatchmakingDotScale(base .. "Dot3", 1.0)
	end

	method void OpenMatchmakingModal()
		-- Opens matchmaking modal and starts its local timer.
		self.isMatchmaking = true
		self.matchmakingElapsed = 0
		self.dotAnimTime = 0
		self.lastMatchmakingElapsedSecond = -1
		self:SetMatchmakingElapsedText("00:00")
		self:ResetMatchmakingDots()
		self:SetMatchmakingPopup(true)
		log("[LobbyController] Matchmaking modal opened")
		log("[LobbyController] Matchmaking timer started")
	end

	method void CloseMatchmakingModal()
		-- Closes matchmaking modal and resets timer/dot state.
		self.isMatchmaking = false
		self.matchmakingElapsed = 0
		self.dotAnimTime = 0
		self.lastMatchmakingElapsedSecond = -1
		self:SetMatchmakingElapsedText("00:00")
		self:ResetMatchmakingDots()
		self:SetMatchmakingPopup(false)
		log("[LobbyController] Matchmaking modal closed")
	end

	method void CancelMatchmaking()
		-- Cancels the local matchmaking wait UI.
		self:CloseMatchmakingModal()
		log("[LobbyController] Matchmaking cancelled")
	end

	method void UpdateMatchmakingModal(number delta)
		-- Advances timer text and loading dots while matchmaking is open.
		if self.isMatchmaking == false then return end

		self.matchmakingElapsed += delta
		self.dotAnimTime += delta

		local elapsedSeconds = math.floor(self.matchmakingElapsed)
		if elapsedSeconds ~= self.lastMatchmakingElapsedSecond then
			self.lastMatchmakingElapsedSecond = elapsedSeconds
			self:SetMatchmakingElapsedText(self:FormatMatchmakingTime(elapsedSeconds))
		end

		local phase = math.floor(self.dotAnimTime / 0.3) % 3
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Box/"
		self:SetMatchmakingDotAlpha(base .. "Dot1", phase == 0 and 1 or 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot2", phase == 1 and 1 or 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot3", phase == 2 and 1 or 0.35)
		self:SetMatchmakingDotScale(base .. "Dot1", phase == 0 and 1.22 or 1.0)
		self:SetMatchmakingDotScale(base .. "Dot2", phase == 1 and 1.22 or 1.0)
		self:SetMatchmakingDotScale(base .. "Dot3", phase == 2 and 1.22 or 1.0)
	end

	method void SetSettingsPopup(boolean active)
		-- Shows or hides the settings popup and resets it to the sound tab when opened.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/SettingsPopup")
		if popup ~= nil and isvalid(popup) then
			popup:SetEnable(active)
			popup.Visible = active
		end
		if active == true then
			self:SyncSettingsSoundState()
			self:ShowSettingsTab("sound")
		end
		log("[LobbyController] Settings popup active=" .. tostring(active))
	end

	method void HideSettingsPopup()
		-- Hides the settings popup.
		self:SetSettingsPopup(false)
	end

	method void ShowSettingsTab(string tabName)
		-- Switches the settings modal between the info and sound content panels.
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/SettingsPopup/Panel"
		local info = _EntityService:GetEntityByPath(base .. "/ContentInfo")
		local sound = _EntityService:GetEntityByPath(base .. "/ContentSound")
		local showSound = (tabName == "sound")

		if info ~= nil and isvalid(info) then
			info:SetEnable(showSound == false)
			info.Visible = (showSound == false)
		else
			log_warning("[LobbyController] Settings ContentInfo not found")
		end

		if sound ~= nil and isvalid(sound) then
			sound:SetEnable(showSound)
			sound.Visible = showSound
		else
			log_warning("[LobbyController] Settings ContentSound not found")
		end

		log("[LobbyController] Settings tab selected=" .. tabName)
	end

	method void SyncSettingsSoundState()
		-- Reads the current BGM setting and mirrors it into the settings sound toggle image.
		local enabled = true
		if _MainFlowBgmController ~= nil then
			enabled = _MainFlowBgmController:IsBgmEnabled()
		end
		self.isSettingsSoundOn = enabled
		self:UpdateSettingsSoundToggleImage()
		log("[LobbyController] Settings sound synced enabled=" .. tostring(enabled))
	end

	method void UpdateSettingsSoundToggleImage()
		-- Applies the configured ON/OFF RUID to the settings sound toggle button.
		local sprite = self.settingsMuteButtonSprite
		if sprite == nil then
			local ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/SettingsPopup/Panel/ContentSound/MuteBtn")
			if ent ~= nil and isvalid(ent) then
				sprite = ent.SpriteGUIRendererComponent
			end
		end

		if sprite == nil then
			log_warning("[LobbyController] Settings sound toggle sprite not found")
			return
		end

		if self.isSettingsSoundOn then
			sprite.ImageRUID = DataRef(self.RUID_TOGGLE_ON)
		else
			sprite.ImageRUID = DataRef(self.RUID_TOGGLE_OFF)
		end
		log("[LobbyController] Settings sound toggle image on=" .. tostring(self.isSettingsSoundOn))
	end

	method void SetExternalPopupVisible(string popupName, boolean active)
		-- Shows or hides one of the lobby popups under ButtonGroup.
		local popupPath = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/" .. popupName
		local popup = _EntityService:GetEntityByPath(popupPath)
		if popup ~= nil and isvalid(popup) then
			popup:SetEnable(active)
			popup.Visible = active
			local uiTransform = popup.UITransformComponent
			if active == true and uiTransform ~= nil then
				_UILogic:SetSiblingIndex(uiTransform, 1000000)
			end
		else
			log_warning("[LobbyController] External popup not found: " .. popupPath)
		end
	end

	method void HideExternalPopups()
		self:SetExternalPopupVisible("FriendPopup", false)
		self:SetExternalPopupVisible("ShopPopup", false)
		self:SetExternalPopupVisible("AlertPopup", false)
	end

	method void SetCollectionPopup(boolean active)
		-- Shows or hides CollectionPopup and keeps CanvasGroup interaction aligned.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup")
		if popup == nil or isvalid(popup) == false then
			log_warning("[CollectionPopup] target not found")
			return
		end

		popup:SetEnable(active)
		popup.Visible = active

		local canvasGroup = popup.CanvasGroupComponent
		if canvasGroup ~= nil then
			if active == true then
				canvasGroup.GroupAlpha = 1
			else
				canvasGroup.GroupAlpha = 0
			end
			canvasGroup.Interactable = active
			canvasGroup.BlocksRaycasts = active
		end

		log("[CollectionPopup] active=" .. tostring(active))
	end

	method void OpenCollectionPopup()
		-- Opens CollectionPopup without changing internal tab or card state.
		self:SetCollectionPopup(true)
	end

	method void CloseCollectionPopup()
		-- Closes CollectionPopup without resetting internal page state.
		self:SetCollectionPopup(false)
	end

	method void SetBagPopup(boolean active)
		-- Shows or hides BagPopup and keeps CanvasGroup interaction aligned.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup")
		if popup == nil or isvalid(popup) == false then
			log_warning("[BagPopup] entity not found")
			return
		end

		popup:SetEnable(active)
		popup.Visible = active

		local canvasGroup = popup.CanvasGroupComponent
		if canvasGroup ~= nil then
			if active == true then
				canvasGroup.GroupAlpha = 1
			else
				canvasGroup.GroupAlpha = 0
			end
			canvasGroup.Interactable = active
			canvasGroup.BlocksRaycasts = active
		end

		log("[BagPopup] active=" .. tostring(active))
	end

	method void OpenBagPopup()
		-- Opens BagPopup without changing internal category or item state.
		self:WireBagPopupEvents()
		self:SetBagPopup(true)
	end

	method void CloseBagPopup()
		-- Closes BagPopup without resetting internal UI state.
		self:SetBagPopup(false)
	end

	method void OpenExternalPopup(string popupName)
		-- Opens one lobby popup and refreshes feature data when required.
		self:HideSettingsPopup()
		self:HideExternalPopups()
		self:SetExternalPopupVisible(popupName, true)
		if popupName == "FriendPopup" then
			self:RefreshFriendPopup()
		end
		log("[LobbyController] External popup opened=" .. popupName)
	end

	method void OnExternalPopupCloseClicked(ButtonClickEvent event)
		self:HideExternalPopups()
		log("[LobbyController] External popup close clicked")
	end

	method void OnCollectionPopupCloseClicked(ButtonClickEvent event)
		-- Closes CollectionPopup from either close button.
		log("[CollectionPopup] close clicked")
		self:CloseCollectionPopup()
	end

	method void OnBagPopupCloseClicked(ButtonClickEvent event)
		-- Closes BagPopup from either close button.
		log("[BagPopup] close clicked")
		self:CloseBagPopup()
	end

	method void SetCreateRoomModalVisible(boolean active)
		-- Shows or hides the create-room modal tree.
		local modal = self.createRoomModalRoot
		if modal == nil or isvalid(modal) == false then
			modal = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/CreateRoomModalRoot")
			self.createRoomModalRoot = modal
		end
		if modal ~= nil and isvalid(modal) then
			modal:SetEnable(active)
			modal.Visible = active
			if active then
				local uiTransform = modal.UITransformComponent
				if uiTransform ~= nil then
					_UILogic:SetSiblingIndex(uiTransform, 1000000)
				end
			end
			local canvas = modal.CanvasGroupComponent
			if canvas ~= nil then
				canvas.GroupAlpha = active and 1 or 0
				canvas.Interactable = active
				canvas.BlocksRaycasts = active
			end
		else
			log_warning("[LobbyController] CreateRoomModalRoot not found")
		end
	end

	method void OpenCreateRoomModal()
		-- Opens the create-room modal and resets the form to its default values.
		self.isCreateRoomModalOpen = true
		self:ResetCreateRoomForm()
		self:UpdateCreateRoomFormView()
		self:WireCreateRoomModalEvents()
		self:SetCreateRoomModalVisible(true)
		log("[Room] RoomCreateModal opened")
	end

	method void WireCommonPopupEvents()
		-- Connects common popup buttons once; DimOverlay intentionally does not close the popup.
		if self.commonPopupConfirmHandler == nil and self.commonPopupConfirmButton ~= nil and isvalid(self.commonPopupConfirmButton) then
			self.commonPopupConfirmHandler = self.commonPopupConfirmButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCommonPopup()
			end)
		end
		if self.commonPopupCloseHandler == nil and self.commonPopupCloseButton ~= nil and isvalid(self.commonPopupCloseButton) then
			self.commonPopupCloseHandler = self.commonPopupCloseButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCommonPopup()
			end)
		end
		log("[CommonPopup] events wired")
	end

	method void DisconnectCommonPopupEvents()
		-- Disconnects common popup button handlers.
		if self.commonPopupConfirmHandler ~= nil and self.commonPopupConfirmButton ~= nil and isvalid(self.commonPopupConfirmButton) then
			self.commonPopupConfirmButton.Entity:DisconnectEvent(ButtonClickEvent, self.commonPopupConfirmHandler)
			self.commonPopupConfirmHandler = nil
		end
		if self.commonPopupCloseHandler ~= nil and self.commonPopupCloseButton ~= nil and isvalid(self.commonPopupCloseButton) then
			self.commonPopupCloseButton.Entity:DisconnectEvent(ButtonClickEvent, self.commonPopupCloseHandler)
			self.commonPopupCloseHandler = nil
		end
	end

	method void CloseCommonPopup()
		-- Hides the common popup layer.
		if self.commonPopupLayer ~= nil and isvalid(self.commonPopupLayer) then
			self.commonPopupLayer:SetEnable(false)
			self.commonPopupLayer.Visible = false
		end
		log("[CommonPopup] closed")
	end

	method void ApplyCommonPopupLayout()
		-- Keeps complete, warning, and error popups aligned to the confirmed common modal layout.
		if self.commonPopupImage ~= nil and isvalid(self.commonPopupImage) then
			local popupTransform = self.commonPopupImage.Entity.UITransformComponent
			if popupTransform ~= nil then
				popupTransform.anchoredPosition = Vector2(0, 40)
				popupTransform.RectSize = Vector2(760, 420)
			end
		end

		if self.commonPopupMessageText ~= nil and isvalid(self.commonPopupMessageText) then
			local messageTransform = self.commonPopupMessageText.Entity.UITransformComponent
			if messageTransform ~= nil then
				messageTransform.anchoredPosition = Vector2(0, 20)
				messageTransform.RectSize = Vector2(560, 120)
			end
		end

		if self.commonPopupConfirmButton ~= nil and isvalid(self.commonPopupConfirmButton) then
			local confirmEntity = self.commonPopupConfirmButton.Entity
			local confirmTransform = confirmEntity.UITransformComponent
			if confirmTransform ~= nil then
				confirmTransform.anchoredPosition = Vector2(0, -132)
				confirmTransform.RectSize = Vector2(220, 82)
			end
			local confirmSprite = confirmEntity.SpriteGUIRendererComponent
			if confirmSprite ~= nil then
				confirmSprite.ImageRUID = DataRef(self.RUID_COMMON_POPUP_CONFIRM_BUTTON)
			end
		end

		if self.commonPopupCloseButton ~= nil and isvalid(self.commonPopupCloseButton) then
			local closeEntity = self.commonPopupCloseButton.Entity
			local closeTransform = closeEntity.UITransformComponent
			if closeTransform ~= nil then
				closeTransform.anchoredPosition = Vector2(336, 222)
				closeTransform.RectSize = Vector2(88, 88)
			end
			local closeSprite = closeEntity.SpriteGUIRendererComponent
			if closeSprite ~= nil then
				closeSprite.ImageRUID = DataRef(self.RUID_COMMON_POPUP_CLOSE_BUTTON)
			end
		end
	end

	method void ShowCommonPopup(string popupType, string message)
		-- Shows a common modal popup and swaps the popup image by type.
		self:ApplyCommonPopupLayout()
		local targetRuid = self.RUID_COMMON_POPUP_WARNING
		if popupType == "complete" then
			targetRuid = self.RUID_COMMON_POPUP_COMPLETE
		elseif popupType == "error" then
			targetRuid = self.RUID_COMMON_POPUP_ERROR
		elseif popupType == "warning" then
			targetRuid = self.RUID_COMMON_POPUP_WARNING
		end

		if self.commonPopupImage ~= nil and isvalid(self.commonPopupImage) then
			self.commonPopupImage.ImageRUID = DataRef(targetRuid)
		end
		if self.commonPopupMessageText ~= nil and isvalid(self.commonPopupMessageText) then
			self.commonPopupMessageText.Text = message or ""
		end
		if self.commonPopupLayer ~= nil and isvalid(self.commonPopupLayer) then
			self.commonPopupLayer:SetEnable(true)
			self.commonPopupLayer.Visible = true
			local uiTransform = self.commonPopupLayer.UITransformComponent
			if uiTransform ~= nil then
				_UILogic:SetSiblingIndex(uiTransform, 1000000)
			end
		else
			log_warning("[CommonPopup] CommonPopupLayer missing")
		end
		log("[CommonPopup] opened type=" .. tostring(popupType) .. " message=" .. tostring(message))
	end

	method void ShowJoinFailurePopup(string reason, string fallbackMessage)
		-- Maps room-join failure reasons to common popup messages.
		local message = "방에 입장할 수 없습니다."
		if reason == "PASSWORD_REQUIRED" then
			message = "비밀번호를 입력해 주세요."
		elseif reason == "PASSWORD_INVALID" then
			message = "비밀번호가 올바르지 않습니다."
		elseif reason == "FULL" then
			message = "현재 방 인원이 가득 찼습니다."
		elseif reason == "PLAYING" then
			message = "이미 게임이 시작된 방입니다."
		elseif fallbackMessage ~= nil and fallbackMessage ~= "" then
			message = fallbackMessage
		end
		self:ShowCommonPopup("error", message)
	end

	method void CloseCreateRoomModal()
		-- Closes the create-room modal and disconnects its temporary button handlers.
		if self.isCreateRoomModalOpen == false then
			self:SetCreateRoomModalVisible(false)
			self:DisconnectCreateRoomModalEvents()
			return
		end
		self:SetCreateRoomModalVisible(false)
		self.isCreateRoomModalOpen = false
		self:DisconnectCreateRoomModalEvents()
		log("[Room] RoomCreateModal closed")
	end

	method void ResetCreateRoomForm()
		-- Restores default create-room form values.
		self.selectedMaxPlayers = 8
		self.isPrivateRoom = false
		if self.createRoomNameInput ~= nil then
			self.createRoomNameInput.Text = ""
		end
		if self.createRoomPasswordInput ~= nil then
			self.createRoomPasswordInput.Text = ""
		end
		self:SetCreateRoomError("")
		self:UpdateCreateRoomFormView()
	end

	method void UpdateCreateRoomFormView()
		-- Mirrors create-room state into the visible modal fields.
		if self.createRoomPlayerCountText ~= nil then
			self.createRoomPlayerCountText.Text = tostring(self.selectedMaxPlayers)
		end

		if self.isPrivateRoom then
			if self.createRoomPrivateToggleSprite ~= nil then
				self.createRoomPrivateToggleSprite.ImageRUID = DataRef(self.RUID_PRIVATE_TOGGLE_ON)
			end
			if self.createRoomPasswordInputBoxSprite ~= nil then
				self.createRoomPasswordInputBoxSprite.ImageRUID = DataRef(self.RUID_PASSWORD_BOX_ACTIVE)
			end
			if self.createRoomPasswordInput ~= nil then
				self.createRoomPasswordInput.Enable = true
			end
		else
			if self.createRoomPrivateToggleSprite ~= nil then
				self.createRoomPrivateToggleSprite.ImageRUID = DataRef(self.RUID_PRIVATE_TOGGLE_OFF)
			end
			if self.createRoomPasswordInputBoxSprite ~= nil then
				self.createRoomPasswordInputBoxSprite.ImageRUID = DataRef(self.RUID_PASSWORD_BOX_OFF)
			end
			if self.createRoomPasswordInput ~= nil then
				self.createRoomPasswordInput.Text = ""
				self.createRoomPasswordInput.Enable = false
			end
		end
	end

	method void TogglePrivateRoom()
		-- Toggles private-room mode and updates password input availability.
		self.isPrivateRoom = not self.isPrivateRoom
		self:UpdateCreateRoomFormView()
		log("[LobbyController] private room=" .. tostring(self.isPrivateRoom))
	end

	method void IncreaseMaxPlayers()
		-- Raises max players up to 8.
		if self.selectedMaxPlayers < 8 then
			self.selectedMaxPlayers += 1
		end
		self:UpdateCreateRoomFormView()
		log("[LobbyController] create room max players=" .. tostring(self.selectedMaxPlayers))
	end

	method void DecreaseMaxPlayers()
		-- Lowers max players down to 6.
		if self.selectedMaxPlayers > 6 then
			self.selectedMaxPlayers -= 1
		end
		self:UpdateCreateRoomFormView()
		log("[LobbyController] create room max players=" .. tostring(self.selectedMaxPlayers))
	end

	method string TrimCreateRoomText(string value)
		-- Trims leading and trailing whitespace from a form value.
		if value == nil then return "" end
		local result = string.match(value, "^%s*(.-)%s*$")
		if result == nil then return "" end
		return result
	end

	method integer GetCreateRoomNameLength(string value)
		-- Counts UTF-8 characters without relying on optional library globals.
		if value == nil then return 0 end
		local count = 0
		local totalBytes = string.len(value)
		for i = 1, totalBytes do
			local byteValue = string.byte(value, i)
			if byteValue ~= nil and (byteValue < 128 or byteValue >= 192) then
				count += 1
			end
		end
		return count
	end

	method void SetCreateRoomError(string message)
		-- Shows or hides the create-room validation error area.
		local hasError = message ~= nil and message ~= ""
		if self.createRoomErrorText ~= nil then
			self.createRoomErrorText.Text = hasError and message or ""
			if self.createRoomErrorText.Entity ~= nil then
				self.createRoomErrorText.Entity:SetEnable(hasError)
				self.createRoomErrorText.Entity.Visible = hasError
			end
		end
		if self.createRoomErrorBox ~= nil and isvalid(self.createRoomErrorBox) then
			self.createRoomErrorBox:SetEnable(hasError)
			self.createRoomErrorBox.Visible = hasError
		end
	end

	method boolean ValidateCreateRoomForm()
		-- Validates current create-room input fields and displays the first error.
		local roomName = ""
		if self.createRoomNameInput ~= nil then
			roomName = self:TrimCreateRoomText(self.createRoomNameInput.Text)
			self.createRoomNameInput.Text = roomName
		end

		if roomName == "" then
			self:SetCreateRoomError("수사방 이름을 입력하세요.")
			return false
		end
		if self:GetCreateRoomNameLength(roomName) > 12 then
			self:SetCreateRoomError("수사방 이름은 12자 이하로 입력하세요.")
			return false
		end
		if self.selectedMaxPlayers < 6 or self.selectedMaxPlayers > 8 then
			self:SetCreateRoomError("최대 인원은 6~8명으로 선택하세요.")
			return false
		end

		if self.isPrivateRoom then
			local password = ""
			if self.createRoomPasswordInput ~= nil then
				password = self:TrimCreateRoomText(self.createRoomPasswordInput.Text)
				self.createRoomPasswordInput.Text = password
			end
			if password == "" then
				self:SetCreateRoomError("비공개 수사방은 비밀번호가 필요합니다.")
				return false
			end
			if string.match(password, "^%d%d%d%d$") == nil then
				self:SetCreateRoomError("비밀번호는 숫자 4자리로 입력하세요.")
				return false
			end
		end

		self:SetCreateRoomError("")
		return true
	end

	method void SubmitCreateRoomForm()
		-- Validates the form, then requests authoritative server-side room creation.
		if self:ValidateCreateRoomForm() == false then return end
		local roomName = ""
		local password = ""
		if self.createRoomNameInput ~= nil then
			roomName = self:TrimCreateRoomText(self.createRoomNameInput.Text)
		end
		if self.isPrivateRoom and self.createRoomPasswordInput ~= nil then
			password = self:TrimCreateRoomText(self.createRoomPasswordInput.Text)
		end
		log("[Room] Room creation requested name=" .. roomName .. " maxPlayers=" .. tostring(self.selectedMaxPlayers) .. " private=" .. tostring(self.isPrivateRoom))
		self:SetCreateRoomError("방을 생성하는 중입니다...")
		_InvestigationRoomManager:CreateRoom(roomName, "기본 수사", self.selectedMaxPlayers, self.isPrivateRoom, password, self.currentProfileNickname)
	end

	method void OnRoomCreateResult(boolean success, string message, string roomJson)
		-- Receives the server result and moves the user into the waiting-state view.
		if success == false then
			log_warning("[Room] Room creation failed: " .. message)
			self:SetCreateRoomError(message)
			self:ShowCommonPopup("error", message ~= "" and message or "방을 생성할 수 없습니다.")
			return
		end
		local room = _HttpService:JSONDecode(roomJson)
		self.joinedRoomId = room.roomId or ""
		log("[Room] Room created successfully id=" .. self.joinedRoomId)
		-- Read room settings before closing the modal so form values are not lost.
		local roomName = ""
		if self.createRoomNameInput ~= nil then
			roomName = self:TrimCreateRoomText(self.createRoomNameInput.Text)
		end
		local password = ""
		if self.isPrivateRoom and self.createRoomPasswordInput ~= nil then
			password = self:TrimCreateRoomText(self.createRoomPasswordInput.Text)
		end
		self:CloseMatchmakingModal()
		self:CloseFindRoomModal()
		self:CloseCreateRoomModal()
		local lobbyRoot = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot")
		if lobbyRoot ~= nil and isvalid(lobbyRoot) then
			lobbyRoot.Enable = false
		end
		if _MafiaUIFlow ~= nil then
			_MafiaUIFlow:OpenLobbyAfterRoomCreated(roomName, self.isPrivateRoom, password, self.selectedMaxPlayers, 2)
			log("[LobbyController] Entered MafiaLobbyHUD source=create title=" .. roomName)
		else
			log_warning("[LobbyController] MafiaUIFlow unavailable source=create")
		end
		if _QAAchievementManager ~= nil then
			_QAAchievementManager:ReportLobbyAction("ROOM_ENTER", "create")
		end
		_UIToast:ShowMessage("수사방이 생성되었습니다. 대기 중입니다.")
	end

	method void WireCreateRoomModalEvents()
		-- Wires create-room modal buttons while it is open.
		if self.createRoomSubmitHandler ~= nil then return end
		if self.createRoomDimOverlayButton ~= nil and isvalid(self.createRoomDimOverlayButton) then
			self.createRoomDimHandler = self.createRoomDimOverlayButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCreateRoomModal()
			end)
		end
		if self.createRoomCloseButton ~= nil and isvalid(self.createRoomCloseButton) then
			self.createRoomCloseHandler = self.createRoomCloseButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCreateRoomModal()
			end)
		end
		if self.createRoomCancelButton ~= nil and isvalid(self.createRoomCancelButton) then
			self.createRoomCancelHandler = self.createRoomCancelButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCreateRoomModal()
			end)
		end
		if self.createRoomMinusButton ~= nil and isvalid(self.createRoomMinusButton) then
			self.createRoomMinusHandler = self.createRoomMinusButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:DecreaseMaxPlayers()
			end)
		end
		if self.createRoomPlusButton ~= nil and isvalid(self.createRoomPlusButton) then
			self.createRoomPlusHandler = self.createRoomPlusButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:IncreaseMaxPlayers()
			end)
		end
		if self.createRoomPrivateToggleButton ~= nil and isvalid(self.createRoomPrivateToggleButton) then
			self.createRoomPrivateHandler = self.createRoomPrivateToggleButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:TogglePrivateRoom()
			end)
		end
		if self.createRoomSubmitButton ~= nil and isvalid(self.createRoomSubmitButton) then
			self.createRoomSubmitHandler = self.createRoomSubmitButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:SubmitCreateRoomForm()
			end)
		end
	end

	method void DisconnectCreateRoomModalEvents()
		-- Disconnects create-room modal handlers to avoid duplicate callbacks after reopen.
		if self.createRoomDimHandler ~= nil and self.createRoomDimOverlayButton ~= nil and isvalid(self.createRoomDimOverlayButton) then
			self.createRoomDimOverlayButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomDimHandler)
			self.createRoomDimHandler = nil
		end
		if self.createRoomCloseHandler ~= nil and self.createRoomCloseButton ~= nil and isvalid(self.createRoomCloseButton) then
			self.createRoomCloseButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomCloseHandler)
			self.createRoomCloseHandler = nil
		end
		if self.createRoomCancelHandler ~= nil and self.createRoomCancelButton ~= nil and isvalid(self.createRoomCancelButton) then
			self.createRoomCancelButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomCancelHandler)
			self.createRoomCancelHandler = nil
		end
		if self.createRoomMinusHandler ~= nil and self.createRoomMinusButton ~= nil and isvalid(self.createRoomMinusButton) then
			self.createRoomMinusButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomMinusHandler)
			self.createRoomMinusHandler = nil
		end
		if self.createRoomPlusHandler ~= nil and self.createRoomPlusButton ~= nil and isvalid(self.createRoomPlusButton) then
			self.createRoomPlusButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomPlusHandler)
			self.createRoomPlusHandler = nil
		end
		if self.createRoomPrivateHandler ~= nil and self.createRoomPrivateToggleButton ~= nil and isvalid(self.createRoomPrivateToggleButton) then
			self.createRoomPrivateToggleButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomPrivateHandler)
			self.createRoomPrivateHandler = nil
		end
		if self.createRoomSubmitHandler ~= nil and self.createRoomSubmitButton ~= nil and isvalid(self.createRoomSubmitButton) then
			self.createRoomSubmitButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomSubmitHandler)
			self.createRoomSubmitHandler = nil
		end
