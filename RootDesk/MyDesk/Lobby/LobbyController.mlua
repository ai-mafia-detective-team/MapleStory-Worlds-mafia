	method void SetFindRoomRowText(string rowPath, string childName, string text)
		local child = _EntityService:GetEntityByPath(rowPath .. "/" .. childName)
		if child ~= nil and isvalid(child) and child.TextComponent ~= nil then
			child.TextComponent.Text = text
		end
	end

	method void SetFindRoomRowButtonEnabled(string rowPath, boolean enabled)
		-- Enables row selection only when the row has an actual room.
		local row = _EntityService:GetEntityByPath(rowPath)
		if row ~= nil and isvalid(row) and row.ButtonComponent ~= nil then
			row.ButtonComponent.Enable = enabled
		end
		local statusButton = _EntityService:GetEntityByPath(rowPath .. "/RoomStatusText")
		if statusButton ~= nil and isvalid(statusButton) and statusButton.ButtonComponent ~= nil then
			statusButton.ButtonComponent.Enable = enabled
		end
	end

	method void SetFindRoomRowJoinButton(string rowPath, boolean hasRoom)
		-- Shows the join button only in the status column when the row has a room.
		local statusButton = _EntityService:GetEntityByPath(rowPath .. "/RoomStatusText")
		if statusButton == nil or not isvalid(statusButton) then return end
		if statusButton.SpriteGUIRendererComponent ~= nil then
			statusButton.SpriteGUIRendererComponent.ImageRUID = DataRef(self.RUID_ROOM_ROW_JOIN_BUTTON)
			statusButton.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
			statusButton.SpriteGUIRendererComponent.RaycastTarget = true
		end
		if statusButton.TextComponent ~= nil then
			statusButton.TextComponent.Text = ""
			statusButton.TextComponent.FontColor = Color(1, 1, 1, 0)
		end
		if statusButton.ButtonComponent ~= nil then
			statusButton.ButtonComponent.Enable = hasRoom
		end
		statusButton:SetEnable(hasRoom)
		statusButton.Visible = hasRoom
	end

	method void SetFindRoomEmptyStateVisible(boolean visible)
		-- Shows one centered empty-state image instead of repeating it in every status cell.
		local emptyState = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch/SearchRoot/RoomListPanel/EmptyStateImage")
		if emptyState == nil or not isvalid(emptyState) then return end
		emptyState:SetEnable(visible)
		emptyState.Visible = visible
	end

	method void LegacyRefreshRoomList()
		local base = "/ui/UI_InvestigationRoomSearch/SearchRoot/RoomListPanel/RoomRowContainer/"
		local rooms = self:GetFindRoomMockData()
		for i = 1, 8 do
			local rowPath = base .. "RoomRow_" .. tostring(i)
			local row = _EntityService:GetEntityByPath(rowPath)
			if row ~= nil and isvalid(row) then
				local room = rooms[i]
				if room ~= nil then
					self:SetFindRoomRowText(rowPath, "RoomNameText", room.name)
					self:SetFindRoomRowText(rowPath, "RoomModeText", room.mode)
					self:SetFindRoomRowText(rowPath, "RoomPlayerCountText", room.players)
					self:SetFindRoomRowText(rowPath, "RoomStatusText", room.status)
					self:SetFindRoomRowText(rowPath, "RoomHostText", room.host)
					local pwIcon = _EntityService:GetEntityByPath(rowPath .. "/RoomPasswordIcon")
					if pwIcon ~= nil and isvalid(pwIcon) then
						pwIcon:SetEnable(room.isPrivate)
						pwIcon.Visible = room.isPrivate
					end
					row:SetEnable(true)
					row.Visible = true
					self:SetFindRoomRowHighlight(i, false)
				else
					row:SetEnable(false)
					row.Visible = false
				end
			end
		end
		self.findRoomSelectedIndex = 0
		log("[FindRoomModal] refresh clicked")
	end

	method void SetFindRoomRowHighlight(integer index, boolean selected)
		local rowPath = "/ui/UI_InvestigationRoomSearch/SearchRoot/RoomListPanel/RoomRowContainer/RoomRow_" .. tostring(index)
		local row = _EntityService:GetEntityByPath(rowPath)
		if row == nil or not isvalid(row) then return end
		local sprite = row.SpriteGUIRendererComponent
		if sprite ~= nil then
			if selected then
				sprite.Color = Color(0.23, 0.32, 0.29, 0.96)
			else
				sprite.Color = Color(0.129411772, 0.113725491, 0.09019608, 1)
			end
		end
	end

	method void LegacySelectRoom(integer index)
		local prev = self.findRoomSelectedIndex
		if prev > 0 and prev ~= index then
			self:SetFindRoomRowHighlight(prev, false)
		end
		self.findRoomSelectedIndex = index
		self:SetFindRoomRowHighlight(index, true)
		log("[FindRoomModal] selected room index=" .. tostring(index))
	end

