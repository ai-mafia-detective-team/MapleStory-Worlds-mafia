	method void HideAvatarFallback()
		-- Keeps the fallback placeholder hidden now that AvatarGUIRenderer is working.
		local fallback = self.fallbackCache
		if fallback == nil or isvalid(fallback) == false then
			fallback = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarFallback")
			self.fallbackCache = fallback
		end
		if fallback ~= nil and isvalid(fallback) then
			fallback:SetEnable(false)
			fallback.Visible = false
			local sprite = fallback.SpriteGUIRendererComponent
			if sprite ~= nil then
				sprite:SetAlpha(0)
				sprite.Enable = false
			end
			log("[LobbyController] Avatar fallback hidden=true")
		else
			log("[LobbyController] Avatar fallback hidden=false")
		end
	end

	method void CheckAvatarFallback()
		-- Legacy safety hook; fallback is intentionally kept hidden.
		self.avatarCheckTimerId = 0
		self:HideAvatarFallback()
	end

	method void ShowAvatarFallback()
		-- Legacy compatibility hook; fallback should not be displayed in the final lobby.
		self:HideAvatarFallback()
	end

	method void WireKeyboardInput()
		-- Connects KeyDownEvent for jump. Guards against double-wiring.
		if self.keyDownHandler ~= nil then return end
		self.keyDownHandler = self.Entity:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		log("[LobbyController] Keyboard wired")
	end

