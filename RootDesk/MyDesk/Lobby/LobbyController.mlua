	method void OnAchievementClicked(ButtonClickEvent event)
		log("[LobbyController] AchievementButton clicked")
		local controllerEntity = _EntityService:GetEntityByPath("/ui/UI_AchievementPopup/Controller")
		if controllerEntity == nil or isvalid(controllerEntity) == false then
			log_warning("[LobbyController] Achievement popup controller not found")
			self:ShowCommonPopup("error", "업적 창을 열 수 없습니다.")
			return
		end
		local achievementUI = controllerEntity:GetComponent("script.QAAchievementUI")
		if achievementUI == nil then
			log_warning("[LobbyController] QAAchievementUI component not found")
			self:ShowCommonPopup("error", "업적 창을 열 수 없습니다.")
			return
		end
		achievementUI:Open()
	end

