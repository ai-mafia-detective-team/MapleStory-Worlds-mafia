	method void OnBeginPlay()
		-- Fires when UI_Lobby is enabled by IntroFlowController (SetEnable → OnBeginPlay).
		-- ShowLobby(nickname) is called immediately after.
		log("[LobbyController] OnBeginPlay")
		log("[LobbyController] self.Entity.Path=" .. tostring(self.Entity.Path))
		-- The search UIGroup itself must remain enabled. Only its child content is toggled.
		-- Reset the state as well so a recreated lobby never inherits an invisible-open modal.
		self.findRoomModalOpen = false
		self:SetInvestigationRoomSearchVisible(false)
		-- The profile modal UIGroup follows the same MSW 26.7 rule as the search group above.
		self.profileModalOpen = false
		self:SetProfileModalVisible(false)
		self:WireKeyboardInput()
		-- Attaching this now lets QAAchievementUI:OnBeginPlay close its popup before the
		-- lobby is shown; otherwise the achievement window covers the screen from the start.
		self:EnsureAchievementUI()
	end

	method void ShowLobby(string nickname)
		-- Enables LobbyRoot, configures avatar renderer, applies nickname, wires buttons.
		log("[LobbyController] ShowLobby called nickname=" .. nickname)
		log("[LobbyController] Avatar constants GROUND_Y=" .. tostring(self.GROUND_Y) .. " MIN_X=" .. tostring(self.MIN_X) .. " MAX_X=" .. tostring(self.MAX_X))
		log("[LobbyController] Avatar SD ratio adjusted=true")
		log("[LobbyController] LobbyAvatar size=" .. tostring(self.AVATAR_WIDTH) .. "x" .. tostring(self.AVATAR_HEIGHT))
		log("[LobbyController] Avatar foot realigned after ratio change=true")
		log("[LobbyController] Nickname position adjusted=true")
		log("[LobbyController] Walk visual fallback enabled=" .. tostring(self.WALK_VISUAL_FALLBACK_ENABLED))
		log("[LobbyController] Walk bob amplitude=" .. tostring(self.WALK_BOB_AMOUNT))
		log("[LobbyController] Jump visual fallback enabled=" .. tostring(self.JUMP_VISUAL_FALLBACK_ENABLED))
		log("[LobbyController] Move range adjusted MIN_X=" .. tostring(self.MIN_X) .. " MAX_X=" .. tostring(self.MAX_X))
		log("[LobbyController] AvatarNameText offset adjusted to " .. tostring(self.NAME_OFFSET_Y))
		
		local lobbyRoot = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot")
		if lobbyRoot ~= nil and isvalid(lobbyRoot) then
			lobbyRoot:SetEnable(true)
			lobbyRoot.Visible = true
			log("[LobbyController] LobbyRoot visible=true enable=true")
		else
			log_warning("[LobbyController] LobbyRoot not found")
		end
		
		-- Keep custom lobby controls clear of the native MSW friend/settings area.
		local topLayoutPaths = {
			"/ui/UI_Lobby/LobbyRoot/ButtonGroup/MoneyDisplay",
			"/ui/UI_Lobby/LobbyRoot/ButtonGroup/알림",
			"/ui/UI_Lobby/LobbyRoot/ButtonGroup/상점",
			"/ui/UI_Lobby/LobbyRoot/ButtonGroup/친구",
			"/ui/UI_Lobby/LobbyRoot/ButtonGroup/설정"
		}
		local topLayoutX = { 230, 472, 550, 630, 710 }
		for index = 1, #topLayoutPaths do
			local entity = _EntityService:GetEntityByPath(topLayoutPaths[index])
			if entity ~= nil and isvalid(entity) and entity.UITransformComponent ~= nil then
				local transform = entity.UITransformComponent
				local x = topLayoutX[index]
				local halfWidth = transform.RectSize.x * 0.5
				transform.OffsetMin = Vector2(x - halfWidth, transform.OffsetMin.y)
				transform.OffsetMax = Vector2(x + halfWidth, transform.OffsetMax.y)
				transform.anchoredPosition = Vector2(x, transform.anchoredPosition.y)
			else
				log_warning("[LobbyController] Top layout entity missing path=" .. topLayoutPaths[index])
			end
		end
		log("[LobbyController] Top layout applied money=230 alert=472 shop=550 friend=630 settings=710")
		
		self:ApplyLobbyBackgroundVisuals()
		self:DisableBlackOverlayBlockers()
		
		-- Hide world LocalPlayer character: IntroFlowController.ShowLobby() makes it visible,
		-- so we override here. Lobby uses UI Avatar only.
		local worldPlayer = _UserService.LocalPlayer
		if worldPlayer ~= nil and isvalid(worldPlayer) then
			log("[LobbyController] LocalPlayer found=true")
			worldPlayer.Visible = false
			local spriteComp = worldPlayer.SpriteRendererComponent
			if spriteComp ~= nil then
				spriteComp.Enable = false
			end
			local skeletonComp = worldPlayer.SkeletonRendererComponent
			if skeletonComp ~= nil then
				skeletonComp.Enable = false
			end
			log("[LobbyController] World character hidden for lobby")
		else
			log_warning("[LobbyController] LocalPlayer not found — cannot hide world character")
		end
		
		self:HideBottomChatPanel()
		self:HideLegacyLobbyButtons()
		self:HideMatchmakingPopup()
		self:HideSettingsPopup()
		self:HideExternalPopups()
		self:CloseCollectionPopup()
		self:CloseBagPopup()
		self:SetCreateRoomModalVisible(false)
		self:SetUnderDevelopmentPopup(false)
		
		-- Cache fallback entity (disabled by default)
		local fallbackEnt = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarFallback")
		if fallbackEnt ~= nil and isvalid(fallbackEnt) then
			self.fallbackCache = fallbackEnt
			self:HideAvatarFallback()
		end
		
		-- Diagnose and configure LobbyAvatar
		local avatarPath = "/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/LobbyAvatar"
		log("[LobbyController] Avatar renderer target path=" .. avatarPath)
		local avatarEntity = _EntityService:GetEntityByPath(avatarPath)
		local avatarFound = avatarEntity ~= nil and isvalid(avatarEntity)
		log("[LobbyController] LobbyAvatar found=" .. tostring(avatarFound))
		
		if avatarFound then
			log("[LobbyController] LobbyAvatar visible=" .. tostring(avatarEntity.Visible) .. " enable=" .. tostring(avatarEntity.Enable))
			log("[LobbyController] LobbyAvatar displayOrder=80")
			self.avatarCache = avatarEntity
		
			local avatarComp = avatarEntity.AvatarGUIRendererComponent
			log("[LobbyController] AvatarGUIRendererComponent found=" .. tostring(avatarComp ~= nil))
			self.avatarAnimationApiFound = avatarComp ~= nil
			log("[LobbyController] Avatar animation API found=" .. tostring(self.avatarAnimationApiFound))
		
			-- LocalPlayer identity needed by CostumeManagerComponent
			local player = _UserService.LocalPlayer
			local playerFound = player ~= nil and isvalid(player)
			log("[LobbyController] LocalPlayer found=" .. tostring(playerFound))
		
			if playerFound then
				-- Set DefaultEquipUserId so CostumeManagerComponent mirrors LocalPlayer's avatar
				local playerComp = player.PlayerComponent
				local costumeComp = avatarEntity.CostumeManagerComponent
				if playerComp ~= nil and costumeComp ~= nil then
					costumeComp.DefaultEquipUserId = playerComp.UserId
					costumeComp.UseCustomEquipOnly = false
					log("[LobbyController] Avatar renderer configured userId=" .. tostring(playerComp.UserId))
				elseif costumeComp ~= nil then
					-- Fallback: empty DefaultEquipUserId → engine may default to LocalPlayer
					costumeComp.UseCustomEquipOnly = false
					log("[LobbyController] Avatar renderer configured (PlayerComponent nil, using empty userId)")
				end
			end
		
			self.currentAvatarState = ""
			self.currentAvatarDirection = "left"
			self.walkBobTime = 0
			self.walkBobLogTimer = 0
			self.walkBobEnabledLogged = false
			log("[LobbyController] Avatar action API sample found=true")
			log("[LobbyController] Avatar action apply method=ActionStateChangedEvent")
			log("[LobbyController] Avatar action map idle=stand1 walk=walk1 jump=jump")
			log("[LobbyController] Avatar facing direction=left")
			self:ApplyAvatarState("idle")
			log("[LobbyController] Avatar renderer applied success=true")
			self:HideAvatarFallback()
		else
			self.avatarAnimationApiFound = false
			log("[LobbyController] Avatar animation API found=false")
		end
		
		self:ConfigureProfilePortrait()
		
		-- Cache AvatarNameText
		local nameText = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarNameText")
		if nameText ~= nil and isvalid(nameText) then
			self.nameTextCache = nameText
			log("[LobbyController] AvatarNameText cached")
		else
			log_warning("[LobbyController] AvatarNameText not found")
		end
		
		self:ResetAvatarPosition()
		self:ApplyNickname(nickname)
		self:WireButtonEvents()
		if _MoneyManager ~= nil then
			_MoneyManager:LoadMoney()
		end
		if _QAAchievementManager ~= nil then
			_QAAchievementManager:ReportLobbyAction("LOBBY_ENTER", "")
		end
	end

	method void ConfigureProfilePortrait()
		-- Applies default profile image and requests saved RUID from server DataStorage.
		log("[LobbyController] ConfigureProfilePortrait: applying default + requesting saved profile")
		self:ApplyProfileImage(self.selectedProfileRuid)
		_ProfileStorageLogic:RequestLoadAllProfile()
	end

	method void ApplyLobbyBackgroundVisuals()
		-- Applies the lobby background RUID and restores full-screen stretch at runtime.
		local bg = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyBackground")
		if bg == nil or isvalid(bg) == false then
			log_warning("[LobbyController] LobbyBackground not found")
			return
		end
		
		bg:SetEnable(true)
		bg.Visible = true
		
		local transform = bg.UITransformComponent
		if transform ~= nil then
			transform.AlignmentOption = AlignmentType.StretchAll
			transform.AnchorsMin = Vector2(0, 0)
			transform.AnchorsMax = Vector2(1, 1)
			transform.OffsetMin = Vector2(0, 0)
			transform.OffsetMax = Vector2(0, 0)
			transform.RectSize = Vector2(1920, 1080)
			transform.anchoredPosition = Vector2(0, 0)
		end
		
		-- ImageRUID는 UI_Lobby.ui에서만 관리합니다 (mlua에서 덮어쓰지 않음).
		local bgComp = bg.SpriteGUIRendererComponent
		if bgComp ~= nil then
			bgComp.Enable = false
			bgComp.Color = Color(1, 1, 1, 1)
			bgComp.RaycastTarget = false
			bgComp.Enable = true
			bgComp:SetAlpha(1)
		end
		
		local fullStretch = false
		local rectText = "nil"
		if transform ~= nil then
			fullStretch = transform.AlignmentOption == AlignmentType.StretchAll and transform.OffsetMin.x == 0 and transform.OffsetMin.y == 0 and transform.OffsetMax.x == 0 and transform.OffsetMax.y == 0
			rectText = tostring(transform.RectSize.x) .. "x" .. tostring(transform.RectSize.y)
		end
		
		log("[LobbyController] LobbyBackground found=true")
		log("[LobbyController] LobbyBackground visible=true alpha=1")
		log("[LobbyController] LobbyBackground applied success")
		log("[LobbyController] LobbyBackground full stretch=" .. tostring(fullStretch))
		log("[LobbyController] LobbyBackground rect=" .. rectText)
	end

	method void DisableBlackOverlayBlockers()
		-- Disables only large dark sprite overlays that can cover the lobby background.
		local found = false
		local disabled = false
		local paths = {
			"/ui/UI_Lobby/LobbyRoot",
			"/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea",
			"/ui/UI_Lobby/LobbyRoot/TopHud",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons",
			"/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarFallback"
		}
		
		for _, path in ipairs(paths) do
			local ent = _EntityService:GetEntityByPath(path)
			if ent ~= nil and isvalid(ent) then
				local sprite = ent.SpriteGUIRendererComponent
				local transform = ent.UITransformComponent
				if sprite ~= nil and transform ~= nil then
					local color = sprite.Color
					local isDark = color.r <= 0.08 and color.g <= 0.08 and color.b <= 0.08 and color.a > 0.1
					local isLarge = transform.RectSize.x >= 500 or transform.RectSize.y >= 500
					if isDark and isLarge then
						found = true
						sprite:SetAlpha(0)
						sprite.Enable = false
						disabled = true
					end
				end
			end
		end
		
		log("[LobbyController] black overlay blocker found=" .. tostring(found))
		log("[LobbyController] black overlay blocker disabled=" .. tostring(disabled))
	end

	method void HideBottomChatPanel()
		-- Keeps the unused chat panel and its children hidden.
		local paths = {
			"/ui/UI_Lobby/LobbyRoot/BottomChatPanel",
			"/ui/UI_Lobby/LobbyRoot/BottomChatPanel/ChatInput",
			"/ui/UI_Lobby/LobbyRoot/BottomChatPanel/ChatLogArea"
		}
		for _, path in ipairs(paths) do
			local ent = _EntityService:GetEntityByPath(path)
			if ent ~= nil and isvalid(ent) then
				ent:SetEnable(false)
				ent.Visible = false
			end
		end
		log("[LobbyController] BottomChatPanel hidden")
	end

	method void SetEntityActive(string path, boolean active)
		local ent = _EntityService:GetEntityByPath(path)
		if ent ~= nil and isvalid(ent) then
			ent:SetEnable(active)
			ent.Visible = active
		end
	end

	method void HideLegacyLobbyButtons()
		-- The new Maple-style ButtonGroup replaces the old placeholder button containers.
		local paths = {
			"/ui/UI_Lobby/LobbyRoot/LeftMenu",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu/CodexButton",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu/BagButton",
			"/ui/UI_Lobby/LobbyRoot/LeftMenu/AchievementButton",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons/StartButton",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons/CreateRoomButton",
			"/ui/UI_Lobby/LobbyRoot/RightActionButtons/FindRoomButton",
			"/ui/UI_Lobby/LobbyRoot/TopHud/FriendButton",
			"/ui/UI_Lobby/LobbyRoot/TopHud/MenuButton"
		}
		for _, path in ipairs(paths) do
			self:SetEntityActive(path, false)
		end
		log("[LobbyController] Legacy placeholder lobby buttons hidden")
	end

	method void SetMatchmakingPopup(boolean active)
		-- Shows or hides the matchmaking modal entity tree.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking")
		if popup ~= nil and isvalid(popup) then
			popup:SetEnable(active)
			popup.Visible = active
			local canvas = popup.CanvasGroupComponent
			if canvas ~= nil then
				canvas.GroupAlpha = active and 1 or 0
				canvas.Interactable = active
				canvas.BlocksRaycasts = active
			end
			local dimmer = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Dimmer")
			if dimmer ~= nil and isvalid(dimmer) then
				dimmer:SetEnable(active)
				dimmer.Visible = active
			end
		end
		log("[LobbyController] Matchmaking popup active=" .. tostring(active))
	end

	method void HideMatchmakingPopup()
		-- Hides matchmaking without emitting cancel-specific logs during lobby setup.
		self:CloseMatchmakingModal()
	end

	method string FormatMatchmakingTime(integer elapsedSeconds)
		-- Converts elapsed seconds to mm:ss text.
		if elapsedSeconds < 0 then elapsedSeconds = 0 end
		local minutes = math.floor(elapsedSeconds / 60)
		local seconds = elapsedSeconds - minutes * 60
		local minuteText = tostring(minutes)
		local secondText = tostring(seconds)
		if minutes < 10 then minuteText = "0" .. minuteText end
		if seconds < 10 then secondText = "0" .. secondText end
		return minuteText .. ":" .. secondText
	end

	method void SetMatchmakingElapsedText(string text)
		-- Writes the elapsed timer label when the text entity exists.
		local elapsed = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Box/Elapsed")
		if elapsed ~= nil and isvalid(elapsed) and elapsed.TextComponent ~= nil then
			elapsed.TextComponent.Text = text
		end
	end

	method void SetMatchmakingDotAlpha(string path, number alpha)
		-- Applies alpha to one loading dot.
		local dot = _EntityService:GetEntityByPath(path)
		if dot ~= nil and isvalid(dot) and dot.SpriteGUIRendererComponent ~= nil then
			local color = dot.SpriteGUIRendererComponent.Color
			dot.SpriteGUIRendererComponent.Color = Color(color.r, color.g, color.b, alpha)
		end
	end

	method void SetMatchmakingDotScale(string path, number scale)
		-- Applies uniform XY scale to one loading dot for the pulse highlight effect.
		local dot = _EntityService:GetEntityByPath(path)
		if dot ~= nil and isvalid(dot) and dot.UITransformComponent ~= nil then
			dot.UITransformComponent.UIScale = Vector3(scale, scale, 1)
		end
	end

	method void ResetMatchmakingDots()
		-- Restores all loading dots to their idle alpha and default scale.
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Box/"
		self:SetMatchmakingDotAlpha(base .. "Dot1", 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot2", 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot3", 0.35)
		self:SetMatchmakingDotScale(base .. "Dot1", 1.0)
		self:SetMatchmakingDotScale(base .. "Dot2", 1.0)
		self:SetMatchmakingDotScale(base .. "Dot3", 1.0)
	end

	method void OpenMatchmakingModal()
		-- Opens matchmaking modal and starts its local timer.
		self.isMatchmaking = true
		self.matchmakingElapsed = 0
		self.dotAnimTime = 0
		self.lastMatchmakingElapsedSecond = -1
		self:SetMatchmakingElapsedText("00:00")
		self:ResetMatchmakingDots()
		self:SetMatchmakingPopup(true)
		log("[LobbyController] Matchmaking modal opened")
		log("[LobbyController] Matchmaking timer started")
	end

	method void CloseMatchmakingModal()
		-- Closes matchmaking modal and resets timer/dot state.
		self.isMatchmaking = false
		self.matchmakingElapsed = 0
		self.dotAnimTime = 0
		self.lastMatchmakingElapsedSecond = -1
		self:SetMatchmakingElapsedText("00:00")
		self:ResetMatchmakingDots()
		self:SetMatchmakingPopup(false)
		log("[LobbyController] Matchmaking modal closed")
	end

	method void CancelMatchmaking()
		-- Cancels the local matchmaking wait UI.
		self:CloseMatchmakingModal()
		log("[LobbyController] Matchmaking cancelled")
	end

	method void UpdateMatchmakingModal(number delta)
		-- Advances timer text and loading dots while matchmaking is open.
		if self.isMatchmaking == false then return end
		
		self.matchmakingElapsed += delta
		self.dotAnimTime += delta
		
		local elapsedSeconds = math.floor(self.matchmakingElapsed)
		if elapsedSeconds ~= self.lastMatchmakingElapsedSecond then
			self.lastMatchmakingElapsedSecond = elapsedSeconds
			self:SetMatchmakingElapsedText(self:FormatMatchmakingTime(elapsedSeconds))
		end
		
		local phase = math.floor(self.dotAnimTime / 0.3) % 3
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/Matchmaking/Box/"
		self:SetMatchmakingDotAlpha(base .. "Dot1", phase == 0 and 1 or 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot2", phase == 1 and 1 or 0.35)
		self:SetMatchmakingDotAlpha(base .. "Dot3", phase == 2 and 1 or 0.35)
		self:SetMatchmakingDotScale(base .. "Dot1", phase == 0 and 1.22 or 1.0)
		self:SetMatchmakingDotScale(base .. "Dot2", phase == 1 and 1.22 or 1.0)
		self:SetMatchmakingDotScale(base .. "Dot3", phase == 2 and 1.22 or 1.0)
	end

	method void SetSettingsPopup(boolean active)
		-- Shows or hides the settings popup and resets it to the sound tab when opened.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/SettingsPopup")
		if popup ~= nil and isvalid(popup) then
			popup:SetEnable(active)
			popup.Visible = active
		end
		if active == true then
			self:SyncSettingsSoundState()
			self:ShowSettingsTab("sound")
		end
		self:SetLobbyUIDimmed(active)
		log("[LobbyController] Settings popup active=" .. tostring(active))
	end

	method void HideSettingsPopup()
		-- Hides the settings popup.
		self:SetSettingsPopup(false)
	end

	method void ShowSettingsTab(string tabName)
		-- Switches the settings modal between the info and sound content panels.
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/SettingsPopup/Panel"
		local info = _EntityService:GetEntityByPath(base .. "/ContentInfo")
		local sound = _EntityService:GetEntityByPath(base .. "/ContentSound")
		local showSound = (tabName == "sound")
		
		if info ~= nil and isvalid(info) then
			info:SetEnable(showSound == false)
			info.Visible = (showSound == false)
		else
			log_warning("[LobbyController] Settings ContentInfo not found")
		end
		
		if sound ~= nil and isvalid(sound) then
			sound:SetEnable(showSound)
			sound.Visible = showSound
		else
			log_warning("[LobbyController] Settings ContentSound not found")
		end
		
		log("[LobbyController] Settings tab selected=" .. tabName)
	end

	method void SyncSettingsSoundState()
		-- Reads the current BGM setting and mirrors it into the settings sound toggle image.
		local enabled = true
		if _MainFlowBgmController ~= nil then
			enabled = _MainFlowBgmController:IsBgmEnabled()
		end
		self.isSettingsSoundOn = enabled
		self:UpdateSettingsSoundToggleImage()
		log("[LobbyController] Settings sound synced enabled=" .. tostring(enabled))
	end

	method void UpdateSettingsSoundToggleImage()
		-- Applies the configured ON/OFF RUID to the settings sound toggle button.
		local sprite = self.settingsMuteButtonSprite
		if sprite == nil then
			local ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/SettingsPopup/Panel/ContentSound/MuteBtn")
			if ent ~= nil and isvalid(ent) then
				sprite = ent.SpriteGUIRendererComponent
			end
		end
		
		if sprite == nil then
			log_warning("[LobbyController] Settings sound toggle sprite not found")
			return
		end
		
		if self.isSettingsSoundOn then
			sprite.ImageRUID = DataRef(self.RUID_TOGGLE_ON)
		else
			sprite.ImageRUID = DataRef(self.RUID_TOGGLE_OFF)
		end
		log("[LobbyController] Settings sound toggle image on=" .. tostring(self.isSettingsSoundOn))
	end

	method void SetExternalPopupVisible(string popupName, boolean active)
		-- Shows or hides one of the lobby popups under ButtonGroup.
		local popupPath = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/" .. popupName
		local popup = _EntityService:GetEntityByPath(popupPath)
		if popup ~= nil and isvalid(popup) then
			popup:SetEnable(active)
			popup.Visible = active
			local canvas = popup.CanvasGroupComponent
			if canvas ~= nil then
				canvas.GroupAlpha = active and 1 or 0
				canvas.Interactable = active
				canvas.BlocksRaycasts = active
			end
			local uiTransform = popup.UITransformComponent
			if active == true and uiTransform ~= nil then
				_UILogic:SetSiblingIndex(uiTransform, 1000000)
			end
			self:SetLobbyUIDimmed(active)
			log("[ExternalPopup] name=" .. popupName .. " active=" .. tostring(active))
		else
			log_warning("[LobbyController] External popup not found: " .. popupPath)
		end
	end

	method void HideExternalPopups()
		self:SetExternalPopupVisible("FriendPopup", false)
		self:SetExternalPopupVisible("ShopPopup", false)
		self:SetExternalPopupVisible("AlertPopup", false)
	end

	method void SetCollectionPopup(boolean active)
		-- Shows or hides CollectionPopup and keeps CanvasGroup interaction aligned.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup")
		if popup == nil or isvalid(popup) == false then
			log_warning("[CollectionPopup] target not found")
			return
		end
		
		popup:SetEnable(active)
		popup.Visible = active
		
		local canvasGroup = popup.CanvasGroupComponent
		if canvasGroup ~= nil then
			if active == true then
				canvasGroup.GroupAlpha = 1
			else
				canvasGroup.GroupAlpha = 0
			end
			canvasGroup.Interactable = active
			canvasGroup.BlocksRaycasts = active
		end
		
		self:SetLobbyUIDimmed(active)
		log("[CollectionPopup] active=" .. tostring(active))
	end

	method void OpenCollectionPopup()
		-- Opens CollectionPopup on the role tab; SetCollectionTab pulls that tab's data.
		self:SetCollectionPopup(true)
		self.rolePage = 1
		self.costumePage = 1
		self:SetCollectionTab("role")
		self:ShowRoleDetail(1)
		log("[CollectionPopup] default role detail=시민 index=1")
	end

	method void CloseCollectionPopup()
		-- Closes CollectionPopup without resetting internal page state.
		self:SetCollectionPopup(false)
	end

	method table GetRoleCollectionDefs()
		-- The 8 role-card slots. `key` matches MafiaGameLogic's integer role as a string;
		-- an empty key marks a "준비 중" placeholder slot that can never unlock.
		return {
			{ key = "0", name = "시민",   team = "시민팀",   skill = "능력 없음",       description = "평범한 수사관. 토론과 투표로 마피아를 찾아낸다.", unlock = "시민 역할로 게임을 1회 플레이" },
			{ key = "1", name = "마피아", team = "마피아팀", skill = "밤에 지목 살해",  description = "밤마다 한 명을 지목해 제거한다. 정체를 숨겨야 한다.", unlock = "마피아 역할로 게임을 1회 플레이" },
			{ key = "2", name = "경찰",   team = "시민팀",   skill = "밤에 정체 조사",  description = "밤마다 한 명을 조사해 마피아인지 확인한다.",       unlock = "경찰 역할로 게임을 1회 플레이" },
			{ key = "3", name = "의사",   team = "시민팀",   skill = "밤에 대상 보호",  description = "밤마다 한 명을 보호해 마피아의 살해를 막는다.",     unlock = "의사 역할로 게임을 1회 플레이" },
			{ key = "",  name = "???",    team = "-",        skill = "-",               description = "아직 공개되지 않은 역할이다.",                      unlock = "준비 중" },
			{ key = "",  name = "???",    team = "-",        skill = "-",               description = "아직 공개되지 않은 역할이다.",                      unlock = "준비 중" },
			{ key = "",  name = "???",    team = "-",        skill = "-",               description = "아직 공개되지 않은 역할이다.",                      unlock = "준비 중" },
			{ key = "",  name = "???",    team = "-",        skill = "-",               description = "아직 공개되지 않은 역할이다.",                      unlock = "준비 중" },
		}
	end

	method void ApplyRoleCollection(string payloadJson)
		-- Receives the server's unlock set (CollectionManager) and repaints the role page.
		local unlockedSet = {}
		if payloadJson ~= nil and payloadJson ~= "" then
			local payload = _HttpService:JSONDecode(payloadJson)
			if payload ~= nil and payload.unlocked ~= nil then
				for _, roleKey in ipairs(payload.unlocked) do
					unlockedSet[tostring(roleKey)] = true
				end
			end
		end
		self.roleUnlockedSet = unlockedSet
		self:RenderRoleCards(unlockedSet)
		
		-- Repaint the open detail so its lock state follows a fresh unlock.
		if self.selectedRoleIndex > 0 then
			self:ShowRoleDetail(self.selectedRoleIndex)
		end
	end

	method void OnRoleCardClicked(integer slot)
		-- `slot` is the 1..8 grid position; convert it to an index into the full list.
		local index = (self.rolePage - 1) * self.COLLECTION_PAGE_SIZE + slot
		log("[CollectionPopup] role card clicked: slot=" .. tostring(slot) .. " index=" .. tostring(index))
		self:ShowRoleDetail(index)
	end

	method void ShowRoleDetail(integer index)
		-- Fills the right-hand DetailPanel from the clicked card's definition.
		local defs = self:GetRoleCollectionDefs()
		local def = defs[index]
		if def == nil then return end
		
		self.selectedRoleIndex = index
		
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/RolePage"
		local detail = base .. "/DetailPanel"
		local unlockedSet = self.roleUnlockedSet or {}
		local isReal = def.key ~= ""
		local isUnlocked = isReal and unlockedSet[def.key] == true
		local roleCardRuidByKey = {
			["0"] = "9b45713ea3ea4673a069d4f2ea0aedd4",
			["1"] = "4ab50fbe108a483994b6f8d992c8c598",
			["2"] = "4de7462417ec4147ba94df5e1c9ef4ed",
			["3"] = "a1f56de4e9184a508d7aef9e7d4ab46d",
		}
		local previewRuid = roleCardRuidByKey[def.key] or "876153f80e8a4f92bd349d205b82484e"
		local preview = _EntityService:GetEntityByPath(detail .. "/PreviewImage")
		if preview ~= nil and isvalid(preview) and preview.SpriteGUIRendererComponent ~= nil then
			preview.SpriteGUIRendererComponent.ImageRUID = DataRef(previewRuid)
			preview.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
		
		self:SetDetailText(detail .. "/RoleNameText", def.name)
		self:SetDetailText(detail .. "/TeamRow/TeamText", def.team)
		self:SetDetailText(detail .. "/SkillDescriptionText", def.skill)
		self:SetDetailText(detail .. "/DescriptionText", def.description)
		if isUnlocked then
			self:SetDetailText(detail .. "/UnlockConditionText", "수집 완료")
		else
			self:SetDetailText(detail .. "/UnlockConditionText", def.unlock)
		end
		
		-- The empty-state hint only makes sense before anything is picked.
		local empty = _EntityService:GetEntityByPath(detail .. "/EmptyState")
		if empty ~= nil and isvalid(empty) then empty:SetEnable(false) end
		
		-- Highlight only the selected card on the visible page.
		local grid = base .. "/ListPanel/CardGrid"
		local selectedSlot = index - (self.rolePage - 1) * self.COLLECTION_PAGE_SIZE
		for slot = 1, self.COLLECTION_PAGE_SIZE do
			local border = _EntityService:GetEntityByPath(grid .. "/RoleCard_0" .. tostring(slot) .. "/SelectedBorder")
			if border ~= nil and isvalid(border) then border:SetEnable(slot == selectedSlot) end
		end
	end

	method void SetDetailText(string path, string value)
		-- Small guard so a missing DetailPanel node cannot break the whole repaint.
		local ent = _EntityService:GetEntityByPath(path)
		if ent ~= nil and isvalid(ent) and ent.TextComponent ~= nil then
			ent.TextComponent.Text = value
		end
	end

	method integer GetPageCount(integer totalItems)
		-- Always at least one page, even when the collection is empty.
		local pageSize = self.COLLECTION_PAGE_SIZE
		if totalItems <= 0 then return 1 end
		return math.ceil(totalItems / pageSize)
	end

	method void UpdatePaginationUI(string pageBase, integer page, integer totalPages)
		-- Writes "n/m" while keeping the resource-backed arrows fully visible.
		local pagination = pageBase .. "/ListPanel/Pagination"
		
		self:SetDetailText(pagination .. "/PageText", tostring(page) .. " / " .. tostring(totalPages))
		
		local prev = _EntityService:GetEntityByPath(pagination .. "/PrevBtn")
		if prev ~= nil and isvalid(prev) and prev.SpriteGUIRendererComponent ~= nil then
			prev.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
		
		local next = _EntityService:GetEntityByPath(pagination .. "/NextBtn")
		if next ~= nil and isvalid(next) and next.SpriteGUIRendererComponent ~= nil then
			next.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
		end
	end

	method void OnRolePagePrev(ButtonClickEvent event)
		-- Previous page of role cards.
		if self.rolePage <= 1 then return end
		self.rolePage = self.rolePage - 1
		self:ClearRoleDetail()
		self:RenderRoleCards(self.roleUnlockedSet or {})
		log("[CollectionPopup] role page=" .. tostring(self.rolePage))
	end

	method void OnRolePageNext(ButtonClickEvent event)
		-- Next page of role cards.
		local totalPages = self:GetPageCount(#(self:GetRoleCollectionDefs()))
		if self.rolePage >= totalPages then return end
		self.rolePage = self.rolePage + 1
		self:ClearRoleDetail()
		self:RenderRoleCards(self.roleUnlockedSet or {})
		log("[CollectionPopup] role page=" .. tostring(self.rolePage))
	end

	method void OnCostumePagePrev(ButtonClickEvent event)
		-- Previous page of costume cards.
		if self.costumePage <= 1 then return end
		self.costumePage = self.costumePage - 1
		self:ClearCostumeDetail()
		self:RenderCostumeCards()
		log("[CollectionPopup] costume page=" .. tostring(self.costumePage))
	end

	method void OnCostumePageNext(ButtonClickEvent event)
		-- Next page of costume cards.
		local totalPages = self:GetPageCount(#(self:GetCostumeCollectionItems()))
		if self.costumePage >= totalPages then return end
		self.costumePage = self.costumePage + 1
		self:ClearCostumeDetail()
		self:RenderCostumeCards()
		log("[CollectionPopup] costume page=" .. tostring(self.costumePage))
	end

	method void WireCollectionPaginationEvents()
		-- Connects the ◀ / ▶ arrows under both card grids.
		local content = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot"
		local ent
		
		if self.rolePrevHandler == nil then
			ent = _EntityService:GetEntityByPath(content .. "/RolePage/ListPanel/Pagination/PrevBtn")
			if ent ~= nil and isvalid(ent) then
				self.rolePrevHandler = ent:ConnectEvent(ButtonClickEvent, self.OnRolePagePrev)
			end
		end
		if self.roleNextHandler == nil then
			ent = _EntityService:GetEntityByPath(content .. "/RolePage/ListPanel/Pagination/NextBtn")
			if ent ~= nil and isvalid(ent) then
				self.roleNextHandler = ent:ConnectEvent(ButtonClickEvent, self.OnRolePageNext)
			end
		end
		if self.costumePrevHandler == nil then
			ent = _EntityService:GetEntityByPath(content .. "/CostumePage/ListPanel/Pagination/PrevBtn")
			if ent ~= nil and isvalid(ent) then
				self.costumePrevHandler = ent:ConnectEvent(ButtonClickEvent, self.OnCostumePagePrev)
			end
		end
		if self.costumeNextHandler == nil then
			ent = _EntityService:GetEntityByPath(content .. "/CostumePage/ListPanel/Pagination/NextBtn")
			if ent ~= nil and isvalid(ent) then
				self.costumeNextHandler = ent:ConnectEvent(ButtonClickEvent, self.OnCostumePageNext)
			end
		end
		log("[CollectionPopup] pagination wired")
	end

	method void SetCollectionTab(string tab)
		-- Switches the 도감 between the role page and the costume page.
		local content = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot"
		self.collectionTab = tab
		
		local rolePage = _EntityService:GetEntityByPath(content .. "/RolePage")
		if rolePage ~= nil and isvalid(rolePage) then rolePage:SetEnable(tab == "role") end
		
		local costumePage = _EntityService:GetEntityByPath(content .. "/CostumePage")
		if costumePage ~= nil and isvalid(costumePage) then costumePage:SetEnable(tab == "costume") end
		
		self:HighlightCollectionTab(tab)
		
		if tab == "costume" then
			self:HighlightCostumeCollectionCategory(self.costumeCategory)
			self:ClearCostumeDetail()
			self:RenderCostumeCards()
		else
			-- Returning from the costume dex should always open the role dex on
			-- its default entry instead of leaving the detail panel empty.
			self.rolePage = 1
			self:ShowRoleDetail(1)
			if _CollectionManager ~= nil then
				_CollectionManager:RequestRoleCollection()
			end
			log("[CollectionPopup] default role detail=시민 index=1")
		end
		log("[CollectionPopup] tab=" .. tab)
	end

	method void HighlightCollectionTab(string tab)
		-- Uses dedicated sprites for selected/unselected role and costume tabs.
		local nav = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/NavigationPanel"
		local white = Color(1.0, 1.0, 1.0, 1.0)
		
		local roleBtn = _EntityService:GetEntityByPath(nav .. "/Tab_Role")
		if roleBtn ~= nil and isvalid(roleBtn) and roleBtn.SpriteGUIRendererComponent ~= nil then
			local roleRuid = tab == "role" and "9f040e220a5c4c96b10a49b6038657ef" or "1b18f5c574384e2e9fb422c1b39e88d1"
			roleBtn.SpriteGUIRendererComponent.ImageRUID = DataRef(roleRuid)
			roleBtn.SpriteGUIRendererComponent.Color = white
			if roleBtn.TextComponent ~= nil then
				roleBtn.TextComponent.Text = ""
				roleBtn.TextComponent.Enable = false
			end
		end
		
		local costumeBtn = _EntityService:GetEntityByPath(nav .. "/Tab_Costume")
		if costumeBtn ~= nil and isvalid(costumeBtn) and costumeBtn.SpriteGUIRendererComponent ~= nil then
			local costumeRuid = tab == "costume" and "cb946ea797b342ff85c6e93e2887cec0" or "9c0b7ef2dacd487180b2ca4279200dd3"
			costumeBtn.SpriteGUIRendererComponent.ImageRUID = DataRef(costumeRuid)
			costumeBtn.SpriteGUIRendererComponent.Color = white
			if costumeBtn.TextComponent ~= nil then
				costumeBtn.TextComponent.Text = ""
				costumeBtn.TextComponent.Enable = false
			end
		end
	end

	method table GetCostumeCollectionItems()
		-- The costume dex reuses ShopController's catalog; MoneyManager keeps item.owned current.
		if _ShopController == nil or _ShopController.costumeData == nil then return {} end
		return _ShopController.costumeData
	end

	method table GetCostumeCategoryButtons()
		-- CategoryBar node name -> catalog category value.
		return {
			{ node = "Category_All",       category = "전체" },
			{ node = "Category_Top",       category = "상의" },
			{ node = "Category_Bottom",    category = "하의" },
			{ node = "Category_Shoes",     category = "신발" },
			{ node = "Category_Accessory", category = "장식" },
			{ node = "Category_Set",       category = "세트" },
		}
	end

	method any GetFilteredCostumeCollectionItems()
		-- Returns costume dex items matching the active costume category.
		local source = self:GetCostumeCollectionItems()
		if self.costumeCategory == "전체" then return source end
		
		local result = {}
		for _, item in ipairs(source) do
			if item.category == self.costumeCategory then
				result[#result + 1] = item
			end
		end
		return result
	end

	method void SelectCostumeCollectionCategory(string category)
		-- Switches the costume dex category and repaints from page 1.
		self.costumeCategory = category
		self.costumePage = 1
		self:HighlightCostumeCollectionCategory(category)
		self:ClearCostumeDetail()
		self:RenderCostumeCards()
		log("[CollectionPopup] costume category=" .. category)
	end

	method void HighlightCostumeCollectionCategory(string category)
		-- Swaps the costume dex category button background while preserving label text.
		local bar = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/CostumePage/CategoryBar"
		local white = Color(1.0, 1.0, 1.0, 1.0)
		for _, entry in ipairs(self:GetCostumeCategoryButtons()) do
			local ent = _EntityService:GetEntityByPath(bar .. "/" .. entry.node)
			if ent ~= nil and isvalid(ent) and ent.SpriteGUIRendererComponent ~= nil then
				if entry.category == category then
					ent.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CATEGORY_ACTIVE_RUID)
				else
					ent.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CATEGORY_INACTIVE_RUID)
				end
				ent.SpriteGUIRendererComponent.Color = white
			end
		end
	end

	method void RenderCostumeCards()
		-- Paints the costume cards: owned ones are lit, unowned stay covered by the lock overlay.
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/CostumePage"
		local grid = base .. "/ListPanel/CardGrid"
		local allItems = self:GetCostumeCollectionItems()
		local items = self:GetFilteredCostumeCollectionItems()
		local pageSize = self.COLLECTION_PAGE_SIZE
		local totalPages = self:GetPageCount(#items)
		if self.costumePage > totalPages then self.costumePage = totalPages end
		if self.costumePage < 1 then self.costumePage = 1 end
		
		-- Progress counts the whole catalog, not just the visible page.
		local ownedCount = 0
		for _, item in ipairs(allItems) do
			if item.owned == true then ownedCount = ownedCount + 1 end
		end
		
		local offset = (self.costumePage - 1) * pageSize
		for slot = 1, pageSize do
			local cardPath = grid .. "/CostumeCard_0" .. tostring(slot)
			local card = _EntityService:GetEntityByPath(cardPath)
			if card ~= nil and isvalid(card) then
				local item = items[offset + slot]
				if item == nil then
					-- Last page may not be full: hide the leftover slots.
					card:SetEnable(false)
				else
					card:SetEnable(true)
					local isOwned = item.owned == true
		
					self:SetDetailText(cardPath .. "/CostumeNamePanel/CostumeNameText", item.name)
		
					local lockOverlay = _EntityService:GetEntityByPath(cardPath .. "/LockOverlay")
					if lockOverlay ~= nil and isvalid(lockOverlay) then lockOverlay:SetEnable(not isOwned) end
		
					local lockIcon = _EntityService:GetEntityByPath(cardPath .. "/LockIcon")
					if lockIcon ~= nil and isvalid(lockIcon) then lockIcon:SetEnable(not isOwned) end
		
					local ownedBadge = _EntityService:GetEntityByPath(cardPath .. "/OwnedBadge")
					if ownedBadge ~= nil and isvalid(ownedBadge) then ownedBadge:SetEnable(isOwned) end
				end
			end
		end
		
		self:UpdatePaginationUI(base, self.costumePage, totalPages)
		
		local progress = _EntityService:GetEntityByPath(base .. "/CollectionHeader/ProgressText")
		if progress ~= nil and isvalid(progress) and progress.TextComponent ~= nil then
			progress.TextComponent.Text = tostring(ownedCount) .. "/" .. tostring(#allItems)
		end
		
		log("[CollectionPopup] costume cards rendered category=" .. self.costumeCategory ..
			" owned=" .. tostring(ownedCount) .. "/" .. tostring(#allItems) ..
			" visible=" .. tostring(#items))
	end

	method void OnCostumeCardClicked(integer slot)
		-- `slot` is the 1..8 grid position; convert it to an index into the filtered catalog.
		local index = (self.costumePage - 1) * self.COLLECTION_PAGE_SIZE + slot
		local items = self:GetFilteredCostumeCollectionItems()
		local item = items[index]
		if item == nil then return end
		log("[CollectionPopup] costume card clicked: slot=" .. tostring(slot) .. " categoryIndex=" .. tostring(index))
		self:ShowCostumeDetail(item)
	end

	method void ShowCostumeDetail(any item)
		-- Fills the costume DetailPanel from the clicked card's catalog entry.
		if item == nil then return end
		
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/CostumePage"
		local detail = base .. "/DetailPanel"
		local isOwned = item.owned == true
		self.selectedCostumeIndex = item.id
		
		self:SetDetailText(detail .. "/CostumeNameText", item.name)
		self:SetDetailText(detail .. "/CategoryRow/CategoryText", item.category)
		self:SetDetailText(detail .. "/GradeRow/GradeText", item.grade)
		self:SetDetailText(detail .. "/DescriptionText", item.desc)
		if isOwned then
			self:SetDetailText(detail .. "/AcquisitionText", "보유 중")
		elseif _ShopController ~= nil then
			self:SetDetailText(detail .. "/AcquisitionText", "상점에서 구매 (" .. _ShopController:FormatPrice(item) .. ")")
		else
			self:SetDetailText(detail .. "/AcquisitionText", "상점에서 구매")
		end
		
		local empty = _EntityService:GetEntityByPath(detail .. "/EmptyState")
		if empty ~= nil and isvalid(empty) then empty:SetEnable(false) end
		
		local grid = base .. "/ListPanel/CardGrid"
		local visibleItems = self:GetFilteredCostumeCollectionItems()
		for slot = 1, self.COLLECTION_PAGE_SIZE do
			local border = _EntityService:GetEntityByPath(grid .. "/CostumeCard_0" .. tostring(slot) .. "/SelectedBorder")
			if border ~= nil and isvalid(border) then
				local visibleItem = visibleItems[(self.costumePage - 1) * self.COLLECTION_PAGE_SIZE + slot]
				border:SetEnable(visibleItem ~= nil and visibleItem.id == self.selectedCostumeIndex)
			end
		end
	end

	method void ClearCostumeDetail()
		-- Returns the costume DetailPanel to its "pick a card" state.
		self.selectedCostumeIndex = 0
		
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/CostumePage"
		local detail = base .. "/DetailPanel"
		
		self:SetDetailText(detail .. "/CostumeNameText", "")
		self:SetDetailText(detail .. "/CategoryRow/CategoryText", "")
		self:SetDetailText(detail .. "/GradeRow/GradeText", "")
		self:SetDetailText(detail .. "/DescriptionText", "")
		self:SetDetailText(detail .. "/AcquisitionText", "")
		
		local empty = _EntityService:GetEntityByPath(detail .. "/EmptyState")
		if empty ~= nil and isvalid(empty) then empty:SetEnable(true) end
		
		local grid = base .. "/ListPanel/CardGrid"
		for i = 1, 8 do
			local border = _EntityService:GetEntityByPath(grid .. "/CostumeCard_0" .. tostring(i) .. "/SelectedBorder")
			if border ~= nil and isvalid(border) then border:SetEnable(false) end
		end
	end

	method void ClearRoleDetail()
		-- Returns the DetailPanel to its "pick a card" state.
		self.selectedRoleIndex = 0
		
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/RolePage"
		local detail = base .. "/DetailPanel"
		
		self:SetDetailText(detail .. "/RoleNameText", "")
		self:SetDetailText(detail .. "/TeamRow/TeamText", "")
		self:SetDetailText(detail .. "/SkillDescriptionText", "")
		self:SetDetailText(detail .. "/DescriptionText", "")
		self:SetDetailText(detail .. "/UnlockConditionText", "")
		local preview = _EntityService:GetEntityByPath(detail .. "/PreviewImage")
		if preview ~= nil and isvalid(preview) and preview.SpriteGUIRendererComponent ~= nil then
			preview.SpriteGUIRendererComponent.ImageRUID = DataRef("")
		end
		
		local empty = _EntityService:GetEntityByPath(detail .. "/EmptyState")
		if empty ~= nil and isvalid(empty) then empty:SetEnable(true) end
		
		local grid = base .. "/ListPanel/CardGrid"
		for i = 1, 8 do
			local border = _EntityService:GetEntityByPath(grid .. "/RoleCard_0" .. tostring(i) .. "/SelectedBorder")
			if border ~= nil and isvalid(border) then border:SetEnable(false) end
		end
	end

	method void RenderRoleCards(table unlockedSet)
		-- Paints all 8 role cards. The 4 real roles always show their name — they are public
		-- knowledge in mafia, so hiding them behind "???" only withholds information. The lock
		-- overlay marks "not experienced yet". Slots 5-8 are unannounced placeholders.
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/RolePage"
		local defs = self:GetRoleCollectionDefs()
		local roleCardRuidByKey = {
			["0"] = "9b45713ea3ea4673a069d4f2ea0aedd4", -- 시민
			["1"] = "4ab50fbe108a483994b6f8d992c8c598", -- 마피아
			["2"] = "4de7462417ec4147ba94df5e1c9ef4ed", -- 경찰
			["3"] = "a1f56de4e9184a508d7aef9e7d4ab46d", -- 의사
		}
		local lockedCardRuid = "876153f80e8a4f92bd349d205b82484e"
		local pageSize = self.COLLECTION_PAGE_SIZE
		local totalPages = self:GetPageCount(#defs)
		if self.rolePage > totalPages then self.rolePage = totalPages end
		if self.rolePage < 1 then self.rolePage = 1 end
		
		-- Progress counts the whole collection, not just the visible page.
		local unlockedCount = 0
		local totalReal = 0
		for _, def in ipairs(defs) do
			if def.key ~= "" then
				totalReal = totalReal + 1
				if unlockedSet[def.key] == true then unlockedCount = unlockedCount + 1 end
			end
		end
		
		local offset = (self.rolePage - 1) * pageSize
		for slot = 1, pageSize do
			local cardPath = base .. "/ListPanel/CardGrid/RoleCard_0" .. tostring(slot)
			local card = _EntityService:GetEntityByPath(cardPath)
			if card ~= nil and isvalid(card) then
				local def = defs[offset + slot]
				if def == nil then
					-- Last page may not be full: hide the leftover slots.
					card:SetEnable(false)
				else
					card:SetEnable(true)
					local isReal = def.key ~= ""
					local isUnlocked = isReal and unlockedSet[def.key] == true
					local cardRuid = lockedCardRuid
					if isReal and roleCardRuidByKey[def.key] ~= nil then
						cardRuid = roleCardRuidByKey[def.key]
					end
					local cardFrame = _EntityService:GetEntityByPath(cardPath .. "/CardFrame")
					if cardFrame ~= nil and isvalid(cardFrame) and cardFrame.SpriteGUIRendererComponent ~= nil then
						cardFrame.SpriteGUIRendererComponent.ImageRUID = DataRef(cardRuid)
						cardFrame.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
						log("[CollectionPopup] role card slot=" .. tostring(slot) .. " key=" .. tostring(def.key) .. " ruid=" .. cardRuid)
					end
					local selectedBorder = _EntityService:GetEntityByPath(cardPath .. "/SelectedBorder")
					if selectedBorder ~= nil and isvalid(selectedBorder) and selectedBorder.SpriteGUIRendererComponent ~= nil then
						selectedBorder.SpriteGUIRendererComponent.ImageRUID = DataRef(cardRuid)
					end
		
					local nameEnt = _EntityService:GetEntityByPath(cardPath .. "/RoleNamePanel/RoleNameText")
					if nameEnt ~= nil and isvalid(nameEnt) and nameEnt.TextComponent ~= nil then
						nameEnt.TextComponent.Text = def.name
					end
		
					-- The locked card resource already contains the locked presentation.
					local lockOverlay = _EntityService:GetEntityByPath(cardPath .. "/LockOverlay")
					if lockOverlay ~= nil and isvalid(lockOverlay) then lockOverlay:SetEnable(false) end
		
					local lockIcon = _EntityService:GetEntityByPath(cardPath .. "/LockIcon")
					if lockIcon ~= nil and isvalid(lockIcon) then lockIcon:SetEnable(false) end
		
					-- The full-card resource includes its own presentation, so legacy badges stay hidden.
					local badge = _EntityService:GetEntityByPath(cardPath .. "/CollectedBadge")
					if badge ~= nil and isvalid(badge) then badge:SetEnable(false) end
				end
			end
		end
		
		self:UpdatePaginationUI(base, self.rolePage, totalPages)
		
		local progress = _EntityService:GetEntityByPath(base .. "/CollectionHeader/ProgressText")
		if progress ~= nil and isvalid(progress) and progress.TextComponent ~= nil then
			progress.TextComponent.Text = tostring(unlockedCount) .. "/" .. tostring(totalReal)
		end
		
		log("[CollectionPopup] role cards rendered unlocked=" .. tostring(unlockedCount) .. "/" .. tostring(totalReal))
	end

	method void SetBagPopup(boolean active)
		-- Shows or hides BagPopup and keeps CanvasGroup interaction aligned.
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup")
		if popup == nil or isvalid(popup) == false then
			log_warning("[BagPopup] entity not found")
			return
		end
		
		popup:SetEnable(active)
		popup.Visible = active
		
		local canvasGroup = popup.CanvasGroupComponent
		if canvasGroup ~= nil then
			if active == true then
				canvasGroup.GroupAlpha = 1
			else
				canvasGroup.GroupAlpha = 0
			end
			canvasGroup.Interactable = active
			canvasGroup.BlocksRaycasts = active
		end
		
		self:SetLobbyUIDimmed(active)
		log("[BagPopup] active=" .. tostring(active))
	end

	method void OpenBagPopup()
		-- Opens BagPopup and repaints it from the player's owned costumes.
		self:WireBagPopupEvents()
		self:WireBagContentEvents()
		self:SetBagPopup(true)
		
		self.bagPage = 1
		self.selectedBagItemId = -1
		self:HighlightBagCategory(self.bagCategory)
		self:ClearBagDetail()
		self:RenderBagSlots()
	end

	method void CloseBagPopup()
		-- Closes BagPopup without resetting internal UI state.
		self:SetBagPopup(false)
	end

	method void OpenExternalPopup(string popupName)
		-- Opens one lobby popup and refreshes feature data when required.
		self:HideSettingsPopup()
		self:HideExternalPopups()
		self:SetExternalPopupVisible(popupName, true)
		if popupName == "FriendPopup" then
			self:RefreshFriendPopup()
		end
		log("[LobbyController] External popup opened=" .. popupName)
	end

	method void OnExternalPopupCloseClicked(ButtonClickEvent event)
		self:HideExternalPopups()
		log("[LobbyController] External popup close clicked")
	end

	method void OnCollectionPopupCloseClicked(ButtonClickEvent event)
		-- Closes CollectionPopup from either close button.
		log("[CollectionPopup] close clicked")
		self:CloseCollectionPopup()
	end

	method void OnBagPopupCloseClicked(ButtonClickEvent event)
		-- Closes BagPopup from either close button.
		log("[BagPopup] close clicked")
		self:CloseBagPopup()
	end

	method void SetUnderDevelopmentPopup(boolean active)
		local popup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/UnderDevelopmentPopup")
		if popup ~= nil and isvalid(popup) then
			popup:SetEnable(active)
		end
		log("[UnderDevelopmentPopup] active=" .. tostring(active))
	end

	method void ShowUnderDevelopmentPopup()
		self:SetUnderDevelopmentPopup(true)
	end

	method void HideUnderDevelopmentPopup()
		self:SetUnderDevelopmentPopup(false)
	end

	method void OnUnderDevelopmentConfirmClicked(ButtonClickEvent event)
		log("[UnderDevelopmentPopup] confirm clicked")
		self:HideUnderDevelopmentPopup()
	end

	method void WireUnderDevelopmentPopupEvents()
		if self.underDevelopmentConfirmHandler ~= nil then return end
		local confirm = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/UnderDevelopmentPopup/PopupFrame/ConfirmButton")
		if confirm ~= nil and isvalid(confirm) then
			self.underDevelopmentConfirmHandler = confirm:ConnectEvent(ButtonClickEvent, self.OnUnderDevelopmentConfirmClicked)
			log("[UnderDevelopmentPopup] confirm wired")
		else
			log_warning("[UnderDevelopmentPopup] ConfirmButton not found")
		end
	end

	method void SetCreateRoomModalVisible(boolean active)
		-- Shows or hides the create-room modal tree.
		local modal = self.createRoomModalRoot
		if modal == nil or isvalid(modal) == false then
			modal = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/CreateRoomModalRoot")
			self.createRoomModalRoot = modal
		end
		if modal ~= nil and isvalid(modal) then
			modal:SetEnable(active)
			modal.Visible = active
			if active then
				local uiTransform = modal.UITransformComponent
				if uiTransform ~= nil then
					_UILogic:SetSiblingIndex(uiTransform, 1000000)
				end
			end
			local canvas = modal.CanvasGroupComponent
			if canvas ~= nil then
				canvas.GroupAlpha = active and 1 or 0
				canvas.Interactable = active
				canvas.BlocksRaycasts = active
			end
		else
			log_warning("[LobbyController] CreateRoomModalRoot not found")
		end
	end

	method void OpenCreateRoomModal()
		-- Opens the create-room modal and resets the form to its default values.
		self.isCreateRoomModalOpen = true
		self:SetCreateRoomRequestPending(false)
		self:ResetCreateRoomForm()
		self:UpdateCreateRoomFormView()
		self:WireCreateRoomModalEvents()
		self:SetCreateRoomModalVisible(true)
		log("[Room] RoomCreateModal opened")
	end

	method void ShowCommonPopup(string popupType, string message)
		-- The stale UUID-bound common popup was removed. Preserve caller behavior with a toast.
		if _UIToast ~= nil and message ~= nil and message ~= "" then
			_UIToast:ShowMessage(message)
		end
		log("[CommonPopupFallback] type=" .. tostring(popupType) .. " message=" .. tostring(message))
	end

	method void ShowJoinFailurePopup(string reason, string fallbackMessage)
		-- Maps room-join failure reasons to common popup messages.
		local message = "방에 입장할 수 없습니다."
		if reason == "PASSWORD_REQUIRED" then
			message = "비밀번호를 입력해 주세요."
		elseif reason == "PASSWORD_INVALID" then
			message = "비밀번호가 올바르지 않습니다."
		elseif reason == "FULL" then
			message = "현재 방 인원이 가득 찼습니다."
		elseif reason == "PLAYING" then
			message = "이미 게임이 시작된 방입니다."
		elseif fallbackMessage ~= nil and fallbackMessage ~= "" then
			message = fallbackMessage
		end
		self:ShowCommonPopup("error", message)
	end

	method void CloseCreateRoomModal()
		-- Closes the create-room modal and disconnects its temporary button handlers.
		if self.isCreateRoomModalOpen == false then
			self:SetCreateRoomModalVisible(false)
			self:DisconnectCreateRoomModalEvents()
			return
		end
		self:SetCreateRoomModalVisible(false)
		self.isCreateRoomModalOpen = false
		self:DisconnectCreateRoomModalEvents()
		log("[Room] RoomCreateModal closed")
	end

	method void ResetCreateRoomForm()
		-- Restores default create-room form values.
		self.selectedMaxPlayers = 8
		self.isPrivateRoom = false
		if self.createRoomNameInput ~= nil then
			self.createRoomNameInput.Text = ""
		end
		if self.createRoomPasswordInput ~= nil then
			self.createRoomPasswordInput.Text = ""
		end
		self:SetCreateRoomError("")
		self:UpdateCreateRoomFormView()
	end

	method void UpdateCreateRoomFormView()
		-- Mirrors create-room state into the visible modal fields.
		if self.createRoomPlayerCountText ~= nil then
			self.createRoomPlayerCountText.Text = tostring(self.selectedMaxPlayers)
		end
		
		if self.isPrivateRoom then
			if self.createRoomPrivateToggleSprite ~= nil then
				self.createRoomPrivateToggleSprite.ImageRUID = DataRef(self.RUID_PRIVATE_TOGGLE_ON)
			end
			if self.createRoomPasswordInputBoxSprite ~= nil then
				self.createRoomPasswordInputBoxSprite.ImageRUID = DataRef(self.RUID_PASSWORD_BOX_ACTIVE)
			end
			if self.createRoomPasswordInput ~= nil then
				self.createRoomPasswordInput.Enable = true
			end
		else
			if self.createRoomPrivateToggleSprite ~= nil then
				self.createRoomPrivateToggleSprite.ImageRUID = DataRef(self.RUID_PRIVATE_TOGGLE_OFF)
			end
			if self.createRoomPasswordInputBoxSprite ~= nil then
				self.createRoomPasswordInputBoxSprite.ImageRUID = DataRef(self.RUID_PASSWORD_BOX_OFF)
			end
			if self.createRoomPasswordInput ~= nil then
				self.createRoomPasswordInput.Text = ""
				self.createRoomPasswordInput.Enable = false
			end
		end
	end

	method void TogglePrivateRoom()
		-- Toggles private-room mode and updates password input availability.
		self.isPrivateRoom = not self.isPrivateRoom
		self:UpdateCreateRoomFormView()
		log("[LobbyController] private room=" .. tostring(self.isPrivateRoom))
	end

	method void IncreaseMaxPlayers()
		-- Raises max players up to 8.
		if self.selectedMaxPlayers < 8 then
			self.selectedMaxPlayers += 1
		end
		self:UpdateCreateRoomFormView()
		log("[LobbyController] create room max players=" .. tostring(self.selectedMaxPlayers))
	end

	method void DecreaseMaxPlayers()
		-- Lowers max players down to 6.
		if self.selectedMaxPlayers > 6 then
			self.selectedMaxPlayers -= 1
		end
		self:UpdateCreateRoomFormView()
		log("[LobbyController] create room max players=" .. tostring(self.selectedMaxPlayers))
	end

	method string TrimCreateRoomText(string value)
		-- Trims leading and trailing whitespace from a form value.
		if value == nil then return "" end
		local result = string.match(value, "^%s*(.-)%s*$")
		if result == nil then return "" end
		return result
	end

	method integer GetCreateRoomNameLength(string value)
		-- Counts UTF-8 characters without relying on optional library globals.
		if value == nil then return 0 end
		local count = 0
		local totalBytes = string.len(value)
		for i = 1, totalBytes do
			local byteValue = string.byte(value, i)
			if byteValue ~= nil and (byteValue < 128 or byteValue >= 192) then
				count += 1
			end
		end
		return count
	end

	method void SetCreateRoomError(string message)
		-- Shows or hides the create-room validation error area.
		local hasError = message ~= nil and message ~= ""
		if self.createRoomErrorText ~= nil then
			self.createRoomErrorText.Text = hasError and message or ""
			if self.createRoomErrorText.Entity ~= nil then
				self.createRoomErrorText.Entity:SetEnable(hasError)
				self.createRoomErrorText.Entity.Visible = hasError
			end
		end
		if self.createRoomErrorBox ~= nil and isvalid(self.createRoomErrorBox) then
			self.createRoomErrorBox:SetEnable(hasError)
			self.createRoomErrorBox.Visible = hasError
		end
	end

	method boolean ValidateCreateRoomForm()
		-- Validates current create-room input fields and displays the first error.
		local roomName = ""
		if self.createRoomNameInput ~= nil then
			roomName = self:TrimCreateRoomText(self.createRoomNameInput.Text)
			self.createRoomNameInput.Text = roomName
		end
		
		if roomName == "" then
			self:SetCreateRoomError("수사방 이름을 입력하세요.")
			return false
		end
		if self:GetCreateRoomNameLength(roomName) > 12 then
			self:SetCreateRoomError("수사방 이름은 12자 이하로 입력하세요.")
			return false
		end
		if self.selectedMaxPlayers < 6 or self.selectedMaxPlayers > 8 then
			self:SetCreateRoomError("최대 인원은 6~8명으로 선택하세요.")
			return false
		end
		
		if self.isPrivateRoom then
			local password = ""
			if self.createRoomPasswordInput ~= nil then
				password = self:TrimCreateRoomText(self.createRoomPasswordInput.Text)
				self.createRoomPasswordInput.Text = password
			end
			if password == "" then
				self:SetCreateRoomError("비공개 수사방은 비밀번호가 필요합니다.")
				return false
			end
			if string.match(password, "^%d%d%d%d$") == nil then
				self:SetCreateRoomError("비밀번호는 숫자 4자리로 입력하세요.")
				return false
			end
		end
		
		self:SetCreateRoomError("")
		return true
	end

	method void SubmitCreateRoomForm()
		-- Validates the form, then requests authoritative server-side room creation.
		if self.isCreateRoomRequestPending then
			log_warning("[Room] Duplicate room creation click ignored while request is pending")
			return
		end
		if self:ValidateCreateRoomForm() == false then return end
		local roomName = ""
		local password = ""
		if self.createRoomNameInput ~= nil then
			roomName = self:TrimCreateRoomText(self.createRoomNameInput.Text)
		end
		if self.isPrivateRoom and self.createRoomPasswordInput ~= nil then
			password = self:TrimCreateRoomText(self.createRoomPasswordInput.Text)
		end
		if _InvestigationRoomManager == nil then
			self:SetCreateRoomError("수사방 서버에 연결할 수 없습니다.")
			log_warning("[Room] Room creation rejected: InvestigationRoomManager unavailable")
			return
		end
		-- Lock before sending the RPC so rapid clicks in the same frame cannot enqueue duplicates.
		self:SetCreateRoomRequestPending(true)
		log("[Room] Room creation requested once name=" .. roomName .. " maxPlayers=" .. tostring(self.selectedMaxPlayers) .. " private=" .. tostring(self.isPrivateRoom))
		_InvestigationRoomManager:CreateRoom(roomName, "기본 수사", self.selectedMaxPlayers, self.isPrivateRoom, password, self.currentProfileNickname)
	end

	method void SetCreateRoomRequestPending(boolean pending)
		-- Keeps the submit button and loading feedback in sync with the active server request.
		self.isCreateRoomRequestPending = pending
		if self.createRoomSubmitButton ~= nil and isvalid(self.createRoomSubmitButton) then
			self.createRoomSubmitButton.Enable = not pending
		end
		if pending then
			self:SetCreateRoomError("방을 생성하는 중입니다...")
		end
		log("[Room] Room creation pending=" .. tostring(pending))
	end

	method void OnRoomCreateResult(boolean success, string message, string roomJson)
		-- Receives the server result and moves the user into the waiting-state view.
		self:SetCreateRoomRequestPending(false)
		if success == false then
			log_warning("[Room] Room creation failed: " .. message)
			self:SetCreateRoomError(message)
			self:ShowCommonPopup("error", message ~= "" and message or "방을 생성할 수 없습니다.")
			return
		end
		local room = _HttpService:JSONDecode(roomJson)
		self.joinedRoomId = room.roomId or ""
		log("[Room] Room created successfully id=" .. self.joinedRoomId)
		self:CloseMatchmakingModal()
		self:CloseFindRoomModal()
		self:CloseCreateRoomModal()
		self:EnterInvestigationRoomLobby("create")
		_UIToast:ShowMessage("수사방이 생성되었습니다. 대기 중입니다.")
	end

	method void WireCreateRoomModalEvents()
		-- Wires create-room modal buttons while it is open.
		if self.createRoomSubmitHandler ~= nil then return end
		if self.createRoomDimOverlayButton ~= nil and isvalid(self.createRoomDimOverlayButton) then
			self.createRoomDimHandler = self.createRoomDimOverlayButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCreateRoomModal()
			end)
		end
		if self.createRoomCloseButton ~= nil and isvalid(self.createRoomCloseButton) then
			self.createRoomCloseHandler = self.createRoomCloseButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCreateRoomModal()
			end)
		end
		if self.createRoomCancelButton ~= nil and isvalid(self.createRoomCancelButton) then
			self.createRoomCancelHandler = self.createRoomCancelButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseCreateRoomModal()
			end)
		end
		if self.createRoomMinusButton ~= nil and isvalid(self.createRoomMinusButton) then
			self.createRoomMinusHandler = self.createRoomMinusButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:DecreaseMaxPlayers()
			end)
		end
		if self.createRoomPlusButton ~= nil and isvalid(self.createRoomPlusButton) then
			self.createRoomPlusHandler = self.createRoomPlusButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:IncreaseMaxPlayers()
			end)
		end
		if self.createRoomPrivateToggleButton ~= nil and isvalid(self.createRoomPrivateToggleButton) then
			self.createRoomPrivateHandler = self.createRoomPrivateToggleButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:TogglePrivateRoom()
			end)
		end
		if self.createRoomSubmitButton ~= nil and isvalid(self.createRoomSubmitButton) then
			self.createRoomSubmitHandler = self.createRoomSubmitButton.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:SubmitCreateRoomForm()
			end)
		end
	end

	method void DisconnectCreateRoomModalEvents()
		-- Disconnects create-room modal handlers to avoid duplicate callbacks after reopen.
		if self.createRoomDimHandler ~= nil and self.createRoomDimOverlayButton ~= nil and isvalid(self.createRoomDimOverlayButton) then
			self.createRoomDimOverlayButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomDimHandler)
			self.createRoomDimHandler = nil
		end
		if self.createRoomCloseHandler ~= nil and self.createRoomCloseButton ~= nil and isvalid(self.createRoomCloseButton) then
			self.createRoomCloseButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomCloseHandler)
			self.createRoomCloseHandler = nil
		end
		if self.createRoomCancelHandler ~= nil and self.createRoomCancelButton ~= nil and isvalid(self.createRoomCancelButton) then
			self.createRoomCancelButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomCancelHandler)
			self.createRoomCancelHandler = nil
		end
		if self.createRoomMinusHandler ~= nil and self.createRoomMinusButton ~= nil and isvalid(self.createRoomMinusButton) then
			self.createRoomMinusButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomMinusHandler)
			self.createRoomMinusHandler = nil
		end
		if self.createRoomPlusHandler ~= nil and self.createRoomPlusButton ~= nil and isvalid(self.createRoomPlusButton) then
			self.createRoomPlusButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomPlusHandler)
			self.createRoomPlusHandler = nil
		end
		if self.createRoomPrivateHandler ~= nil and self.createRoomPrivateToggleButton ~= nil and isvalid(self.createRoomPrivateToggleButton) then
			self.createRoomPrivateToggleButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomPrivateHandler)
			self.createRoomPrivateHandler = nil
		end
		if self.createRoomSubmitHandler ~= nil and self.createRoomSubmitButton ~= nil and isvalid(self.createRoomSubmitButton) then
			self.createRoomSubmitButton.Entity:DisconnectEvent(ButtonClickEvent, self.createRoomSubmitHandler)
			self.createRoomSubmitHandler = nil
		end
	end

	method void HideAvatarFallback()
		-- Keeps the fallback placeholder hidden now that AvatarGUIRenderer is working.
		local fallback = self.fallbackCache
		if fallback == nil or isvalid(fallback) == false then
			fallback = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarFallback")
			self.fallbackCache = fallback
		end
		if fallback ~= nil and isvalid(fallback) then
			fallback:SetEnable(false)
			fallback.Visible = false
			local sprite = fallback.SpriteGUIRendererComponent
			if sprite ~= nil then
				sprite:SetAlpha(0)
				sprite.Enable = false
			end
			log("[LobbyController] Avatar fallback hidden=true")
		else
			log("[LobbyController] Avatar fallback hidden=false")
		end
	end

	method void CheckAvatarFallback()
		-- Legacy safety hook; fallback is intentionally kept hidden.
		self.avatarCheckTimerId = 0
		self:HideAvatarFallback()
	end

	method void ShowAvatarFallback()
		-- Legacy compatibility hook; fallback should not be displayed in the final lobby.
		self:HideAvatarFallback()
	end

	method void WireKeyboardInput()
		-- Connects KeyDownEvent for jump/ESC. Guards against double-wiring.
		if self.keyDownHandler ~= nil then return end
		self.keyDownHandler = self.Entity:ConnectEvent(KeyDownEvent, self.OnKeyDown)
		self:WirePopupBackdrops()
		self:WireAchievementPopupDim()
		log("[LobbyController] Keyboard wired")
	end

	method void CloseAllPopups()
		-- Closes every lobby popup/modal. Idempotent — safe on already-closed ones.
		self:HideExternalPopups()
		self:CloseCollectionPopup()
		self:CloseBagPopup()
		self:HideSettingsPopup()
		self:CloseMatchmakingModal()
		self:CloseFindRoomModal()
		self:CloseCreateRoomModal()
		self:CloseProfileModal()
		local achPopup = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/PopupRoot")
		if achPopup ~= nil and isvalid(achPopup) then achPopup:SetEnable(false) end
		log("[LobbyController] CloseAllPopups")
	end

	method void OnPopupBackdropClicked(ButtonClickEvent event)
		-- Clicking the dim area outside any popup panel closes all popups.
		if self:IsPopupOpenGuardActive() then return end
		self:CloseAllPopups()
	end

	method boolean IsPopupOpenGuardActive()
		-- True for a beat right after a popup opens. Opening dims the lobby chrome and
		-- clears its BlocksRaycasts, so the very click that opened the popup would
		-- otherwise fall straight through the button onto the popup's own DimOverlay
		-- and close it again in the same gesture.
		return _UtilLogic.ElapsedSeconds < self.popupOpenGuardUntil
	end

	method void WireAchievementPopupDim()
		-- The achievement popup is owned by QAAchievementUI, which toggles its root's
		-- Enable directly — LobbyController never sees an Open/Close call it can hook.
		-- Watching EnabledInHierarchy instead catches every path (the popup's own close
		-- button, CloseAllPopups, ...) so the lobby dim can never get stuck on.
		if self.achievementPopupEnabledHandler ~= nil then return end
		if self.achievementPopupRoot == nil or isvalid(self.achievementPopupRoot) == false then
			log_warning("[LobbyController] achievement popup root not found for dim wiring")
			return
		end
		self.achievementPopupEnabledHandler = self.achievementPopupRoot:ConnectEvent(EntityEnabledInHierarchyChangedEvent, function(event)
			self:SetLobbyUIDimmed(event.EnabledInHierarchy)
			log("[LobbyController] achievement popup enabled=" .. tostring(event.EnabledInHierarchy))
		end)
		log("[LobbyController] achievement popup dim wired")
	end

	method void WirePopupBackdrops()
		-- Wires each popup's full-screen backdrop (dim) so a click outside the
		-- panel closes it. Guards against double-wiring. CreateRoom's dim is
		-- already wired to CloseCreateRoomModal, so it is omitted here.
		if self.popupBackdropHandlers ~= nil then return end
		self.popupBackdropHandlers = {}
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/"
		local paths = {
			base .. "ShopPopup/DimOverlay",
			base .. "FriendPopup/CloseBackdrop",
			base .. "AlertPopup/CloseBackdrop",
			base .. "CollectionPopup/DimOverlay",
			base .. "BagPopup/DimOverlay",
			base .. "SettingsPopup/CloseBackdrop",
			base .. "Matchmaking/Dimmer",
			base .. "PopupRoot/Dim",
			"/ui/UI_Lobby/LobbyRoot/ProfileSettingModalRoot/DimOverlay",
			"/ui/UI_InvestigationRoomSearch/CloseBackdrop",
		}
		for _, path in ipairs(paths) do
			local ent = _EntityService:GetEntityByPath(path)
			if ent ~= nil and isvalid(ent) then
				local h = ent:ConnectEvent(ButtonClickEvent, self.OnPopupBackdropClicked)
				self.popupBackdropHandlers[#self.popupBackdropHandlers + 1] = { entity = ent, eventHandler = h }
			else
				log_warning("[LobbyController] popup backdrop not found: " .. path)
			end
		end
		log("[LobbyController] popup backdrops wired = " .. tostring(#self.popupBackdropHandlers))
	end

	method void WireExternalPopupEvents()
		-- Wires close buttons for the lobby popup entities inside UI_Lobby.
		local ent
		
		if self.friendPopupCloseHandler == nil then
