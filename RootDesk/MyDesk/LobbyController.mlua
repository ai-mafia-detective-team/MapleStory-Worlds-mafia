		if self.roleNextHandler ~= nil then
			ent = _EntityService:GetEntityByPath(content .. "/RolePage/ListPanel/Pagination/NextBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.roleNextHandler) end
			self.roleNextHandler = nil
		end
		if self.costumePrevHandler ~= nil then
			ent = _EntityService:GetEntityByPath(content .. "/CostumePage/ListPanel/Pagination/PrevBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.costumePrevHandler) end
			self.costumePrevHandler = nil
