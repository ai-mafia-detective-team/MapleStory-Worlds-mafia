	end

	method table GetBagCategoryButtons()
		-- CategoryBar node name -> catalog category value.
		return {
			{ node = "Category_All",       category = "전체" },
			{ node = "Category_Top",       category = "상의" },
			{ node = "Category_Bottom",    category = "하의" },
			{ node = "Category_Shoes",     category = "신발" },
			{ node = "Category_Accessory", category = "장식" },
			{ node = "Category_Set",       category = "세트" },
		}
	end

	method table GetBagItems()
		-- The bag holds what the player actually owns: same catalog as the shop,
		-- filtered by ownership (MoneyManager keeps item.owned current) and category.
		local result = {}
		if _ShopController == nil or _ShopController.costumeData == nil then return result end
		for _, item in ipairs(_ShopController.costumeData) do
			if item.owned == true then
				if self.bagCategory == "전체" or item.category == self.bagCategory then
					result[#result + 1] = item
				end
			end
		end
		return result
	end

	method integer GetOwnedCostumeCount()
		-- Total owned, ignoring the category filter (used by the header counter).
		local count = 0
		if _ShopController == nil or _ShopController.costumeData == nil then return 0 end
		for _, item in ipairs(_ShopController.costumeData) do
			if item.owned == true then count = count + 1 end
		end
		return count
	end

	method void WireBagContentEvents()
		-- Slots, category bar, pagination arrows and the action bar.
		local bag = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel"
		
		if self.bagSlotHandlers == nil then
			self.bagSlotHandlers = {}
			for slot = 1, self.BAG_SLOT_COUNT do
				local name = "ItemSlot_0" .. tostring(slot)
				if slot >= 10 then name = "ItemSlot_" .. tostring(slot) end
				local ent = _EntityService:GetEntityByPath(bag .. "/Body/InventoryPanel/SlotGrid/" .. name)
				if ent ~= nil and isvalid(ent) then
					local capturedSlot = slot
					local h = ent:ConnectEvent(ButtonClickEvent, function() self:OnBagSlotClicked(capturedSlot) end)
					self.bagSlotHandlers[#self.bagSlotHandlers + 1] = { entity = ent, eventHandler = h }
				end
			end
		end
		
		if self.bagCategoryHandlers == nil then
			self.bagCategoryHandlers = {}
			for _, entry in ipairs(self:GetBagCategoryButtons()) do
				local ent = _EntityService:GetEntityByPath(bag .. "/CategoryBar/" .. entry.node)
				if ent ~= nil and isvalid(ent) then
					local capturedCategory = entry.category
					local h = ent:ConnectEvent(ButtonClickEvent, function() self:SelectBagCategory(capturedCategory) end)
					self.bagCategoryHandlers[#self.bagCategoryHandlers + 1] = { entity = ent, eventHandler = h }
				end
			end
		end
		
		if self.bagPrevHandler == nil then
			local ent = _EntityService:GetEntityByPath(bag .. "/Body/InventoryPanel/Pagination/PrevBtn")
			if ent ~= nil and isvalid(ent) then
				self.bagPrevHandler = ent:ConnectEvent(ButtonClickEvent, self.OnBagPagePrev)
			end
		end
		if self.bagNextHandler == nil then
			local ent = _EntityService:GetEntityByPath(bag .. "/Body/InventoryPanel/Pagination/NextBtn")
			if ent ~= nil and isvalid(ent) then
				self.bagNextHandler = ent:ConnectEvent(ButtonClickEvent, self.OnBagPageNext)
			end
		end
		
		-- Equip / Unequip / Reset are UI-only for now: the avatar equip pipeline is not built.
		if self.bagEquipHandler == nil then
			local ent = _EntityService:GetEntityByPath(bag .. "/ActionBar/EquipBtn")
			if ent ~= nil and isvalid(ent) then
				self.bagEquipHandler = ent:ConnectEvent(ButtonClickEvent, self.OnBagEquipClicked)
			end
		end
		if self.bagUnequipHandler == nil then
			local ent = _EntityService:GetEntityByPath(bag .. "/ActionBar/UnequipBtn")
			if ent ~= nil and isvalid(ent) then
				self.bagUnequipHandler = ent:ConnectEvent(ButtonClickEvent, self.OnBagEquipClicked)
			end
		end
		if self.bagResetHandler == nil then
			local ent = _EntityService:GetEntityByPath(bag .. "/ActionBar/ResetBtn")
			if ent ~= nil and isvalid(ent) then
				self.bagResetHandler = ent:ConnectEvent(ButtonClickEvent, self.OnBagEquipClicked)
			end
		end
		
		log("[BagPopup] content wired slots=" .. tostring(#self.bagSlotHandlers) ..
			" categories=" .. tostring(#self.bagCategoryHandlers))
	end

	method void SelectBagCategory(string category)
		-- Switch category; back to page 1 and drop the selection.
		self.bagCategory = category
		self.bagPage = 1
		self.selectedBagItemId = -1
		self:HighlightBagCategory(category)
		self:ClearBagDetail()
		self:RenderBagSlots()
		log("[BagPopup] category=" .. category)
	end

	method void HighlightBagCategory(string category)
		-- Swaps the category button background while preserving its label text.
		local bar = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel/CategoryBar"
		local white = Color(1.0, 1.0, 1.0, 1.0)
		for _, entry in ipairs(self:GetBagCategoryButtons()) do
			local ent = _EntityService:GetEntityByPath(bar .. "/" .. entry.node)
			if ent ~= nil and isvalid(ent) and ent.SpriteGUIRendererComponent ~= nil then
				if entry.category == category then
					ent.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CATEGORY_ACTIVE_RUID)
				else
					ent.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CATEGORY_INACTIVE_RUID)
				end
				ent.SpriteGUIRendererComponent.Color = white
			end
		end
	end

	method string GetBagSlotPath(integer slot)
		-- Slot nodes are ItemSlot_01..09 then ItemSlot_10..15.
		local grid = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel/Body/InventoryPanel/SlotGrid"
		if slot < 10 then return grid .. "/ItemSlot_0" .. tostring(slot) end
		return grid .. "/ItemSlot_" .. tostring(slot)
	end

	method void RenderBagSlots()
		-- Fills the 15 slots with the current category's page of owned costumes.
		local bag = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel"
		local items = self:GetBagItems()
		local pageSize = self.BAG_SLOT_COUNT
		local totalPages = 1
		if #items > 0 then totalPages = math.ceil(#items / pageSize) end
		if self.bagPage > totalPages then self.bagPage = totalPages end
		if self.bagPage < 1 then self.bagPage = 1 end
		
		local offset = (self.bagPage - 1) * pageSize
		for slot = 1, pageSize do
			local slotPath = self:GetBagSlotPath(slot)
			local slotEnt = _EntityService:GetEntityByPath(slotPath)
			if slotEnt ~= nil and isvalid(slotEnt) then
				local item = items[offset + slot]
				local filled = item ~= nil
		
				-- Empty slots keep their frame but show the empty overlay and no content.
				local empty = _EntityService:GetEntityByPath(slotPath .. "/EmptyOverlay")
				if empty ~= nil and isvalid(empty) then empty:SetEnable(not filled) end
		
				local image = _EntityService:GetEntityByPath(slotPath .. "/ItemImage")
				if image ~= nil and isvalid(image) then image:SetEnable(filled) end
		
				local grade = _EntityService:GetEntityByPath(slotPath .. "/GradeMarker")
				if grade ~= nil and isvalid(grade) then grade:SetEnable(filled) end
		
				local badge = _EntityService:GetEntityByPath(slotPath .. "/EquippedBadge")
				if badge ~= nil and isvalid(badge) then
					badge:SetEnable(filled and item.equipped == true)
				end
		
				local border = _EntityService:GetEntityByPath(slotPath .. "/SelectedBorder")
				if border ~= nil and isvalid(border) then
					border:SetEnable(filled and item.id == self.selectedBagItemId)
				end
			end
		end
		
		self:SetDetailText(bag .. "/Body/InventoryPanel/InventoryHeader/OwnedCountText",
			tostring(self:GetOwnedCostumeCount()) .. "개 보유")
		self:SetDetailText(bag .. "/Body/InventoryPanel/Pagination/PageText",
			tostring(self.bagPage) .. " / " .. tostring(totalPages))
		
		log("[BagPopup] slots rendered category=" .. self.bagCategory ..
			" page=" .. tostring(self.bagPage) .. "/" .. tostring(totalPages) ..
			" items=" .. tostring(#items))
	end

	method void OnBagSlotClicked(integer slot)
		-- `slot` is the 1..15 grid position; map it onto the filtered+paged list.
		local items = self:GetBagItems()
		local item = items[(self.bagPage - 1) * self.BAG_SLOT_COUNT + slot]
		if item == nil then return end
		self.selectedBagItemId = item.id
		self:ShowBagDetail(item)
		self:RenderBagSlots()
		log("[BagPopup] slot clicked slot=" .. tostring(slot) .. " id=" .. tostring(item.id))
	end

	method void ShowBagDetail(any item)
		-- Fills the right-hand DetailPanel and the action bar's selected-item label.
		local bag = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel"
		local detail = bag .. "/Body/DetailPanel"
		
		local empty = _EntityService:GetEntityByPath(detail .. "/EmptyState")
		if empty ~= nil and isvalid(empty) then empty:SetEnable(false) end
		
		self:SetDetailText(detail .. "/ItemNameText", item.name)
		self:SetDetailText(detail .. "/CategoryRow/CategoryText", item.category)
		self:SetDetailText(detail .. "/GradeRow/GradeText", item.grade)
		self:SetDetailText(detail .. "/DescriptionText", item.desc)
		if item.equipped == true then
			self:SetDetailText(detail .. "/EquippedStateText", "장착 중")
		else
			self:SetDetailText(detail .. "/EquippedStateText", "미장착")
		end
		
		self:SetDetailText(bag .. "/ActionBar/SelectedItemNameText", item.name)
	end

	method void ClearBagDetail()
		-- Back to the "pick an item" state.
		local bag = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel"
		local detail = bag .. "/Body/DetailPanel"
		
		local empty = _EntityService:GetEntityByPath(detail .. "/EmptyState")
		if empty ~= nil and isvalid(empty) then empty:SetEnable(true) end
		
		self:SetDetailText(detail .. "/ItemNameText", "")
		self:SetDetailText(detail .. "/CategoryRow/CategoryText", "")
		self:SetDetailText(detail .. "/GradeRow/GradeText", "")
		self:SetDetailText(detail .. "/DescriptionText", "")
		self:SetDetailText(detail .. "/EquippedStateText", "")
		self:SetDetailText(bag .. "/ActionBar/SelectedItemNameText", "의상을 선택하세요")
	end

	method void OnBagPagePrev(ButtonClickEvent event)
		if self.bagPage <= 1 then return end
		self.bagPage = self.bagPage - 1
		self:ClearBagDetail()
		self.selectedBagItemId = -1
		self:RenderBagSlots()
	end

	method void OnBagPageNext(ButtonClickEvent event)
		local items = self:GetBagItems()
		local totalPages = 1
		if #items > 0 then totalPages = math.ceil(#items / self.BAG_SLOT_COUNT) end
		if self.bagPage >= totalPages then return end
		self.bagPage = self.bagPage + 1
		self:ClearBagDetail()
		self.selectedBagItemId = -1
		self:RenderBagSlots()
	end

	method void OnBagEquipClicked(ButtonClickEvent event)
		-- The avatar equip pipeline (CostumeManagerComponent + item RUIDs) is not built yet.
		if _UIToast ~= nil then _UIToast:ShowMessage("착용 기능은 준비 중입니다.") end
		log("[BagPopup] equip action requested (not implemented)")
	end

	method void DisconnectBagPopupEvents()
		-- Disconnects BagPopup close-button handlers.
		local ent
		
		if self.bagSlotHandlers ~= nil then
			for _, rec in ipairs(self.bagSlotHandlers) do
				if rec.entity ~= nil and isvalid(rec.entity) then
					rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
				end
			end
			self.bagSlotHandlers = nil
		end
		
		if self.bagCategoryHandlers ~= nil then
			for _, rec in ipairs(self.bagCategoryHandlers) do
				if rec.entity ~= nil and isvalid(rec.entity) then
					rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
				end
			end
			self.bagCategoryHandlers = nil
		end
		
		-- NOTE: `handler` is a reserved word in mlua and cannot be used as a table key.
		local bagPanel = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel"
		local singleHandlers = {
			{ eventHandler = self.bagPrevHandler,    path = bagPanel .. "/Body/InventoryPanel/Pagination/PrevBtn" },
			{ eventHandler = self.bagNextHandler,    path = bagPanel .. "/Body/InventoryPanel/Pagination/NextBtn" },
			{ eventHandler = self.bagEquipHandler,   path = bagPanel .. "/ActionBar/EquipBtn" },
			{ eventHandler = self.bagUnequipHandler, path = bagPanel .. "/ActionBar/UnequipBtn" },
			{ eventHandler = self.bagResetHandler,   path = bagPanel .. "/ActionBar/ResetBtn" },
		}
		for _, rec in ipairs(singleHandlers) do
			if rec.eventHandler ~= nil then
				ent = _EntityService:GetEntityByPath(rec.path)
				if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, rec.eventHandler) end
			end
		end
		self.bagPrevHandler = nil
		self.bagNextHandler = nil
		self.bagEquipHandler = nil
		self.bagUnequipHandler = nil
		self.bagResetHandler = nil
		
		if self.bagPopupCloseHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel/Header/CloseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.bagPopupCloseHandler) end
			self.bagPopupCloseHandler = nil
		end
		
		if self.bagPopupBottomCloseHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/BagPopup/Panel/ActionBar/BottomCloseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.bagPopupBottomCloseHandler) end
			self.bagPopupBottomCloseHandler = nil
		end
	end

	method void DisconnectExternalPopupEvents()
		-- Disconnects close-button handlers attached by WireExternalPopupEvents.
		local ent
		
		if self.friendPopupCloseHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/FriendPopup/Panel/Header/CloseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.friendPopupCloseHandler) end
			self.friendPopupCloseHandler = nil
		end
		
		if self.friendAddHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/FriendPopup/Panel/AddRow/AddBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.friendAddHandler) end
			self.friendAddHandler = nil
		end
		
		if self.friendTabFriendsHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/FriendPopup/Panel/TabFriends")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.friendTabFriendsHandler) end
			self.friendTabFriendsHandler = nil
		end
		
		if self.friendTabRequestsHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/FriendPopup/Panel/TabRequests")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.friendTabRequestsHandler) end
			self.friendTabRequestsHandler = nil
		end
		self:ClearFriendRows()
		
		if self.shopPopupCloseHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/ShopPopup/Panel/Header/CloseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.shopPopupCloseHandler) end
			self.shopPopupCloseHandler = nil
		end
		
		if self.shopPopupCancelHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/ShopPopup/Panel/PurchaseBar/BottomCloseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.shopPopupCancelHandler) end
			self.shopPopupCancelHandler = nil
		end
		
		if self.alertPopupCloseHandler ~= nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/AlertPopup/Panel/Header/CloseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.alertPopupCloseHandler) end
			self.alertPopupCloseHandler = nil
		end
	end

	method void RefreshFriendPopup()
		-- Requests the latest server-owned friend data for the open popup.
		if self.friendFriends == nil then self.friendFriends = {} end
		if self.friendRequests == nil then self.friendRequests = {} end
		if self.friendRows == nil then self.friendRows = {} end
		self:RenderFriendRows()
		if _FriendManager ~= nil then
			_FriendManager:RequestFriendData(self.currentProfileNickname)
			log("[FriendUI] refresh requested nickname=" .. self.currentProfileNickname)
		else
			log_warning("[FriendUI] FriendManager unavailable")
		end
	end

	method void OnFriendAddClicked(ButtonClickEvent event)
		-- Sends a request using the nickname entered in the friend popup.
		local nickname = ""
		if self.friendNicknameInput ~= nil then
			nickname = string.match(self.friendNicknameInput.Text or "", "^%s*(.-)%s*$") or ""
		end
		if nickname == "" then
			_UIToast:ShowMessage("친구 닉네임을 입력해 주세요.")
			return
		end
		if _FriendManager ~= nil then
			_FriendManager:RequestSendFriendRequest(nickname)
			log("[FriendUI] add requested nickname=" .. nickname)
		end
	end

	method void OnFriendTabFriendsClicked(ButtonClickEvent event)
		-- Switches the popup to the accepted-friends list.
		self.friendSelectedTab = 1
		self:RenderFriendRows()
		log("[FriendUI] friends tab selected")
	end

	method void OnFriendTabRequestsClicked(ButtonClickEvent event)
		-- Switches the popup to the incoming-request list.
		self.friendSelectedTab = 2
		self:RenderFriendRows()
		log("[FriendUI] requests tab selected")
	end

	method void ApplyFriendData(string friendsJson, string requestsJson, string message, boolean isError)
		-- Applies a server response and redraws the currently selected tab.
		self.friendFriends = _HttpService:JSONDecode(friendsJson or "[]")
		self.friendRequests = _HttpService:JSONDecode(requestsJson or "[]")
		if self.friendFriends == nil then self.friendFriends = {} end
		if self.friendRequests == nil then self.friendRequests = {} end
		self:RenderFriendRows()
		if self.friendNicknameInput ~= nil and isError == false then
			self.friendNicknameInput.Text = ""
		end
		if message ~= nil and message ~= "" then
			_UIToast:ShowMessage(message)
		end
		if isError then
			log_warning("[FriendUI] response error message=" .. tostring(message))
		else
			log("[FriendUI] data applied friends=" .. tostring(#self.friendFriends) .. " requests=" .. tostring(#self.friendRequests))
		end
	end

	method void ClearFriendRows()
		-- Disconnects dynamic row events and destroys cloned row entities.
		if self.friendRows == nil then
			self.friendRows = {}
			return
		end
		for _, row in ipairs(self.friendRows) do
			for _, link in ipairs(row.eventHandlers or {}) do
				if link.buttonEntity ~= nil and isvalid(link.buttonEntity) and link.eventHandler ~= nil then
					link.buttonEntity:DisconnectEvent(ButtonClickEvent, link.eventHandler)
				end
			end
			if row.root ~= nil and isvalid(row.root) then row.root:Destroy() end
		end
		self.friendRows = {}
	end

	method void ConfigureFriendRow(Entity row, table item, boolean requestRow)
		-- Populates one cloned row and wires its action buttons.
		local nameEntity = row:GetChildByName("Name", false)
		if nameEntity ~= nil and nameEntity.TextComponent ~= nil then
			nameEntity.TextComponent.Text = tostring(item.nickname or "수사관")
		end
		local eventHandlers = {}
		local userId = tostring(item.userId or "")
		if requestRow then
			local acceptEntity = row:GetChildByName("Accept", false)
			local rejectEntity = row:GetChildByName("Reject", false)
			if acceptEntity ~= nil and isvalid(acceptEntity) then
				local acceptHandler = acceptEntity:ConnectEvent(ButtonClickEvent, function(evt)
					if _FriendManager ~= nil then _FriendManager:RequestAcceptFriend(userId) end
					log("[FriendUI] accept requested userId=" .. userId)
				end)
				table.insert(eventHandlers, { buttonEntity = acceptEntity, eventHandler = acceptHandler })
			end
			if rejectEntity ~= nil and isvalid(rejectEntity) then
				local rejectHandler = rejectEntity:ConnectEvent(ButtonClickEvent, function(evt)
					if _FriendManager ~= nil then _FriendManager:RequestRejectFriend(userId) end
					log("[FriendUI] reject requested userId=" .. userId)
				end)
				table.insert(eventHandlers, { buttonEntity = rejectEntity, eventHandler = rejectHandler })
			end
		else
			local statusEntity = row:GetChildByName("Status", false)
			if statusEntity ~= nil and statusEntity.TextComponent ~= nil then
				statusEntity.TextComponent.Text = item.online == true and "온라인" or "오프라인"
			end
			local removeEntity = row:GetChildByName("Remove", false)
			if removeEntity ~= nil and isvalid(removeEntity) then
				local removeHandler = removeEntity:ConnectEvent(ButtonClickEvent, function(evt)
					if _FriendManager ~= nil then _FriendManager:RequestDeleteFriend(userId) end
					log("[FriendUI] delete requested userId=" .. userId)
				end)
				table.insert(eventHandlers, { buttonEntity = removeEntity, eventHandler = removeHandler })
			end
		end
		table.insert(self.friendRows, { root = row, eventHandlers = eventHandlers })
	end

	method void CreateEmptyFriendRow(Entity template, boolean requestRow)
		-- Creates a non-interactive row when the selected list is empty.
		local row = template:Clone(requestRow and "EmptyRequestRow" or "EmptyFriendRow")
		row:SetEnable(true)
		local nameEntity = row:GetChildByName("Name", false)
		if nameEntity ~= nil and nameEntity.TextComponent ~= nil then
			nameEntity.TextComponent.Text = requestRow and "받은 친구 요청이 없습니다." or "등록된 친구가 없습니다."
		end
		local buttons = { "Remove", "Status", "Accept", "Reject" }
		for _, childName in ipairs(buttons) do
			local child = row:GetChildByName(childName, false)
			if child ~= nil then child:SetEnable(false) end
		end
		table.insert(self.friendRows, { root = row, eventHandlers = {} })
	end

	method void RenderFriendRows()
		-- Rebuilds the scroll list from the active tab's cached data.
		self:ClearFriendRows()
		local base = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/FriendPopup/Panel/FriendList"
		local friendTemplate = _EntityService:GetEntityByPath(base .. "/Item")
		local requestTemplate = _EntityService:GetEntityByPath(base .. "/ReqItem")
		if friendTemplate == nil or requestTemplate == nil then
			log_warning("[FriendUI] row templates missing")
			return
		end
		friendTemplate:SetEnable(false)
		requestTemplate:SetEnable(false)
		local requestRow = self.friendSelectedTab == 2
		local source = requestRow and self.friendRequests or self.friendFriends
		if source == nil then source = {} end
		local template = requestRow and requestTemplate or friendTemplate
		if #source == 0 then
			self:CreateEmptyFriendRow(template, requestRow)
		else
			for index, item in ipairs(source) do
				local rowName = requestRow and ("RequestRow_" .. tostring(index)) or ("FriendRow_" .. tostring(index))
				local row = template:Clone(rowName)
				row:SetEnable(true)
				self:ConfigureFriendRow(row, item, requestRow)
			end
		end
		local listEntity = _EntityService:GetEntityByPath(base)
		if listEntity ~= nil and listEntity.ScrollLayoutGroupComponent ~= nil then
			listEntity.ScrollLayoutGroupComponent:ResetScrollPosition(UITransformAxis.Vertical)
		end
		log("[FriendUI] rows rendered tab=" .. tostring(self.friendSelectedTab) .. " count=" .. tostring(#source))
	end

	method void WireButtonEvents()
		-- Wires the active lobby UI: profile elements live under LobbyRoot, buttons live under ButtonGroup.
		local base = "/ui/UI_Lobby/LobbyRoot"
		local buttonBase = base .. "/ButtonGroup"
		local ent
		
		ent = self.profileButtonEntity
		if ent == nil or isvalid(ent) == false then
			ent = _EntityService:GetEntityByPath(base .. "/ProfileRoot/ProfileButton")
		end
		if ent ~= nil and isvalid(ent) then
			self.btnProfileHandler = ent:ConnectEvent(ButtonClickEvent, self.OnProfileClicked)
		end
		
		ent = _EntityService:GetEntityByPath(buttonBase .. "/친구")
