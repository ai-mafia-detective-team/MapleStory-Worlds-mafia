			{ name = "초보 수사관 환영!",      mode = "기본 수사", players = "4/8",  isPrivate = false, host = "추리왕",         status = "입장" },
			{ name = "진지하게 수사하실 분",   mode = "심화 수사", players = "7/10", isPrivate = true,  host = "설록K",          status = "입장" },
			{ name = "즐겜 방 ~",              mode = "기본 수사", players = "3/8",  isPrivate = false, host = "유령단서",       status = "입장" },
			{ name = "고수만 입장 가능",       mode = "심화 수사", players = "8/10", isPrivate = true,  host = "마스터K",        status = "입장" },
			{ name = "수다 금지! 집중 수사",   mode = "기본 수사", players = "5/8",  isPrivate = false, host = "냉정한분석가",   status = "입장" },
