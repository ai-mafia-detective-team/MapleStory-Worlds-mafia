	method any EnsureAchievementUI()
		-- The Controller entity is a model instance (uiempty), and a script component declared
		-- on a model instance in the .ui is not created at load — GetComponent returns nil, so
		-- QAAchievementUI:OnBeginPlay never runs and the popup it would have closed stays on
		-- screen covering the lobby. Attach it here instead (the MSW-sanctioned pattern:
		-- keep the model native-only, add the script at runtime).
		local controllerEntity = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/Controller")
		if controllerEntity == nil or isvalid(controllerEntity) == false then
			log_warning("[LobbyController] Achievement popup controller not found")
			return nil
		end
		
		local achievementUI = controllerEntity:GetComponent("script.QAAchievementUI")
		if achievementUI == nil then
			controllerEntity:AddComponent("script.QAAchievementUI")
			achievementUI = controllerEntity:GetComponent("script.QAAchievementUI")
			log("[LobbyController] QAAchievementUI attached at runtime = " .. tostring(achievementUI ~= nil))
		end
		return achievementUI
	end

	method void OnAchievementClicked(ButtonClickEvent event)
		log("[LobbyController] AchievementButton clicked")
		local achievementUI = self:EnsureAchievementUI()
		if achievementUI == nil then
			self:ShowCommonPopup("error", "업적 창을 열 수 없습니다.")
			return
		end
		achievementUI:Open()
	end

