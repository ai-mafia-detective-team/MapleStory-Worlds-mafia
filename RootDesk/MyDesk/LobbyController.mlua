		local friendInputEntity = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/FriendPopup/Panel/AddRow/NickInput")
		if friendInputEntity ~= nil and isvalid(friendInputEntity) then
			self.friendNicknameInput = friendInputEntity.TextInputComponent
