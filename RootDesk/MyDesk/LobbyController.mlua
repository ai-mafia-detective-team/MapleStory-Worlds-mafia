			ent = _EntityService:GetEntityByPath(content .. "/CostumePage/ListPanel/Pagination/NextBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.costumeNextHandler) end
			self.costumeNextHandler = nil
