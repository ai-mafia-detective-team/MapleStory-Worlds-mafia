	method void DisconnectCollectionPopupEvents()
		-- Disconnects CollectionPopup close-button and role-card handlers.
		local ent
		
		if self.roleCardHandlers ~= nil then
			for _, rec in ipairs(self.roleCardHandlers) do
				if rec.entity ~= nil and isvalid(rec.entity) then
					rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
				end
			end
			self.roleCardHandlers = nil
		end
		
		if self.costumeCardHandlers ~= nil then
			for _, rec in ipairs(self.costumeCardHandlers) do
				if rec.entity ~= nil and isvalid(rec.entity) then
					rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
				end
			end
			self.costumeCardHandlers = nil
		end
		
		if self.costumeCategoryHandlers ~= nil then
			for _, rec in ipairs(self.costumeCategoryHandlers) do
				if rec.entity ~= nil and isvalid(rec.entity) then
					rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
				end
			end
			self.costumeCategoryHandlers = nil
		end
		
		local nav = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/NavigationPanel"
		if self.collectionTabRoleHandler ~= nil then
			ent = _EntityService:GetEntityByPath(nav .. "/Tab_Role")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.collectionTabRoleHandler) end
			self.collectionTabRoleHandler = nil
		end
		
		if self.collectionTabCostumeHandler ~= nil then
			ent = _EntityService:GetEntityByPath(nav .. "/Tab_Costume")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.collectionTabCostumeHandler) end
			self.collectionTabCostumeHandler = nil
		end
		
		local content = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot"
		if self.rolePrevHandler ~= nil then
			ent = _EntityService:GetEntityByPath(content .. "/RolePage/ListPanel/Pagination/PrevBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.rolePrevHandler) end
			self.rolePrevHandler = nil
