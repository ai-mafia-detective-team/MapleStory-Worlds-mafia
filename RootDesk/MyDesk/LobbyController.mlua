		if self.btnSettingsSoundTabHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/TabBar/TabSound")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnSettingsSoundTabHandler) end
			self.btnSettingsSoundTabHandler = nil
		end
		if self.btnSettingsMuteHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/ContentSound/MuteBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnSettingsMuteHandler) end
			self.btnSettingsMuteHandler = nil
		end
		if self.btnMatchCancelHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/Matchmaking/Box/CancelBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnMatchCancelHandler) end
			self.btnMatchCancelHandler = nil
