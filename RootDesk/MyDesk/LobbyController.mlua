		if self.collectionPopupBottomCloseHandler == nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/BottomBar/BottomCloseBtn")
			if ent ~= nil and isvalid(ent) then
				self.collectionPopupBottomCloseHandler = ent:ConnectEvent(ButtonClickEvent, self.OnCollectionPopupCloseClicked)
