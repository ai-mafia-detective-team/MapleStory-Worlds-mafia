			self.btnBagHandler = ent:ConnectEvent(ButtonClickEvent, self.OnBagClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/업적")
		if ent ~= nil and isvalid(ent) then
			self.btnAchievementHandler = ent:ConnectEvent(ButtonClickEvent, self.OnAchievementClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/start")
		if ent ~= nil and isvalid(ent) then
			self.btnStartHandler = ent:ConnectEvent(ButtonClickEvent, self.OnStartClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/방만들기")
		if ent ~= nil and isvalid(ent) then
			self.btnCreateHandler = ent:ConnectEvent(ButtonClickEvent, self.OnCreateRoomClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/찾기")
		if ent ~= nil and isvalid(ent) then
			self.btnFindHandler = ent:ConnectEvent(ButtonClickEvent, self.OnFindRoomClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/상점")
		if ent ~= nil and isvalid(ent) then
			self.btnShopHandler = ent:ConnectEvent(ButtonClickEvent, self.OnShopClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/알림")
		if ent ~= nil and isvalid(ent) then
			self.btnAlertHandler = ent:ConnectEvent(ButtonClickEvent, self.OnAlertClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/설정")
		if ent ~= nil and isvalid(ent) then
			self.btnSettingsHandler = ent:ConnectEvent(ButtonClickEvent, self.OnSettingsClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/Header/CloseBtn")
		if ent ~= nil and isvalid(ent) then
			self.btnSettingsCloseHandler = ent:ConnectEvent(ButtonClickEvent, self.OnSettingsCloseClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/TabBar/TabInfo")
		if ent ~= nil and isvalid(ent) then
			self.btnSettingsInfoTabHandler = ent:ConnectEvent(ButtonClickEvent, self.OnSettingsInfoTabClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/TabBar/TabSound")
		if ent ~= nil and isvalid(ent) then
			self.btnSettingsSoundTabHandler = ent:ConnectEvent(ButtonClickEvent, self.OnSettingsSoundTabClicked)
		end
		ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/ContentSound/MuteBtn")
		if ent ~= nil and isvalid(ent) then
			self.btnSettingsMuteHandler = ent:ConnectEvent(ButtonClickEvent, self.OnSettingsMuteClicked)
		end
		self:WireExternalPopupEvents()
		self:WireCollectionPopupEvents()
		self:WireBagPopupEvents()
		self:WireUnderDevelopmentPopupEvents()
		ent = _EntityService:GetEntityByPath(buttonBase .. "/Matchmaking/Box/CancelBtn")
		if ent ~= nil and isvalid(ent) then
			self.btnMatchCancelHandler = ent:ConnectEvent(ButtonClickEvent, self.OnMatchmakingCancelClicked)
		end
		
		if self.btnFindHandler == nil then
			ent = self.findRoomButtonEntity
			if ent ~= nil and isvalid(ent) then
				self.btnFindHandler = ent:ConnectEvent(ButtonClickEvent, self.OnFindRoomClicked)
				log("[LobbyController] FindRoomButton wired by uuid")
			end
		end
		
		log("[LobbyController] ButtonGroup events wired")
	end

	method void WireInvestigationRoomSearchEvents()
		-- Use the existing room-search UI group only. Do not create an extra lobby modal.
		if self.searchButtonHandlers ~= nil then return end
		
		self.searchButtonHandlers = {}
		self:SetInvestigationRoomSearchVisible(false)
		
		self:ConnectInvestigationSearchButton("Close", "/ui/UI_InvestigationRoomSearch/SearchRoot/CloseButton")
		self:ConnectInvestigationSearchButton("ModeFilter", "/ui/UI_InvestigationRoomSearch/SearchRoot/FilterBar/ModeFilterButton")
		self:ConnectInvestigationSearchButton("StatusFilter", "/ui/UI_InvestigationRoomSearch/SearchRoot/FilterBar/StatusFilterButton")
		self:ConnectInvestigationSearchButton("HidePasswordRoom", "/ui/UI_InvestigationRoomSearch/SearchRoot/FilterBar/HidePasswordCheckbox")
		self:ConnectInvestigationSearchButton("Refresh", "/ui/UI_InvestigationRoomSearch/SearchRoot/FilterBar/RefreshButton")
		self:ConnectInvestigationSearchButton("PagePrev", "/ui/UI_InvestigationRoomSearch/SearchRoot/PagingPanel/PagePrevButton")
		self:ConnectInvestigationSearchButton("PageNext", "/ui/UI_InvestigationRoomSearch/SearchRoot/PagingPanel/PageNextButton")
		self:ConnectInvestigationSearchButton("QuickJoin", "/ui/UI_InvestigationRoomSearch/SearchRoot/CreateRoomButton")
		self:ConnectInvestigationSearchButton("Cancel", "/ui/UI_InvestigationRoomSearch/SearchRoot/EnterRoomCodeButton")
		
		for i = 1, 8 do
			self:ConnectInvestigationSearchButton("RoomRow" .. tostring(i), "/ui/UI_InvestigationRoomSearch/SearchRoot/RoomListPanel/RoomRowContainer/RoomRow_" .. tostring(i))
			self:ConnectInvestigationSearchButton("JoinRoom" .. tostring(i), "/ui/UI_InvestigationRoomSearch/SearchRoot/RoomListPanel/RoomRowContainer/RoomRow_" .. tostring(i) .. "/RoomStatusText")
		end
		local searchInput = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch/SearchRoot/SearchInput")
		if searchInput ~= nil and isvalid(searchInput) and searchInput.TextInputComponent ~= nil then
			self.findRoomSearchInputHandler = searchInput:ConnectEvent(TextInputValueChangeEvent, function(evt)
				self.findRoomSearchKeyword = searchInput.TextInputComponent.Text or ""
				self.findRoomCurrentPage = 1
				self:ApplyRoomFilters()
			end)
		end
		log("[InvestigationRoomSearch] Button events wired")
	end

	method void WireFindRoomModalEvents()
		self:WireInvestigationRoomSearchEvents()
	end

	method void SetInvestigationRoomSearchVisible(boolean visible)
		-- Keep the standalone UIGroup alive and toggle only its child entities.
		-- Disabling the UIGroup root can leave it non-rendering after SetEnable(true).
		local searchGroup = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch")
		local searchRoot = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch/SearchRoot")
		-- Full-screen outside-click backdrop: kept disabled until the search opens so
		-- it never covers (and blocks) the intro/other screens.
		local searchBackdrop = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch/CloseBackdrop")
		if searchGroup ~= nil and isvalid(searchGroup) then searchGroup:SetEnable(true) end
		if visible then
			if searchRoot ~= nil and isvalid(searchRoot) then searchRoot:SetEnable(true) end
			if searchBackdrop ~= nil and isvalid(searchBackdrop) then searchBackdrop:SetEnable(true) end
			-- The published client may not repaint children enabled inside an already-shown
			-- group; a sibling reorder forces it (same convention as the lobby modals).
			if searchRoot ~= nil and isvalid(searchRoot) and searchRoot.UITransformComponent ~= nil then
				_UILogic:SetSiblingIndex(searchRoot.UITransformComponent, 1000000)
			end
		else
			if searchBackdrop ~= nil and isvalid(searchBackdrop) then searchBackdrop:SetEnable(false) end
			if searchRoot ~= nil and isvalid(searchRoot) then searchRoot:SetEnable(false) end
		end
		log("[InvestigationRoomSearch] visible=" .. tostring(visible))
	end

	method void SetProfileModalVisible(boolean visible)
		-- Keep the profile modal UIGroup root alive and toggle only its child entities.
		-- Disabling the UIGroup root can leave it non-rendering after SetEnable(true) (MSW 26.7).
		local modal = self.modalGroup
		if modal ~= nil and isvalid(modal) then modal:SetEnable(true) end
		local dim = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ProfileSettingModalRoot/DimOverlay")
		local panel = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ProfileSettingModalRoot/ModalPanel")
		if visible then
			if dim ~= nil and isvalid(dim) then dim:SetEnable(true) end
			if panel ~= nil and isvalid(panel) then panel:SetEnable(true) end
			-- Maker save renormalizes authored displayOrder, so force the modal above its
			-- siblings at open time instead of relying on the .ui value (same convention
			-- as SetCreateRoomModalVisible).
			if modal ~= nil and isvalid(modal) and modal.UITransformComponent ~= nil then
				_UILogic:SetSiblingIndex(modal.UITransformComponent, 1000000)
			end
		else
			if panel ~= nil and isvalid(panel) then panel:SetEnable(false) end
			if dim ~= nil and isvalid(dim) then dim:SetEnable(false) end
		end
		log("[ProfileModal] visible=" .. tostring(visible))
	end

	method void SetFindRoomModalVisible(boolean visible)
		self:SetInvestigationRoomSearchVisible(visible)
	end

	method void ConnectInvestigationSearchButton(string logName, string path)
		local ent = _EntityService:GetEntityByPath(path)
		if ent == nil or not isvalid(ent) then
			log_warning("[InvestigationRoomSearch] Missing button: " .. logName)
			return
		end
		
		local eventHandler = ent:ConnectEvent(ButtonClickEvent, function(evt)
			self:OnInvestigationSearchClicked(logName)
		end)
		table.insert(self.searchButtonHandlers, { Target = ent, EventHandler = eventHandler })
	end

	method void ConnectFindRoomButton(string logName, string path)
		self:ConnectInvestigationSearchButton(logName, path)
	end

	method void OnInvestigationSearchClicked(string logName)
		if logName == "Close" or logName == "Cancel" then
			self:CloseFindRoomModal()
			return
		end
		if logName == "Refresh" then
			self:RefreshRoomList()
			return
		end
		if logName == "QuickJoin" then
			self:QuickJoinRoom()
			return
		end
		if logName == "ModeFilter" then
			self:CycleFindRoomModeFilter()
			return
		end
		if logName == "StatusFilter" then
			self:CycleFindRoomStatusFilter()
			return
		end
		if logName == "HidePasswordRoom" then
			self.findRoomHidePrivate = not self.findRoomHidePrivate
			self:UpdateFindRoomFilterLabels()
			self:ApplyRoomFilters()
			return
		end
		if logName == "PagePrev" then
			if self.findRoomCurrentPage > 1 then
				self.findRoomCurrentPage -= 1
				self:RenderFindRoomList()
			end
			return
		end
		if logName == "PageNext" then
			if self.findRoomCurrentPage < self.findRoomTotalPages then
				self.findRoomCurrentPage += 1
				self:RenderFindRoomList()
			end
			return
		end
		
		local joinPrefix = "JoinRoom"
		local joinPrefixLen = string.len(joinPrefix)
		if string.len(logName) > joinPrefixLen and string.sub(logName, 1, joinPrefixLen) == joinPrefix then
			local index = tonumber(string.sub(logName, joinPrefixLen + 1))
			if index ~= nil then
				self:SelectRoom(index)
				self:JoinSelectedRoom()
				return
			end
		end
		
		local rowPrefix = "RoomRow"
		local prefixLen = string.len(rowPrefix)
		if string.len(logName) > prefixLen and string.sub(logName, 1, prefixLen) == rowPrefix then
			local index = tonumber(string.sub(logName, prefixLen + 1))
			if index ~= nil then
				self:SelectRoom(index)
				return
			end
		end
		log("[InvestigationRoomSearch] " .. logName .. " clicked")
	end

	method void OnFindRoomModalClicked(string logName)
		self:OnInvestigationSearchClicked(logName)
	end

	method void DisconnectInvestigationRoomSearchEvents()
		if self.searchButtonHandlers ~= nil then
			for _, record in ipairs(self.searchButtonHandlers) do
				if record.Target ~= nil and isvalid(record.Target) and record.EventHandler ~= nil then
					record.Target:DisconnectEvent(ButtonClickEvent, record.EventHandler)
				end
			end
			self.searchButtonHandlers = nil
		end
		local searchInput = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch/SearchRoot/SearchInput")
		if self.findRoomSearchInputHandler ~= nil and searchInput ~= nil and isvalid(searchInput) then
			searchInput:DisconnectEvent(TextInputValueChangeEvent, self.findRoomSearchInputHandler)
		end
		self.findRoomSearchInputHandler = nil
	end

	method void DisconnectFindRoomModalEvents()
		self:DisconnectInvestigationRoomSearchEvents()
	end

	method void LegacyOpenFindRoomModal()
		if self.findRoomModalOpen then return end
		self.findRoomModalOpen = true
		self.findRoomSelectedIndex = 0
		self:WireInvestigationRoomSearchEvents()
		local searchRoot = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch/SearchRoot")
		if searchRoot == nil or not isvalid(searchRoot) then
			log_warning("[FindRoomModal] SearchRoot not found")
			return
		end
		self:SetInvestigationRoomSearchVisible(true)
		self:RefreshRoomList()
		self:UpdateFindRoomPageText()
		log("[FindRoomModal] open")
	end

	method void LegacyCloseFindRoomModal()
		local wasOpen = self.findRoomModalOpen
		self.findRoomModalOpen = false
		self.findRoomSelectedIndex = 0
		self:SetInvestigationRoomSearchVisible(false)
		if wasOpen then
			log("[FindRoomModal] close")
		end
	end

