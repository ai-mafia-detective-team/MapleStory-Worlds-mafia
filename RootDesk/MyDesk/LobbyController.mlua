	method void ApplyProfileImage(string ruid)
		-- Updates ProfileAvatar sprite to display the given RUID image.
		log("[LobbyController] ApplyProfileImage ruid=" .. ruid)
		self.selectedProfileRuid = ruid
		local avatar = self.profileAvatarSprite
		if avatar == nil or isvalid(avatar) == false then
			local ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ProfileRoot/ProfileAvatarClip/ProfileImage")
			if ent ~= nil and isvalid(ent) then
				avatar = ent
			end
		end
		if avatar ~= nil and isvalid(avatar) then
			local spriteComp = avatar.SpriteGUIRendererComponent
			if spriteComp ~= nil then
				spriteComp.ImageRUID = DataRef(ruid)
				log("[LobbyController] ProfileAvatar image updated ruid=" .. ruid)
			else
				log_warning("[LobbyController] ProfileAvatar SpriteGUIRendererComponent not found")
			end
		else
			log_warning("[LobbyController] ProfileAvatar entity not found")
		end
		self:UpdateSelectedIndicators()
	end

	method void OpenProfileModal()
		-- Shows the profile selection modal and wires slot/close/dim click handlers.
		if self.profileModalOpen then return end
		log("[LobbyController] OpenProfileModal")
		self.profileModalOpen = true
		self:SetLobbyAvatarAreaVisible(false)
		self:SetAvatarNameTextVisible(false)
		_ProfileStorageLogic:RequestLoadAllProfile()
		local modal = self.modalGroup
		if modal ~= nil and isvalid(modal) then
			modal.Enable = true
		end
		self:RefreshProfileModalFields()
		self:UpdateSelectedIndicators()
		-- Wire slot buttons
		if self.btnProfileSlot1 ~= nil and isvalid(self.btnProfileSlot1) then
			self.btnProfileSlot1Handler = self.btnProfileSlot1.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:SelectProfileSlot(self.RUID_PROFILE_1)
			end)
		end
		if self.btnProfileSlot2 ~= nil and isvalid(self.btnProfileSlot2) then
			self.btnProfileSlot2Handler = self.btnProfileSlot2.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:SelectProfileSlot(self.RUID_PROFILE_2)
			end)
		end
		if self.btnProfileSlot3 ~= nil and isvalid(self.btnProfileSlot3) then
			self.btnProfileSlot3Handler = self.btnProfileSlot3.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:SelectProfileSlot(self.RUID_PROFILE_3)
			end)
		end
		if self.btnProfileSlot4 ~= nil and isvalid(self.btnProfileSlot4) then
			self.btnProfileSlot4Handler = self.btnProfileSlot4.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:SelectProfileSlot(self.RUID_PROFILE_4)
			end)
		end
		if self.btnProfileModalClose ~= nil and isvalid(self.btnProfileModalClose) then
			self.btnProfileModalCloseHandler = self.btnProfileModalClose.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseProfileModal()
			end)
		end
		if self.btnProfileModalSave ~= nil and isvalid(self.btnProfileModalSave) then
			self.btnProfileModalSaveHandler = self.btnProfileModalSave.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:SaveProfileModal()
			end)
		end
		if self.btnProfileModalCancel ~= nil and isvalid(self.btnProfileModalCancel) then
			self.btnProfileModalCancelHandler = self.btnProfileModalCancel.Entity:ConnectEvent(ButtonClickEvent, function(evt)
				self:CloseProfileModal()
			end)
		end
		if self.modalDimOverlay ~= nil and isvalid(self.modalDimOverlay) then
			local dimBtn = self.modalDimOverlay.ButtonComponent
			if dimBtn ~= nil then
				self.dimOverlayHandler = self.modalDimOverlay:ConnectEvent(ButtonClickEvent, function(evt)
					self:CloseProfileModal()
				end)
			end
		end
		log("[LobbyController] ProfileModal opened handlers wired")
	end

	method void CloseProfileModal()
		-- Hides the profile selection modal and disconnects all modal event handlers.
		if self.profileModalOpen == false then return end
		log("[LobbyController] CloseProfileModal")
		self.profileModalOpen = false
		self:SetLobbyAvatarAreaVisible(true)
		self:SetAvatarNameTextVisible(true)
		if self.btnProfileSlot1Handler ~= nil and self.btnProfileSlot1 ~= nil and isvalid(self.btnProfileSlot1) then
			self.btnProfileSlot1.Entity:DisconnectEvent(ButtonClickEvent, self.btnProfileSlot1Handler)
			self.btnProfileSlot1Handler = nil
		end
		if self.btnProfileSlot2Handler ~= nil and self.btnProfileSlot2 ~= nil and isvalid(self.btnProfileSlot2) then
			self.btnProfileSlot2.Entity:DisconnectEvent(ButtonClickEvent, self.btnProfileSlot2Handler)
			self.btnProfileSlot2Handler = nil
		end
		if self.btnProfileSlot3Handler ~= nil and self.btnProfileSlot3 ~= nil and isvalid(self.btnProfileSlot3) then
			self.btnProfileSlot3.Entity:DisconnectEvent(ButtonClickEvent, self.btnProfileSlot3Handler)
			self.btnProfileSlot3Handler = nil
		end
		if self.btnProfileSlot4Handler ~= nil and self.btnProfileSlot4 ~= nil and isvalid(self.btnProfileSlot4) then
			self.btnProfileSlot4.Entity:DisconnectEvent(ButtonClickEvent, self.btnProfileSlot4Handler)
			self.btnProfileSlot4Handler = nil
		end
		if self.btnProfileModalCloseHandler ~= nil and self.btnProfileModalClose ~= nil and isvalid(self.btnProfileModalClose) then
			self.btnProfileModalClose.Entity:DisconnectEvent(ButtonClickEvent, self.btnProfileModalCloseHandler)
			self.btnProfileModalCloseHandler = nil
		end
		if self.btnProfileModalSaveHandler ~= nil and self.btnProfileModalSave ~= nil and isvalid(self.btnProfileModalSave) then
			self.btnProfileModalSave.Entity:DisconnectEvent(ButtonClickEvent, self.btnProfileModalSaveHandler)
			self.btnProfileModalSaveHandler = nil
		end
		if self.btnProfileModalCancelHandler ~= nil and self.btnProfileModalCancel ~= nil and isvalid(self.btnProfileModalCancel) then
			self.btnProfileModalCancel.Entity:DisconnectEvent(ButtonClickEvent, self.btnProfileModalCancelHandler)
			self.btnProfileModalCancelHandler = nil
		end
		if self.dimOverlayHandler ~= nil and self.modalDimOverlay ~= nil and isvalid(self.modalDimOverlay) then
			self.modalDimOverlay:DisconnectEvent(ButtonClickEvent, self.dimOverlayHandler)
			self.dimOverlayHandler = nil
		end
		local modal = self.modalGroup
		if modal ~= nil and isvalid(modal) then
			modal.Enable = false
		end
		log("[LobbyController] ProfileModal closed handlers disconnected")
	end

	method void SetAvatarNameTextVisible(boolean visible)
		-- Shows or hides the lobby avatar name while the profile modal is open.
		local nameText = self.nameTextCache
		if nameText == nil or isvalid(nameText) == false then
			nameText = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarNameText")
			if nameText ~= nil and isvalid(nameText) then
				self.nameTextCache = nameText
			end
		end
		if nameText ~= nil and isvalid(nameText) then
			nameText:SetEnable(visible)
			nameText.Visible = visible
			log("[LobbyController] AvatarNameText visible=" .. tostring(visible))
		else
			log_warning("[LobbyController] AvatarNameText visibility target not found")
		end
	end

	method void SetLobbyAvatarAreaVisible(boolean visible)
		local area = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea")
		if area ~= nil and isvalid(area) then
			area:SetEnable(visible)
			area.Visible = visible
		end
		
		local avatar = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/LobbyAvatar")
		if avatar ~= nil and isvalid(avatar) then
			avatar:SetEnable(visible)
			avatar.Visible = visible
		end
		
		local nameText = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarNameText")
		if nameText ~= nil and isvalid(nameText) then
			nameText:SetEnable(visible)
			nameText.Visible = visible
		end
		
		if visible then
			self:HideAvatarFallback()
		else
			local fallback = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarFallback")
			if fallback ~= nil and isvalid(fallback) then
				fallback:SetEnable(false)
				fallback.Visible = false
			end
		end
		log("[LobbyController] LobbyAvatarArea visible=" .. tostring(visible))
	end

	method void SaveProfileModal()
		local saveNickname = self.currentProfileNickname
		if self.modalNicknameInput ~= nil then
			saveNickname = self.modalNicknameInput.Text
		end
		saveNickname = self:NormalizeProfileNickname(saveNickname)
		self.currentProfileNickname = saveNickname
		if self.currentProfileTitle == nil or self.currentProfileTitle == "" then
			self.currentProfileTitle = "신입 수사관"
		end
		
		self:ApplyNickname(saveNickname)
		self:RefreshProfileModalFields()
		_ProfileStorageLogic:RequestSaveAllProfile(saveNickname, self.currentProfileTitle, self.selectedProfileRuid)
		log("[LobbyController] ProfileModal saved nickname=" .. saveNickname .. " title=" .. self.currentProfileTitle .. " ruid=" .. self.selectedProfileRuid)
		self:CloseProfileModal()
	end

	method void SelectProfileSlot(string ruid)
		-- Selects a profile image and previews it. SaveButton commits nickname/image/title together.
		log("[LobbyController] SelectProfileSlot ruid=" .. ruid)
		self:ApplyProfileImage(ruid)
		self:RefreshProfileModalFields()
	end

	method void UpdateSelectedIndicators()
		-- Shows gold border on the selected slot, hides borders on others.
		local slots = {
			{ border = self.profileSlot1Border, ruid = "ef1ba8b05d0a4d9e8d4033c9e797f708" },
			{ border = self.profileSlot2Border, ruid = "ba1ad8baabb5492b8030f62062bac632" },
			{ border = self.profileSlot3Border, ruid = "889918f7b8454392867298470d9ed43a" },
			{ border = self.profileSlot4Border, ruid = "f54ce587be5a462d846f64b2de315e3d" },
		}
		for _, entry in ipairs(slots) do
			local border = entry.border
			if border ~= nil and isvalid(border) then
				local spriteComp = border.SpriteGUIRendererComponent
				if spriteComp ~= nil then
					if entry.ruid == self.selectedProfileRuid then
						spriteComp:SetAlpha(1)
					else
						spriteComp:SetAlpha(0)
					end
				end
			end
		end
		log("[LobbyController] UpdateSelectedIndicators selected=" .. self.selectedProfileRuid)
	end

	method void OnEndPlay()
		-- Disconnects keyboard, button handlers, and cancels any pending timer.
		if self.keyDownHandler ~= nil then
			self.Entity:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
			self.keyDownHandler = nil
		end
		
		if self.avatarCheckTimerId ~= 0 then
			_TimerService:ClearTimer(self.avatarCheckTimerId)
			self.avatarCheckTimerId = 0
		end
		
		-- Disconnect profile modal handlers.
		self:CloseProfileModal()
		self:CloseCreateRoomModal()
		self:CloseFindRoomModal()
		self:DisconnectInvestigationRoomSearchEvents()
		self:DisconnectExternalPopupEvents()
		
		local base = "/ui/UI_Lobby/LobbyRoot"
		local buttonBase = base .. "/ButtonGroup"
		local ent
		
		if self.btnProfileHandler ~= nil then
			ent = _EntityService:GetEntityByPath(base .. "/ProfileFrame")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnProfileHandler) end
			self.btnProfileHandler = nil
		end
		if self.btnFriendHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/친구")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnFriendHandler) end
			self.btnFriendHandler = nil
		end
		if self.btnCodexHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/도감")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnCodexHandler) end
			self.btnCodexHandler = nil
		end
		if self.btnBagHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/가방")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnBagHandler) end
			self.btnBagHandler = nil
		end
		if self.btnAchievementHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/업적")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnAchievementHandler) end
			self.btnAchievementHandler = nil
		end
		if self.btnStartHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/start")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnStartHandler) end
			self.btnStartHandler = nil
		end
		if self.btnCreateHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/방만들기")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnCreateHandler) end
			self.btnCreateHandler = nil
		end
		if self.btnFindHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/찾기")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnFindHandler) end
			self.btnFindHandler = nil
		end
		if self.btnShopHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/상점")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnShopHandler) end
			self.btnShopHandler = nil
		end
		if self.btnAlertHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/알림")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnAlertHandler) end
			self.btnAlertHandler = nil
		end
		if self.btnSettingsHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/설정")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnSettingsHandler) end
			self.btnSettingsHandler = nil
		end
		if self.btnSettingsCloseHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/Header/CloseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnSettingsCloseHandler) end
			self.btnSettingsCloseHandler = nil
		end
		if self.btnSettingsInfoTabHandler ~= nil then
			ent = _EntityService:GetEntityByPath(buttonBase .. "/SettingsPopup/Panel/TabBar/TabInfo")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.btnSettingsInfoTabHandler) end
			self.btnSettingsInfoTabHandler = nil
