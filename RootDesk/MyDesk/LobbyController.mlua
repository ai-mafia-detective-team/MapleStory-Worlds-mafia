	method void JoinSelectedRoom()
		if self.findRoomSelectedIndex <= 0 then
			log("[FindRoomModal] join clicked room=none")
			return
		end
		local rooms = self:GetFindRoomMockData()
		local room = rooms[self.findRoomSelectedIndex]
		if room ~= nil then
			if room.isPrivate then
				log("[FindRoomModal] join clicked room=" .. room.name .. " (비밀번호 입력 필요)")
			else
				log("[FindRoomModal] join clicked room=" .. room.name)
			end
		end
	end

	method void QuickJoinRoom()
		log("[FindRoomModal] quick join clicked")
	end

	method void OnKeyDown(KeyDownEvent event)
		-- Triggers a single jump when Space is pressed while avatar is on the ground.
		if event.key == KeyboardKey.Space then
			log("[LobbyController] Space input detected")
			self:TryAvatarJump()
		end
	end

	method void OnUpdate(number delta)
		-- Simulates avatar movement/gravity; keeps AvatarNameText above avatar each frame.
		self:UpdateMatchmakingModal(delta)
		
		local avatarEntity = self.avatarCache
		if avatarEntity == nil or isvalid(avatarEntity) == false then return end
		
		-- Horizontal input: A / LeftArrow = left,  D / RightArrow = right
		local moveDir = 0
		if _InputService:IsKeyPressed(KeyboardKey.A) or _InputService:IsKeyPressed(KeyboardKey.LeftArrow) then
			moveDir -= 1
		end
		if _InputService:IsKeyPressed(KeyboardKey.D) or _InputService:IsKeyPressed(KeyboardKey.RightArrow) then
			moveDir += 1
		end
		
		local spacePressed = _InputService:IsKeyPressed(KeyboardKey.Space)
		if spacePressed and self.jumpPressedLastFrame == false then
			log("[LobbyController] Space input detected")
			self:TryAvatarJump()
		end
		self.jumpPressedLastFrame = spacePressed
		
		self.avatarPosX += moveDir * self.MOVE_SPEED * delta
		if self.avatarPosX < self.MIN_X then self.avatarPosX = self.MIN_X end
		if self.avatarPosX > self.MAX_X then self.avatarPosX = self.MAX_X end
		
		self:ApplyAvatarDirection(moveDir)
		
		-- Gravity while airborne
		local landedThisFrame = false
		if self.isOnGround == false then
			self.avatarVelY -= self.GRAVITY * delta
			self.avatarPosY += self.avatarVelY * delta
			if self.avatarPosY <= self.GROUND_Y then
				self.avatarPosY = self.GROUND_Y
				self.avatarVelY = 0
				self.isOnGround = true
				landedThisFrame = true
				log("[LobbyController] Avatar landed")
				self.jumpSquashTime = 0
				self.jumpReturnTime = 0
			end
		end
		
		local nextState = "idle"
		if self.isOnGround == false then
			nextState = "jump"
		elseif moveDir ~= 0 then
			nextState = "walk"
		end
		if landedThisFrame then
			log("[LobbyController] Avatar state after landing=" .. nextState)
		end
		self:ApplyAvatarState(nextState)
		
		-- Periodic action re-apply: ensures animation state sticks when it resets mid-motion.
		-- Walk and jump states are re-sent every actionReapplyInterval seconds.
		self.actionReapplyTimer -= delta
		if self.actionReapplyTimer <= 0 then
			if nextState == "walk" or nextState == "jump" then
				self:ForceApplyAvatarAction(nextState)
				self.actionReapplyTimer = self.actionReapplyInterval
				log("[LobbyController] Avatar action reapplied=true interval=" .. tostring(self.actionReapplyInterval))
			else
				self.actionReapplyTimer = 0
			end
		end
		
		local visualY = self.avatarPosY
		if self.WALK_VISUAL_FALLBACK_ENABLED and nextState == "walk" then
			if self.walkBobEnabledLogged == false then
				log("[LobbyController] Walk bob enabled")
				self.walkBobEnabledLogged = true
			end
			self.walkBobTime += delta
			local walkBob = math.sin(self.walkBobTime * self.WALK_BOB_SPEED) * self.WALK_BOB_AMOUNT
			visualY += walkBob
			self.walkBobLogTimer -= delta
			if self.walkBobLogTimer <= 0 then
				log("[LobbyController] Walk bob value=" .. tostring(walkBob))
				self.walkBobLogTimer = 0.35
			end
		else
			self.walkBobTime = 0
			self.walkBobLogTimer = 0
		end
		
		-- Apply avatar position via UITransform
		local transform = avatarEntity.UITransformComponent
		if transform ~= nil then
			transform.anchoredPosition = Vector2(self.avatarPosX, visualY)
			if self.JUMP_VISUAL_FALLBACK_ENABLED and self.jumpSquashTime > 0 then
				-- Phase 1: hold max squash at jump start for JUMP_SQUASH_DURATION (0.08s)
				transform.UIScale = Vector3(1.03, 0.96, 1)
				self.avatarScaleSquashed = true
				self.jumpSquashTime -= delta
				if self.jumpSquashTime <= 0 then
					self.jumpReturnTime = self.JUMP_RETURN_DURATION
				end
			elseif self.jumpReturnTime > 0 then
				-- Phase 2: lerp back to (1,1) over JUMP_RETURN_DURATION (0.18s)
				local t = self.jumpReturnTime / self.JUMP_RETURN_DURATION
				local sx = 1.0 + 0.03 * t
				local sy = 1.0 - 0.04 * t
				transform.UIScale = Vector3(sx, sy, 1)
				self.avatarScaleSquashed = true
				self.jumpReturnTime -= delta
			elseif self.avatarScaleSquashed then
				transform.UIScale = Vector3(1, 1, 1)
				self.avatarScaleSquashed = false
				log("[LobbyController] Avatar base scale restored x=1 y=1")
			elseif landedThisFrame then
				transform.UIScale = Vector3(1, 1, 1)
				self.jumpReturnTime = 0
				log("[LobbyController] Avatar base scale restored x=1 y=1")
			end
		end
		
		-- Move fallback placeholder alongside avatar (position matches avatar)
		local fallback = self.fallbackCache
		if fallback ~= nil and isvalid(fallback) and fallback.Enable then
			local fb = fallback.UITransformComponent
			if fb ~= nil then
				fb.anchoredPosition = Vector2(self.avatarPosX, self.avatarPosY)
			end
		end
		
		-- AvatarNameText tracks avatar: stays NAME_OFFSET_Y units from avatar center.
		local nameText = self.nameTextCache
		if nameText ~= nil and isvalid(nameText) then
			local nameTransform = nameText.UITransformComponent
			if nameTransform ~= nil then
				nameTransform.anchoredPosition = Vector2(self.avatarPosX, self.avatarPosY + self.NAME_OFFSET_Y)
			end
		end
		
		self.updateLogTimer -= delta
		if self.updateLogTimer <= 0 then
			log("[LobbyController] OnUpdate active")
			log("[LobbyController] Avatar position x=" .. tostring(self.avatarPosX) .. " y=" .. tostring(self.avatarPosY))
			log("[LobbyController] Avatar ground position x=" .. tostring(self.avatarPosX) .. " y=" .. tostring(self.GROUND_Y))
			self.updateLogTimer = 0.5
		end
	end

	method void TryAvatarJump()
		-- Starts a jump only while grounded; repeated Space presses in air are ignored.
		if self.isOnGround == false then return end
		self.avatarVelY = self.JUMP_FORCE
		self.isOnGround = false
		if self.JUMP_VISUAL_FALLBACK_ENABLED then
			self.jumpSquashTime = self.JUMP_SQUASH_DURATION
			self.jumpReturnTime = 0
			self.avatarScaleSquashed = false
			log("[LobbyController] Avatar jump visual applied")
		end
		log("[LobbyController] Avatar jump")
	end

	method void ApplyNickname(string nickname)
		-- Sets the ProfileRoot nickname plate and AvatarNameText text.
		local displayName = self:NormalizeProfileNickname(nickname)
		self.currentProfileNickname = displayName
		
		local plate = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ProfileRoot/NicknamePlate/NicknameText")
		if plate ~= nil and isvalid(plate) and plate.TextComponent ~= nil then
			plate.TextComponent.Text = displayName
		end
		local titleEntity = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ProfileRoot/NicknamePlate/TitleText")
		if titleEntity ~= nil and isvalid(titleEntity) and titleEntity.TextComponent ~= nil then
			titleEntity.TextComponent.Text = self.currentProfileTitle
		end
		local nameText = self.nameTextCache
		if nameText ~= nil and isvalid(nameText) and nameText.TextComponent ~= nil then
			nameText.TextComponent.Text = displayName
		end
		log("[LobbyController] ProfileRoot nickname applied: " .. displayName)
	end

	method string NormalizeProfileNickname(string nickname)
		local displayName = nickname
		if displayName ~= nil then
			displayName = string.match(displayName, "^%s*(.-)%s*$")
		end
		if displayName == nil or displayName == "" or displayName == "?섏궗愿" then
			displayName = "수사관"
		end
		return displayName
	end

	method void ApplyAllProfile(string nickname, string title, string ruid)
		-- Applies profile values loaded from DataStorage.
		if title == nil or title == "" then
			title = "신입 수사관"
		end
		self.currentProfileTitle = title
		self:ApplyNickname(nickname)
		if ruid ~= nil and ruid ~= "" then
			self:ApplyProfileImage(ruid)
		end
		if self.profileModalOpen then
			self:RefreshProfileModalFields()
		end
		log("[LobbyController] ApplyAllProfile complete nickname=" .. self.currentProfileNickname .. " title=" .. self.currentProfileTitle .. " ruid=" .. self.selectedProfileRuid)
	end

	method void RefreshProfileModalFields()
		-- Mirrors the saved profile values into the settings modal. Nickname is real text, not placeholder.
		local displayName = self:NormalizeProfileNickname(self.currentProfileNickname)
		self.currentProfileNickname = displayName
		if self.currentProfileTitle == nil or self.currentProfileTitle == "" then
			self.currentProfileTitle = "신입 수사관"
		end
		
		if self.modalNicknameInput ~= nil then
			self.modalNicknameInput.Text = displayName
			if displayName ~= "" then
				self.modalNicknameInput.PlaceHolder = ""
			else
				self.modalNicknameInput.PlaceHolder = "닉네임 입력"
			end
		end
		if self.modalPreviewNicknameText ~= nil then
			self.modalPreviewNicknameText.Text = displayName
		end
		if self.modalPreviewTitleText ~= nil then
			self.modalPreviewTitleText.Text = self.currentProfileTitle
		end
		if self.modalTitleDisplayText ~= nil then
			self.modalTitleDisplayText.Text = self.currentProfileTitle
		end
		if self.modalPreviewProfileImage ~= nil and isvalid(self.modalPreviewProfileImage) then
			local spriteComp = self.modalPreviewProfileImage.SpriteGUIRendererComponent
			if spriteComp ~= nil then
				spriteComp.ImageRUID = DataRef(self.selectedProfileRuid)
			end
		end
		log("[LobbyController] ProfileModal fields refreshed nickname=" .. displayName .. " title=" .. self.currentProfileTitle .. " ruid=" .. self.selectedProfileRuid)
	end

	method void ResetAvatarPosition()
		-- Resets avatar simulation to center-ground starting position.
		self.avatarPosX = 0
		self.avatarPosY = self.GROUND_Y
		self.avatarVelY = 0
		self.isOnGround = true
		self.jumpPressedLastFrame = false
		self.walkBobTime = 0
		self.walkBobLogTimer = 0
		self.jumpSquashTime = 0
		self.jumpReturnTime = 0
		self.avatarScaleSquashed = false
		self.actionReapplyTimer = 0
		self.avatarStructureDiagnosed = false
		self.updateLogTimer = 0
		log("[LobbyController] Avatar ground position x=" .. tostring(self.avatarPosX) .. " y=" .. tostring(self.avatarPosY))
		self:ApplyAvatarState("idle")
	end

	method void ApplyAvatarDirection(integer moveDir)
		-- Flips the avatar only when movement direction actually changes.
		-- AvatarGUIRendererComponent.FlipX is independent of UIScale (jump squash) — no conflict.
		-- Default avatar faces right (FlipX=false). Left movement needs FlipX=true to flip toward left.
		if moveDir == 0 then return end
		local nextDirection = "right"
		if moveDir < 0 then nextDirection = "left" end
		if nextDirection == self.currentAvatarDirection then return end
		
		self.currentAvatarDirection = nextDirection
		local avatarEntity = self.avatarCache
		if avatarEntity == nil or isvalid(avatarEntity) == false then return end
		
		local avatarComp = avatarEntity.AvatarGUIRendererComponent
		if avatarComp ~= nil then
			-- MSW avatar default facing is LEFT (FlipX=false=left).
			-- To face right: FlipX=true. To face left: FlipX=false.
			avatarComp.FlipX = nextDirection == "right"
			log("[LobbyController] Avatar facing direction=" .. nextDirection)
			log("[LobbyController] Avatar flip mapping corrected=true")
			log("[LobbyController] Avatar final scaleX=" .. tostring(avatarComp.FlipX and -1 or 1))
		end
	end

	method void DiagnoseAvatarBodyStructure()
		-- Runs once on first action apply to diagnose whether the avatar entity supports animation.
		local avatarEntity = self.avatarCache
		if avatarEntity == nil or isvalid(avatarEntity) == false then return end
		local avatarComp = avatarEntity.AvatarGUIRendererComponent
		if avatarComp == nil then return end
		
		local avatarPath = "/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/LobbyAvatar"
		log("[LobbyController] AvatarGUIRendererComponent entity path=" .. avatarPath)
		
		-- Avatar root entity
		local rootEntity = avatarComp:GetAvatarRootEntity()
		local rootValid = rootEntity ~= nil and isvalid(rootEntity)
		if rootValid then
			log("[LobbyController] Avatar root entity path=" .. tostring(rootEntity.Name))
			local rootASA  = rootEntity.AvatarStateAnimationComponent ~= nil
			local rootABAS = rootEntity.AvatarBodyActionSelectorComponent ~= nil
			local rootSC   = rootEntity.StateComponent ~= nil
			log("[LobbyController] Avatar root components=StateAnim:" .. tostring(rootASA) .. " BodyActionSelector:" .. tostring(rootABAS) .. " StateComp:" .. tostring(rootSC))
		else
			log("[LobbyController] Avatar root entity path=nil")
			log("[LobbyController] Avatar root components=nil")
		end
		
		-- Body entity (target of BodyActionStateChangeEvent)
		local bodyEntity = avatarComp:GetBodyEntity()
		local bodyValid = bodyEntity ~= nil and isvalid(bodyEntity)
		if bodyValid then
			log("[LobbyController] Avatar body entity path=" .. tostring(bodyEntity.Name))
			local bodyASA  = bodyEntity.AvatarStateAnimationComponent ~= nil
			local bodyABAS = bodyEntity.AvatarBodyActionSelectorComponent ~= nil
			local bodySC   = bodyEntity.StateComponent ~= nil
			local bodySSTA = bodyEntity.StateStringToAvatarActionComponent ~= nil
			log("[LobbyController] Avatar body components=StateAnim:" .. tostring(bodyASA) .. " BodyActionSelector:" .. tostring(bodyABAS) .. " StateComp:" .. tostring(bodySC) .. " StateStrToAction:" .. tostring(bodySSTA))
			log("[LobbyController] AvatarStateAnimationComponent found=" .. tostring(bodyASA))
			log("[LobbyController] AvatarBodyActionSelectorComponent found=" .. tostring(bodyABAS))
			log("[LobbyController] StateStringToAvatarActionComponent found=" .. tostring(bodySSTA))
			log("[LobbyController] StateComponent found=" .. tostring(bodySC))
		
			-- ActionState readback via AvatarBodyActionSelectorComponent
			local selector = bodyEntity.AvatarBodyActionSelectorComponent
			if selector ~= nil then
				log("[LobbyController] Avatar action readback=" .. tostring(selector.ActionState))
			else
				log("[LobbyController] Avatar action readback=current action readback unsupported")
			end
		
			local animSupported = bodyASA or bodyABAS
			log("[LobbyController] Avatar GUI body animation supported=" .. tostring(animSupported))
			if not animSupported then
				log_warning("[LobbyController] AvatarGUIRendererComponent body action animation component missing")
				log_warning("[LobbyController] Walk/Fall motion not playable via BodyActionStateChangeEvent — required components absent from body entity")
			end
		else
			log("[LobbyController] Avatar body entity path=nil")
			log("[LobbyController] Avatar body components=nil")
			log("[LobbyController] AvatarStateAnimationComponent found=false")
			log("[LobbyController] AvatarBodyActionSelectorComponent found=false")
			log("[LobbyController] StateStringToAvatarActionComponent found=false")
			log("[LobbyController] StateComponent found=false")
			log("[LobbyController] Avatar action readback=current action readback unsupported")
			log("[LobbyController] Avatar GUI body animation supported=false")
		end
	end

	method void ForceApplyAvatarAction(string state)
		-- ActionStateChangedEvent → body entity (GetBodyEntity()).
		-- Ref: MSW docs "Playing Animation" sample; coreActionName drives torso+parts animation directly.
		local avatarEntity = self.avatarCache
		if avatarEntity == nil or isvalid(avatarEntity) == false then return end
		
		local avatarComp = avatarEntity.AvatarGUIRendererComponent
		if avatarComp == nil then
			self.avatarAnimationApiFound = false
			return
		end
		self.avatarAnimationApiFound = true
		
		if self.avatarStructureDiagnosed == false then
			self.avatarStructureDiagnosed = true
			self:DiagnoseAvatarBodyStructure()
		end
		
		local bodyEntity = avatarComp:GetBodyEntity()
		local bodyValid = bodyEntity ~= nil and isvalid(bodyEntity)
		log("[LobbyController] Avatar body entity found=" .. tostring(bodyValid))
		if not bodyValid then
			log_warning("[LobbyController] Avatar body entity nil — cannot send action")
			return
		end
		
		log("[LobbyController] Avatar action apply method=ActionStateChangedEvent")
		
		local coreAction = "stand1"
		local partsAction = "stand1"
		local playRate = 1.0
		
		if state == "walk" then
			coreAction = "walk1"
			partsAction = "walk1"
			playRate = 1.35
			log("[LobbyController] Avatar direct action core=walk1 parts=walk1 playRate=1.35")
		elseif state == "jump" then
			coreAction = "jump"
			partsAction = "jump"
			playRate = 1.0
			log("[LobbyController] Avatar direct action core=jump parts=jump playRate=1")
		else
			log("[LobbyController] Avatar direct action core=stand1 parts=stand1 playRate=1")
		end
		
		local event = ActionStateChangedEvent(coreAction, partsAction, playRate, SpriteAnimClipPlayType.Loop, 0, 2147483647)
		bodyEntity:SendEvent(event)
		log("[LobbyController] ActionStateChangedEvent sent=true")
	end

	method void ApplyAvatarState(string nextState)
		-- Applies idle/walk/jump visual state only on transitions.
		if nextState == self.currentAvatarState then return end
		local prevState = self.currentAvatarState
		if prevState == "" then prevState = "none" end
		self.currentAvatarState = nextState
		self.actionReapplyTimer = 0
		
		log("[LobbyController] Avatar state changed " .. prevState .. " -> " .. nextState)
		log("[LobbyController] Avatar state=" .. nextState)
		
		self:ForceApplyAvatarAction(nextState)
		if nextState == "walk" then
			log("[LobbyController] Walk visual fallback enabled=" .. tostring(self.WALK_VISUAL_FALLBACK_ENABLED))
		end
	end

