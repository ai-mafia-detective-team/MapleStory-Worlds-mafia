			if ent ~= nil and isvalid(ent) then
				self.friendPopupCloseHandler = ent:ConnectEvent(ButtonClickEvent, self.OnExternalPopupCloseClicked)
			end
		end
		
		if self.friendAddHandler == nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/FriendPopup/Panel/AddRow/AddBtn")
			if ent ~= nil and isvalid(ent) then
