		if self.collectionPopupCloseHandler == nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/Header/CloseBtn")
			if ent ~= nil and isvalid(ent) then
				self.collectionPopupCloseHandler = ent:ConnectEvent(ButtonClickEvent, self.OnCollectionPopupCloseClicked)
