	method void WireCostumeCategoryEvents()
		-- Connects costume dex category buttons once.
		if self.costumeCategoryHandlers ~= nil then return end
		self.costumeCategoryHandlers = {}
		
		local bar = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/CostumePage/CategoryBar"
		for _, entry in ipairs(self:GetCostumeCategoryButtons()) do
			local ent = _EntityService:GetEntityByPath(bar .. "/" .. entry.node)
			if ent ~= nil and isvalid(ent) then
				local capturedCategory = entry.category
				local h = ent:ConnectEvent(ButtonClickEvent, function() self:SelectCostumeCollectionCategory(capturedCategory) end)
				self.costumeCategoryHandlers[#self.costumeCategoryHandlers + 1] = { entity = ent, eventHandler = h }
			else
				log_warning("[CollectionPopup] costume category button not found: " .. entry.node)
			end
		end
		log("[CollectionPopup] costume categories wired: " .. tostring(#self.costumeCategoryHandlers))
	end

	method void WireRoleCardEvents()
		-- Connects each role card so clicking it drives the right-hand DetailPanel.
		if self.roleCardHandlers ~= nil then return end
		self.roleCardHandlers = {}
		
		local grid = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/CollectionPopup/Panel/ContentRoot/RolePage/ListPanel/CardGrid"
		for i = 1, 8 do
			local card = _EntityService:GetEntityByPath(grid .. "/RoleCard_0" .. tostring(i))
			if card ~= nil and isvalid(card) then
				local capturedIndex = i
				local h = card:ConnectEvent(ButtonClickEvent, function() self:OnRoleCardClicked(capturedIndex) end)
				self.roleCardHandlers[#self.roleCardHandlers + 1] = { entity = card, eventHandler = h }
			else
				log_warning("[CollectionPopup] RoleCard_0" .. tostring(i) .. " not found")
			end
		end
		log("[CollectionPopup] role card clicks wired: " .. tostring(#self.roleCardHandlers))
		
		self:WireCostumeCardEvents()
		self:WireCollectionTabEvents()
		self:WireCollectionPaginationEvents()
	end

