	method void ShowLiveDiag(string tag)
		-- TEMP live diagnostic: release builds strip log(), so surface modal state in
		-- the always-visible top-bar money text. Remove after the live issue is fixed.
		local moneyText = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/MoneyDisplay/FreeMoneyBar/FreeMoneyText")
		if moneyText == nil then return end
		if isvalid(moneyText) == false then return end
		if moneyText.TextComponent == nil then return end
		local msg = "D3." .. tag
		local targets = {
			"/ui/UI_Lobby/LobbyRoot/ProfileSettingModalRoot",
			"/ui/UI_Lobby/LobbyRoot/ProfileSettingModalRoot/ModalPanel",
			"/ui/UI_InvestigationRoomSearch",
			"/ui/UI_InvestigationRoomSearch/SearchRoot"
		}
		for i = 1, #targets do
			local e = _EntityService:GetEntityByPath(targets[i])
			local mark = "X"
			if e ~= nil and isvalid(e) then
				if e.Enable then mark = "E1" else mark = "E0" end
				if e.Visible then mark = mark .. "V1" else mark = mark .. "V0" end
			end
			msg = msg .. " " .. mark
		end
		moneyText.TextComponent.Text = msg
	end

