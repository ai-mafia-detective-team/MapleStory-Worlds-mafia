		if self.shopPopupCancelHandler == nil then
			ent = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ButtonGroup/ShopPopup/Panel/PurchaseBar/BottomCloseBtn")
			if ent ~= nil and isvalid(ent) then
				self.shopPopupCancelHandler = ent:ConnectEvent(ButtonClickEvent, self.OnExternalPopupCloseClicked)
