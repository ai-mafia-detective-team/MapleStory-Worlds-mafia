	method void SetFindRoomRowText(string rowPath, string childName, string text)
		local child = _EntityService:GetEntityByPath(rowPath .. "/" .. childName)
		if child ~= nil and isvalid(child) and child.TextComponent ~= nil then
			child.TextComponent.Text = text
		end
	end

	method void RefreshRoomList()
		local base = "/ui/UI_InvestigationRoomSearch/SearchRoot/RoomListPanel/RoomRowContainer/"
		local rooms = self:GetFindRoomMockData()
		for i = 1, 8 do
			local rowPath = base .. "RoomRow_" .. tostring(i)
			local row = _EntityService:GetEntityByPath(rowPath)
			if row ~= nil and isvalid(row) then
				local room = rooms[i]
				if room ~= nil then
					self:SetFindRoomRowText(rowPath, "RoomNameText", room.name)
					self:SetFindRoomRowText(rowPath, "RoomModeText", room.mode)
					self:SetFindRoomRowText(rowPath, "RoomPlayerCountText", room.players)
					self:SetFindRoomRowText(rowPath, "RoomStatusText", room.status)
					self:SetFindRoomRowText(rowPath, "RoomHostText", room.host)
					local pwIcon = _EntityService:GetEntityByPath(rowPath .. "/RoomPasswordIcon")
					if pwIcon ~= nil and isvalid(pwIcon) then
						pwIcon:SetEnable(room.isPrivate)
						pwIcon.Visible = room.isPrivate
					end
					row:SetEnable(true)
					row.Visible = true
					self:SetFindRoomRowHighlight(i, false)
				else
					row:SetEnable(false)
					row.Visible = false
				end
			end
		end
		self.findRoomSelectedIndex = 0
		log("[FindRoomModal] refresh clicked")
	end

	method void SetFindRoomRowHighlight(integer index, boolean selected)
		local rowPath = "/ui/UI_InvestigationRoomSearch/SearchRoot/RoomListPanel/RoomRowContainer/RoomRow_" .. tostring(index)
		local row = _EntityService:GetEntityByPath(rowPath)
		if row == nil or not isvalid(row) then return end
		local sprite = row.SpriteGUIRendererComponent
		if sprite ~= nil then
			if selected then
				sprite.Color = Color(0.23, 0.32, 0.29, 0.96)
			else
				sprite.Color = Color(0.129411772, 0.113725491, 0.09019608, 1)
			end
		end
	end

	method void SelectRoom(integer index)
		local prev = self.findRoomSelectedIndex
		if prev > 0 and prev ~= index then
			self:SetFindRoomRowHighlight(prev, false)
		end
		self.findRoomSelectedIndex = index
		self:SetFindRoomRowHighlight(index, true)
		log("[FindRoomModal] selected room index=" .. tostring(index))
	end

	method void SetFindRoomDetailText(string fullPath, string text)
		local ent = _EntityService:GetEntityByPath(fullPath)
		if ent ~= nil and isvalid(ent) and ent.TextComponent ~= nil then
			ent.TextComponent.Text = text
		end
	end

	method void UpdateFindRoomDetailPanel(integer index)
		-- Existing UI_InvestigationRoomSearch is row-list based.
	end

	method void ClearFindRoomDetailPanel()
		-- Existing UI_InvestigationRoomSearch is row-list based.
	end

	method void UpdateFindRoomPageText()
		local pageText = _EntityService:GetEntityByPath("/ui/UI_InvestigationRoomSearch/SearchRoot/PagingPanel/PageTextBox_Border")
		if pageText ~= nil and isvalid(pageText) and pageText.TextComponent ~= nil then
			pageText.TextComponent.Text = "1 / 3"
		end
