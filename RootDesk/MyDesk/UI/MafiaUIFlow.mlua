method void HandleInviteScrollUpClick()
    if self.inviteScrollOffset <= 0 then return end
    self.inviteScrollOffset = self.inviteScrollOffset - 1
    self:RenderInviteSlots()
    log("[MafiaUIFlow] invite scroll up; offset=" .. tostring(self.inviteScrollOffset))
end

method void HandleInviteScrollDownClick()
    if self.inviteFilteredPlayers == nil then return end
    if self.inviteScrollOffset + 4 >= #self.inviteFilteredPlayers then return end
    self.inviteScrollOffset = self.inviteScrollOffset + 1
    self:RenderInviteSlots()
    log("[MafiaUIFlow] invite scroll down; offset=" .. tostring(self.inviteScrollOffset))
end

method void RefreshInviteList(string searchText)
    if self.inviteFilteredPlayers == nil then self.inviteFilteredPlayers = {} end
    self.inviteFilteredPlayers = {}
    local localUserId = self:GetLocalUserId()
    for _, uid in ipairs(_UserService.Users.Keys) do
        local userId = tostring(uid)
        if userId ~= localUserId then
            local name = self:GetUserDisplayName(userId)
            local lower = string.lower(name)
            local query = string.lower(searchText or "")
            if query == "" or string.find(lower, query, 1, true) ~= nil then
                self.inviteFilteredPlayers[#self.inviteFilteredPlayers + 1] = userId
            end
        end
    end
    self.inviteScrollOffset = 0
    self:RenderInviteSlots()
    log("[MafiaUIFlow] invite list refreshed; count=" .. tostring(#self.inviteFilteredPlayers))
end

method void RenderInviteSlots()
    if self.inviteSlotTexts == nil then return end
    if self.inviteFilteredPlayers == nil then return end
    local startIdx = self.inviteScrollOffset + 1
    for i = 1, 4 do
        local textComp = self.inviteSlotTexts[i]
        if textComp ~= nil then
            local playerIdx = startIdx + i - 1
            if playerIdx <= #self.inviteFilteredPlayers then
                local userId = self.inviteFilteredPlayers[playerIdx]
                textComp.Text = self:GetUserDisplayName(userId)
                textComp.Entity.Enable = true
            else
                textComp.Text = ""
                textComp.Entity.Enable = false
            end
        end
    end
    self:RefreshInviteScrollVisual()
end

method void RefreshInviteScrollVisual()
    if self.inviteScrollThumb == nil then return end
    if self.inviteScrollThumb.UITransformComponent == nil then return end
    if self.inviteFilteredPlayers == nil then
        self.inviteScrollThumb.Enable = false
        return
    end

    local total = #self.inviteFilteredPlayers
    local maxOffset = math.max(0, total - 4)
    local hasOverflow = maxOffset > 0
    self.inviteScrollThumb.Enable = hasOverflow
    if not hasOverflow then return end

    local topY = 125
    local bottomY = -139
    local ratio = 0
    if maxOffset > 0 then ratio = self.inviteScrollOffset / maxOffset end
    if ratio < 0 then ratio = 0 end
    if ratio > 1 then ratio = 1 end

    local y = topY + (bottomY - topY) * ratio
    local pos = self.inviteScrollThumb.UITransformComponent.anchoredPosition
    self.inviteScrollThumb.UITransformComponent.anchoredPosition = Vector2(pos.x, y)
end

method void HandleInviteConfirm()
    log("[MafiaUIFlow] invite confirm clicked")
end

method void HandleRoomSettingsOpen()
    if self.roomSettingsPanel == nil then return end
    self.roomSettingPrivate = true
    self.roomSettingMaxPlayers = 8
    self.roomSettingMafiaCount = 2
    local title = "커닝시티 마피아"
    local password = ""
    if _MafiaGameLogic ~= nil then
        self.roomSettingPrivate = _MafiaGameLogic.IsPrivateRoom
        if _MafiaGameLogic.RoomMaxPlayers ~= nil then self.roomSettingMaxPlayers = _MafiaGameLogic.RoomMaxPlayers end
        if _MafiaGameLogic.MafiaPlayerCount ~= nil then self.roomSettingMafiaCount = _MafiaGameLogic.MafiaPlayerCount end
        if _MafiaGameLogic.RoomTitle ~= nil and _MafiaGameLogic.RoomTitle ~= "" then title = _MafiaGameLogic.RoomTitle end
        if _MafiaGameLogic.RoomPassword ~= nil then password = _MafiaGameLogic.RoomPassword end
    end
    self.roomSettingsPanel.Enable = true
    if self.roomTitleInput ~= nil then self.roomTitleInput.Text = title end
    if self.roomPasswordInput ~= nil then self.roomPasswordInput.Text = password end
    self:RefreshRoomPasswordInputState()
    _TimerService:SetTimerOnce(function()
        if self.roomSettingsPanel ~= nil and self.roomSettingsPanel.Enable then
            if self.roomTitleInput ~= nil then self.roomTitleInput.Text = title end
            if self.roomPasswordInput ~= nil then self.roomPasswordInput.Text = password end
            self:RefreshRoomPasswordInputState()
            log("[MafiaUIFlow] room settings input values applied title=" .. tostring(title))
        end
    end, 0.03)
    self:RefreshRoomSettingsVisual()
    log("[MafiaUIFlow] room settings opened")
end

method void HandleRoomSettingsClose()
    if self.roomSettingsPanel ~= nil then self.roomSettingsPanel.Enable = false end
    log("[MafiaUIFlow] room settings closed")
end

method void HandleRoomSettingsConfirm()
    local title = "커닝시티 마피아"
    local password = ""
    if self.roomTitleInput ~= nil and self.roomTitleInput.Text ~= nil and self.roomTitleInput.Text ~= "" then
        title = self.roomTitleInput.Text
    end
    if self.roomPasswordInput ~= nil and self.roomPasswordInput.Text ~= nil then
        password = self.roomPasswordInput.Text
    end
    if not self.roomSettingPrivate then
        password = ""
    end
    if _MafiaGameLogic ~= nil then
        _MafiaGameLogic:SetRoomSettings(title, self.roomSettingPrivate, password, self.roomSettingMaxPlayers, self.roomSettingMafiaCount)
    end
    if self.roomSettingsPanel ~= nil then self.roomSettingsPanel.Enable = false end
    log("[MafiaUIFlow] room settings confirmed")
end

