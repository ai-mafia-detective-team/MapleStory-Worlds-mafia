method void OnBeginPlay()
    self.lobbyAvatarEntities = {}
    self.lobbyRoomTexts = {}
    self.cachedLobbySeats = {}
    self.inviteSlotTexts = {}
    self.inviteFilteredPlayers = {}
    self.inviteCheckedPlayers = {}
    self.roomPlayerButtons = {}
    self.roomPlayerButtonTexts = {}
    self.roomPlayerVisuals = {}
    self.roomMafiaButtons = {}
    self.roomMafiaButtonTexts = {}
    self.roomMafiaVisuals = {}
    self.voteCardEntities = {}
    self.voteAvatarEntities = {}
    self.voteNameTexts = {}
    self.voteCircleOffEntities = {}
    self.voteCircleOnEntities = {}
    self.voteCardHandlers = {}
    self.votePlayerUserIds = {}
    self.nightMafiaCards    = {}
    self.nightMafiaAvatars  = {}
    self.nightMafiaNames    = {}
    self.nightMafiaCircles  = {}
    self.nightMafiaHandlers = {}
    self.nightMafiaPlayerIds = {}
    self.nightPoliceCards    = {}
    self.nightPoliceAvatars  = {}
    self.nightPoliceNames    = {}
    self.nightPoliceCircles  = {}
    self.nightPoliceHandlers = {}
    self.nightPolicePlayerIds = {}
    self.nightDoctorCards    = {}
    self.nightDoctorAvatars  = {}
    self.nightDoctorNames    = {}
    self.nightDoctorCircles  = {}
    self.nightDoctorHandlers = {}
    self.nightDoctorPlayerIds = {}
    self:ResolveUI()
    self:RefreshUI(true)
    log("[MafiaUIFlow] initialized")
end

method void OnUpdate(number delta)
    if self.lobbyScrollThumb ~= nil and self.lobbyScrollThumb.UITransformComponent ~= nil then
        local curr = self.lobbyScrollThumbCurrentY
        local target = self.lobbyScrollThumbTargetY
        if math.abs(target - curr) > 0.5 then
            local factor = math.min(1.0, delta * 14)
            local newY = curr + (target - curr) * factor
            self.lobbyScrollThumbCurrentY = newY
            local pos = self.lobbyScrollThumb.UITransformComponent.anchoredPosition
            self.lobbyScrollThumb.UITransformComponent.anchoredPosition = Vector2(pos.x, newY)
        elseif curr ~= target then
            self.lobbyScrollThumbCurrentY = target
            local pos = self.lobbyScrollThumb.UITransformComponent.anchoredPosition
            self.lobbyScrollThumb.UITransformComponent.anchoredPosition = Vector2(pos.x, target)
        end
    end
    self.refreshAccumulator = self.refreshAccumulator + delta
    if self.refreshAccumulator < 0.1 then return end
    self.refreshAccumulator = 0.0
    if not self.uiResolved then self:ResolveUI() end
    self:RefreshUI(false)
end

method void OnEndPlay()
    if self.lobbyReadyButton ~= nil and self.readyClickHandler ~= nil then
        self.lobbyReadyButton.Entity:DisconnectEvent(ButtonClickEvent, self.readyClickHandler)
    end
    if self.lobbyInviteButton ~= nil and self.inviteClickHandler ~= nil then
        self.lobbyInviteButton.Entity:DisconnectEvent(ButtonClickEvent, self.inviteClickHandler)
    end
    if self.lobbyChatInput ~= nil and self.lobbyChatSubmitHandler ~= nil then
        self.lobbyChatInput.Entity:DisconnectEvent(TextInputSubmitEvent, self.lobbyChatSubmitHandler)
    end
