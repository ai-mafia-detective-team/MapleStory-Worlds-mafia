method void RefreshRoomSettingsVisual()
    self:RefreshRoomPasswordInputState()
    self:RefreshRoomPrivateCheckSprite(self.roomPrivateCheckSprite)
    self:RefreshRoomPrivateCheckSprite(self.roomPrivateLegacyCheckSprite)
    self:RefreshRoomSettingChoice(self.roomPlayerVisuals, self.roomPlayerButtonTexts, self.roomSettingMaxPlayers)
    self:RefreshRoomSettingChoice(self.roomMafiaVisuals, self.roomMafiaButtonTexts, self.roomSettingMafiaCount)
end

method void RefreshRoomPasswordInputState()
    -- Enables password entry only for private rooms while keeping the visual input frame visible.
    if self.roomPasswordInput == nil then return end
    self.roomPasswordInput.Enable = self.roomSettingPrivate
    if self.roomSettingPrivate then
        self.roomPasswordInput.PlaceHolder = "비밀번호"
    else
        self.roomPasswordInput.Text = ""
        self.roomPasswordInput.PlaceHolder = "비공개 방에서 입력 가능"
    end
    log("[MafiaUIFlow] room password input enabled=" .. tostring(self.roomSettingPrivate))
end

method void RefreshRoomPrivateCheckSprite(Entity spriteEntity)
    if spriteEntity == nil then return end
    spriteEntity.Enable = true
    if spriteEntity.SpriteGUIRendererComponent == nil then return end
    if self.roomSettingPrivate then
        spriteEntity.SpriteGUIRendererComponent.ImageRUID = self.roomCheckOnRuid
    else
        spriteEntity.SpriteGUIRendererComponent.ImageRUID = self.roomCheckOffRuid
    end
end

method void RefreshRoomSettingChoice(table visuals, table texts, integer selectedValue)
    if visuals == nil then return end
    for value, entity in pairs(visuals) do
        local selected = value == selectedValue
        if entity ~= nil and entity.SpriteGUIRendererComponent ~= nil then
            if selected then
                entity.SpriteGUIRendererComponent.ImageRUID = self.roomSettingSelectedRuid
            else
                entity.SpriteGUIRendererComponent.ImageRUID = self.roomSettingNormalRuid
            end
        end
        if texts ~= nil and texts[value] ~= nil then
            if selected then
                texts[value].FontColor = Color(1, 0.78, 0.22, 1)
            else
                texts[value].FontColor = Color(1, 1, 1, 1)
            end
        end
    end
end

