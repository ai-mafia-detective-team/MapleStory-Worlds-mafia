        self.roomConfirmButton.Entity:DisconnectEvent(ButtonClickEvent, self.roomConfirmHandler)
    end
    if self.roomPlayerButtons ~= nil then
        if self.roomPlayerButtons[6] ~= nil and self.roomPlayer6Handler ~= nil then self.roomPlayerButtons[6].Entity:DisconnectEvent(ButtonClickEvent, self.roomPlayer6Handler) end
        if self.roomPlayerButtons[7] ~= nil and self.roomPlayer7Handler ~= nil then self.roomPlayerButtons[7].Entity:DisconnectEvent(ButtonClickEvent, self.roomPlayer7Handler) end
        if self.roomPlayerButtons[8] ~= nil and self.roomPlayer8Handler ~= nil then self.roomPlayerButtons[8].Entity:DisconnectEvent(ButtonClickEvent, self.roomPlayer8Handler) end
    end
    if self.roomMafiaButtons ~= nil then
        if self.roomMafiaButtons[1] ~= nil and self.roomMafia1Handler ~= nil then self.roomMafiaButtons[1].Entity:DisconnectEvent(ButtonClickEvent, self.roomMafia1Handler) end
        if self.roomMafiaButtons[2] ~= nil and self.roomMafia2Handler ~= nil then self.roomMafiaButtons[2].Entity:DisconnectEvent(ButtonClickEvent, self.roomMafia2Handler) end
        if self.roomMafiaButtons[3] ~= nil and self.roomMafia3Handler ~= nil then self.roomMafiaButtons[3].Entity:DisconnectEvent(ButtonClickEvent, self.roomMafia3Handler) end
    end
    if self.voteCardHandlers ~= nil then
        for i = 1, 8 do
            if self.voteCardEntities ~= nil and self.voteCardEntities[i] ~= nil and self.voteCardHandlers[i] ~= nil then
