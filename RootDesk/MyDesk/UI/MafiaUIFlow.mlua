    end
    if self.voteAbstainEntity ~= nil and self.voteAbstainHandler ~= nil then
        self.voteAbstainEntity:DisconnectEvent(ButtonClickEvent, self.voteAbstainHandler)
    end
end

method void ResolveUI()
    self.lobbyRoot = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD")
    self.dayRoot   = _EntityService:GetEntityByPath("/ui/MafiaDayHUD")
    self.nightRoot = _EntityService:GetEntityByPath("/ui/MafiaNightHUD")
    self.legacyRoot = _EntityService:GetEntityByPath("/ui/MafiaPlayHUD")
    if self.lobbyRoot == nil or self.dayRoot == nil then return end

    if self.lobbyAvatarEntities == nil then self.lobbyAvatarEntities = {} end
    if self.lobbyRoomTexts == nil then self.lobbyRoomTexts = {} end
    if self.cachedLobbySeats == nil then self.cachedLobbySeats = {} end

    for i = 1, 8 do
        local avatarEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/RoomBadge" .. tostring(i) .. "/PlayerAvatar")
        local textEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/RoomBadge" .. tostring(i) .. "/Text")
        self.lobbyAvatarEntities[i] = avatarEntity
        if textEntity ~= nil then self.lobbyRoomTexts[i] = textEntity.TextComponent end
    end

    local entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/SkipButton")
    if entity ~= nil then
        self.lobbyReadyButton = entity.ButtonComponent
        self.lobbyReadyText = entity.TextComponent
    end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/InviteButton")
    if entity ~= nil then self.lobbyInviteButton = entity.ButtonComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/PlayerCountText")
    if entity ~= nil then self.lobbyPlayerCountText = entity.TextComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/VoteStatusText")
    if entity ~= nil then self.lobbyReadyStatusText = entity.TextComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/VoteHintText")
    if entity ~= nil then self.lobbyReadyHintText = entity.TextComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/ChatScroll")
    if entity ~= nil then self.lobbyChatScroll = entity.ScrollLayoutGroupComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/ChatScroll/ChatLogText")
    if entity ~= nil then
        self.lobbyChatLogText = entity.TextComponent
        entity.Enable = false
    end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/ChatInput")
    if entity ~= nil then self.lobbyChatInput = entity.TextInputComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/ChatSendButton")
    if entity ~= nil then self.lobbyChatSendButton = entity.ButtonComponent end
    self.lobbyOtherChatBubble = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/text")
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/text/NameText")
    if entity ~= nil then self.lobbyOtherChatNameText = entity.TextComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/text/MessageText")
    if entity ~= nil then self.lobbyOtherChatMessageText = entity.TextComponent end
    self.lobbyOwnChatBubble = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/text1")
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/text1/MessageText")
    if entity ~= nil then self.lobbyOwnChatMessageText = entity.TextComponent end
    if self.lobbyOtherChatBubble ~= nil then self.lobbyOtherChatBubble.Enable = false end
    if self.lobbyOwnChatBubble ~= nil then self.lobbyOwnChatBubble.Enable = false end

    if self.lobbyChatSlotRoots == nil then self.lobbyChatSlotRoots = {} end
    if self.lobbyChatSlotFrames == nil then self.lobbyChatSlotFrames = {} end
    if self.lobbyChatSlotOtherBubbles == nil then self.lobbyChatSlotOtherBubbles = {} end
    if self.lobbyChatSlotOtherNames == nil then self.lobbyChatSlotOtherNames = {} end
    if self.lobbyChatSlotOtherMessages == nil then self.lobbyChatSlotOtherMessages = {} end
    if self.lobbyChatSlotOwnBubbles == nil then self.lobbyChatSlotOwnBubbles = {} end
    if self.lobbyChatSlotOwnMessages == nil then self.lobbyChatSlotOwnMessages = {} end
    for i = 1, self.lobbyChatSlotCount do
        local slotIndex = tostring(i)
        local slotBasePath = "/ui/MafiaLobbyHUD/CenterPanel/LobbyChatSlot" .. slotIndex
        local slotRoot = _EntityService:GetEntityByPath(slotBasePath)
        if slotRoot == nil then
            slotBasePath = "/ui/MafiaLobbyHUD/LobbyChatSlot" .. slotIndex
            slotRoot = _EntityService:GetEntityByPath(slotBasePath)
        end
        self.lobbyChatSlotRoots[i] = slotRoot
        if slotRoot ~= nil then slotRoot.Enable = false end

        local frameEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/LobbyChatFrameSlot" .. slotIndex)
        if frameEntity == nil then
            frameEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/LobbyChatFrameSlot" .. slotIndex)
        end
        self.lobbyChatSlotFrames[i] = frameEntity
        if frameEntity ~= nil then frameEntity.Enable = false end

        local nameEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/LobbyChatNameSlot" .. slotIndex)
        if nameEntity == nil then
            nameEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/LobbyChatNameSlot" .. slotIndex)
        end
        if nameEntity ~= nil then
            self.lobbyChatSlotOtherNames[i] = nameEntity.TextComponent
            nameEntity.Enable = false
        end

        local otherBubble = slotRoot
        self.lobbyChatSlotOtherBubbles[i] = otherBubble
        if otherBubble ~= nil then otherBubble.Enable = false end

        entity = _EntityService:GetEntityByPath(slotBasePath .. "/OtherBubble/NameText")
        if entity ~= nil then self.lobbyChatSlotOtherNames[i] = entity.TextComponent end
        entity = _EntityService:GetEntityByPath(slotBasePath .. "/OtherBubble/MessageText")
        if entity ~= nil then self.lobbyChatSlotOtherMessages[i] = entity.TextComponent end
        if self.lobbyChatSlotOtherMessages[i] == nil and slotRoot ~= nil then
            self.lobbyChatSlotOtherMessages[i] = slotRoot.TextComponent
        end

        local ownBubble = slotRoot
        self.lobbyChatSlotOwnBubbles[i] = ownBubble
        if ownBubble ~= nil then ownBubble.Enable = false end

        entity = _EntityService:GetEntityByPath(slotBasePath .. "/OwnBubble/MessageText")
        if entity ~= nil then self.lobbyChatSlotOwnMessages[i] = entity.TextComponent end
        if self.lobbyChatSlotOwnMessages[i] == nil and slotRoot ~= nil then
            self.lobbyChatSlotOwnMessages[i] = slotRoot.TextComponent
        end
    end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/UISprite_2")
    if entity ~= nil then self.lobbyScrollUpButton = entity.ButtonComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/UISprite_3")
    if entity ~= nil then self.lobbyScrollDownButton = entity.ButtonComponent end
    entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/UISprite_1")
    if entity ~= nil then self.lobbyScrollThumb = entity end
    self.lobbyScrollTrack = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/UISprite")
