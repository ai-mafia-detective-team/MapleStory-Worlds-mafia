@Component
@ExecSpace("ClientOnly")
script MafiaPlayHUD extends Component

property TextComponent roomInfoText = "59f82016-b4fa-4667-b1b4-95b597a264de"
property TextComponent playerCountText = "d73f7d5f-1e91-41a3-8b6d-91346cce032f"
property TextComponent phaseTitleText = "68981ef5-680a-4b4a-8091-5f61066120c7"
property TextComponent phaseDescriptionText = "c55c3783-0bce-46be-84eb-09a8e6f06716"
property TextComponent dayText = "abe1b641-528f-4887-8d43-82093fa99b5f"
property TextComponent timerText = "ead4d679-64c6-44a3-9945-7892c1b1c3c3"
property TextComponent chatLogText = "e756dc13-85ca-4b43-a290-e1e35779f4e6"
property TextComponent voteStatusText = "ebc3c733-01d5-4430-b92f-679a75fcad46"
property TextComponent voteHintText = "3aeb832c-86da-4d7b-88f6-36bcc16f17eb"
property TextInputComponent chatInput = "17c12dc2-6640-4bb8-928f-9192d0eb09b7"
property ButtonComponent chatSendButton = "97de12ed-8cf9-4d63-9fb9-8b52b5fe6ca4"
property ButtonComponent skipButton = "2744ab76-af1b-43a8-8596-dbb504837c19"

property any chatSubmitHandler = nil
property any chatClickHandler = nil
property any skipClickHandler = nil
property number refreshAccumulator = 0
property string cachedChatLog = ""
property string cachedVoteStatus = ""
property integer cachedPhase = -1

method void OnBeginPlay()
    -- HUD 이벤트를 연결하고 최초 화면 상태를 적용한다.
    if self.chatInput ~= nil then
        self.chatInput.CharacterLimit = 100
        self.chatInput.AutoClear = true
        self.chatSubmitHandler = self.chatInput.Entity:ConnectEvent(TextInputSubmitEvent, self.HandleChatSubmit)
    end
    if self.chatSendButton ~= nil then
        self.chatClickHandler = self.chatSendButton.Entity:ConnectEvent(ButtonClickEvent, self.HandleChatClick)
    end
    if self.skipButton ~= nil then
        self.skipClickHandler = self.skipButton.Entity:ConnectEvent(ButtonClickEvent, self.HandleSkipClick)
    end
    self:RefreshHUD(true)
    log("[MafiaPlayHUD] 초기화 완료")
end

method void OnUpdate(number delta)
    -- HUD 갱신 빈도를 제한해 불필요한 매 프레임 문자열 생성을 줄인다.
    self.refreshAccumulator = self.refreshAccumulator + delta
    if self.refreshAccumulator < 0.1 then
        return
    end
    self.refreshAccumulator = 0
    self:RefreshHUD(false)
end

method void OnEndPlay()
    -- 등록한 UI 이벤트를 모두 해제한다.
    if self.chatInput ~= nil and self.chatSubmitHandler ~= nil then
        self.chatInput.Entity:DisconnectEvent(TextInputSubmitEvent, self.chatSubmitHandler)
    end
    if self.chatSendButton ~= nil and self.chatClickHandler ~= nil then
        self.chatSendButton.Entity:DisconnectEvent(ButtonClickEvent, self.chatClickHandler)
    end
    if self.skipButton ~= nil and self.skipClickHandler ~= nil then
        self.skipButton.Entity:DisconnectEvent(ButtonClickEvent, self.skipClickHandler)
    end
end

method void RefreshHUD(boolean force)
    -- 서버 게임 상태를 읽어 중앙 HUD 텍스트를 갱신한다.
    if _MafiaGameLogic == nil then
        return
    end

    local phase = _MafiaGameLogic.CurrentPhase
    if force or phase ~= self.cachedPhase then
        self.cachedPhase = phase
        self:RefreshPhase(phase)
    end

    local playerCount = #(_UserService.Users.Keys)
    self.playerCountText.Text = "플레이어  " .. tostring(playerCount) .. "/8"
    self.dayText.Text = tostring(math.max(1, _MafiaGameLogic.DayCount)) .. "일차"
    self.timerText.Text = self:FormatTime(_MafiaGameLogic.PhaseTimer)

    local chatLog = _MafiaGameLogic.ChatLog
    if force or chatLog ~= self.cachedChatLog then
        self.cachedChatLog = chatLog
        self:RefreshChat(chatLog)
    end

    local voteStatus = _MafiaGameLogic.VoteStatusList
    if force or voteStatus ~= self.cachedVoteStatus then
        self.cachedVoteStatus = voteStatus
        self:RefreshVoteStatus(voteStatus)
    end
end

method void RefreshPhase(integer phase)
    -- 현재 게임 단계에 맞는 제목, 설명, 버튼 상태를 설정한다.
    if phase == _MafiaGameLogic.PHASE_LOBBY then
        self.phaseTitleText.Text = "게임 대기실"
        self.phaseDescriptionText.Text = "플레이어가 모이기를 기다리고 있습니다."
    elseif phase == _MafiaGameLogic.PHASE_FREE_ROAM then
        self.phaseTitleText.Text = "낮 토론"
        self.phaseDescriptionText.Text = "모두가 자유롭게 의견을 나누는 시간입니다."
    elseif phase == _MafiaGameLogic.PHASE_NIGHT then
        self.phaseTitleText.Text = "밤"
        self.phaseDescriptionText.Text = "역할 행동을 선택하고 밤이 끝나기를 기다리세요."
    elseif phase == _MafiaGameLogic.PHASE_MORNING then
        self.phaseTitleText.Text = "아침 결과"
        self.phaseDescriptionText.Text = "지난 밤의 결과가 공개됩니다."
    elseif phase == _MafiaGameLogic.PHASE_MEETING then
        self.phaseTitleText.Text = "처형 후보 투표"
        self.phaseDescriptionText.Text = "의심되는 플레이어를 선택하거나 스킵하세요."
    elseif phase == _MafiaGameLogic.PHASE_MEETING_RESULT then
        self.phaseTitleText.Text = "투표 결과"
        self.phaseDescriptionText.Text = "투표 결과를 확인하고 있습니다."
    elseif phase == _MafiaGameLogic.PHASE_GAME_OVER then
        self.phaseTitleText.Text = "게임 종료"
        self.phaseDescriptionText.Text = "최종 결과를 확인해주세요."
    else
        self.phaseTitleText.Text = "커닝시티 마피아"
        self.phaseDescriptionText.Text = "게임 상태를 확인하고 있습니다."
    end

    if self.skipButton ~= nil then
        self.skipButton.Enable = (phase == _MafiaGameLogic.PHASE_MEETING)
    end
end

method void RefreshChat(string chatLog)
    -- 동기화된 채팅 로그를 화면 표시 형식으로 변환한다.
    if chatLog == nil or chatLog == "" then
        self.chatLogText.Text = "아직 등록된 메시지가 없습니다."
        return
    end

    local lines = {}
    for line in string.gmatch(chatLog, "[^\n]+") do
        local splitIndex = string.match(line, "()\t")
        if splitIndex ~= nil then
            local userId = string.sub(line, 1, splitIndex - 1)
            local message = string.sub(line, splitIndex + 1)
            lines[#lines + 1] = userId .. " : " .. message
        end
    end

    local startIndex = math.max(1, #lines - 7)
    local visibleLines = {}
    for i = startIndex, #lines do
        visibleLines[#visibleLines + 1] = lines[i]
    end
    self.chatLogText.Text = table.concat(visibleLines, "\n")
end

method void RefreshVoteStatus(string voteStatus)
    -- 투표 완료 인원을 세어 중앙 투표 현황에 표시한다.
    local count = 0
    if voteStatus ~= nil and voteStatus ~= "" then
        for _ in string.gmatch(voteStatus, "[^,]+") do
            count = count + 1
        end
    end
    self.voteStatusText.Text = tostring(count) .. "/8 투표"
    if count == 0 then
        self.voteHintText.Text = "아직 투표한 플레이어가 없습니다."
    else
        self.voteHintText.Text = tostring(count) .. "명이 선택을 완료했습니다."
    end
end

method string FormatTime(number seconds)
    -- 남은 초를 MM:SS 문자열로 변환한다.
    local safeSeconds = math.max(0, math.floor(seconds))
    local minutes = math.floor(safeSeconds / 60)
    local remainSeconds = safeSeconds % 60
    return string.format("%02d:%02d", minutes, remainSeconds)
end

method void HandleChatSubmit(TextInputSubmitEvent event)
    -- Enter 입력으로 제출된 채팅을 서버에 전달한다.
    self:SendChatMessage(event.Text)
end

method void HandleChatClick()
    -- 전송 버튼 클릭 시 현재 입력 내용을 서버에 전달한다.
    if self.chatInput == nil then
        return
    end
    self:SendChatMessage(self.chatInput.Text)
end

method void SendChatMessage(string message)
    -- 비어 있지 않은 채팅 메시지만 현재 사용자 ID와 함께 전송한다.
    if message == nil or message == "" then
        return
    end
    local userId = self:GetLocalUserId()
    if userId == "" then
        return
    end
    _MafiaGameLogic:SendChat(userId, message)
    if self.chatInput ~= nil then
        self.chatInput.Text = ""
    end
end

method void HandleSkipClick()
    -- 투표 단계에서 현재 플레이어의 스킵 표를 서버에 제출한다.
    if _MafiaGameLogic.CurrentPhase ~= _MafiaGameLogic.PHASE_MEETING then
        return
    end
    local userId = self:GetLocalUserId()
    if userId ~= "" then
        _MafiaGameLogic:SubmitVote(userId, "")
    end
end

method string GetLocalUserId()
    -- 로컬 플레이어 엔티티와 일치하는 사용자 ID를 찾는다.
    local localPlayer = _UserService.LocalPlayer
    if localPlayer == nil then
        return ""
    end
    local keys = _UserService.Users.Keys
    for _, userId in ipairs(keys) do
        local entity = _UserService:GetUserEntityByUserId(tostring(userId))
        if entity == localPlayer then
            return tostring(userId)
        end
    end
    return ""
end

end
