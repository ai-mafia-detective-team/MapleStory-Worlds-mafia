@Logic
@ExecSpace("ClientOnly")
script ShopController extends Logic

	property string PANEL_PATH = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/ShopPopup/Panel"

	-- ── Handler storage ──────────────────────────────────────────────────────
	property any categoryHandlers  = nil
	property any cardBuyHandlers   = nil
	property any defaultBtnHandler = nil
	property any previewBtnHandler = nil
	property any useBarBuyHandler  = nil
	property any useBarUseHandler  = nil

	-- ── Selection state ───────────────────────────────────────────────────────
	property string selectedCategory = "전체"
	property integer selectedItemId  = -1

	-- ── Costume catalog (dummy data; replace once real data is available) ─────
	-- structure: { id, name, category, price, grade, desc }
	property any costumeData = nil
	property string pendingOwnedJson = ""

	method void OnBeginPlay()
		-- Build dummy catalog then wire all shop buttons.
		self:InitCostumeData()
		self:WireButtons()
		log("[ShopController] initialized")
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Data
	-- ─────────────────────────────────────────────────────────────────────────

	method void InitCostumeData()
		-- Populate static dummy entries; real data will replace this table.
		self.costumeData = {
			{ id=1, name="수사관 정장", category="상의", priceType="free", price=1200, grade="일반", desc="단정한 기본 수사 의상입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=2, name="엘리트 코트", category="상의", priceType="paid", price=280, grade="고급", desc="베테랑 수사관의 롱코트입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=3, name="수사관 더비", category="신발", priceType="free", price=600, grade="일반", desc="기본 지급 가죽 구두입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=4, name="택티컬 부츠", category="신발", priceType="paid", price=180, grade="희귀", desc="험지 대응형 전술화입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=5, name="클래식 모자", category="장식", priceType="free", price=800, grade="일반", desc="클래식한 수사관용 모자입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=6, name="탐정 장식", category="장식", priceType="paid", price=90, grade="고급", desc="탐정의 상징적인 장식입니다.", owned=false, equipped=false, imageRuid="" },
		}
		if self.pendingOwnedJson ~= "" then self:ApplyOwnedState(self.pendingOwnedJson) end
	end

	method any GetFilteredCostumes()
		-- Returns the subset of costumeData matching selectedCategory.
		if self.costumeData == nil then return {} end
		if self.selectedCategory == "전체" then return self.costumeData end
		local result = {}
		for _, item in ipairs(self.costumeData) do
			if (self.selectedCategory == "보유중" and item.owned == true) or item.category == self.selectedCategory then
				result[#result + 1] = item
			end
		end
		return result
	end

	method any FindCostume(integer itemId)
		if self.costumeData == nil then return nil end
		for _, item in ipairs(self.costumeData) do
			if item.id == itemId then return item end
		end
		return nil
	end

	method string FormatPrice(any costume)
		if costume.priceType == "paid" then return "캐시 " .. tostring(costume.price) end
		return "코인 " .. tostring(costume.price)
	end

	method void ApplyOwnedState(string ownedJson)
		self.pendingOwnedJson = ownedJson or ""
		if self.costumeData == nil or ownedJson == nil or ownedJson == "" then return end
		local owned = _HttpService:JSONDecode(ownedJson)
		if owned == nil then return end
		for _, item in ipairs(self.costumeData) do
			item.owned = owned[tostring(item.id)] == true
		end
		self:RefreshCardGrid()
		if self.selectedItemId >= 0 then
			local selected = self:FindCostume(self.selectedItemId)
			if selected ~= nil then self:ShowDetailPanel(selected) end
		end
		log("[ShopController] owned state applied")
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Wiring
	-- ─────────────────────────────────────────────────────────────────────────

	method void WireButtons()
		-- Wire category buttons, card BuyBtns, preview buttons, and UseBar buttons.
		local panel = self.PANEL_PATH

		-- Category buttons
		local cats = { "전체", "상의", "하의", "신발", "장식", "세트", "보유중" }
		self.categoryHandlers = {}
		for _, cat in ipairs(cats) do
			local ent = _EntityService:GetEntityByPath(panel .. "/CategoryPanel/Cat_" .. cat)
			if ent ~= nil and isvalid(ent) then
				self.categoryHandlers[cat] = ent:ConnectEvent(ButtonClickEvent, self.OnCategoryClicked)
			end
		end

		-- ItemCard BuyBtns (selecting an item for detail review)
		self.cardBuyHandlers = {}
		for i = 1, 6 do
			local buyEnt = _EntityService:GetEntityByPath(panel .. "/GridPanel/ItemCard_" .. tostring(i) .. "/BuyBtn")
			if buyEnt ~= nil and isvalid(buyEnt) then
				self.cardBuyHandlers[i] = buyEnt:ConnectEvent(ButtonClickEvent, self.OnCardBuyClicked)
			end
		end

		-- Preview panel buttons
		local defaultEnt = _EntityService:GetEntityByPath(panel .. "/PreviewPanel/DefaultBtn")
		if defaultEnt ~= nil and isvalid(defaultEnt) then
			self.defaultBtnHandler = defaultEnt:ConnectEvent(ButtonClickEvent, self.OnDefaultBtnClicked)
		end
		local previewEnt = _EntityService:GetEntityByPath(panel .. "/PreviewPanel/PreviewBtn")
		if previewEnt ~= nil and isvalid(previewEnt) then
			self.previewBtnHandler = previewEnt:ConnectEvent(ButtonClickEvent, self.OnPreviewBtnClicked)
		end

		-- UseBar action buttons
		local buyBarEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/BuyBtn")
		if buyBarEnt ~= nil and isvalid(buyBarEnt) then
			self.useBarBuyHandler = buyBarEnt:ConnectEvent(ButtonClickEvent, self.OnUseBarBuyClicked)
		end
		local useEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/UseBtn")
		if useEnt ~= nil and isvalid(useEnt) then
			self.useBarUseHandler = useEnt:ConnectEvent(ButtonClickEvent, self.OnUseBarUseClicked)
		end

		-- Initial grid render
		self:RefreshCardGrid()
		log("[ShopController] buttons wired")
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Category
	-- ─────────────────────────────────────────────────────────────────────────

	method void OnCategoryClicked(any event)
		-- Switch active category; re-render grid and reset selection.
		if event == nil or event.Entity == nil then return end
		local entName = event.Entity.Name
		-- Button names are "Cat_전체", "Cat_상의", … → skip the "Cat_" prefix
		if #entName <= 4 then return end
		local cat = string.sub(entName, 5)
		self.selectedCategory = cat
		self.selectedItemId   = -1
		self:UpdateCategoryVisuals()
		self:RefreshCardGrid()
		self:ClearDetailPanel()
		log("[ShopController] category=" .. cat)
	end

	method void UpdateCategoryVisuals()
		-- Applies gold highlight to the active category button, dims others.
		local panel = self.PANEL_PATH
		local cats = { "전체", "상의", "하의", "신발", "장식", "세트", "보유중" }
		for _, cat in ipairs(cats) do
			local ent = _EntityService:GetEntityByPath(panel .. "/CategoryPanel/Cat_" .. cat)
			if ent ~= nil and isvalid(ent) then
				local active = (cat == self.selectedCategory)
				local spriteComp = ent.SpriteGUIRendererComponent
				if spriteComp ~= nil then
					if active then
						spriteComp.Color = Color(0.92, 0.82, 0.42, 1.0)
					else
						spriteComp.Color = Color(0.12, 0.12, 0.22, 0.88)
					end
				end
				local textComp = ent.TextComponent
				if textComp ~= nil then
					if active then
						textComp.FontColor = Color(0.05, 0.05, 0.12, 1.0)
					else
						textComp.FontColor = Color(0.78, 0.78, 0.78, 1.0)
					end
				end
			end
		end
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Card grid
	-- ─────────────────────────────────────────────────────────────────────────

	method void RefreshCardGrid()
		-- Fills visible card slots with the current category's costumes.
		local panel    = self.PANEL_PATH
		local filtered = self:GetFilteredCostumes()
		for i = 1, 6 do
			local cardPath = panel .. "/GridPanel/ItemCard_" .. tostring(i)
			local cardEnt  = _EntityService:GetEntityByPath(cardPath)
			if cardEnt ~= nil and isvalid(cardEnt) then
				local costume = filtered[i]
				if costume ~= nil then
					cardEnt.Enable = true
					local nameEnt = _EntityService:GetEntityByPath(cardPath .. "/ItemName")
					if nameEnt ~= nil and isvalid(nameEnt) then
						local tc = nameEnt.TextComponent
						if tc ~= nil then tc.Text = costume.name end
					end
					local priceEnt = _EntityService:GetEntityByPath(cardPath .. "/ItemPrice")
					if priceEnt ~= nil and isvalid(priceEnt) then
						local tc = priceEnt.TextComponent
						if tc ~= nil then tc.Text = costume.owned and "보유 중" or self:FormatPrice(costume) end
					end
					local buyEnt = _EntityService:GetEntityByPath(cardPath .. "/BuyBtn")
					if buyEnt ~= nil and isvalid(buyEnt) and buyEnt.TextComponent ~= nil then
						buyEnt.TextComponent.Text = costume.owned and "보유중" or "선택"
					end
					local badgeEnt = _EntityService:GetEntityByPath(cardPath .. "/ItemBadge")
					if badgeEnt ~= nil and isvalid(badgeEnt) then
						local isSpecial = costume.grade ~= "일반"
						badgeEnt.Enable = isSpecial
						if isSpecial then
							local tc = badgeEnt.TextComponent
							if tc ~= nil then tc.Text = costume.grade end
						end
					end
				else
					cardEnt.Enable = false
				end
			end
		end
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Card interaction
	-- ─────────────────────────────────────────────────────────────────────────

	method void OnCardBuyClicked(any event)
		-- Clicking a card's BuyBtn selects it and populates the UseBar detail panel.
		if event == nil or event.Entity == nil then return end
		local panel    = self.PANEL_PATH
		local filtered = self:GetFilteredCostumes()
		for i = 1, 6 do
			local buyEnt = _EntityService:GetEntityByPath(panel .. "/GridPanel/ItemCard_" .. tostring(i) .. "/BuyBtn")
			if buyEnt ~= nil and isvalid(buyEnt) and buyEnt == event.Entity then
				local costume = filtered[i]
				if costume ~= nil then
					self.selectedItemId = costume.id
					self:ShowDetailPanel(costume)
					log("[ShopController] card selected index=" .. tostring(i) .. " id=" .. tostring(costume.id))
				end
				break
			end
		end
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Detail panel (UseBar)
	-- ─────────────────────────────────────────────────────────────────────────

	method void ShowDetailPanel(any costume)
		-- Fills UseBar fields with the selected costume's data.
		local panel = self.PANEL_PATH
		local labelEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/SelLabel")
		if labelEnt ~= nil and isvalid(labelEnt) then labelEnt.Enable = false end

		local nameEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/SelItemName")
		if nameEnt ~= nil and isvalid(nameEnt) then
			nameEnt.Enable = true
			local tc = nameEnt.TextComponent
			if tc ~= nil then tc.Text = costume.name end
		end
		local gradeEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/SelGrade")
		if gradeEnt ~= nil and isvalid(gradeEnt) then
			gradeEnt.Enable = true
			local tc = gradeEnt.TextComponent
			if tc ~= nil then tc.Text = "[" .. costume.grade .. "]" end
		end
		local descEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/SelDesc")
		if descEnt ~= nil and isvalid(descEnt) then
			descEnt.Enable = true
			local tc = descEnt.TextComponent
			if tc ~= nil then tc.Text = costume.desc end
		end
		local priceEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/SelPrice")
		if priceEnt ~= nil and isvalid(priceEnt) then
			priceEnt.Enable = true
			local tc = priceEnt.TextComponent
			if tc ~= nil then tc.Text = costume.owned and "보유 중" or self:FormatPrice(costume) end
		end
		local buyButton = _EntityService:GetEntityByPath(panel .. "/UseBar/BuyBtn")
		if buyButton ~= nil and isvalid(buyButton) and buyButton.TextComponent ~= nil then
			buyButton.TextComponent.Text = costume.owned and "보유중" or "구매"
		end
	end

	method void ClearDetailPanel()
		-- Resets UseBar to the placeholder state (no item selected).
		local panel = self.PANEL_PATH
		local labelEnt = _EntityService:GetEntityByPath(panel .. "/UseBar/SelLabel")
		if labelEnt ~= nil and isvalid(labelEnt) then labelEnt.Enable = true end

		local namePaths = { "SelItemName", "SelGrade", "SelDesc", "SelPrice" }
		for _, rel in ipairs(namePaths) do
			local ent = _EntityService:GetEntityByPath(panel .. "/UseBar/" .. rel)
			if ent ~= nil and isvalid(ent) then ent.Enable = false end
		end
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- UseBar actions
	-- ─────────────────────────────────────────────────────────────────────────

	method void OnUseBarBuyClicked(any event)
		-- Confirms purchase of the currently selected item.
		if self.selectedItemId < 0 then
			if _UIToast ~= nil then _UIToast:ShowMessage("구매할 의상을 선택하세요.") end
			return
		end
		local costume = self:FindCostume(self.selectedItemId)
		if costume == nil then return end
		if costume.owned == true then
			if _UIToast ~= nil then _UIToast:ShowMessage("이미 보유한 의상입니다.") end
			return
		end
		_MoneyManager:RequestPurchase(self.selectedItemId)
		log("[ShopController] purchase requested itemId=" .. tostring(self.selectedItemId))
	end

	method void HandlePurchaseResult(boolean success, string resultCode, integer itemId)
		if success then
			local item = self:FindCostume(itemId)
			if item ~= nil then item.owned = true end
			self:RefreshCardGrid()
			if item ~= nil then self:ShowDetailPanel(item) end
			if _UIToast ~= nil then _UIToast:ShowMessage("의상을 구매했습니다.") end
			log("[ShopController] purchase completed itemId=" .. tostring(itemId))
			return
		end
		local message = "구매에 실패했습니다."
		if resultCode == "NOT_ENOUGH_FREE" then message = "코인이 부족합니다." end
		if resultCode == "NOT_ENOUGH_PAID" then message = "캐시가 부족합니다." end
		if resultCode == "ALREADY_OWNED" then message = "이미 보유한 의상입니다." end
		if resultCode == "SAVE_FAILED" then message = "구매 정보를 저장하지 못했습니다." end
		if _UIToast ~= nil then _UIToast:ShowMessage(message) end
		log_warning("[ShopController] purchase failed itemId=" .. tostring(itemId) .. " code=" .. resultCode)
	end

	method void OnUseBarUseClicked(any event)
		-- Equips the currently selected item.
		if self.selectedItemId < 0 then
			if _UIToast ~= nil then _UIToast:ShowMessage("착용할 의상을 선택하세요.") end
			return
		end
		if _UIToast ~= nil then _UIToast:ShowMessage("착용 기능은 준비 중입니다.") end
		log("[ShopController] use clicked itemId=" .. tostring(self.selectedItemId))
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Preview panel
	-- ─────────────────────────────────────────────────────────────────────────

	method void OnDefaultBtnClicked(any event)
		-- Reverts to the default costume (placeholder until equip system is ready).
		if _UIToast ~= nil then _UIToast:ShowMessage("기본 복장으로 전환합니다.") end
		log("[ShopController] default costume clicked")
	end

	method void OnPreviewBtnClicked(any event)
		-- Shows a costume preview (placeholder).
		if _UIToast ~= nil then _UIToast:ShowMessage("미리보기 기능은 준비 중입니다.") end
		log("[ShopController] preview clicked")
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Cleanup
	-- ─────────────────────────────────────────────────────────────────────────

	method void OnEndPlay()
		-- Disconnects all wired event handlers.
		local panel = self.PANEL_PATH
		local cats = { "전체", "상의", "하의", "신발", "장식", "세트", "보유중" }

		if self.categoryHandlers ~= nil then
			for _, cat in ipairs(cats) do
				local h = self.categoryHandlers[cat]
				if h ~= nil then
					local ent = _EntityService:GetEntityByPath(panel .. "/CategoryPanel/Cat_" .. cat)
					if ent ~= nil and isvalid(ent) then
						ent:DisconnectEvent(ButtonClickEvent, h)
					end
				end
			end
			self.categoryHandlers = nil
		end

		if self.cardBuyHandlers ~= nil then
			for i = 1, 6 do
				local h = self.cardBuyHandlers[i]
				if h ~= nil then
					local ent = _EntityService:GetEntityByPath(panel .. "/GridPanel/ItemCard_" .. tostring(i) .. "/BuyBtn")
					if ent ~= nil and isvalid(ent) then
						ent:DisconnectEvent(ButtonClickEvent, h)
					end
				end
			end
			self.cardBuyHandlers = nil
		end

		if self.defaultBtnHandler ~= nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/PreviewPanel/DefaultBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.defaultBtnHandler) end
			self.defaultBtnHandler = nil
		end
		if self.previewBtnHandler ~= nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/PreviewPanel/PreviewBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.previewBtnHandler) end
			self.previewBtnHandler = nil
		end
		if self.useBarBuyHandler ~= nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/UseBar/BuyBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.useBarBuyHandler) end
			self.useBarBuyHandler = nil
		end
		if self.useBarUseHandler ~= nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/UseBar/UseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.useBarUseHandler) end
			self.useBarUseHandler = nil
		end

		self.costumeData = nil
		log("[ShopController] cleanup done")
	end

end
