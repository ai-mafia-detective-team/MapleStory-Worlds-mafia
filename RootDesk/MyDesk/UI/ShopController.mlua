@Logic
@ExecSpace("ClientOnly")
script ShopController extends Logic

	-- Retargeted onto the current ShopPopup layout. The previous version drove
	-- Panel/GridPanel/ItemCard_* + Panel/UseBar/*, which no longer exist in the .ui
	-- (they survive only as disabled 10x10 stubs), so every GetEntityByPath returned
	-- nil and the shop never showed real data. The live layout is:
	--   Panel/Body/ProductPanel/ProductGrid/ProductCard_01..08
	--   Panel/Body/ProductPanel/Pagination/{PrevBtn,PageText,NextBtn}
	--   Panel/Body/ProductDetailPanel/*
	--   Panel/CategoryBar/Category_*  ·  Panel/PurchaseBar/*  ·  Panel/Header/CurrencyPanel/*
	property string PANEL_PATH = "/ui/UI_Lobby/LobbyRoot/ButtonGroup/ShopPopup/Panel"

	-- The grid has 8 slots, so a page holds 8 items.
	property integer PAGE_SIZE = 8

	property string CATEGORY_ACTIVE_RUID = "1bbac083829c4c738b351ea238bef7fd"
	property string CATEGORY_INACTIVE_RUID = "10c10be2edab40e0a5be2c78492f8ab9"

	-- ── Handler storage ──────────────────────────────────────────────────────
	property any categoryHandlers = nil
	property any cardHandlers     = nil
	property any purchaseHandler  = nil
	property any prevPageHandler  = nil
	property any nextPageHandler  = nil

	-- ── Selection state ───────────────────────────────────────────────────────
	property string selectedCategory = "전체"
	property integer selectedItemId  = -1
	property integer currentPage     = 1

	-- ── Costume catalog (dummy data; replace once real data is available) ─────
	property any costumeData = nil
	property string pendingOwnedJson = ""

	method void OnBeginPlay()
		-- The shop is a pure view: the Logic also spins up server-side, where none of the
		-- UI entities exist, so bail out there instead of warning about every missing node.
		if self:IsServer() then return end

		self:InitCostumeData()
		self:WireButtons()
		self:HighlightCategory(self.selectedCategory)
		self:ClearDetailPanel()
		self:RefreshCardGrid()
		log("[ShopController] initialized")
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Data
	-- ─────────────────────────────────────────────────────────────────────────

	method void InitCostumeData()
		-- 10 entries so every CategoryBar button has content and the grid spans 2 pages.
		self.costumeData = {
			{ id=1,  name="수사관 정장",     category="상의", priceType="free", price=1200, grade="일반", desc="단정한 기본 수사 의상입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=2,  name="엘리트 코트",     category="상의", priceType="paid", price=280,  grade="고급", desc="베테랑 수사관의 롱코트입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=3,  name="수사관 더비",     category="신발", priceType="free", price=600,  grade="일반", desc="기본 지급 가죽 구두입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=4,  name="택티컬 부츠",     category="신발", priceType="paid", price=180,  grade="희귀", desc="험지 대응형 전술화입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=5,  name="클래식 모자",     category="장식", priceType="free", price=800,  grade="일반", desc="클래식한 수사관용 모자입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=6,  name="탐정 장식",       category="장식", priceType="paid", price=90,   grade="고급", desc="탐정의 상징적인 장식입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=7,  name="수사관 슬랙스",   category="하의", priceType="free", price=900,  grade="일반", desc="활동성을 살린 기본 정장 바지입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=8,  name="잠복용 카고팬츠", category="하의", priceType="paid", price=150,  grade="고급", desc="장비를 넣을 주머니가 많은 잠복용 바지입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=9,  name="정예 수사관 세트", category="세트", priceType="paid", price=450,  grade="희귀", desc="정예 수사관 복장 한 벌입니다.", owned=false, equipped=false, imageRuid="" },
			{ id=10, name="야간 잠복 세트",   category="세트", priceType="free", price=2000, grade="고급", desc="야간 잠복 전용 복장 한 벌입니다.", owned=false, equipped=false, imageRuid="" },
		}
		if self.pendingOwnedJson ~= "" then self:ApplyOwnedState(self.pendingOwnedJson) end
	end

	method table GetCategoryButtons()
		-- CategoryBar node name -> catalog category value.
		return {
			{ node = "Category_All",       category = "전체" },
			{ node = "Category_Top",       category = "상의" },
			{ node = "Category_Bottom",    category = "하의" },
			{ node = "Category_Shoes",     category = "신발" },
			{ node = "Category_Accessory", category = "장식" },
			{ node = "Category_Set",       category = "세트" },
		}
	end

	method any GetFilteredCostumes()
		-- Returns the subset of costumeData matching selectedCategory.
		if self.costumeData == nil then return {} end
		if self.selectedCategory == "전체" then return self.costumeData end
		local result = {}
		for _, item in ipairs(self.costumeData) do
			if item.category == self.selectedCategory then
				result[#result + 1] = item
			end
		end
		return result
	end

	method any FindCostume(integer itemId)
		if self.costumeData == nil then return nil end
		for _, item in ipairs(self.costumeData) do
			if item.id == itemId then return item end
		end
		return nil
	end

	method string FormatPrice(any costume)
		if costume.priceType == "paid" then return "캐시 " .. tostring(costume.price) end
		return "메소 " .. tostring(costume.price)
	end

	method void ApplyOwnedState(string ownedJson)
		-- Server-owned purchase state arrives here via MoneyManager.
		self.pendingOwnedJson = ownedJson or ""
		if self.costumeData == nil or ownedJson == nil or ownedJson == "" then return end
		local owned = _HttpService:JSONDecode(ownedJson)
		if owned == nil then return end
		for _, item in ipairs(self.costumeData) do
			item.owned = owned[tostring(item.id)] == true
		end
		self:RefreshCardGrid()
		if self.selectedItemId >= 0 then
			local selected = self:FindCostume(self.selectedItemId)
			if selected ~= nil then self:ShowDetailPanel(selected) end
		end
		log("[ShopController] owned state applied")
	end

	method void ApplyMoney(integer paidMoney, integer freeMoney)
		-- Mirrors the balances into the shop header's own currency boxes.
		local header = self.PANEL_PATH .. "/Header/CurrencyPanel"
		self:SetText(header .. "/PaidMoneyBox/ValueText", tostring(paidMoney))
		self:SetText(header .. "/FreeMoneyBox/ValueText", tostring(freeMoney))
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Small helpers
	-- ─────────────────────────────────────────────────────────────────────────

	method void SetText(string path, string value)
		-- Guarded text write so one missing node cannot abort a whole repaint.
		local ent = _EntityService:GetEntityByPath(path)
		if ent ~= nil and isvalid(ent) and ent.TextComponent ~= nil then
			ent.TextComponent.Text = value
		end
	end

	method void SetEnabled(string path, boolean enabled)
		local ent = _EntityService:GetEntityByPath(path)
		if ent ~= nil and isvalid(ent) then ent:SetEnable(enabled) end
	end

	method integer GetPageCount(integer totalItems)
		if totalItems <= 0 then return 1 end
		return math.ceil(totalItems / self.PAGE_SIZE)
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Wiring
	-- ─────────────────────────────────────────────────────────────────────────

	method void WireButtons()
		-- Category bar, product cards, pagination arrows, purchase button.
		local panel = self.PANEL_PATH

		if self.categoryHandlers == nil then
			self.categoryHandlers = {}
			for _, entry in ipairs(self:GetCategoryButtons()) do
				local ent = _EntityService:GetEntityByPath(panel .. "/CategoryBar/" .. entry.node)
				if ent ~= nil and isvalid(ent) then
					local capturedCategory = entry.category
					local h = ent:ConnectEvent(ButtonClickEvent, function() self:SelectCategory(capturedCategory) end)
					self.categoryHandlers[#self.categoryHandlers + 1] = { entity = ent, eventHandler = h }
				else
					log_warning("[ShopController] category button missing: " .. entry.node)
				end
			end
		end

		if self.cardHandlers == nil then
			self.cardHandlers = {}
			for slot = 1, self.PAGE_SIZE do
				local ent = _EntityService:GetEntityByPath(panel .. "/Body/ProductPanel/ProductGrid/ProductCard_0" .. tostring(slot))
				if ent ~= nil and isvalid(ent) then
					local capturedSlot = slot
					local h = ent:ConnectEvent(ButtonClickEvent, function() self:OnCardClicked(capturedSlot) end)
					self.cardHandlers[#self.cardHandlers + 1] = { entity = ent, eventHandler = h }
				end
			end
		end

		if self.prevPageHandler == nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/Body/ProductPanel/Pagination/PrevBtn")
			if ent ~= nil and isvalid(ent) then
				self.prevPageHandler = ent:ConnectEvent(ButtonClickEvent, self.OnPrevPage)
			end
		end
		if self.nextPageHandler == nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/Body/ProductPanel/Pagination/NextBtn")
			if ent ~= nil and isvalid(ent) then
				self.nextPageHandler = ent:ConnectEvent(ButtonClickEvent, self.OnNextPage)
			end
		end

		if self.purchaseHandler == nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/PurchaseBar/PurchaseBtn")
			if ent ~= nil and isvalid(ent) then
				self.purchaseHandler = ent:ConnectEvent(ButtonClickEvent, self.OnPurchaseClicked)
			end
		end

		log("[ShopController] buttons wired categories=" .. tostring(#self.categoryHandlers) .. " cards=" .. tostring(#self.cardHandlers))
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Category
	-- ─────────────────────────────────────────────────────────────────────────

	method void SelectCategory(string category)
		-- Switch active category; reset to page 1 and drop the selection.
		self.selectedCategory = category
		self.currentPage = 1
		self.selectedItemId = -1
		self:HighlightCategory(category)
		self:ClearDetailPanel()
		self:RefreshCardGrid()
		log("[ShopController] category=" .. category)
	end

	method void HighlightCategory(string category)
		-- Swaps the category button background while preserving its label text.
		local panel = self.PANEL_PATH
		local white = Color(1.0, 1.0, 1.0, 1.0)
		for _, entry in ipairs(self:GetCategoryButtons()) do
			local ent = _EntityService:GetEntityByPath(panel .. "/CategoryBar/" .. entry.node)
			if ent ~= nil and isvalid(ent) and ent.SpriteGUIRendererComponent ~= nil then
				if entry.category == category then
					ent.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CATEGORY_ACTIVE_RUID)
				else
					ent.SpriteGUIRendererComponent.ImageRUID = DataRef(self.CATEGORY_INACTIVE_RUID)
				end
				ent.SpriteGUIRendererComponent.Color = white
			end
		end
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Card grid + pagination
	-- ─────────────────────────────────────────────────────────────────────────

	method void RefreshCardGrid()
		-- Fills the 8 product slots with the current category's page of costumes.
		local grid = self.PANEL_PATH .. "/Body/ProductPanel/ProductGrid"
		local filtered = self:GetFilteredCostumes()
		local totalPages = self:GetPageCount(#filtered)
		if self.currentPage > totalPages then self.currentPage = totalPages end
		if self.currentPage < 1 then self.currentPage = 1 end

		local offset = (self.currentPage - 1) * self.PAGE_SIZE
		for slot = 1, self.PAGE_SIZE do
			local cardPath = grid .. "/ProductCard_0" .. tostring(slot)
			local cardEnt = _EntityService:GetEntityByPath(cardPath)
			if cardEnt ~= nil and isvalid(cardEnt) then
				local costume = filtered[offset + slot]
				if costume == nil then
					cardEnt:SetEnable(false)
				else
					cardEnt:SetEnable(true)
					self:SetText(cardPath .. "/ItemNameText", costume.name)
					if costume.owned == true then
						self:SetText(cardPath .. "/PriceRow/PriceText", "보유 중")
					else
						self:SetText(cardPath .. "/PriceRow/PriceText", self:FormatPrice(costume))
					end

					-- Grade badge only for anything above 일반.
					local isSpecial = costume.grade ~= "일반"
					self:SetEnabled(cardPath .. "/GradeBadge", isSpecial)
					if isSpecial then
						self:SetText(cardPath .. "/GradeBadge/GradeText", costume.grade)
					end

					self:SetEnabled(cardPath .. "/OwnedBadge", costume.owned == true)
					self:SetEnabled(cardPath .. "/SelectedBorder", costume.id == self.selectedItemId)
				end
			end
		end

		self:UpdatePaginationUI(self.currentPage, totalPages)
		log("[ShopController] grid refreshed category=" .. self.selectedCategory ..
			" page=" .. tostring(self.currentPage) .. "/" .. tostring(totalPages) ..
			" items=" .. tostring(#filtered))
	end

	method void UpdatePaginationUI(integer page, integer totalPages)
		-- "n / m" plus greyed-out arrows at the ends of the range.
		local pagination = self.PANEL_PATH .. "/Body/ProductPanel/Pagination"
		self:SetText(pagination .. "/PageText", tostring(page) .. " / " .. tostring(totalPages))

		local prev = _EntityService:GetEntityByPath(pagination .. "/PrevBtn")
		if prev ~= nil and isvalid(prev) and prev.SpriteGUIRendererComponent ~= nil then
			if page > 1 then
				prev.SpriteGUIRendererComponent.Color = Color(0.85, 0.85, 0.85, 1.0)
			else
				prev.SpriteGUIRendererComponent.Color = Color(0.85, 0.85, 0.85, 0.35)
			end
		end
		local next = _EntityService:GetEntityByPath(pagination .. "/NextBtn")
		if next ~= nil and isvalid(next) and next.SpriteGUIRendererComponent ~= nil then
			if page < totalPages then
				next.SpriteGUIRendererComponent.Color = Color(0.85, 0.85, 0.85, 1.0)
			else
				next.SpriteGUIRendererComponent.Color = Color(0.85, 0.85, 0.85, 0.35)
			end
		end
	end

	method void OnPrevPage(ButtonClickEvent event)
		if self.currentPage <= 1 then return end
		self.currentPage = self.currentPage - 1
		self:RefreshCardGrid()
	end

	method void OnNextPage(ButtonClickEvent event)
		local totalPages = self:GetPageCount(#(self:GetFilteredCostumes()))
		if self.currentPage >= totalPages then return end
		self.currentPage = self.currentPage + 1
		self:RefreshCardGrid()
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Card interaction
	-- ─────────────────────────────────────────────────────────────────────────

	method void OnCardClicked(integer slot)
		-- `slot` is the 1..8 grid position; map it onto the filtered+paged list.
		local filtered = self:GetFilteredCostumes()
		local costume = filtered[(self.currentPage - 1) * self.PAGE_SIZE + slot]
		if costume == nil then return end
		self.selectedItemId = costume.id
		self:ShowDetailPanel(costume)
		self:RefreshCardGrid()
		log("[ShopController] card selected slot=" .. tostring(slot) .. " id=" .. tostring(costume.id))
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Detail panel + purchase bar
	-- ─────────────────────────────────────────────────────────────────────────

	method void ShowDetailPanel(any costume)
		-- Fills ProductDetailPanel and the bottom PurchaseBar for the selected costume.
		local panel = self.PANEL_PATH
		local detail = panel .. "/Body/ProductDetailPanel"

		self:SetEnabled(detail .. "/EmptyState", false)
		self:SetText(detail .. "/ItemNameText", costume.name)
		self:SetText(detail .. "/CategoryRow/ValueText", costume.category)
		self:SetText(detail .. "/GradeRow/ValueText", costume.grade)
		self:SetText(detail .. "/DescriptionText", costume.desc)
		if costume.owned == true then
			self:SetText(detail .. "/OwnershipText", "보유 중")
		else
			self:SetText(detail .. "/OwnershipText", "미보유")
		end

		local bar = panel .. "/PurchaseBar"
		self:SetText(bar .. "/SelectedItemText", costume.name)
		if costume.owned == true then
			self:SetText(bar .. "/PriceBox/PriceText", "보유 중")
			self:SetText(bar .. "/PurchaseBtn/LabelText", "보유중")
		else
			self:SetText(bar .. "/PriceBox/PriceText", self:FormatPrice(costume))
			self:SetText(bar .. "/PurchaseBtn/LabelText", "구매")
		end
	end

	method void ClearDetailPanel()
		-- Back to the "pick an item" state.
		local panel = self.PANEL_PATH
		local detail = panel .. "/Body/ProductDetailPanel"

		self:SetEnabled(detail .. "/EmptyState", true)
		self:SetText(detail .. "/ItemNameText", "")
		self:SetText(detail .. "/CategoryRow/ValueText", "")
		self:SetText(detail .. "/GradeRow/ValueText", "")
		self:SetText(detail .. "/DescriptionText", "")
		self:SetText(detail .. "/OwnershipText", "")

		local bar = panel .. "/PurchaseBar"
		self:SetText(bar .. "/SelectedItemText", "의상을 선택하세요")
		self:SetText(bar .. "/PriceBox/PriceText", "-")
		self:SetText(bar .. "/PurchaseBtn/LabelText", "구매")
	end

	method void OnPurchaseClicked(ButtonClickEvent event)
		-- Confirms purchase of the currently selected item.
		if self.selectedItemId < 0 then
			if _UIToast ~= nil then _UIToast:ShowMessage("구매할 의상을 선택하세요.") end
			return
		end
		local costume = self:FindCostume(self.selectedItemId)
		if costume == nil then return end
		if costume.owned == true then
			if _UIToast ~= nil then _UIToast:ShowMessage("이미 보유한 의상입니다.") end
			return
		end
		_MoneyManager:RequestPurchase(self.selectedItemId)
		log("[ShopController] purchase requested itemId=" .. tostring(self.selectedItemId))
	end

	method void HandlePurchaseResult(boolean success, string resultCode, integer itemId)
		-- Called back by MoneyManager after the server settles the purchase.
		if success then
			local item = self:FindCostume(itemId)
			if item ~= nil then item.owned = true end
			self:RefreshCardGrid()
			if item ~= nil then self:ShowDetailPanel(item) end
			if _UIToast ~= nil then _UIToast:ShowMessage("의상을 구매했습니다.") end
			log("[ShopController] purchase completed itemId=" .. tostring(itemId))
			return
		end

		local message = "구매에 실패했습니다."
		if resultCode == "NOT_ENOUGH_FREE" then message = "메소가 부족합니다." end
		if resultCode == "NOT_ENOUGH_PAID" then message = "캐시가 부족합니다." end
		if resultCode == "ALREADY_OWNED" then message = "이미 보유한 의상입니다." end
		if resultCode == "SAVE_FAILED" then message = "구매 정보를 저장하지 못했습니다." end
		if _UIToast ~= nil then _UIToast:ShowMessage(message) end
		log_warning("[ShopController] purchase failed itemId=" .. tostring(itemId) .. " code=" .. resultCode)
	end

	-- ─────────────────────────────────────────────────────────────────────────
	-- Cleanup
	-- ─────────────────────────────────────────────────────────────────────────

	method void OnEndPlay()
		-- Disconnects every handler wired in WireButtons.
		local panel = self.PANEL_PATH

		if self.categoryHandlers ~= nil then
			for _, rec in ipairs(self.categoryHandlers) do
				if rec.entity ~= nil and isvalid(rec.entity) and rec.eventHandler ~= nil then
					rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
				end
			end
			self.categoryHandlers = nil
		end

		if self.cardHandlers ~= nil then
			for _, rec in ipairs(self.cardHandlers) do
				if rec.entity ~= nil and isvalid(rec.entity) and rec.eventHandler ~= nil then
					rec.entity:DisconnectEvent(ButtonClickEvent, rec.eventHandler)
				end
			end
			self.cardHandlers = nil
		end

		if self.prevPageHandler ~= nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/Body/ProductPanel/Pagination/PrevBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.prevPageHandler) end
			self.prevPageHandler = nil
		end
		if self.nextPageHandler ~= nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/Body/ProductPanel/Pagination/NextBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.nextPageHandler) end
			self.nextPageHandler = nil
		end
		if self.purchaseHandler ~= nil then
			local ent = _EntityService:GetEntityByPath(panel .. "/PurchaseBar/PurchaseBtn")
			if ent ~= nil and isvalid(ent) then ent:DisconnectEvent(ButtonClickEvent, self.purchaseHandler) end
			self.purchaseHandler = nil
		end

		self.costumeData = nil
		log("[ShopController] cleanup done")
	end

end
