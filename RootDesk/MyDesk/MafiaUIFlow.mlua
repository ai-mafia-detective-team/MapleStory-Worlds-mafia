	method void HandleInviteSearchChange(TextInputValueChangeEvent event)
		    if self.inviteSearchHint ~= nil then
		        self.inviteSearchHint.Enable = (event.text == nil or event.text == "")
		    end
		    self:RefreshInviteList(event.text)
