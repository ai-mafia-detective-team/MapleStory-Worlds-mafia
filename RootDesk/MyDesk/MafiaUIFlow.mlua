		    self.lobbyRoot = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD")
		    self.dayRoot   = _EntityService:GetEntityByPath("/ui/MafiaDayHUD")
		    self.nightRoot = _EntityService:GetEntityByPath("/ui/MafiaNightHUD")
