		        if entity ~= nil then self.lobbyChatSlotOtherMessages[i] = entity.TextComponent end
		        if self.lobbyChatSlotOtherMessages[i] == nil and slotRoot ~= nil then
		            self.lobbyChatSlotOtherMessages[i] = slotRoot.TextComponent
		        end
		
