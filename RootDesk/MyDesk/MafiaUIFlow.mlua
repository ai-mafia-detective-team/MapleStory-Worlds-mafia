	method void HandleLobbyChatValueChange(TextInputValueChangeEvent event)
		    self.lobbyChatDraft = event.text or ""
		    if self.lobbyChatDraft ~= "" then
		        self.lobbyChatLastNonEmptyDraft = self.lobbyChatDraft
		    end
	end

	method void HandleDayChatValueChange(TextInputValueChangeEvent event)
		    self.dayChatDraft = event.text or ""
		    if self.dayChatDraft ~= "" then
		        self.dayChatLastNonEmptyDraft = self.dayChatDraft
		    end
	end

