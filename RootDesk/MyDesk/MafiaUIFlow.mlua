		    self.nightMafiaCards    = {}
		    self.nightMafiaAvatars  = {}
		    self.nightMafiaNames    = {}
		    self.nightMafiaCircles  = {}
		    self.nightMafiaCirclesOff = {}
		    self.nightMafiaHandlers = {}
		    self.nightMafiaPlayerIds = {}
		    self.nightPoliceCards    = {}
		    self.nightPoliceAvatars  = {}
		    self.nightPoliceNames    = {}
