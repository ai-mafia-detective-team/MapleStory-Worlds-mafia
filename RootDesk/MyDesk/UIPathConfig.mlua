@Component
script UIPathConfig extends Component

	-- ── UI 루트 ─────────────────────────────────────────────────────────────────
	property string ROOT_LOBBY          = "/ui/UI_Lobby"
	property string ROOT_NICKNAME_SETUP = "/ui/UI_NicknameSetup"
	property string ROOT_FIND_ROOM      = "/ui/UI_FindRoom"

	-- ── 로비 주요 엔티티 ─────────────────────────────────────────────────────────
	property string LOBBY_BG            = "/ui/UI_Lobby/LobbyRoot/LobbyBackground"
	property string LOBBY_ROOT          = "/ui/UI_Lobby/LobbyRoot"

	-- ── 닉네임 설정 주요 엔티티 ──────────────────────────────────────────────────
	property string NICKNAME_ROOT       = "/ui/UI_NicknameSetup/NicknameRoot"
	property string NICKNAME_BG         = "/ui/UI_NicknameSetup/NicknameRoot/NicknameBackground"
	property string NICKNAME_CENTER     = "/ui/UI_NicknameSetup/NicknameRoot/CenterPanel"

	-- ── 사용 방법 ────────────────────────────────────────────────────────────────
	-- 현재 각 컨트롤러에서 경로를 지역 변수(local base)로 관리합니다.
	-- 서버 연동 또는 경로 구조 변경 시 이 파일의 값을 수정하세요.
	-- 컴포넌트를 영구 UI 엔티티에 부착 후 :GetComponent("script.UIPathConfig") 로 접근합니다.

end
