@Component
script RoomTouchZone extends Component

	property integer roomIndex = 0

	property boolean isActive = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		    local trc = self.Entity.TouchReceiveComponent
		    if trc ~= nil then
		        trc.TouchArea = Vector2(3.0, 1.5)
		        log("[TouchZone] 방 " .. self.roomIndex .. " 초기화 완료 (TouchArea=3.0x1.5)")
		    else
		        log("[TouchZone][ERR] 방 " .. self.roomIndex .. " TouchReceiveComponent 없음")
		    end
	end

	@ExecSpace("ClientOnly")
	method void OnEmitTouchEvent(TouchEvent evt)
		    if not self.isActive then return end
		    log("[TouchZone] 방 " .. self.roomIndex .. " 클릭됨")
		
		    -- MapController의 MafiaNightCinematic에 방 선택 전달
		    local mapRoot = "/maps/map01"
		    if _RoomService:IsInstanceRoom() then mapRoot = "/maps/map02" end
		    local mapCtrl = _EntityService:GetEntityByPath(mapRoot .. "/MapController")
		    if mapCtrl == nil then
		        log("[TouchZone][ERR] MapController 없음")
		        return
		    end
		    local cinematic = mapCtrl.MafiaNightCinematic
		    if cinematic == nil then
		        log("[TouchZone][ERR] MafiaNightCinematic 컴포넌트 없음")
		        return
		    end
		    cinematic:OnRoomSelected(self.roomIndex)
	end

end