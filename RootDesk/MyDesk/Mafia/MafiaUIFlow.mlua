	method void ResolvePhaseChatContext(string hudName)
		    local rootPath = "/ui/" .. hudName
		    local entity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/ChatScroll")
		    if entity ~= nil then self.lobbyChatScroll = entity.ScrollLayoutGroupComponent end
		    entity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/ChatScroll/ChatLogText")
		    if entity ~= nil then
		        self.lobbyChatLogText = entity.TextComponent
		        entity.Enable = false
		    end
		
		    if self.lobbyChatSlotRoots == nil then self.lobbyChatSlotRoots = {} end
		    if self.lobbyChatSlotFrames == nil then self.lobbyChatSlotFrames = {} end
		    if self.lobbyChatSlotOtherBubbles == nil then self.lobbyChatSlotOtherBubbles = {} end
		    if self.lobbyChatSlotOtherNames == nil then self.lobbyChatSlotOtherNames = {} end
		    if self.lobbyChatSlotOtherMessages == nil then self.lobbyChatSlotOtherMessages = {} end
		    if self.lobbyChatSlotOwnBubbles == nil then self.lobbyChatSlotOwnBubbles = {} end
		    if self.lobbyChatSlotOwnMessages == nil then self.lobbyChatSlotOwnMessages = {} end
		
		    local resolvedSlots = 0
		    for i = 1, self.lobbyChatSlotCount do
		        local slotIndex = tostring(i)
		        local slotBasePath = rootPath .. "/CenterPanel/LobbyChatSlot" .. slotIndex
		        local slotRoot = _EntityService:GetEntityByPath(slotBasePath)
		        if slotRoot == nil then
		            slotBasePath = rootPath .. "/LobbyChatSlot" .. slotIndex
		            slotRoot = _EntityService:GetEntityByPath(slotBasePath)
		        end
		        if slotRoot == nil then
		            slotBasePath = rootPath .. "/CenterPanel/MafiaChat/Chat_3/LobbyChatSlot" .. slotIndex
		            slotRoot = _EntityService:GetEntityByPath(slotBasePath)
		        end
		        self.lobbyChatSlotRoots[i] = slotRoot
		        if slotRoot ~= nil then
		            resolvedSlots = resolvedSlots + 1
		        end
		
		        local frameEntity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/LobbyChatFrameSlot" .. slotIndex)
		        if frameEntity == nil then frameEntity = _EntityService:GetEntityByPath(rootPath .. "/LobbyChatFrameSlot" .. slotIndex) end
		        self.lobbyChatSlotFrames[i] = frameEntity
		
		        local nameEntity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/LobbyChatNameSlot" .. slotIndex)
		        if nameEntity == nil then nameEntity = _EntityService:GetEntityByPath(rootPath .. "/LobbyChatNameSlot" .. slotIndex) end
		        if nameEntity ~= nil then
		            self.lobbyChatSlotOtherNames[i] = nameEntity.TextComponent
		        else
		            self.lobbyChatSlotOtherNames[i] = nil
		        end
		
		        self.lobbyChatSlotOtherBubbles[i] = slotRoot
		
		        entity = _EntityService:GetEntityByPath(slotBasePath .. "/OtherBubble/NameText")
		        if entity ~= nil then self.lobbyChatSlotOtherNames[i] = entity.TextComponent end
		        entity = _EntityService:GetEntityByPath(slotBasePath .. "/OtherBubble/MessageText")
		        if entity ~= nil then
		            self.lobbyChatSlotOtherMessages[i] = entity.TextComponent
		        elseif slotRoot ~= nil then
		            self.lobbyChatSlotOtherMessages[i] = slotRoot.TextComponent
		        else
		            self.lobbyChatSlotOtherMessages[i] = nil
		        end
		
		        self.lobbyChatSlotOwnBubbles[i] = slotRoot
		
		        entity = _EntityService:GetEntityByPath(slotBasePath .. "/OwnBubble/MessageText")
		        if entity ~= nil then
		            self.lobbyChatSlotOwnMessages[i] = entity.TextComponent
		        elseif slotRoot ~= nil then
		            self.lobbyChatSlotOwnMessages[i] = slotRoot.TextComponent
		        else
		            self.lobbyChatSlotOwnMessages[i] = nil
		        end
		    end
		
		    if hudName == "MafiaNightHUD" then
		        entity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/MafiaChat/Chat_2/Chat_2_1")
		        if entity ~= nil then self.lobbyScrollUpButton = entity.ButtonComponent end
		        entity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/MafiaChat/Chat_2/Chat_2_2")
		        if entity ~= nil then self.lobbyScrollDownButton = entity.ButtonComponent end
		        self.lobbyScrollTrack = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/MafiaChat/Chat_2/NightScrollTrack")
		        entity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/MafiaChat/Chat_2/NightScrollThumb")
		        if entity ~= nil then self.lobbyScrollThumb = entity end
		    else
		        entity = _EntityService:GetEntityByPath(rootPath .. "/UISprite_2")
		        if entity ~= nil then self.lobbyScrollUpButton = entity.ButtonComponent end
		        entity = _EntityService:GetEntityByPath(rootPath .. "/UISprite_3")
		        if entity ~= nil then self.lobbyScrollDownButton = entity.ButtonComponent end
		        self.lobbyScrollTrack = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/UISprite")
		        entity = _EntityService:GetEntityByPath(rootPath .. "/CenterPanel/UISprite_1")
		        if entity ~= nil then self.lobbyScrollThumb = entity end
		    end
		
		    if hudName ~= "MafiaLobbyHUD" then
		        self:ConnectPhaseChatScrollControls(hudName)
		    end
	end

	method void ConnectPhaseChatScrollControls(string hudName)
		    if self.phaseScrollUpHandlers == nil then self.phaseScrollUpHandlers = {} end
		    if self.phaseScrollDownHandlers == nil then self.phaseScrollDownHandlers = {} end
		    if self.phaseScrollThumbDownHandlers == nil then self.phaseScrollThumbDownHandlers = {} end
		    if self.phaseScrollThumbDragHandlers == nil then self.phaseScrollThumbDragHandlers = {} end
		    if self.phaseScrollThumbUpHandlers == nil then self.phaseScrollThumbUpHandlers = {} end
		    if self.phaseScrollTrackDownHandlers == nil then self.phaseScrollTrackDownHandlers = {} end
		
		    if self.lobbyScrollUpButton ~= nil and self.phaseScrollUpHandlers[hudName] == nil then
		        self.phaseScrollUpHandlers[hudName] = self.lobbyScrollUpButton.Entity:ConnectEvent(ButtonClickEvent, self.HandleScrollUpClick)
		    end
		    if self.lobbyScrollDownButton ~= nil and self.phaseScrollDownHandlers[hudName] == nil then
		        self.phaseScrollDownHandlers[hudName] = self.lobbyScrollDownButton.Entity:ConnectEvent(ButtonClickEvent, self.HandleScrollDownClick)
		    end
		    if self.lobbyScrollThumb ~= nil and self.phaseScrollThumbDownHandlers[hudName] == nil then
		        self.phaseScrollThumbDownHandlers[hudName] = self.lobbyScrollThumb:ConnectEvent(UITouchDownEvent, self.HandleLobbyScrollThumbDown)
		    end
		    if self.lobbyScrollThumb ~= nil and self.phaseScrollThumbDragHandlers[hudName] == nil then
		        self.phaseScrollThumbDragHandlers[hudName] = self.lobbyScrollThumb:ConnectEvent(UITouchDragEvent, self.HandleLobbyScrollThumbDrag)
		    end
		    if self.lobbyScrollThumb ~= nil and self.phaseScrollThumbUpHandlers[hudName] == nil then
		        self.phaseScrollThumbUpHandlers[hudName] = self.lobbyScrollThumb:ConnectEvent(UITouchUpEvent, self.HandleLobbyScrollThumbUp)
		    end
		    if self.lobbyScrollTrack ~= nil and self.phaseScrollTrackDownHandlers[hudName] == nil then
		        self.phaseScrollTrackDownHandlers[hudName] = self.lobbyScrollTrack:ConnectEvent(UITouchDownEvent, self.HandleLobbyScrollTrackDown)
		    end
	end

	method void RefreshUI(boolean force)
		    if _MafiaGameLogic == nil or not self.uiResolved then return end
		    if not self.mafiaHudUnlocked then
		        self:HideAllMafiaHUDs()
		        return
		    end
		    local phase = _MafiaGameLogic.CurrentPhase
		    if force or phase ~= self.cachedPhase then
		        local prevPhase = self.cachedPhase
		        self.cachedPhase = phase
		        self:SyncDayLobbyTemplatesFromLobby()
		        -- PHASE_MORNING 진입 시 결과 애니메이션 시작 (inNight 계산 전에 호출)
		        if phase == _MafiaGameLogic.PHASE_MORNING and prevPhase ~= _MafiaGameLogic.PHASE_MORNING then
		            self:StartMorningResultAnime()
		        end
		        local inLobby = (phase == _MafiaGameLogic.PHASE_LOBBY)
		        local inNight = (phase == _MafiaGameLogic.PHASE_NIGHT) or (phase == _MafiaGameLogic.PHASE_MORNING and self.resultAnimePlaying)
		        local inGameOver = (phase == _MafiaGameLogic.PHASE_GAME_OVER)
		        local inDay = (not inLobby) and (not inNight) and (not inGameOver)
		        self:SetHudActive(self.lobbyRoot, inLobby)
		        if prevPhase == _MafiaGameLogic.PHASE_LOBBY and phase == _MafiaGameLogic.PHASE_FREE_ROAM and not self.loadingActive then
		            self:SetHudActive(self.dayRoot, false)
		            self:TriggerLoadingScreen()
		        else
		            self:SetHudActive(self.dayRoot, inDay)
		        end
		        self:SetHudActive(self.nightRoot, inNight)
		        self:SetHudActive(self.legacyRoot, false)
		        self:SetHudActive(self.mafiaWinRoot, inGameOver and _MafiaGameLogic.WinnerRole == _MafiaGameLogic.ROLE_MAFIA)
		        self:SetHudActive(self.citizenWinRoot, inGameOver and _MafiaGameLogic.WinnerRole == _MafiaGameLogic.ROLE_CITIZEN)
		        if not inNight and self.nightUIShown then self:HideNightPanel() end
		        if inLobby then
		            log("[MafiaUIFlow] showing lobby UI")
		        elseif inNight then
		            log("[MafiaUIFlow] showing night UI")
		        elseif inGameOver then
		            log("[MafiaUIFlow] showing win UI; winner=" .. tostring(_MafiaGameLogic.WinnerRole))
		        else
		            log("[MafiaUIFlow] showing day UI; phase=" .. tostring(phase))
		        end
		    end
		    if phase == _MafiaGameLogic.PHASE_LOBBY then
		        self:RefreshLobby()
		    elseif phase == _MafiaGameLogic.PHASE_NIGHT then
		        self:RefreshNight()
		    elseif phase == _MafiaGameLogic.PHASE_GAME_OVER then
		        self:RefreshWinAvatars(_MafiaGameLogic.WinnerRole)
		    else
		        self:RefreshDay(phase)
		    end
	end

	method void HideAllMafiaHUDs()
		    -- Keeps Mafia HUDs invisible until the main flow reaches room creation completion.
		    self:SetHudActive(self.lobbyRoot, false)
		    self:SetHudActive(self.dayRoot, false)
		    self:SetHudActive(self.nightRoot, false)
		    self:SetHudActive(self.legacyRoot, false)
		    self:SetHudActive(self.citizenWinRoot, false)
		    self:SetHudActive(self.mafiaWinRoot, false)
	end

	method void SetHudActive(Entity root, boolean active)
		    -- Applies both Enable and Visible so previous intro hiding does not leave a HUD visually disabled.
		    if root == nil or isvalid(root) == false then return end
		    -- 낮 HUD가 다른 화면으로 전환되며 꺼지면 진행 중이던 페이드를 취소하고 다음 진입용 알파를 복구한다.
		    if root == self.dayRoot and not active then
		        self.dayFadeInPlaying = false
		        self.dayFadeInAlpha = 1.0
		        local dayCg = root.CanvasGroupComponent
		        if dayCg ~= nil then dayCg.GroupAlpha = 1.0 end
		    end
		    root:SetEnable(active)
		    root.Visible = active
	end

	method void BeginStartupLoadingFlow()
		    -- Skip loading cover; go directly to the intro sequence.
		    if self.startupIntroRequested then return end
		    self.startupIntroRequested = true
		    self:ShowStartupLoadingCover()
		    self:StartIntroAfterStartupLoading()
		    log("[MafiaUIFlow] startup loading flow started")
	end

	method void ShowStartupLoadingCover()
		    -- Covers the raw map immediately on Play.
		    self:HideUiRootByPath("/ui/UI_Lobby")
		    self:HideUiRootByPath("/ui/UI_NicknameSetup")
		    self:HideUiRootByPath("/ui/UI_StorySequence")
		    self:HideUiRootByPath("/ui/UI_IntroSequence")
		    self:HideAllMafiaHUDs()
		    local mapsRoot = _EntityService:GetEntityByPath("/maps")
		    if mapsRoot ~= nil and isvalid(mapsRoot) then
		        mapsRoot:SetEnable(false)
		    end
		    log("[MafiaUIFlow] maps hidden for intro flow")
	end

	method void StartIntroAfterStartupLoading()
		    -- Hands control from the startup cover to the intro logo flow.
		    local intro = _EntityService:GetEntityByPath("/ui/UI_IntroSequence")
		    if intro == nil or isvalid(intro) == false then
		        log_warning("[MafiaUIFlow] /ui/UI_IntroSequence not found after startup loading")
		        return
		    end
		    intro:SetEnable(true)
		    intro.Visible = true
		    local ctrl = intro:GetComponent("script.IntroSequenceController")
		    if ctrl == nil then
		        intro:AddComponent("script.IntroSequenceController")
		        log("[MafiaUIFlow] IntroSequenceController attached after startup loading")
		    else
		        ctrl:ApplyInitialState()
		        ctrl:StartTimeline()
		        log("[MafiaUIFlow] IntroSequenceController restarted after startup loading")
		    end
	end

	method void HideUiRootByPath(string path)
		    -- Hides a UI root if it exists.
		    local root = _EntityService:GetEntityByPath(path)
		    if root == nil or isvalid(root) == false then return end
		    root:SetEnable(false)
		    root.Visible = false
	end

	method void SetLoadingText(string path, string text)
		    -- Updates loading HUD text when the entity exists.
		    local entity = _EntityService:GetEntityByPath(path)
		    if entity == nil or isvalid(entity) == false then return end
		    if entity.TextComponent ~= nil then
		        entity.TextComponent.Text = text
		    end
	end

	method void RestoreLocalWorldPlayerForLobby()
		    -- Re-enables the local world avatar and its movement stack for lobby room control.
		    local worldPlayer = _UserService.LocalPlayer
		    if worldPlayer == nil or isvalid(worldPlayer) == false then return end
		
		    worldPlayer:SetEnable(true)
		    worldPlayer.Visible = true
		
		    if worldPlayer.AvatarRendererComponent ~= nil then worldPlayer.AvatarRendererComponent.Enable = true end
		    if worldPlayer.AvatarStateAnimationComponent ~= nil then worldPlayer.AvatarStateAnimationComponent.Enable = true end
		    if worldPlayer.CostumeManagerComponent ~= nil then worldPlayer.CostumeManagerComponent.Enable = true end
		    if worldPlayer.PlayerControllerComponent ~= nil then worldPlayer.PlayerControllerComponent.Enable = true end
		    if worldPlayer.MovementComponent ~= nil then
		        worldPlayer.MovementComponent.Enable = true
		        if worldPlayer.MovementComponent.InputSpeed <= 0 then worldPlayer.MovementComponent.InputSpeed = 1 end
		    end
		    if worldPlayer.RigidbodyComponent ~= nil then worldPlayer.RigidbodyComponent.Enable = true end
		    if worldPlayer.NameTagComponent ~= nil then worldPlayer.NameTagComponent.Enable = false end
	end

	method void RequestLobbyRoomPlacementOnce()
		    -- MafiaGameLogic.CheckNewLobbyPlayers handles room assignment automatically.
		    if self.lobbyPlacementRequested then return end
		    self.lobbyPlacementRequested = true
		    log("[MafiaUIFlow] lobby room placement delegated to MafiaGameLogic")
	end

	method void SetLobbyAvatarScale(number scale)
		    local nextScale = math.max(0.5, math.min(2.0, scale))
		    self.lobbyAvatarScale = nextScale
		    if self.lobbyAvatarEntities ~= nil then
		        for i = 1, 8 do
		            local avatarEntity = self.lobbyAvatarEntities[i]
		            if avatarEntity ~= nil and isvalid(avatarEntity)
		                and avatarEntity.UITransformComponent ~= nil then
		                avatarEntity.UITransformComponent.RectSize = Vector2(
		                    self.lobbyAvatarBaseWidth * nextScale,
		                    self.lobbyAvatarBaseHeight * nextScale)
		            end
		        end
		    end
		    log("[MafiaUIFlow] lobby avatar scale applied=" .. tostring(nextScale))
	end

	method void PositionLobbyNickname(integer seatIndex, number avatarX, number floorY)
		    if self.lobbyRoomTexts == nil then return end
		    local roomText = self.lobbyRoomTexts[seatIndex]
		    if roomText == nil or roomText.Entity == nil or isvalid(roomText.Entity) == false then return end
		    local textTransform = roomText.Entity.UITransformComponent
		    if textTransform == nil then return end
		    textTransform.anchoredPosition = Vector2(avatarX, floorY + self.lobbyNicknameOffsetY)
	end

	method void CopyUISlotTransform(Entity sourceEntity, Entity targetEntity)
		    if sourceEntity == nil or isvalid(sourceEntity) == false then return end
		    if targetEntity == nil or isvalid(targetEntity) == false then return end
		    local srcTransform = sourceEntity.UITransformComponent
		    local dstTransform = targetEntity.UITransformComponent
		    if srcTransform == nil or dstTransform == nil then return end
		    if srcTransform.anchoredPosition ~= nil then
		        dstTransform.anchoredPosition = Vector2(srcTransform.anchoredPosition.x, srcTransform.anchoredPosition.y)
		    end
		    if srcTransform.RectSize ~= nil then
		        dstTransform.RectSize = Vector2(srcTransform.RectSize.x, srcTransform.RectSize.y)
		    end
		    if srcTransform.OffsetMin ~= nil then
		        dstTransform.OffsetMin = Vector2(srcTransform.OffsetMin.x, srcTransform.OffsetMin.y)
		    end
		    if srcTransform.OffsetMax ~= nil then
		        dstTransform.OffsetMax = Vector2(srcTransform.OffsetMax.x, srcTransform.OffsetMax.y)
		    end
		    if srcTransform.AnchorsMin ~= nil then
		        dstTransform.AnchorsMin = Vector2(srcTransform.AnchorsMin.x, srcTransform.AnchorsMin.y)
		    end
		    if srcTransform.AnchorsMax ~= nil then
		        dstTransform.AnchorsMax = Vector2(srcTransform.AnchorsMax.x, srcTransform.AnchorsMax.y)
		    end
		    if srcTransform.Pivot ~= nil then
		        dstTransform.Pivot = Vector2(srcTransform.Pivot.x, srcTransform.Pivot.y)
		    end
	end

	method void CopyUISpriteTemplate(Entity sourceEntity, Entity targetEntity)
		    if sourceEntity == nil or isvalid(sourceEntity) == false then return end
		    if targetEntity == nil or isvalid(targetEntity) == false then return end
		    local srcSprite = sourceEntity.SpriteGUIRendererComponent
		    local dstSprite = targetEntity.SpriteGUIRendererComponent
		    if srcSprite == nil or dstSprite == nil then return end
		    if srcSprite.ImageRUID ~= nil then
		        dstSprite.ImageRUID = srcSprite.ImageRUID
		    end
		    if srcSprite.Color ~= nil then
		        dstSprite.Color = Color(srcSprite.Color.r, srcSprite.Color.g, srcSprite.Color.b, srcSprite.Color.a)
		    end
		    dstSprite.FlipX = srcSprite.FlipX
		    dstSprite.FlipY = srcSprite.FlipY
		    dstSprite.Type = srcSprite.Type
		    dstSprite.OrderInLayer = srcSprite.OrderInLayer
		    dstSprite.SortingLayer = srcSprite.SortingLayer
		    dstSprite.Enable = srcSprite.Enable
	end

	method void MakeUISpriteTransparent(Entity targetEntity)
		    if targetEntity == nil or isvalid(targetEntity) == false then return end
		    -- Keep the boundary entity enabled for layout/movement calculations, but hide
		    -- every renderer in its hierarchy regardless of the concrete renderer type.
		    targetEntity.Enable = true
		    targetEntity.Visible = false
		    local hiddenRendererCount = 0
		    local spriteRenderer = targetEntity.SpriteGUIRendererComponent
		    if spriteRenderer ~= nil then
		        spriteRenderer:SetAlpha(0)
		        hiddenRendererCount = hiddenRendererCount + 1
		    end
		    local pixelRenderer = targetEntity.PixelGUIRendererComponent
		    if pixelRenderer ~= nil then
		        pixelRenderer.Enable = false
		        hiddenRendererCount = hiddenRendererCount + 1
		    end
		    local lineRenderer = targetEntity.LineGUIRendererComponent
		    if lineRenderer ~= nil then
		        lineRenderer.Enable = false
		        hiddenRendererCount = hiddenRendererCount + 1
		    end
		    log("[MafiaUIFlow] Day boundary hidden path=" .. tostring(targetEntity.Path)
		        .. " visible=" .. tostring(targetEntity.Visible)
		        .. " enabled=" .. tostring(targetEntity.Enable)
		        .. " rendererCount=" .. tostring(hiddenRendererCount))
	end

	method void CopyAvatarTemplateBindings(Entity sourceEntity, Entity targetEntity)
		    if sourceEntity == nil or isvalid(sourceEntity) == false then return end
		    if targetEntity == nil or isvalid(targetEntity) == false then return end
		    local srcRenderer = sourceEntity.AvatarGUIRendererComponent
		    local dstRenderer = targetEntity.AvatarGUIRendererComponent
		    if srcRenderer ~= nil and dstRenderer ~= nil then
		        dstRenderer.FlipX = srcRenderer.FlipX
		    end
		    local srcCostume = sourceEntity.CostumeManagerComponent
		    local dstCostume = targetEntity.CostumeManagerComponent
		    if srcCostume ~= nil and dstCostume ~= nil then
		        dstCostume.UseCustomEquipOnly = srcCostume.UseCustomEquipOnly
		        dstCostume.DefaultEquipUserId = srcCostume.DefaultEquipUserId
		    end
	end

	method string GetLobbyAvatarSuffix(integer slotIndex)
		    if slotIndex == 1 then return "" end
		    return "_" .. tostring(slotIndex - 1)
	end

	method string GetLobbyVariantSuffix(integer slotIndex)
		    if slotIndex <= 1 then return "" end
		    if slotIndex <= 6 then return "_1" end
		    if slotIndex == 7 then return "_2" end
		    return "_3"
	end

	method Entity EnsureDayRoomBadgeChild(Entity sourceEntity, Entity daySlot, string childName)
		    if sourceEntity == nil or isvalid(sourceEntity) == false then return nil end
		    if daySlot == nil or isvalid(daySlot) == false then return nil end
		    local existing = daySlot:GetChildByName(childName, false)
		    if existing ~= nil and isvalid(existing) then return existing end
		    -- AvatarGUIRendererComponent creates AvatarRoot/Body/Face itself. Excluding
		    -- live children prevents duplicate body renderers and costume flicker.
		    local clone = _SpawnService:SpawnByEntity(sourceEntity, childName, Vector3.zero, daySlot, false)
		    if clone ~= nil and isvalid(clone) then
		        log("[MafiaUIFlow] Day RoomBadge child cloned at runtime: " .. tostring(clone.Path))
		        return clone
		    end
		    log_warning("[MafiaUIFlow] failed to clone Day RoomBadge child: " .. childName)
		    return nil
	end

	method void SyncDayRoomBadgeSlot(integer slotIndex)
		    if slotIndex < 1 or slotIndex > 8 then return end
		    local slotText = tostring(slotIndex)
		    local lobbySuffix = self:GetLobbyAvatarSuffix(slotIndex)
		    local variantSuffix = self:GetLobbyVariantSuffix(slotIndex)
		    local lobbyBase = "/ui/MafiaLobbyHUD/RoomBadge" .. slotText
		    local dayBase = "/ui/MafiaDayHUD/RoomBadge" .. slotText
		
		    local lobbySlot = _EntityService:GetEntityByPath(lobbyBase)
		    local daySlot = _EntityService:GetEntityByPath(dayBase)
		    self:CopyUISlotTransform(lobbySlot, daySlot)
		    self:CopyUISpriteTemplate(lobbySlot, daySlot)
		    if daySlot ~= nil then
		        if lobbySlot ~= nil then
		            daySlot.Enable = lobbySlot.Enable
		            daySlot.Visible = lobbySlot.Visible
		        end
		        self.dayRoomBadgeRoots[slotIndex] = daySlot
		    end
		
		    local lobbyDungeon = _EntityService:GetEntityByPath(lobbyBase .. "/DungeonBg")
		    local dayDungeon = _EntityService:GetEntityByPath(dayBase .. "/DungeonBg")
		    if dayDungeon == nil then dayDungeon = self:EnsureDayRoomBadgeChild(lobbyDungeon, daySlot, "DungeonBg") end
		    self:CopyUISlotTransform(lobbyDungeon, dayDungeon)
		    self:CopyUISpriteTemplate(lobbyDungeon, dayDungeon)
		    if dayDungeon ~= nil then self.dayRoomBadgeDungeonBgs[slotIndex] = dayDungeon end
		
		    local lobbyBg = _EntityService:GetEntityByPath(lobbyBase .. "/Bg")
		    local dayBg = _EntityService:GetEntityByPath(dayBase .. "/Bg")
		    if dayBg == nil then dayBg = self:EnsureDayRoomBadgeChild(lobbyBg, daySlot, "Bg") end
		    self:CopyUISlotTransform(lobbyBg, dayBg)
		    self:CopyUISpriteTemplate(lobbyBg, dayBg)
		    if dayBg ~= nil then self.dayRoomBadgeBgs[slotIndex] = dayBg end
		
		    local lobbyAvatarArea = _EntityService:GetEntityByPath(lobbyBase .. "/LobbyAvatarArea" .. lobbySuffix)
		    local dayAvatarArea = _EntityService:GetEntityByPath(dayBase .. "/LobbyAvatarArea" .. lobbySuffix)
		    if dayAvatarArea == nil then
		        dayAvatarArea = self:EnsureDayRoomBadgeChild(lobbyAvatarArea, daySlot, "LobbyAvatarArea" .. lobbySuffix)
		    end
		    self:CopyUISlotTransform(lobbyAvatarArea, dayAvatarArea)
		    self:CopyAvatarTemplateBindings(lobbyAvatarArea, dayAvatarArea)
		    if dayAvatarArea ~= nil then self.dayRoomBadgeAvatars[slotIndex] = dayAvatarArea end
		
		    local lobbyPlayerAvatar = _EntityService:GetEntityByPath(lobbyBase .. "/PlayerAvatar")
		    local dayPlayerAvatar = _EntityService:GetEntityByPath(dayBase .. "/PlayerAvatar")
		    if dayPlayerAvatar == nil then
		        dayPlayerAvatar = self:EnsureDayRoomBadgeChild(lobbyPlayerAvatar, daySlot, "PlayerAvatar")
		    end
		    self:CopyUISlotTransform(lobbyPlayerAvatar, dayPlayerAvatar)
		    self:CopyAvatarTemplateBindings(lobbyPlayerAvatar, dayPlayerAvatar)
		    if dayPlayerAvatar ~= nil then
		        dayPlayerAvatar.Enable = false
		        dayPlayerAvatar.Visible = false
		        if dayPlayerAvatar.AvatarGUIRendererComponent ~= nil then dayPlayerAvatar.AvatarGUIRendererComponent.Enable = false end
		        if dayPlayerAvatar.CostumeManagerComponent ~= nil then dayPlayerAvatar.CostumeManagerComponent.Enable = false end
		    end
		
		    local lobbyLeft = _EntityService:GetEntityByPath(lobbyBase .. "/DebugUIFoothold_Left" .. variantSuffix)
		    local dayLeft = _EntityService:GetEntityByPath(dayBase .. "/DebugUIFoothold_Left" .. variantSuffix)
		    if dayLeft == nil then
		        dayLeft = self:EnsureDayRoomBadgeChild(lobbyLeft, daySlot, "DebugUIFoothold_Left" .. variantSuffix)
		    end
		    self:CopyUISlotTransform(lobbyLeft, dayLeft)
		    self:CopyUISpriteTemplate(lobbyLeft, dayLeft)
		    self:MakeUISpriteTransparent(dayLeft)
		    if dayLeft ~= nil then self.dayRoomBadgeFloorLeft[slotIndex] = dayLeft end
		
		    local lobbyRight = _EntityService:GetEntityByPath(lobbyBase .. "/DebugUIFoothold_Right" .. variantSuffix)
		    local dayRight = _EntityService:GetEntityByPath(dayBase .. "/DebugUIFoothold_Right" .. variantSuffix)
		    if dayRight == nil then
		        dayRight = self:EnsureDayRoomBadgeChild(lobbyRight, daySlot, "DebugUIFoothold_Right" .. variantSuffix)
		    end
		    self:CopyUISlotTransform(lobbyRight, dayRight)
		    self:CopyUISpriteTemplate(lobbyRight, dayRight)
		    self:MakeUISpriteTransparent(dayRight)
		    if dayRight ~= nil then self.dayRoomBadgeFloorRight[slotIndex] = dayRight end
		
		    local lobbyLine = _EntityService:GetEntityByPath(lobbyBase .. "/DebugUITextFoothold_Line" .. variantSuffix)
		    local dayLine = _EntityService:GetEntityByPath(dayBase .. "/DebugUITextFoothold_Line" .. variantSuffix)
		    if dayLine == nil then
		        dayLine = self:EnsureDayRoomBadgeChild(lobbyLine, daySlot, "DebugUITextFoothold_Line" .. variantSuffix)
		    end
		    self:CopyUISlotTransform(lobbyLine, dayLine)
		    self:CopyUISpriteTemplate(lobbyLine, dayLine)
		    self:MakeUISpriteTransparent(dayLine)
		    if dayLine ~= nil then self.dayRoomBadgeFloorLine[slotIndex] = dayLine end
		
		    local lobbyText = _EntityService:GetEntityByPath(lobbyBase .. "/Text")
		    local dayTextEntity = _EntityService:GetEntityByPath(dayBase .. "/Text")
		    if dayTextEntity == nil then dayTextEntity = self:EnsureDayRoomBadgeChild(lobbyText, daySlot, "Text") end
		    if lobbyText ~= nil and dayTextEntity ~= nil and dayTextEntity.TextComponent ~= nil then
		        self:CopyUISlotTransform(lobbyText, dayTextEntity)
		        if lobbyText.TextComponent ~= nil then
		            dayTextEntity.TextComponent.Text = lobbyText.TextComponent.Text
		        end
		    end
		    if dayTextEntity ~= nil then self.dayRoomBadgeTexts[slotIndex] = dayTextEntity.TextComponent end
	end

	method void SyncDayLobbyTemplatesFromLobby()
		    if self.dayLobbyTemplateSynced then return end
		    local resolvedAvatarCount = 0
		    for i = 1, 8 do
		        self:SyncDayRoomBadgeSlot(i)
		        if self.dayRoomBadgeAvatars[i] ~= nil and isvalid(self.dayRoomBadgeAvatars[i]) then
		            resolvedAvatarCount = resolvedAvatarCount + 1
		        end
		    end
		    self.dayLobbyTemplateSynced = (resolvedAvatarCount == 8)
		    log("[MafiaUIFlow] synced MafiaLobbyHUD room badge template to MafiaDayHUD (1:1 slot mapping) avatars="
		        .. tostring(resolvedAvatarCount) .. "/8")
	end

	method void RefreshDayRoomBadgeAvatars()
		    self:SyncDayLobbyTemplatesFromLobby()
		    if self.dayRoomBadgeAvatars == nil then return end
		    if self.dayRoomBadgeBoundUsers == nil then self.dayRoomBadgeBoundUsers = {} end

		    local seats = self:GetLobbySeatOrderForDisplay()
		    local nicknames = self:GetLobbySeatNicknamesForDisplay(seats)
		    local localUserId = self:GetLocalUserId()
		    local localProfileNickname = self:GetMainLobbyProfileNickname()

		    for i = 1, 8 do
		        local userId = seats[i]
		        local dayAvatar = self.dayRoomBadgeAvatars[i]
		        local dayText = self.dayRoomBadgeTexts[i]
		        if userId ~= nil and userId ~= "" and dayAvatar ~= nil and isvalid(dayAvatar) then
		            local sourceAvatar = self.lobbyAvatarEntities[i]
		            local sourceCostume = nil
		            local sourceRenderer = nil
		            if sourceAvatar ~= nil and isvalid(sourceAvatar) then
		                sourceCostume = sourceAvatar.CostumeManagerComponent
		                sourceRenderer = sourceAvatar.AvatarGUIRendererComponent
		            end

		            local targetCostume = dayAvatar.CostumeManagerComponent
		            local targetRenderer = dayAvatar.AvatarGUIRendererComponent
		            local needsBinding = (self.dayRoomBadgeBoundUsers[i] ~= userId)
		            if needsBinding and targetRenderer ~= nil then targetRenderer.Enable = false end
		            if needsBinding and targetCostume ~= nil then
		                targetCostume.Enable = false
		                if sourceCostume ~= nil then
		                    targetCostume.UseCustomEquipOnly = sourceCostume.UseCustomEquipOnly
		                    local equipUserId = tostring(sourceCostume.DefaultEquipUserId or "")
		                    targetCostume.DefaultEquipUserId = (equipUserId ~= "") and equipUserId or userId
		                else
		                    targetCostume.UseCustomEquipOnly = false
		                    targetCostume.DefaultEquipUserId = userId
		                end
		                targetCostume.Enable = true
		            end
		            if targetRenderer ~= nil then
		                if needsBinding and sourceRenderer ~= nil then targetRenderer.FlipX = sourceRenderer.FlipX end
		                targetRenderer.Enable = true
		            end
		            dayAvatar.Enable = true
		            dayAvatar.Visible = true

		            if dayText ~= nil then
		                local nickname = nicknames[i]
		                if userId == localUserId and localProfileNickname ~= nil and localProfileNickname ~= "" then
		                    nickname = localProfileNickname
		                end
		                if nickname == nil or nickname == "" then nickname = "플레이어" end
		                dayText.Text = nickname
		            end

		            if needsBinding then
		                self.dayRoomBadgeBoundUsers[i] = userId
		                self.dayAvatarActionStates[i] = nil
		                if dayAvatar.UITransformComponent ~= nil then
		                    self.dayAvatarHomeX[i] = dayAvatar.UITransformComponent.anchoredPosition.x
		                end
		                log("[MafiaUIFlow] Day avatar bound 1:1 slot=" .. tostring(i) .. " userId=" .. tostring(userId))
		            end
		else
		            if dayAvatar ~= nil and isvalid(dayAvatar) then
		                dayAvatar.Enable = false
		                if dayAvatar.AvatarGUIRendererComponent ~= nil then dayAvatar.AvatarGUIRendererComponent.Enable = false end
		                if dayAvatar.CostumeManagerComponent ~= nil then dayAvatar.CostumeManagerComponent.Enable = false end
		            end
		            if dayText ~= nil then dayText.Text = "" end
		            self.dayRoomBadgeBoundUsers[i] = nil
		        end
		    end
	end

	method void PositionDayNickname(integer seatIndex, number avatarX, number floorY)
		    if self.dayRoomBadgeTexts == nil then return end
		    local roomText = self.dayRoomBadgeTexts[seatIndex]
		    if roomText == nil or roomText.Entity == nil or isvalid(roomText.Entity) == false then return end
		    local textTransform = roomText.Entity.UITransformComponent
		    if textTransform == nil then return end
		    textTransform.anchoredPosition = Vector2(avatarX, floorY + self.lobbyNicknameOffsetY)
	end

	method void ApplyDayAvatarMotion(integer seatIndex, number avatarX, boolean flipX, string actionState)
		    if self.dayRoomBadgeAvatars == nil then return end
		    local avatarEntity = self.dayRoomBadgeAvatars[seatIndex]
		    if avatarEntity == nil or isvalid(avatarEntity) == false or avatarEntity.UITransformComponent == nil then return end
		    local nextY = avatarEntity.UITransformComponent.anchoredPosition.y
		    local leftFoothold = self.dayRoomBadgeFloorLeft[seatIndex]
		    local rightFoothold = self.dayRoomBadgeFloorRight[seatIndex]
		    if leftFoothold ~= nil and rightFoothold ~= nil
		        and leftFoothold.UITransformComponent ~= nil and rightFoothold.UITransformComponent ~= nil then
		        local leftTransform = leftFoothold.UITransformComponent
		        local rightTransform = rightFoothold.UITransformComponent
		        local leftPosition = leftTransform.anchoredPosition
		        local rightPosition = rightTransform.anchoredPosition
		        local span = rightPosition.x - leftPosition.x
		        local ratio = 0.5
		        if span ~= 0 then ratio = math.max(0, math.min(1, (avatarX - leftPosition.x) / span)) end
		        local leftFloorY = leftPosition.y - leftTransform.RectSize.y * 0.5
		        local rightFloorY = rightPosition.y - rightTransform.RectSize.y * 0.5
		        nextY = leftFloorY + (rightFloorY - leftFloorY) * ratio
		    end
		    avatarEntity.UITransformComponent.anchoredPosition = Vector2(avatarX, nextY)
		    local renderer = avatarEntity.AvatarGUIRendererComponent
		    if renderer ~= nil then renderer.FlipX = flipX end
		    if self.dayAvatarActionStates == nil then self.dayAvatarActionStates = {} end
		    if self.dayAvatarActionStates[seatIndex] ~= actionState and renderer ~= nil then
		        local body = renderer:GetBodyEntity()
		        if body ~= nil and isvalid(body) then
		            self:ApplyLobbyAvatarBodyAction(avatarEntity, actionState)
		            self.dayAvatarActionStates[seatIndex] = actionState
		        end
		    end
		    self:PositionDayNickname(seatIndex, avatarX, nextY)
	end

	method void ApplySyncedDayAvatarMotions()
		    if self:IsServer() then return end
		    if self.dayRoot == nil or self.dayRoot.Enable == false or _MafiaGameLogic == nil then return end
		    local raw = _MafiaGameLogic.DayAvatarMotionData or ""
		    if raw == "" then return end
		    local seats = self:GetLobbySeatOrderForDisplay()
		    local localUserId = self:GetLocalUserId()
		    for record in string.gmatch(raw .. ";", "(.-);") do
		        local uid, xText, flipText, state = string.match(record, "([^|]+)|([^|]+)|([^|]+)|([^|]+)")
		        if uid ~= nil and uid ~= localUserId then
		            local seatIndex = 0
		            for i = 1, 8 do
		                if seats[i] == uid then seatIndex = i break end
		            end
		            local avatarX = tonumber(xText)
		            if seatIndex > 0 and avatarX ~= nil then
		                self:ApplyDayAvatarMotion(seatIndex, avatarX, flipText == "1", state)
		            end
		        end
		    end
	end

	method void UpdateLocalDayAvatarMovement(number delta)
		    if self:IsServer() then return end
		    if self.dayRoot == nil or self.dayRoot.Enable == false then return end
		    if _MafiaGameLogic == nil or _MafiaGameLogic.CurrentPhase == _MafiaGameLogic.PHASE_LOBBY
		        or _MafiaGameLogic.CurrentPhase == _MafiaGameLogic.PHASE_NIGHT
		        or _MafiaGameLogic.CurrentPhase == _MafiaGameLogic.PHASE_GAME_OVER then return end
		    if self.dayChatInput ~= nil and self.dayChatInput.IsFocused then return end

		    local localUserId = self:GetLocalUserId()
		    if localUserId == "" then return end
		    local seats = self:GetLobbySeatOrderForDisplay()
		    local seatIndex = 0
		    for i = 1, 8 do
		        if seats[i] == localUserId then seatIndex = i break end
		    end
		    if seatIndex <= 0 then return end
		    local avatarEntity = self.dayRoomBadgeAvatars[seatIndex]
		    if avatarEntity == nil or isvalid(avatarEntity) == false or avatarEntity.UITransformComponent == nil then return end

		    local dir = 0
		    if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) or _InputService:IsKeyPressed(KeyboardKey.A) then dir = dir - 1 end
		    if _InputService:IsKeyPressed(KeyboardKey.RightArrow) or _InputService:IsKeyPressed(KeyboardKey.D) then dir = dir + 1 end
		    local actionState = (dir ~= 0) and "walk" or "idle"
		    local renderer = avatarEntity.AvatarGUIRendererComponent
		    local flipX = (renderer ~= nil) and renderer.FlipX or false
		    if dir ~= 0 then flipX = (dir > 0) end

		    local pos = avatarEntity.UITransformComponent.anchoredPosition
		    local minX = pos.x - self.lobbyAvatarMoveLimit
		    local maxX = pos.x + self.lobbyAvatarMoveLimit
		    local leftFoothold = self.dayRoomBadgeFloorLeft[seatIndex]
		    local rightFoothold = self.dayRoomBadgeFloorRight[seatIndex]
		    if leftFoothold ~= nil and rightFoothold ~= nil
		        and leftFoothold.UITransformComponent ~= nil and rightFoothold.UITransformComponent ~= nil then
		        minX = math.min(leftFoothold.UITransformComponent.anchoredPosition.x, rightFoothold.UITransformComponent.anchoredPosition.x)
		        maxX = math.max(leftFoothold.UITransformComponent.anchoredPosition.x, rightFoothold.UITransformComponent.anchoredPosition.x)
		    elseif self.dayAvatarHomeX[seatIndex] ~= nil then
		        minX = self.dayAvatarHomeX[seatIndex] - self.lobbyAvatarMoveLimit
		        maxX = self.dayAvatarHomeX[seatIndex] + self.lobbyAvatarMoveLimit
		    end
		    local nextX = pos.x + dir * self.lobbyAvatarMoveSpeed * delta
		    nextX = math.max(minX, math.min(maxX, nextX))
		    self:ApplyDayAvatarMotion(seatIndex, nextX, flipX, actionState)

		    self.dayAvatarSyncAccumulator = self.dayAvatarSyncAccumulator + delta
		    local changed = self.dayAvatarHasSentMotion == false
		        or math.abs(nextX - self.dayAvatarLastSentX) >= 1
		        or actionState ~= self.dayAvatarLastSentState
		        or flipX ~= self.dayAvatarLastSentFlip
		    if changed and self.dayAvatarSyncAccumulator >= 0.1 then
		        self.dayAvatarSyncAccumulator = 0
		        self.dayAvatarLastSentX = nextX
		        self.dayAvatarLastSentState = actionState
		        self.dayAvatarLastSentFlip = flipX
		        self.dayAvatarHasSentMotion = true
		        _MafiaGameLogic:SetDayAvatarMotion(localUserId, nextX, flipX, actionState)
		        log("[MafiaUIFlow] Day avatar motion sent slot=" .. tostring(seatIndex)
		            .. " x=" .. tostring(nextX) .. " state=" .. actionState .. " flip=" .. tostring(flipX))
		    end
	end

	method void ApplyLobbyAvatarBodyAction(Entity avatarEntity, string state)
		    if avatarEntity == nil or isvalid(avatarEntity) == false then return end
		    local avatarRenderer = avatarEntity.AvatarGUIRendererComponent
		    if avatarRenderer == nil then return end
		    local bodyEntity = avatarRenderer:GetBodyEntity()
		    if bodyEntity == nil or isvalid(bodyEntity) == false then return end

		    local coreAction = "stand1"
		    local partsAction = "stand1"
		    local playRate = 1.0
		    if state == "walk" then
		        coreAction = "walk1"
		        partsAction = "walk1"
		        playRate = 1.35
		    end

		    local event = ActionStateChangedEvent(
		        coreAction,
		        partsAction,
		        playRate,
		        SpriteAnimClipPlayType.Loop,
		        0,
		        2147483647
		    )
		    bodyEntity:SendEvent(event)
	end

	method boolean ApplyLobbyAvatarFromMainLobby(integer seatIndex, string userId, Entity avatarEntity, boolean applyAction)
	    if avatarEntity == nil or isvalid(avatarEntity) == false then return false end
		    local localUserId = self:GetLocalUserId()
		    if localUserId == "" then
		        if _UserService.LocalPlayer ~= nil and isvalid(_UserService.LocalPlayer) and _UserService.LocalPlayer.PlayerComponent ~= nil then
		            localUserId = tostring(_UserService.LocalPlayer.PlayerComponent.UserId)
		        end
		    end
		    if localUserId == "" or localUserId ~= tostring(userId) then return false end

		    local lobbyRoot = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if lobbyRoot == nil or isvalid(lobbyRoot) == false then return false end

		    local uiLobbyAvatar = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/LobbyAvatar")
		    if uiLobbyAvatar == nil or isvalid(uiLobbyAvatar) == false then return false end
		    local uiCostume = uiLobbyAvatar.CostumeManagerComponent
		    local uiRenderer = uiLobbyAvatar.AvatarGUIRendererComponent
		    local uiBodyState = self:GetMainLobbyAvatarState()
		    local uiFlip = false

		    if uiRenderer ~= nil then
		        uiFlip = uiRenderer.FlipX
		    end

		    local targetCostume = avatarEntity.CostumeManagerComponent
		    local targetRenderer = avatarEntity.AvatarGUIRendererComponent
		    if applyAction == nil then applyAction = false end
		    if uiCostume ~= nil and targetCostume ~= nil then
		        local sourceAvatarUserId = tostring(uiCostume.DefaultEquipUserId or "")
		        if sourceAvatarUserId == "" then
		            sourceAvatarUserId = localUserId
		        end
		        targetCostume.UseCustomEquipOnly = uiCostume.UseCustomEquipOnly
		        targetCostume.DefaultEquipUserId = sourceAvatarUserId
		        targetCostume.Enable = true
		    end
		    if targetRenderer ~= nil then
		        targetRenderer.FlipX = uiFlip
		    end

		    if applyAction == true then
		        if uiBodyState == "" then uiBodyState = "idle" end
		        self:ApplyLobbyAvatarBodyAction(avatarEntity, uiBodyState)
		    end

		    log("[MafiaUIFlow] mirrored local lobby avatar from UI_Lobby slot=" .. tostring(seatIndex)
		        .. " userId=" .. tostring(userId)
		        .. " equipUserId=" .. tostring(targetCostume ~= nil and targetCostume.DefaultEquipUserId or "")
		        .. " flipX=" .. tostring(uiFlip)
		        .. " action=" .. tostring(applyAction and uiBodyState or "keep-mafia-motion"))
		    return true
	end

	method void UpdateLocalLobbyAvatarMovement(number delta)
		    -- The visible room character in MafiaLobbyHUD is a UI avatar, not the world player.
		    -- Move that visible avatar directly so the lobby room character responds to player input.
		    if self.lobbyRoot == nil or self.lobbyRoot.Enable == false then return end
		    if self.lobbyAvatarEntities == nil or self.cachedLobbySeats == nil then return end
		    if _MafiaGameLogic == nil or _MafiaGameLogic.CurrentPhase ~= _MafiaGameLogic.PHASE_LOBBY then return end
		
		    if self.lobbyChatInput ~= nil and self.lobbyChatInput.IsFocused then return end
		    if self.roomTitleInput ~= nil and self.roomTitleInput.IsFocused then return end
		    if self.roomPasswordInput ~= nil and self.roomPasswordInput.IsFocused then return end
		    if self.inviteSearchInput ~= nil and self.inviteSearchInput.IsFocused then return end
		
		    local localUserId = self:GetLocalUserId()
		    if localUserId == "" then return end
		
		    local seatIndex = 0
		    for i = 1, 8 do
		        if self.cachedLobbySeats[i] == localUserId then
		            seatIndex = i
		            break
		        end
		    end
		    if seatIndex <= 0 then return end
		
		    local avatarEntity = self.lobbyAvatarEntities[seatIndex]
		    if avatarEntity == nil or isvalid(avatarEntity) == false then return end
		    if avatarEntity.UITransformComponent == nil then return end
		
		    if self.lobbyAvatarHomeX == nil then self.lobbyAvatarHomeX = {} end
		    local pos = avatarEntity.UITransformComponent.anchoredPosition
		    if self.lobbyAvatarHomeX[seatIndex] == nil then
		        self.lobbyAvatarHomeX[seatIndex] = pos.x
		        log("[MafiaUIFlow] local lobby avatar control ready seat=" .. tostring(seatIndex) .. " homeX=" .. tostring(pos.x))
		    end
		
		    local dir = 0
		    if _InputService:IsKeyPressed(KeyboardKey.LeftArrow) or _InputService:IsKeyPressed(KeyboardKey.A) then
		        dir = dir - 1
		    end
		    if _InputService:IsKeyPressed(KeyboardKey.RightArrow) or _InputService:IsKeyPressed(KeyboardKey.D) then
		        dir = dir + 1
		    end

		    local nextState = "idle"
		    if dir ~= 0 then nextState = "walk" end

		    local avatarRenderer = avatarEntity.AvatarGUIRendererComponent
		    if avatarRenderer ~= nil and dir ~= 0 then
		        -- The unflipped lobby avatar faces left; flip it while moving right.
		        avatarRenderer.FlipX = (dir > 0)
		    end
		
		    local homeX = self.lobbyAvatarHomeX[seatIndex]
		    local minX = homeX - self.lobbyAvatarMoveLimit
		    local maxX = homeX + self.lobbyAvatarMoveLimit
		    local nextX = pos.x + dir * self.lobbyAvatarMoveSpeed * delta
		    if nextX < minX then nextX = minX end
		    if nextX > maxX then nextX = maxX end

		    local nextY = pos.y
		    local leftFoothold = self.lobbyFootholdLeftEntities[seatIndex]
		    local rightFoothold = self.lobbyFootholdRightEntities[seatIndex]
		    if leftFoothold ~= nil and rightFoothold ~= nil
		        and leftFoothold.UITransformComponent ~= nil and rightFoothold.UITransformComponent ~= nil then
		        local leftTransform = leftFoothold.UITransformComponent
		        local rightTransform = rightFoothold.UITransformComponent
		        local leftPosition = leftTransform.anchoredPosition
		        local rightPosition = rightTransform.anchoredPosition
		        local span = rightPosition.x - leftPosition.x
		        local ratio = 0.5
		        if span ~= 0 then ratio = math.max(0, math.min(1, (nextX - leftPosition.x) / span)) end
		        local leftFloorY = leftPosition.y - leftTransform.RectSize.y * 0.5
		        local rightFloorY = rightPosition.y - rightTransform.RectSize.y * 0.5
		        local floorY = leftFloorY + (rightFloorY - leftFloorY) * ratio
		        nextY = floorY
		    end
		    avatarEntity.UITransformComponent.anchoredPosition = Vector2(nextX, nextY)

		    if self.lobbyAvatarActionStates == nil then self.lobbyAvatarActionStates = {} end
		    if self.lobbyAvatarActionStates[seatIndex] ~= nextState then
		        self.lobbyAvatarActionStates[seatIndex] = nextState
		        self:ApplyLobbyAvatarBodyAction(avatarEntity, nextState)
		    end

		    self:PositionLobbyNickname(seatIndex, nextX, nextY)
		    if self.lobbyAvatarFollowLogged == false then
		        local roomText = self.lobbyRoomTexts[seatIndex]
		        if roomText ~= nil and roomText.Entity ~= nil
		            and roomText.Entity.UITransformComponent ~= nil then
		            local nicknamePosition = roomText.Entity.UITransformComponent.anchoredPosition
		            self.lobbyAvatarFollowLogged = true
		            log("[MafiaUIFlow] lobby nickname follow verified seat=" .. tostring(seatIndex)
		                .. " avatarX=" .. tostring(nextX)
		                .. " nicknameX=" .. tostring(nicknamePosition.x)
		                .. " offsetY=" .. tostring(nicknamePosition.y - nextY))
		        end
		    end
	end

	method void OpenLobbyAfterRoomCreated(string roomTitle, boolean isPrivate, string password, integer maxPlayers, integer mafiaCount)
		    -- Unlocks the Mafia HUD flow after the user creates a room from the main lobby.
		    self.lobbyLeavePending = false
		    self.mafiaHudUnlocked = true
		    self.cachedPhase = -1
		    self.dayLobbyTemplateSynced = false
		    if _MafiaGameLogic ~= nil then
		        _MafiaGameLogic:SetRoomSettings(roomTitle, isPrivate, password, maxPlayers, mafiaCount)
		    end
		    self.lobbyPlacementRequested = false
		
		    local introUI = _EntityService:GetEntityByPath("/ui/UI_IntroSequence")
		    if introUI ~= nil and isvalid(introUI) then introUI:SetEnable(false) end
		
		    local storyUI = _EntityService:GetEntityByPath("/ui/UI_StorySequence")
		    if storyUI ~= nil and isvalid(storyUI) then storyUI:SetEnable(false) end
		
		    local nicknameUI = _EntityService:GetEntityByPath("/ui/UI_NicknameSetup")
		    if nicknameUI ~= nil and isvalid(nicknameUI) then nicknameUI:SetEnable(false) end
		
		    local mainLobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if mainLobby ~= nil and isvalid(mainLobby) then
		        mainLobby:SetEnable(false)
		        mainLobby.Visible = false
		    end
		
		    self:RestoreLocalWorldPlayerForLobby()
		    self:RequestLobbyRoomPlacementOnce()
		
		    self:ResolveUI()
		    self:SyncDayLobbyTemplatesFromLobby()
		    self:RefreshUI(true)
		    log("[MafiaUIFlow] mafia lobby unlocked after room creation title=" .. tostring(roomTitle) .. " max=" .. tostring(maxPlayers) .. " mafia=" .. tostring(mafiaCount))
	end

	method void EnterRoomLobby()
		    -- Called by LobbyController after room creation or join. Unlocks the Mafia HUD flow.
		    self.lobbyLeavePending = false
		    self.mafiaHudUnlocked = true
		    self.cachedPhase = -1
		    self.dayLobbyTemplateSynced = false
		    local introUI = _EntityService:GetEntityByPath("/ui/UI_IntroSequence")
		    if introUI ~= nil and isvalid(introUI) then introUI:SetEnable(false) end
		    local storyUI = _EntityService:GetEntityByPath("/ui/UI_StorySequence")
		    if storyUI ~= nil and isvalid(storyUI) then storyUI:SetEnable(false) end
		    local nicknameUI = _EntityService:GetEntityByPath("/ui/UI_NicknameSetup")
		    if nicknameUI ~= nil and isvalid(nicknameUI) then nicknameUI:SetEnable(false) end
		    local mainLobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if mainLobby ~= nil and isvalid(mainLobby) then
		        mainLobby:SetEnable(false)
		        mainLobby.Visible = false
		    end
		    self:RestoreLocalWorldPlayerForLobby()
		    self:RequestLobbyRoomPlacementOnce()
		    self:ResolveUI()
		    self:SyncDayLobbyTemplatesFromLobby()
		    self:RefreshUI(true)
		    log("[MafiaUIFlow] EnterRoomLobby: mafia HUD unlocked")
	end

	method void RefreshLobby()
		    self:RestoreLocalWorldPlayerForLobby()
		    self:RequestLobbyRoomPlacementOnce()
		    self:ResolvePhaseChatContext("MafiaLobbyHUD")
		    if self.lobbyRoomInfoText ~= nil and _MafiaGameLogic ~= nil then
		        local title = _MafiaGameLogic.RoomTitle
		        if title ~= nil and title ~= "" then
		            self.lobbyRoomInfoText.Text = title
		        end
		    end
		    local playerCount = _MafiaGameLogic.LobbyPlayerCount
		    if playerCount <= 0 then playerCount = #(_UserService.Users.Keys) end
		    local readyCount = _MafiaGameLogic.ReadyCount
		    local maxPlayers = _MafiaGameLogic.RoomMaxPlayers
		    if maxPlayers == nil or maxPlayers <= 0 then maxPlayers = _MafiaGameLogic.MAX_PLAYERS end
		    if self.lobbyPlayerCountText ~= nil then
		        self.lobbyPlayerCountText.Text = "대기 인원 " .. tostring(playerCount) .. "/" .. tostring(maxPlayers)
		    end
		    if self.lobbyReadyStatusText ~= nil then
		        self.lobbyReadyStatusText.Text = "준비 현황 " .. tostring(readyCount) .. "/" .. tostring(playerCount)
		    end
		    if self.lobbyReadyHintText ~= nil then
		        if _MafiaGameLogic.DebugMode then
		            self.lobbyReadyHintText.Text = "준비하면 테스트 플레이가 시작됩니다."
		        elseif playerCount < _MafiaGameLogic.MIN_PLAYERS then
		            self.lobbyReadyHintText.Text = "최소 " .. tostring(_MafiaGameLogic.MIN_PLAYERS) .. "명이 필요합니다."
		        else
		            self.lobbyReadyHintText.Text = "모든 플레이어가 준비하면 게임을 시작합니다."
		        end
		    end
		    local localReady = self:IsLocalReady()
		    if self.lobbyReadyText ~= nil then
		        self.lobbyReadyText.Text = localReady and "준비완료" or "준비"
		    end
		    local lobbyChatLog = _MafiaGameLogic.ChatLog or ""
		    if lobbyChatLog ~= self.lastLobbyChatLog then
		        self.lastLobbyChatLog = lobbyChatLog
		        self.lobbyChatBubbleScrollOffset = 0
		        self:HideLobbyRawChatLog()
		        self:ApplyLobbyChatBubbles(lobbyChatLog)
		    end
		    self:RefreshLobbyAvatars()
		    if self.lobbyReadyEntities ~= nil and self.cachedLobbySeats ~= nil then
		        local readySet = {}
		        for uid in string.gmatch(_MafiaGameLogic.ReadyStatusList or "", "[^,]+") do
		            readySet[uid] = true
		        end
		        for i = 1, 8 do
		            local userId = self.cachedLobbySeats[i]
		            local ent = self.lobbyReadyEntities[i]
		            if ent ~= nil then
		                ent.Enable = (userId ~= nil and userId ~= "" and readySet[userId] == true)
		            end
		        end
		    end
	end

	method table ParseLobbySeatString(string rawValue)
		    local seats = {}
		    for i = 1, 8 do seats[i] = "" end
		    if rawValue == nil or rawValue == "" then return seats end
		    local seatIndex = 1
		    for token in string.gmatch(rawValue .. ",", "(.-),") do
		        if seatIndex > 8 then break end
		        seats[seatIndex] = token
		        seatIndex = seatIndex + 1
		    end
		    return seats
	end

	method table GetLobbySeatOrderForDisplay()
		    local seats = self:ParseLobbySeatString(tostring(_MafiaGameLogic ~= nil and _MafiaGameLogic.LobbySeatOrder or ""))
		    if _MafiaGameLogic == nil or self:SeatCsvEmpty(_MafiaGameLogic.LobbySeatOrder) then
		        for i = 1, 8 do seats[i] = "" end
		        local seat = 1
		        for _, uid in ipairs(_UserService.Users.Keys) do
		            if seat > 8 then break end
		            seats[seat] = tostring(uid)
		            seat = seat + 1
		        end
		    end
		    return seats
	end

	method boolean SeatCsvEmpty(string value)
		    return value == nil or value == ""
	end

	method table GetLobbySeatNicknamesForDisplay(table seatOrder)
		    local names = {}
		    for i = 1, 8 do names[i] = "" end
		    if seatOrder == nil then
		        seatOrder = self:GetLobbySeatOrderForDisplay()
		    end

		    if _MafiaGameLogic ~= nil then
		        local nickSource = self:ParseLobbySeatString(tostring(_MafiaGameLogic.LobbySeatNicknames or ""))
		        if not self:SeatCsvEmpty(_MafiaGameLogic.LobbySeatNicknames) then
		            for i = 1, 8 do
		                names[i] = nickSource[i]
		            end
		        end
		    end

		    for i = 1, 8 do
		        if names[i] == "" then
		            local uid = seatOrder[i]
		            if uid ~= nil and uid ~= "" then
		                local user = _UserService.Users[uid]
		                if user ~= nil and user.Nickname ~= nil and user.Nickname ~= "" then
		                    names[i] = user.Nickname
		                else
		                    names[i] = "플레이어"
		                end
		            end
		        end
		    end

		    return names
	end

	method string GetMainLobbyProfileNickname()
		    local lobbyRoot = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if lobbyRoot == nil or isvalid(lobbyRoot) == false then return "" end
		    local lobbyCtrl = lobbyRoot:GetComponent("script.LobbyController")
		    if lobbyCtrl ~= nil and lobbyCtrl.currentProfileNickname ~= nil and lobbyCtrl.currentProfileNickname ~= "" then
		        return lobbyCtrl.currentProfileNickname
		    end

		    local profileText = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/ProfileRoot/NicknamePlate/NicknameText")
		    if profileText ~= nil and profileText.TextComponent ~= nil and profileText.TextComponent.Text ~= "" then
		        return profileText.TextComponent.Text
		    end

		    local avatarNameText = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot/LobbyAvatarArea/AvatarNameText")
		    if avatarNameText ~= nil and avatarNameText.TextComponent ~= nil and avatarNameText.TextComponent.Text ~= "" then
		        return avatarNameText.TextComponent.Text
		    end
		    return ""
	end

	method string GetMainLobbyAvatarState()
		    local lobbyRoot = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if lobbyRoot == nil or isvalid(lobbyRoot) == false then return "idle" end
		    local lobbyCtrl = lobbyRoot:GetComponent("script.LobbyController")
		    if lobbyCtrl ~= nil then
		        if lobbyCtrl.currentAvatarState ~= nil and lobbyCtrl.currentAvatarState ~= "" then
		            return lobbyCtrl.currentAvatarState
		        end
		    end
		    return "idle"
	end

	method void RefreshLobbyAvatars()
		if self.lobbyAvatarEntities == nil then return end

		local seats = self:GetLobbySeatOrderForDisplay()
		local nicknames = self:GetLobbySeatNicknamesForDisplay(seats)
		local localUserId = self:GetLocalUserId()
		if localUserId == "" and _UserService.LocalPlayer ~= nil and isvalid(_UserService.LocalPlayer) and _UserService.LocalPlayer.PlayerComponent ~= nil then
		    localUserId = tostring(_UserService.LocalPlayer.PlayerComponent.UserId)
		end
		local localProfileNickname = self:GetMainLobbyProfileNickname()
		for i = 1, 8 do
			local userId = seats[i]
			local avatarEntity = self.lobbyAvatarEntities[i]
			local roomText = self.lobbyRoomTexts[i]
			local isNewLocalSeat = false

			if userId ~= nil and userId ~= "" then
				if avatarEntity ~= nil then
					local avatarRenderer = avatarEntity.AvatarGUIRendererComponent
					local costume = avatarEntity.CostumeManagerComponent

					if self.cachedLobbySeats[i] ~= userId then
						isNewLocalSeat = true
						if self.lobbyAvatarActionStates ~= nil then
							self.lobbyAvatarActionStates[i] = nil
						end
						-- Apply the user's equipment before the first rendered frame.
						if avatarRenderer ~= nil then avatarRenderer.Enable = false end
						if costume ~= nil then
							costume.Enable = false
							costume.UseCustomEquipOnly = false
							costume.DefaultEquipUserId = userId
							costume.Enable = true
						end

						self.cachedLobbySeats[i] = userId
						log("[MafiaUIFlow] lobby avatar initialized seat=" .. tostring(i)
							.. " userId=" .. userId
							.. " costume=" .. tostring(costume ~= nil)
							.. " renderer=" .. tostring(avatarRenderer ~= nil))
					end

					if userId == localUserId then
						-- Local slot must always mirror UI_Lobby profile nickname and avatar state.
						if isNewLocalSeat == true then
							-- Initialize with idle so movement state is managed only by lobby movement input afterward.
							self.lobbyAvatarActionStates[i] = "idle"
							self:ApplyLobbyAvatarBodyAction(avatarEntity, "idle")
						end
						self:ApplyLobbyAvatarFromMainLobby(i, userId, avatarEntity, false)
					elseif costume ~= nil then
						costume.UseCustomEquipOnly = false
						costume.DefaultEquipUserId = userId
						costume.Enable = true
					end

					avatarEntity.Enable = true
					avatarEntity.Visible = true
					if costume ~= nil then costume.Enable = true end
					if avatarRenderer ~= nil then avatarRenderer.Enable = true end
				end

				if roomText ~= nil then
					local nickname = nicknames[i]
					if userId == localUserId then
						if localProfileNickname ~= nil and localProfileNickname ~= "" then
							nickname = localProfileNickname
						end
					end
					if nickname == "" then nickname = "플레이어" end
					roomText.Text = nickname
				end
			else
				if avatarEntity ~= nil then
					avatarEntity.Enable = false
					if avatarEntity.AvatarGUIRendererComponent ~= nil then avatarEntity.AvatarGUIRendererComponent.Enable = false end
					if avatarEntity.CostumeManagerComponent ~= nil then avatarEntity.CostumeManagerComponent.Enable = false end
				end

				if roomText ~= nil then roomText.Text = "" end
				self.cachedLobbySeats[i] = nil
			end
		end
	end

	method void RefreshDay(integer phase)
		    self:ResolvePhaseChatContext("MafiaDayHUD")
		    self:RefreshDayRoomBadgeAvatars()
		    local playerCount = #(_UserService.Users.Keys)
		    if self.dayPlayerCountText ~= nil then
		        self.dayPlayerCountText.Text = "플레이어 " .. tostring(playerCount) .. "/" .. tostring(_MafiaGameLogic.MAX_PLAYERS)
		    end
		    if self.dayText ~= nil then self.dayText.Text = tostring(math.max(1, _MafiaGameLogic.DayCount)) .. "일차" end
		    if self.dayTimerText ~= nil then self.dayTimerText.Text = self:FormatTime(_MafiaGameLogic.PhaseTimer) end
		    if self.dayPhaseTitleText ~= nil and self.dayPhaseDescriptionText ~= nil then
		        if phase == _MafiaGameLogic.PHASE_FREE_ROAM then
		            self.dayPhaseTitleText.Text = "낮 토론"
		            self.dayPhaseDescriptionText.Text = "대화와 추리를 통해 마피아를 찾아보세요."
		        elseif phase == _MafiaGameLogic.PHASE_MEETING then
		            self.dayPhaseTitleText.Text = "투표"
		            self.dayPhaseDescriptionText.Text = "의심되는 플레이어를 선택하거나 스킵하세요."
		        else
		            self.dayPhaseTitleText.Text = "게임 진행 중"
		            self.dayPhaseDescriptionText.Text = "현재 페이즈가 진행 중입니다."
		        end
		    end
		    -- 사망 플레이어는 DeadChatLog를, 생존자는 ChatLog를 표시
		    local dayChatLog
		    if self:IsLocalPlayerDead() then
		        dayChatLog = _MafiaGameLogic.DeadChatLog or ""
		        if dayChatLog ~= self.lastDeadChatLog then
		            self.lastDeadChatLog = dayChatLog
		            self.lastDayChatLog  = ""
		            self.lobbyChatBubbleScrollOffset = 0
		            self:HideLobbyRawChatLog()
		            self:ApplyLobbyChatBubbles(dayChatLog)
		        end
		    else
		        dayChatLog = _MafiaGameLogic.ChatLog or ""
		    end
		    if not self:IsLocalPlayerDead() and dayChatLog ~= self.lastDayChatLog then
		        self.lastDayChatLog = dayChatLog
		        self.lobbyChatBubbleScrollOffset = 0
		        self:HideLobbyRawChatLog()
		        self:ApplyLobbyChatBubbles(dayChatLog)
		    end
		    if self.dayVoteStatusText ~= nil then
		        local count = self:CountCsv(_MafiaGameLogic.VoteStatusList)
		        self.dayVoteStatusText.Text = tostring(count) .. "/" .. tostring(playerCount) .. " 투표"
		    end
		    if self.daySkipCountText ~= nil then
		        local skipCount = self:CountCsv(_MafiaGameLogic.DaySkipStatusList)
		        self.daySkipCountText.Text = tostring(skipCount) .. "/" .. tostring(playerCount)
		        local showSkip = (phase == _MafiaGameLogic.PHASE_FREE_ROAM) and not self:IsLocalPlayerDead()
		        self.daySkipCountText.Entity.Enable = showSkip
		        if self.daySkipButton ~= nil then
		            self.daySkipButton.Entity.Enable = showSkip
		        end
		    end
		    if self.dayVoteHintText ~= nil then
		        if phase == _MafiaGameLogic.PHASE_MEETING then
		            self.dayVoteHintText.Text = "투표할 플레이어를 선택해주세요."
		        else
		            self.dayVoteHintText.Text = "토론을 진행하며 단서를 모아보세요."
		        end
		    end
		    if phase == _MafiaGameLogic.PHASE_MEETING then
		        if not self.voteUIShown and not self.voteAnimePlaying then
		            self:PlayVoteAnime()
		        else
		            if self.voteTitleComp ~= nil then
		                self.voteTitleComp.Text = "투표  " .. tostring(math.max(0, math.ceil(_MafiaGameLogic.PhaseTimer)))
		            end
		        end
		    elseif phase == _MafiaGameLogic.PHASE_MEETING_RESULT then
		        if self.voteUIShown and not self.executionStampShown then
		            self.executionStampShown = true
		            local executeTarget = _MafiaGameLogic.ExecuteTarget
		            if executeTarget ~= nil and executeTarget ~= "" then
		                self:ShowExecutionStamp(executeTarget)
		                self.voteResultPendingTarget = executeTarget
		                self.voteResultPendingDelay = 1.5
		            else
		                self:PlayVoteResultAnime(executeTarget)
		            end
		        end
		    else
		        if self.voteUIShown then
		            self:HideVotePanel()
		        end
		    end
	end

	method void HandleReadyClick()
		    if _MafiaGameLogic == nil or _MafiaGameLogic.CurrentPhase ~= _MafiaGameLogic.PHASE_LOBBY then return end
		    local userId = self:GetLocalUserId()
		    if userId == "" then return end
		    local isReady = self:IsLocalReady()
		    _MafiaGameLogic:SetReady(userId, not isReady)
		    log("[MafiaUIFlow] ready toggle: " .. userId .. " -> " .. tostring(not isReady))
	end

	method void PlayReadyTransition()
		    if self.lobbyReadyButton == nil then return end
		    local buttonEntity = self.lobbyReadyButton.Entity
		    if buttonEntity == nil then return end
		    if self.readyTween ~= nil and self.readyTween.IsPlaying then self.readyTween:Complete() end
		    local shrink = _TweenLogic:ScaleTo(buttonEntity, Vector2(0.94, 0.94), 0.08, EaseType.QuadEaseOut)
		    self.readyTween = shrink
		    shrink:SetOnEndCallback(function()
		        if self.lobbyReadyText ~= nil then self.lobbyReadyText.Text = "준비완료" end
		        self.readyTween = _TweenLogic:ScaleTo(buttonEntity, Vector2(1, 1), 0.16, EaseType.BackEaseOut)
		    end)
		    log("[MafiaUIFlow] ready transition animation started")
	end

	method void HandleInviteClick()
		    if self.invitePanel ~= nil then
		        self.invitePanel.Enable = true
		        if self.inviteSearchInput ~= nil then self.inviteSearchInput.Text = "" end
		        if self.inviteSearchHint ~= nil then self.inviteSearchHint.Enable = true end
		        self:RefreshInviteList("")
		    end
		    log("[MafiaUIFlow] invite panel opened")
	end

	method void HandleLobbyExit()
		    -- Returns to UI_Lobby immediately, then asks the server to clear the room data.
		    log("[MafiaUIFlow] lobby exit requested")
		    local roomId = self:GetJoinedInvestigationRoomId()
		    self:ClearJoinedInvestigationRoomId()
		    if _MafiaGameLogic ~= nil then
		        _MafiaGameLogic:RequestLeaveRoom()
		    end
		    self:ReturnToMainLobbyFromRoom()

		    if _InvestigationRoomManager ~= nil then
		        self.lobbyLeavePending = true
		        _InvestigationRoomManager:LeaveRoom(roomId)
		        log("[MafiaUIFlow] requested room cleanup roomId=" .. roomId)
		    else
		        self.lobbyLeavePending = false
		        log_warning("[MafiaUIFlow] room manager missing while leaving; returned locally")
		    end
	end

	method string GetJoinedInvestigationRoomId()
		    -- Reads the currently joined investigation room id from the main lobby controller.
		    local lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if lobby == nil or isvalid(lobby) == false then return "" end
		    ---@type LobbyController
		    local controller = lobby:GetComponent("script.LobbyController")
		    if controller == nil then return "" end
		    if controller.joinedRoomId == nil then return "" end
		    return controller.joinedRoomId
	end

	method void ResetLobbyLeavePending()
		    -- Allows the exit button to be used again after a leave failure.
		    self.lobbyLeavePending = false
	end

	method void OnInvestigationRoomLeaveResult(boolean success, string message)
		    -- Handles the authoritative room cleanup result after the UI already returned.
		    self:ResetLobbyLeavePending()
		    if success == false then
		        log_warning("[MafiaUIFlow] leave room failed message=" .. tostring(message))
		        if _UIToast ~= nil then _UIToast:ShowMessage(message) end
		        return
		    end

		    self:ClearJoinedInvestigationRoomId()
		    if _UIToast ~= nil then _UIToast:ShowMessage(message) end
		    log("[MafiaUIFlow] leave result success; room cleanup completed")
	end

	method void ClearJoinedInvestigationRoomId()
		    -- Clears the room id cached by the main lobby controller.
		    local lobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if lobby == nil or isvalid(lobby) == false then return end
		    ---@type LobbyController
		    local controller = lobby:GetComponent("script.LobbyController")
		    if controller ~= nil then
		        controller.joinedRoomId = ""
		    end
	end

	method void ReturnToMainLobbyFromRoom()
		    -- Hides Mafia HUD roots and reopens the main UI_Lobby screen.
		    self.lobbyLeavePending = false
		    self.mafiaHudUnlocked = false
		    self.cachedPhase = -1
		    self.lobbyPlacementRequested = false
		    self:HideAllMafiaHUDs()
		    if self.invitePanel ~= nil then self.invitePanel.Enable = false end
		    if self.roomSettingsPanel ~= nil then self.roomSettingsPanel.Enable = false end
		    if self.settingsPanel ~= nil then self.settingsPanel.Enable = false end

		    local mainLobby = _EntityService:GetEntityByPath("/ui/UI_Lobby")
		    if mainLobby == nil or isvalid(mainLobby) == false then
		        log_warning("[MafiaUIFlow] UI_Lobby not found while leaving MafiaLobbyHUD")
		        return
		    end
		    mainLobby:SetEnable(true)
		    mainLobby.Visible = true

		    local lobbyRoot = _EntityService:GetEntityByPath("/ui/UI_Lobby/LobbyRoot")
		    if lobbyRoot ~= nil and isvalid(lobbyRoot) then
		        lobbyRoot:SetEnable(true)
		        lobbyRoot.Visible = true
		    end

		    ---@type LobbyController
		    local controller = mainLobby:GetComponent("script.LobbyController")
		    if controller ~= nil then
		        local nickname = controller.currentProfileNickname
		        if nickname == nil or nickname == "" then nickname = "수사관" end
		        controller:ShowLobby(nickname)
		    else
		        log_warning("[MafiaUIFlow] LobbyController not found while returning to UI_Lobby")
		    end
		    log("[MafiaUIFlow] returned to UI_Lobby from MafiaLobbyHUD")
	end

	method void HandleInviteClose()
		    if self.invitePanel ~= nil then
		        self.invitePanel.Enable = false
		    end
		    log("[MafiaUIFlow] invite panel closed")
	end

	method void HandleInviteSearchChange(TextInputValueChangeEvent event)
