		        if self.roomPlayerButtons[7] ~= nil and self.roomPlayer7Handler ~= nil then self.roomPlayerButtons[7].Entity:DisconnectEvent(ButtonClickEvent, self.roomPlayer7Handler) end
		        if self.roomPlayerButtons[8] ~= nil and self.roomPlayer8Handler ~= nil then self.roomPlayerButtons[8].Entity:DisconnectEvent(ButtonClickEvent, self.roomPlayer8Handler) end
