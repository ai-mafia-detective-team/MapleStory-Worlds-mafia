		    self.citizenWinAvatarEntities = {}
		    self.mafiaWinAvatarEntities = {}
		    self.lastWinAvatarSignature = ""
		    self.settingResolutionOptions = {"1280 × 720", "1600 × 900", "1920 × 1080"}
		    self:ResolveUI()
		    self:HideAllMafiaHUDs()
		    -- Keep the Mafia in-room HUD hidden until the main flow finishes room creation.
		    -- Desired flow: Intro -> Nickname -> Create Room -> MafiaLobbyHUD.
		    self.mafiaHudUnlocked = false
		    self:BeginStartupLoadingFlow()
		    log("[MafiaUIFlow] initialized")
	end

	method void OnUpdate(number delta)
		    if self.settingsPanel ~= nil and self.settingsPanel.Enable then
		        if _InputService:IsKeyPressed(KeyboardKey.Escape) then
		            self:HandleSettingsClose()
		        end
		    end
		    if self.lobbyScrollThumb ~= nil and self.lobbyScrollThumb.UITransformComponent ~= nil then
		        local curr = self.lobbyScrollThumbCurrentY
		        local target = self.lobbyScrollThumbTargetY
		        if math.abs(target - curr) > 0.5 then
		            local factor = math.min(1.0, delta * 14)
		            local newY = curr + (target - curr) * factor
		            self.lobbyScrollThumbCurrentY = newY
		            local pos = self.lobbyScrollThumb.UITransformComponent.anchoredPosition
		            self.lobbyScrollThumb.UITransformComponent.anchoredPosition = Vector2(pos.x, newY)
		        elseif curr ~= target then
		            self.lobbyScrollThumbCurrentY = target
		            local pos = self.lobbyScrollThumb.UITransformComponent.anchoredPosition
		            self.lobbyScrollThumb.UITransformComponent.anchoredPosition = Vector2(pos.x, target)
		        end
		    end
		    if self.mafiaHudUnlocked then
		        self:UpdateLocalLobbyAvatarMovement(delta)
		        self:ApplySyncedDayAvatarMotions()
		        self:UpdateLocalDayAvatarMovement(delta)
		    end
		    -- 나이트 액션 엔티티 페이드인
		    -- 나이트 액션 패널 페이드아웃 (서브페이즈 전환 시)
		    if self.nightFadingOut then
		        self.nightFadeOutAlpha = math.max(0.0, self.nightFadeOutAlpha - delta * 2.5)
		        local foe = self.nightFadeOutEnt
		        if foe ~= nil then
		            local cg = foe.CanvasGroupComponent
		            if cg ~= nil then cg.GroupAlpha = self.nightFadeOutAlpha end
		        end
		        if self.nightOverlayTextComp ~= nil then
		            local fc = self.nightOverlayTextComp.FontColor
		            self.nightOverlayTextComp.FontColor = Color(fc.r, fc.g, fc.b, self.nightFadeOutAlpha)
		        end
		        if self.nightFadeOutAlpha <= 0 then
		            self.nightFadingOut = false
		            local foe2 = self.nightFadeOutEnt
		            if foe2 ~= nil then
		                foe2.Enable = false
		                self.nightFadeOutEnt = nil
		            end
		        end
		    end
		    if self.nightFadingIn then
		        self.nightActionAlpha = math.min(1.0, self.nightActionAlpha + delta * 2.5)
		        local a = self.nightActionAlpha
		        local activeEnt = nil
		        if self.nightMafiaActionEnt ~= nil and self.nightMafiaActionEnt.Enable then
		            activeEnt = self.nightMafiaActionEnt
		        elseif self.nightPoliceActionEnt ~= nil and self.nightPoliceActionEnt.Enable then
		            activeEnt = self.nightPoliceActionEnt
		        elseif self.nightDoctorActionEnt ~= nil and self.nightDoctorActionEnt.Enable then
		            activeEnt = self.nightDoctorActionEnt
		        elseif self.nightMafiaPanel ~= nil and self.nightMafiaPanel.Enable then
		            activeEnt = self.nightMafiaPanel
		        elseif self.nightPolicePanel ~= nil and self.nightPolicePanel.Enable then
		            activeEnt = self.nightPolicePanel
		        elseif self.nightDoctorPanel ~= nil and self.nightDoctorPanel.Enable then
		            activeEnt = self.nightDoctorPanel
		        end
		        if activeEnt ~= nil then
		            local cg = activeEnt.CanvasGroupComponent
		            if cg ~= nil then cg.GroupAlpha = a end
		        end
		        if self.nightOverlayTextComp ~= nil then
		            local fc = self.nightOverlayTextComp.FontColor
		            self.nightOverlayTextComp.FontColor = Color(fc.r, fc.g, fc.b, a)
		        end
		        if a >= 1.0 then self.nightFadingIn = false end
		    end
		    -- VoteAnime 페이드 인/아웃 상태머신
		    if self.voteAnimePlaying then
		        local SPEED = 2.5
		        local DARK  = 0.25
		        if self.voteAnimePhase == 1 then
		            self.voteAnimeAlpha = math.min(1.0, self.voteAnimeAlpha + delta * SPEED)
		            local dark = math.max(DARK, 1.0 - self.voteAnimeAlpha * (1.0 - DARK))
		            if self.voteAnimeEnt ~= nil then
		                local cg = self.voteAnimeEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = self.voteAnimeAlpha end
		            end
		            if self.dayHudCenterPanelEnt ~= nil then
		                local cg = self.dayHudCenterPanelEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = dark end
		            end
		            if self.voteAnimeAlpha >= 1.0 then
		                self.voteAnimePhase = 2
		                self.voteAnimeTimer = 0
		            end
		        elseif self.voteAnimePhase == 2 then
		            self.voteAnimeTimer = self.voteAnimeTimer + delta
		            if self.voteAnimeTimer >= 2.5 then
		                self.voteAnimePhase = 3
		            end
		        elseif self.voteAnimePhase == 3 then
		            self.voteAnimeAlpha = math.max(0.0, self.voteAnimeAlpha - delta * SPEED)
		            local bright = DARK + (1.0 - DARK) * (1.0 - self.voteAnimeAlpha)
		            if self.voteAnimeEnt ~= nil then
		                local cg = self.voteAnimeEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = self.voteAnimeAlpha end
		            end
		            if self.dayHudCenterPanelEnt ~= nil then
		                local cg = self.dayHudCenterPanelEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = bright end
		            end
		            if self.voteAnimeAlpha <= 0.0 then
		                self.voteAnimePlaying = false
		                self.voteAnimePhase   = 0
		                if self.dayHudCenterPanelEnt ~= nil then
		                    local cg = self.dayHudCenterPanelEnt.CanvasGroupComponent
		                    if cg ~= nil then cg.GroupAlpha = 1.0 end
		                end
		                if self.voteAnimeEnt ~= nil then
		                    self.voteAnimeEnt.Enable = false
		                end
		                self:ShowVoteUI()
		            end
		        end
		    end
		    -- ResultAnime 페이드 인/아웃 상태머신 (VoteResult + MorningResult 공용)
	    if self.voteResultPendingDelay > 0 then
		        self.voteResultPendingDelay = self.voteResultPendingDelay - delta
		        if self.voteResultPendingDelay <= 0 then
		            self.voteResultPendingDelay = 0
		            local pendingTarget = self.voteResultPendingTarget
		            self.voteResultPendingTarget = ""
		            self:PlayVoteResultAnime(pendingTarget)
		        end
		    end
		    if self.resultAnimePlaying then
		        local SPEED = 2.5
		        -- context에 따라 적절한 dim 엔티티 선택
		        local curDimEnt = (self.resultAnimeContext == "vote") and self.voteResultDimEnt or self.resultDimEnt
		        -- 투표 결과는 낮 HUD 전체가 확실히 어두워지도록 아침 결과보다 dim을 조금 더 진하게 적용한다.
		        local dimMaxAlpha = (self.resultAnimeContext == "vote") and 0.78 or 0.65
		        if self.resultAnimePhase == 1 then
		            self.resultAnimeAlpha = math.min(1.0, self.resultAnimeAlpha + delta * SPEED)
		            if self.resultAnimeEnt ~= nil then
		                local cg = self.resultAnimeEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = self.resultAnimeAlpha end
		            end
		            -- dim 오버레이도 같이 페이드인
		            if curDimEnt ~= nil then
		                local dimCg = curDimEnt.CanvasGroupComponent
		                if dimCg ~= nil then dimCg.GroupAlpha = self.resultAnimeAlpha * dimMaxAlpha end
		            end
		            if self.resultAnimeAlpha >= 1.0 then
		                self.resultAnimePhase = 2
		                self.resultAnimeTimer = 0
		            end
		        elseif self.resultAnimePhase == 2 then
		            self.resultAnimeTimer = self.resultAnimeTimer + delta
		            -- Result_1/2(아침 결과)만 1초 더 유지한다. 투표 결과 애니메이션은 기존 2.5초 유지.
		            local holdDuration = (self.resultAnimeContext == "morning") and 3.5 or 2.5
		            if self.resultAnimeTimer >= holdDuration then
		                self.resultAnimePhase = 3
		            end
		        elseif self.resultAnimePhase == 3 then
		            self.resultAnimeAlpha = math.max(0.0, self.resultAnimeAlpha - delta * SPEED)
		            if self.resultAnimeEnt ~= nil then
		                local cg = self.resultAnimeEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = self.resultAnimeAlpha end
		            end
		            -- dim 오버레이도 같이 페이드아웃
		            if curDimEnt ~= nil then
		                local dimCg = curDimEnt.CanvasGroupComponent
		                if dimCg ~= nil then dimCg.GroupAlpha = self.resultAnimeAlpha * dimMaxAlpha end
		            end
		            if self.resultAnimeAlpha <= 0.0 then
		                self.resultAnimePlaying = false
		                self.resultAnimePhase   = 0
		                if self.resultAnimeEnt ~= nil then
		                    self.resultAnimeEnt.Enable = false
		                    self.resultAnimeEnt = nil
		                end
		                if curDimEnt ~= nil then
		                    curDimEnt.Enable = false
		                end
		                local ctx = self.resultAnimeContext
		                self.resultAnimeContext = ""
		                if ctx == "vote" then
		                    self:HideVotePanel()
		                elseif ctx == "morning" then
		                    self:RefreshUI(true)
		                    local dayCg = (self.dayRoot ~= nil) and self.dayRoot.CanvasGroupComponent or nil
		                    if dayCg ~= nil then
		                        self.dayFadeInAlpha = 0.0
		                        self.dayFadeInPlaying = true
		                        dayCg.GroupAlpha = 0.0
		                        log("[MafiaUIFlow] morning result faded out; MafiaDayHUD fade-in started")
		                    end
		                end
		            end
		        end
		    end
		    -- Result_1/2가 완전히 사라진 뒤 낮 HUD를 부드럽게 나타낸다.
		    if self.dayFadeInPlaying then
		        local dayCg = (self.dayRoot ~= nil) and self.dayRoot.CanvasGroupComponent or nil
		        if dayCg == nil then
		            self.dayFadeInPlaying = false
		            self.dayFadeInAlpha = 1.0
		        else
		            self.dayFadeInAlpha = math.min(1.0, self.dayFadeInAlpha + delta * 1.8)
		            dayCg.GroupAlpha = self.dayFadeInAlpha
		            if self.dayFadeInAlpha >= 1.0 then
		                self.dayFadeInPlaying = false
		                log("[MafiaUIFlow] MafiaDayHUD fade-in completed")
		            end
		        end
		    end
		    -- 경찰 조사결과 애니메이션 상태머신 (경찰 클라이언트 전용)
		    -- Phase 1: ResultDimBg 서서히 어두워짐 + PoliceResultDisplay 페이드인
		    -- Phase 2: 2초 대기
		    -- Phase 3: 페이드아웃 + dim 해제 → DoctorAction 페이드인 트리거
		    if self.policeResultPlaying then
		        local SPEED = 2.5
		        if self.policeResultPhase == 1 then
		            self.policeResultAlpha = math.min(1.0, self.policeResultAlpha + delta * SPEED)
		            if self.policeResultDisplayEnt ~= nil then
		                local cg = self.policeResultDisplayEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = self.policeResultAlpha end
		            end
		            if self.resultDimEnt ~= nil then
		                local dimCg = self.resultDimEnt.CanvasGroupComponent
		                if dimCg ~= nil then dimCg.GroupAlpha = self.policeResultAlpha * 0.65 end
		            end
		            if self.policeResultAlpha >= 1.0 then
		                self.policeResultPhase = 2
		                self.policeResultTimer = 0.0
		            end
		        elseif self.policeResultPhase == 2 then
		            self.policeResultTimer = self.policeResultTimer + delta
		            if self.policeResultTimer >= 2.0 then
		                self.policeResultPhase = 3
		            end
		        elseif self.policeResultPhase == 3 then
		            self.policeResultAlpha = math.max(0.0, self.policeResultAlpha - delta * SPEED)
		            if self.policeResultDisplayEnt ~= nil then
		                local cg = self.policeResultDisplayEnt.CanvasGroupComponent
		                if cg ~= nil then cg.GroupAlpha = self.policeResultAlpha end
		            end
		            if self.resultDimEnt ~= nil then
		                local dimCg = self.resultDimEnt.CanvasGroupComponent
		                if dimCg ~= nil then dimCg.GroupAlpha = self.policeResultAlpha * 0.65 end
		            end
		            if self.policeResultAlpha <= 0.0 then
		                self.policeResultPlaying = false
		                self.policeResultPhase   = 0
		                if self.policeResultDisplayEnt ~= nil then self.policeResultDisplayEnt.Enable = false end
		                if self.policeResultTextEnt ~= nil then self.policeResultTextEnt.Enable = false end
		                if self.resultDimEnt ~= nil then self.resultDimEnt.Enable = false end
		                -- DoctorAction 페이드인: GroupAlpha=0으로 enable 후 nightFadingIn 시작
		                if self.nightDoctorActionEnt ~= nil then
		                    self.nightDoctorActionEnt.Enable = true
		                    local cg = self.nightDoctorActionEnt.CanvasGroupComponent
		                    if cg ~= nil then cg.GroupAlpha = 0 end
		                end
		                self.nightActionAlpha = 0
		                self.nightFadingIn    = true
		                self.nightUIShown     = true  -- ShowNightPanel 중복 호출 방지
		            end
		        end
		    end
		    self.refreshAccumulator = self.refreshAccumulator + delta
		    if self.refreshAccumulator < 0.1 then return end
		    self.refreshAccumulator = 0.0
		    if not self.uiResolved then self:ResolveUI() end
		    if not self.mafiaHudUnlocked then
		        self:HideAllMafiaHUDs()
		        return
		    end
		    self:RefreshUI(false)
	end

	method void OnEndPlay()
		    if self.startupLoadingTimerId > 0 then
		        _TimerService:ClearTimer(self.startupLoadingTimerId)
		        self.startupLoadingTimerId = 0
		    end
		    if self.lobbyReadyButton ~= nil and self.readyClickHandler ~= nil then
		        self.lobbyReadyButton.Entity:DisconnectEvent(ButtonClickEvent, self.readyClickHandler)
