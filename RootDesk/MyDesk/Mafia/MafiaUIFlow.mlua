	method void ResolveUI()
		    self.lobbyRoot = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD")
		    self.dayRoot   = _EntityService:GetEntityByPath("/ui/MafiaDayHUD")
		    self.nightRoot = _EntityService:GetEntityByPath("/ui/MafiaNightHUD")
		    self.legacyRoot = _EntityService:GetEntityByPath("/ui/MafiaPlayHUD")
		    if self.lobbyRoot == nil or self.dayRoot == nil then return end
		
		    if self.lobbyAvatarEntities == nil then self.lobbyAvatarEntities = {} end
		    if self.lobbyRoomTexts == nil then self.lobbyRoomTexts = {} end
		    if self.cachedLobbySeats == nil then self.cachedLobbySeats = {} end
		    if self.lobbyFootholdLeftEntities == nil then self.lobbyFootholdLeftEntities = {} end
		    if self.lobbyFootholdRightEntities == nil then self.lobbyFootholdRightEntities = {} end
		    local lobbyFootholdLeftPaths = {
		        "/ui/MafiaLobbyHUD/RoomBadge1/DebugUIFoothold_Left",
		        "/ui/MafiaLobbyHUD/RoomBadge2/DebugUIFoothold_Left_1",
		        "/ui/MafiaLobbyHUD/RoomBadge3/DebugUIFoothold_Left_1",
		        "/ui/MafiaLobbyHUD/RoomBadge4/DebugUIFoothold_Left_1",
		        "/ui/MafiaLobbyHUD/RoomBadge5/DebugUIFoothold_Left_1",
		        "/ui/MafiaLobbyHUD/RoomBadge6/DebugUIFoothold_Left_1",
		        "/ui/MafiaLobbyHUD/RoomBadge7/DebugUIFoothold_Left_2",
		        "/ui/MafiaLobbyHUD/RoomBadge8/DebugUIFoothold_Left_3"
		    }
		    local lobbyFootholdRightPaths = {
		        "/ui/MafiaLobbyHUD/RoomBadge1/DebugUIFoothold_Right",
		        "/ui/MafiaLobbyHUD/RoomBadge2/DebugUIFoothold_Right_1",
		        "/ui/MafiaLobbyHUD/RoomBadge3/DebugUIFoothold_Right_1",
		        "/ui/MafiaLobbyHUD/RoomBadge4/DebugUIFoothold_Right_1",
		        "/ui/MafiaLobbyHUD/RoomBadge5/DebugUIFoothold_Right_1",
		        "/ui/MafiaLobbyHUD/RoomBadge6/DebugUIFoothold_Right_1",
		        "/ui/MafiaLobbyHUD/RoomBadge7/DebugUIFoothold_Right_2",
		        "/ui/MafiaLobbyHUD/RoomBadge8/DebugUIFoothold_Right_3"
		    }
		    local lobbyFootholdLinePaths = {
		        "/ui/MafiaLobbyHUD/RoomBadge1/DebugUITextFoothold_Line",
		        "/ui/MafiaLobbyHUD/RoomBadge2/DebugUITextFoothold_Line_1",
		        "/ui/MafiaLobbyHUD/RoomBadge3/DebugUITextFoothold_Line_1",
		        "/ui/MafiaLobbyHUD/RoomBadge4/DebugUITextFoothold_Line_1",
		        "/ui/MafiaLobbyHUD/RoomBadge5/DebugUITextFoothold_Line_1",
		        "/ui/MafiaLobbyHUD/RoomBadge6/DebugUITextFoothold_Line_1",
		        "/ui/MafiaLobbyHUD/RoomBadge7/DebugUITextFoothold_Line_2",
		        "/ui/MafiaLobbyHUD/RoomBadge8/DebugUITextFoothold_Line_3"
		    }
		
		    for i = 1, 8 do
		        local suffix = (i == 1) and "" or ("_" .. tostring(i - 1))
		        local avatarEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/RoomBadge" .. tostring(i) .. "/LobbyAvatarArea" .. suffix)
		        local leftFoothold = _EntityService:GetEntityByPath(lobbyFootholdLeftPaths[i])
		        local rightFoothold = _EntityService:GetEntityByPath(lobbyFootholdRightPaths[i])
		        local footholdLine = _EntityService:GetEntityByPath(lobbyFootholdLinePaths[i])
		        local textEntity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/RoomBadge" .. tostring(i) .. "/Text")
		        self.lobbyAvatarEntities[i] = avatarEntity
		        self.lobbyFootholdLeftEntities[i] = leftFoothold
		        self.lobbyFootholdRightEntities[i] = rightFoothold
		        if textEntity ~= nil then self.lobbyRoomTexts[i] = textEntity.TextComponent end
		        if avatarEntity ~= nil and leftFoothold ~= nil and rightFoothold ~= nil and footholdLine ~= nil
		            and avatarEntity.UITransformComponent ~= nil
		            and leftFoothold.UITransformComponent ~= nil
		            and rightFoothold.UITransformComponent ~= nil
		            and footholdLine.UITransformComponent ~= nil then
		            local avatarTransform = avatarEntity.UITransformComponent
		            avatarTransform.RectSize = Vector2(
		                self.lobbyAvatarBaseWidth * self.lobbyAvatarScale,
		                self.lobbyAvatarBaseHeight * self.lobbyAvatarScale)
		            local leftTransform = leftFoothold.UITransformComponent
		            local rightTransform = rightFoothold.UITransformComponent
		            local spawnX = footholdLine.UITransformComponent.anchoredPosition.x
		            local leftPosition = leftTransform.anchoredPosition
		            local rightPosition = rightTransform.anchoredPosition
		            local span = rightPosition.x - leftPosition.x
		            local ratio = 0.5
		            if span ~= 0 then ratio = math.max(0, math.min(1, (spawnX - leftPosition.x) / span)) end
		            local leftFloorY = leftPosition.y - leftTransform.RectSize.y * 0.5
		            local rightFloorY = rightPosition.y - rightTransform.RectSize.y * 0.5
		            local floorY = leftFloorY + (rightFloorY - leftFloorY) * ratio
		            avatarTransform.anchoredPosition = Vector2(spawnX, floorY)
		            self:PositionLobbyNickname(i, spawnX, floorY)
		            if self.lobbyAvatarHomeX ~= nil then self.lobbyAvatarHomeX[i] = spawnX end
		        end
		    end
		    log("[MafiaUIFlow] lobby avatar layout configured scale=" .. tostring(self.lobbyAvatarScale)
		        .. " nicknameOffsetY=" .. tostring(self.lobbyNicknameOffsetY))
		
		    local entity = _EntityService:GetEntityByPath("/ui/MafiaLobbyHUD/CenterPanel/ReadyButton")
		    if entity ~= nil then
		        self.lobbyReadyButton = entity.ButtonComponent
