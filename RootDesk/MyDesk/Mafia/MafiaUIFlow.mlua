	method void SendNightMafiaChat(string message)
		    -- 마피아 전용 야간 채팅 전송. 서버에서 역할 검증 후 MafiaChatLog에 기록.
		    if message == nil or message == "" then return end
		    local userId = self:GetLocalUserId()
		    if userId == "" then return end
		    self.nightChatDraft = ""
		    self.nightChatLastNonEmptyDraft = ""
		    _MafiaGameLogic:SendMafiaChat(userId, message)
		    if self.nightChatInput ~= nil then
		        self.nightChatInput.Text = ""
		        self.nightChatInput:ActivateInputField()
		    end
	end

	method void SendChat(string message, any input)
		    if message == nil or message == "" then return end
		    local userId = self:GetLocalUserId()
		    if userId == "" then return end
		    if input == self.lobbyChatInput then
		        self.lastLobbySentMessage = message
		        self.lobbyChatDraft = ""
		        self.lobbyChatLastNonEmptyDraft = ""
		    elseif input == self.dayChatInput then
		        self.dayChatDraft = ""
		        self.dayChatLastNonEmptyDraft = ""
		    elseif input == self.nightChatInput then
		        self.nightChatDraft = ""
		        self.nightChatLastNonEmptyDraft = ""
		    end
		    _MafiaGameLogic:SendChat(userId, message)
		    if input ~= nil then
		        input.Text = ""
		        input:ActivateInputField()
		    end
	end

	method void HandleDaySkipClick()
		    if _MafiaGameLogic == nil then return end
		    local userId = self:GetLocalUserId()
		    if userId == "" then return end
		    if self:IsLocalPlayerDead() then return end
		    local phase = _MafiaGameLogic.CurrentPhase
		    if phase == _MafiaGameLogic.PHASE_FREE_ROAM then
		        _MafiaGameLogic:RequestSkipToMeeting(userId)
		    end
	end

	method boolean IsLocalReady()
		    local userId = self:GetLocalUserId()
		    if userId == "" then return false end
		    for id in string.gmatch(_MafiaGameLogic.ReadyStatusList or "", "[^,]+") do
		        if id == userId then return true end
		    end
		    return false
	end

	method string GetLocalUserId()
		    local localPlayer = _UserService.LocalPlayer
		    if localPlayer == nil then return "" end
		    for _, userId in ipairs(_UserService.Users.Keys) do
		        local entity = _UserService:GetUserEntityByUserId(tostring(userId))
		        if entity == localPlayer then return tostring(userId) end
		    end
		    return ""
	end

	method string FormatChat(string chatLog)
		    if chatLog == nil or chatLog == "" then return "아직 등록된 메시지가 없습니다." end
		    local lines = {}
		    for line in string.gmatch(chatLog, "[^\n]+") do
		        local splitIndex = string.match(line, "()\t")
		        if splitIndex ~= nil then
		            lines[#lines + 1] = string.sub(line, 1, splitIndex - 1) .. " : " .. string.sub(line, splitIndex + 1)
		        end
		    end
		    return table.concat(lines, "\n")
	end

	method void ApplyChatLog(any textComponent, any scrollComponent, string chatLog)
		    if textComponent == nil then return end
		    local formatted = self:FormatChat(chatLog)
		    textComponent.Text = formatted
		
		    local lineCount = 1
		    for _ in string.gmatch(formatted, "\n") do lineCount = lineCount + 1 end
		    local contentHeight = math.max(450, lineCount * 26 + 24)
		    local transform = textComponent.Entity.UITransformComponent
		    if transform ~= nil then transform.RectSize = Vector2(600, contentHeight) end
		
		    if scrollComponent ~= nil then
		        scrollComponent:SetScrollNormalizedPosition(UITransformAxis.Vertical, 0)
		        log("[MafiaUIFlow] chat scroll updated; lines=" .. tostring(lineCount))
		    end
		    if scrollComponent == self.lobbyChatScroll then
		        self:UpdateScrollThumb(lineCount, chatLog)
		    end
	end

	method void ApplyLobbyChatBubbles(string chatLog)
		    -- Renders each chat entry into its own speech-bubble slot.
		    local localUserId = self:GetLocalUserId()
		    local userIds = {}
		    local messages = {}
		
		    if chatLog ~= nil and chatLog ~= "" then
		        for line in string.gmatch(chatLog, "[^\n]+") do
		            local splitIndex = string.match(line, "()\t")
		            if splitIndex ~= nil then
		                local userId = string.sub(line, 1, splitIndex - 1)
		                local message = string.sub(line, splitIndex + 1)
		                userIds[#userIds + 1] = userId
		                messages[#messages + 1] = message
		            end
		        end
		    end
		
		    self:ClearLobbyChatSlots()
		
		    local total = #messages
		    self.lobbyChatBubbleTotalCount = total
		    if total <= 0 then
		        self:UpdateLobbyChatBubbleScrollVisual(0)
		        log("[MafiaUIFlow] lobby chat bubbles cleared")
		        return
		    end
		
		    local maxOffset = math.max(0, total - self.lobbyChatSlotCount)
		    if self.lobbyChatBubbleScrollOffset < 0 then self.lobbyChatBubbleScrollOffset = 0 end
		    if self.lobbyChatBubbleScrollOffset > maxOffset then self.lobbyChatBubbleScrollOffset = maxOffset end
		
		    local visibleLastIndex = total - self.lobbyChatBubbleScrollOffset
		    local startIndex = visibleLastIndex - self.lobbyChatSlotCount + 1
		    if startIndex < 1 then
		        startIndex = 1
		    end
		
		    local slotIndex = 1
		    for i = startIndex, visibleLastIndex do
		        local userId = userIds[i]
		        local message = messages[i]
		        local isOwn = false
		        if localUserId ~= "" and userId == localUserId then
		            isOwn = true
		        elseif self.lastLobbySentMessage ~= "" and message == self.lastLobbySentMessage then
		            isOwn = true
		        end
		
		        self:RenderLobbyChatSlot(slotIndex, userId, message, isOwn)
		        slotIndex = slotIndex + 1
		    end
		
		    self:UpdateLobbyChatBubbleScrollVisual(total)
		    log("[MafiaUIFlow] lobby chat bubble list updated; total=" .. tostring(total) .. " offset=" .. tostring(self.lobbyChatBubbleScrollOffset) .. " start=" .. tostring(startIndex) .. " last=" .. tostring(visibleLastIndex))
	end

	method void HideLobbyRawChatLog()
		    -- Keeps the old center chat log from rendering because lobby chat is shown through speech bubbles.
		    if self.lobbyChatLogText ~= nil then
		        self.lobbyChatLogText.Text = ""
		        if self.lobbyChatLogText.Entity ~= nil then
		            self.lobbyChatLogText.Entity.Enable = false
		        end
		    end
	end

	method void ClearLobbyChatSlots()
		    if self.lobbyChatSlotRoots == nil then return end
		    for i = 1, self.lobbyChatSlotCount do
		        local root = self.lobbyChatSlotRoots[i]
		        if root ~= nil then root.Enable = false end
		        if self.lobbyChatSlotFrames ~= nil and self.lobbyChatSlotFrames[i] ~= nil then
		            self.lobbyChatSlotFrames[i].Enable = false
		        end
		
		        local otherBubble = self.lobbyChatSlotOtherBubbles[i]
		        local ownBubble = self.lobbyChatSlotOwnBubbles[i]
		
		        local nameText = self.lobbyChatSlotOtherNames[i]
		        if nameText ~= nil then
		            nameText.Text = ""
		            if nameText.Entity ~= nil then nameText.Entity.Enable = false end
		        end
		        local otherText = self.lobbyChatSlotOtherMessages[i]
		        if otherText ~= nil then otherText.Text = "" end
		        local ownText = self.lobbyChatSlotOwnMessages[i]
		        if ownText ~= nil then ownText.Text = "" end
		    end
	end

	method void RenderLobbyChatSlot(integer slotIndex, string userId, string message, boolean isOwn)
		    if self.lobbyChatSlotRoots == nil then return end
		    local root = self.lobbyChatSlotRoots[slotIndex]
		    if root == nil then return end
		    root.Enable = true
		
		    local rowBubble = self.lobbyChatSlotOtherBubbles[slotIndex]
		    if rowBubble ~= nil then rowBubble.Enable = true end
		    ---@type Entity
		    local rowFrame = nil
		    if self.lobbyChatSlotFrames ~= nil then rowFrame = self.lobbyChatSlotFrames[slotIndex] end
		    if rowFrame ~= nil then rowFrame:SetEnable(false) end
		    self:PositionLobbyChatSlot(rowBubble, rowFrame, self.lobbyChatSlotOtherNames[slotIndex], isOwn)
		
		    if isOwn then
		        self:StyleLobbyChatRow(rowBubble, rowFrame, true)
		        local nameText = self.lobbyChatSlotOtherNames[slotIndex]
		        if nameText ~= nil then
		            nameText.Text = ""
		            if nameText.Entity ~= nil then nameText.Entity.Enable = false end
		        end
		        local messageText = self.lobbyChatSlotOtherMessages[slotIndex]
		        if messageText ~= nil then
		            messageText.Text = message or ""
		            self:StyleLobbyOwnChatText(messageText)
		            self:ResizeLobbyChatBubble(rowBubble, messageText, nameText, message or "")
		        end
		    else
		        self:StyleLobbyChatRow(rowBubble, rowFrame, false)
		        local nameText = self.lobbyChatSlotOtherNames[slotIndex]
		        if nameText ~= nil then
		            nameText.Text = self:GetUserDisplayName(userId)
		            if nameText.Entity ~= nil then nameText.Entity.Enable = true end
		            self:StyleLobbyChatName(nameText)
		        end
		        local otherText = self.lobbyChatSlotOtherMessages[slotIndex]
		        if otherText ~= nil then
		            otherText.Text = message or ""
		            self:StyleLobbyChatText(otherText)
		            self:ResizeLobbyChatBubble(rowBubble, otherText, nameText, message or "")
		        end
		    end
	end

	method void PositionLobbyChatSlot(Entity rowBubble, Entity rowFrame, any nameText, boolean isOwn)
		    -- Moves the chat row into the invisible left/right lane while preserving the row's vertical slot.
		    local x = -176
		    if isOwn then x = 122 end
		
		    if rowFrame ~= nil and rowFrame.UITransformComponent ~= nil then
		        local framePos = rowFrame.UITransformComponent.anchoredPosition
		        rowFrame.UITransformComponent.anchoredPosition = Vector2(x, framePos.y)
		    end
		
		    if rowBubble ~= nil and rowBubble.UITransformComponent ~= nil then
		        local pos = rowBubble.UITransformComponent.anchoredPosition
		        rowBubble.UITransformComponent.anchoredPosition = Vector2(x, pos.y)
		    end
		
		    if nameText ~= nil and nameText.Entity ~= nil and nameText.Entity.UITransformComponent ~= nil then
		        local namePos = nameText.Entity.UITransformComponent.anchoredPosition
		        nameText.Entity.UITransformComponent.anchoredPosition = Vector2(x, namePos.y)
		    end
	end

	method void StyleLobbyChatRow(Entity rowBubble, Entity rowFrame, boolean isOwn)
		    if rowFrame ~= nil and rowFrame.SpriteGUIRendererComponent ~= nil then
		        if isOwn then
		            rowFrame.SpriteGUIRendererComponent.Color = Color(1.0, 0.72, 0.30, 0.34)
		        else
		            rowFrame.SpriteGUIRendererComponent.Color = Color(0.82, 0.72, 0.58, 0.22)
		        end
		    end
		    if rowBubble ~= nil and rowBubble.SpriteGUIRendererComponent ~= nil then
		        rowBubble.SpriteGUIRendererComponent.Color = Color(0, 0, 0, 0)
		    end
	end

	method void StyleLobbyChatText(any textComponent)
		    if textComponent == nil then return end
		    textComponent.Font = FontType.Maple
		    textComponent.FontSize = 25
		    textComponent.Bold = true
		    textComponent.Alignment = TextAlignmentType.MiddleLeft
		    textComponent.Overflow = OverflowType.Overflow
		    textComponent.UseConstraintX = true
		    textComponent.ConstraintX = 248
		    textComponent.UseConstraintY = true
		    textComponent.ConstraintY = 46
		    textComponent.LineSpacing = 0.78
		    textComponent.FontColor = Color(1, 1, 1, 1)
		    textComponent.DropShadow = true
		    textComponent.DropShadowColor = Color(0, 0, 0, 0.9)
		    textComponent.DropShadowDistance = 1.5
		    textComponent.DropShadowAngle = 315
	end

	method void StyleLobbyOwnChatText(any textComponent)
		    if textComponent == nil then return end
		    textComponent.Font = FontType.Maple
		    textComponent.FontSize = 25
		    textComponent.Bold = true
		    textComponent.Alignment = TextAlignmentType.MiddleRight
		    textComponent.Overflow = OverflowType.Overflow
		    textComponent.UseConstraintX = true
		    textComponent.ConstraintX = 248
		    textComponent.UseConstraintY = true
		    textComponent.ConstraintY = 46
		    textComponent.LineSpacing = 0.78
		    textComponent.FontColor = Color(1, 0.84, 0.42, 1)
		    textComponent.DropShadow = true
		    textComponent.DropShadowColor = Color(0, 0, 0, 0.9)
		    textComponent.DropShadowDistance = 1.5
		    textComponent.DropShadowAngle = 315
	end

	method void StyleLobbyChatName(any textComponent)
		    if textComponent == nil then return end
		    textComponent.Font = FontType.Maple
		    textComponent.FontSize = 21
		    textComponent.Bold = true
		    textComponent.Alignment = TextAlignmentType.MiddleLeft
		    textComponent.Overflow = 2
		    textComponent.FontColor = Color(0.86, 0.68, 0.36, 1)
		    textComponent.DropShadow = true
		    textComponent.DropShadowColor = Color(0, 0, 0, 0.9)
		    textComponent.DropShadowDistance = 1.5
		    textComponent.DropShadowAngle = 315
	end

	method void ResizeLobbyChatBubble(Entity bubble, any messageText, any nameText, string message)
		    if bubble == nil or messageText == nil then return end
		    if messageText.Entity == bubble then
		        local directTransform = bubble.UITransformComponent
		        if directTransform ~= nil then
		            directTransform.RectSize = Vector2(284, 52)
		        end
		        return
		    end
		
		    local bubbleTransform = bubble.UITransformComponent
		    if bubbleTransform ~= nil then
		        bubbleTransform.RectSize = Vector2(284, 52)
		        bubbleTransform.anchoredPosition = Vector2(0, 0)
		    end
		
		    local messageTransform = messageText.Entity.UITransformComponent
		    if messageTransform ~= nil then
		        if messageText.Entity == bubble then
		            messageTransform.RectSize = Vector2(642, 34)
		        elseif nameText ~= nil then
		            messageTransform.RectSize = Vector2(430, 30)
		            messageTransform.anchoredPosition = Vector2(182, 0)
		        else
		            messageTransform.RectSize = Vector2(594, 30)
		            messageTransform.anchoredPosition = Vector2(-24, 0)
		        end
		    end
		
		    if nameText ~= nil and nameText.Entity ~= nil then
		        local nameTransform = nameText.Entity.UITransformComponent
		        if nameTransform ~= nil then
		            nameTransform.RectSize = Vector2(150, 24)
		            nameTransform.anchoredPosition = Vector2(22, 0)
		        end
		    end
	end

	method void ShowLobbyOwnChatBubble(string message)
		    -- Deprecated: lobby chat now renders through LobbyChatSlot1..6.
		    self:ApplyLobbyChatBubbles(_MafiaGameLogic.ChatLog or "")
	end

	method string GetUserDisplayName(string userId)
		    -- Returns the best display name available for a user id.
		    if userId == nil or userId == "" then return "" end
		    local user = _UserService.Users[userId]
		    if user ~= nil and user.Nickname ~= nil and user.Nickname ~= "" then
		        return user.Nickname
		    end
		    return "Player " .. tostring(userId)
	end

	method integer CountChatEntries(string chatLog)
		    local count = 0
		    if chatLog ~= nil and chatLog ~= "" then
		        for line in string.gmatch(chatLog, "[^\n]+") do
		            local splitIndex = string.match(line, "()\t")
		            if splitIndex ~= nil then
		                count = count + 1
		            end
		        end
		    end
		    return count
	end

	method integer CountCsv(string value)
		    local count = 0
		    if value ~= nil and value ~= "" then
		        for _ in string.gmatch(value, "[^,]+") do count = count + 1 end
		    end
		    return count
	end

	method string FormatTime(number seconds)
		    local safeSeconds = math.max(0, math.floor(seconds))
		    return string.format("%02d:%02d", math.floor(safeSeconds / 60), safeSeconds % 60)
	end

	method void HandleScrollUpClick()
		    -- 위로 스크롤 (오래된 메시지 방향)
		    local chatLog = ""
		    if _MafiaGameLogic ~= nil then chatLog = _MafiaGameLogic.ChatLog or "" end
		    local total = self:CountChatEntries(chatLog)
		    local maxOffset = math.max(0, total - self.lobbyChatSlotCount)
		    if self.lobbyChatBubbleScrollOffset >= maxOffset then
		        log("[MafiaUIFlow] lobby bubble scroll up ignored; offset=" .. tostring(self.lobbyChatBubbleScrollOffset) .. " max=" .. tostring(maxOffset))
		        return
		    end
		    self.lobbyChatBubbleScrollOffset = self.lobbyChatBubbleScrollOffset + 1
		    self:ApplyLobbyChatBubbles(chatLog)
		    log("[MafiaUIFlow] lobby bubble scroll up; offset=" .. tostring(self.lobbyChatBubbleScrollOffset) .. " total=" .. tostring(total))
	end

	method void HandleScrollDownClick()
		    -- 아래로 스크롤 (최신 메시지 방향)
		    local chatLog = ""
		    if _MafiaGameLogic ~= nil then chatLog = _MafiaGameLogic.ChatLog or "" end
		    local total = self:CountChatEntries(chatLog)
		    if self.lobbyChatBubbleScrollOffset <= 0 then
		        log("[MafiaUIFlow] lobby bubble scroll down ignored; offset=0 total=" .. tostring(total))
		        return
		    end
		    self.lobbyChatBubbleScrollOffset = self.lobbyChatBubbleScrollOffset - 1
		    self:ApplyLobbyChatBubbles(chatLog)
		    log("[MafiaUIFlow] lobby bubble scroll down; offset=" .. tostring(self.lobbyChatBubbleScrollOffset) .. " total=" .. tostring(total))
	end

	method void HandleLobbyMouseScroll(MouseScrollEvent event)
		    if _MafiaGameLogic == nil then return end
		    local total = self:CountChatEntries(_MafiaGameLogic.ChatLog or "")
		    if total <= self.lobbyChatSlotCount then return end
		
		    if event.ScrollDelta > 0 then
		        self:HandleScrollUpClick()
		    elseif event.ScrollDelta < 0 then
		        self:HandleScrollDownClick()
		    end
		    log("[MafiaUIFlow] lobby mouse wheel scroll; delta=" .. tostring(event.ScrollDelta) .. " offset=" .. tostring(self.lobbyChatBubbleScrollOffset))
	end

	method void HandleLobbyScrollThumbDown(UITouchDownEvent event)
		    -- Starts dragging the custom lobby chat scrollbar thumb.
		    self.lobbyScrollThumbDragging = true
		    log("[MafiaUIFlow] lobby scrollbar thumb down")
	end

	method void HandleLobbyScrollThumbUp(UITouchUpEvent event)
		    -- Ends dragging the custom lobby chat scrollbar thumb.
		    self.lobbyScrollThumbDragging = false
		    log("[MafiaUIFlow] lobby scrollbar thumb up")
	end

	method void HandleLobbyScrollThumbDrag(UITouchDragEvent event)
		    -- Converts scrollbar-thumb drag distance into a lobby chat scroll offset.
		    if self.lobbyScrollThumb == nil then return end
		    if self.lobbyScrollThumb.UITransformComponent == nil then return end
		    local chatLog = ""
		    if _MafiaGameLogic ~= nil then chatLog = _MafiaGameLogic.ChatLog or "" end
		    local total = self:CountChatEntries(chatLog)
		    if total <= self.lobbyChatSlotCount then return end
		
		    local pos = self.lobbyScrollThumb.UITransformComponent.anchoredPosition
		    local targetY = pos.y + event.TouchDelta.y
		    self:ApplyLobbyChatScrollByThumbY(targetY, "thumb-drag")
	end

	method void HandleLobbyScrollTrackDown(UITouchDownEvent event)
		    -- Jumps the custom lobby chat scrollbar thumb to the clicked track location.
		    self:ApplyLobbyChatScrollByTouchPoint(event.TouchPoint, "track-click")
	end

	method void HandleLobbyScrollHitDown(UITouchDownEvent event)
		    -- Jumps the lobby chat scrollbar by the wide invisible hit area.
		    self:ApplyLobbyChatScrollByTouchPoint(event.TouchPoint, "hitarea-click")
	end

	method void HandleLobbyScrollHitDrag(UITouchDragEvent event)
		    -- Drags the lobby chat scrollbar through the wide invisible hit area.
		    self:ApplyLobbyChatScrollByTouchPoint(event.TouchPoint, "hitarea-drag")
	end

	method void HandleLobbyScrollbarScreenTouch(ScreenTouchEvent event)
		    -- Starts scrollbar dragging through screen coordinates when the UI touch layer misses the drag.
		    if self.settingsPanel ~= nil and self.settingsPanel.Enable then
		        if not self:IsSettingsTouchInside(event.TouchPoint) then
		            self:HandleSettingsClose()
		            return
		        end
		    end
		    if not self:IsLobbyScrollbarTouchPoint(event.TouchPoint) then return end
		    self.lobbyScrollPointerActive = true
		    self.lobbyScrollPointerId = event.TouchId
		    self:ApplyLobbyChatScrollByTouchPoint(event.TouchPoint, "screen-touch")
		    log("[MafiaUIFlow] lobby scrollbar screen touch captured; id=" .. tostring(event.TouchId))
	end

	method void HandleLobbyScrollbarScreenTouchHold(ScreenTouchHoldEvent event)
		    -- Continues scrollbar dragging through screen coordinates.
		    if not self.lobbyScrollPointerActive then return end
		    if self.lobbyScrollPointerId ~= 0 and event.TouchId ~= self.lobbyScrollPointerId then return end
		    self:ApplyLobbyChatScrollByTouchPoint(event.TouchPoint, "screen-drag")
	end

	method void HandleLobbyScrollbarScreenTouchRelease(ScreenTouchReleaseEvent event)
		    -- Ends scrollbar dragging through screen coordinates.
		    if not self.lobbyScrollPointerActive then return end
		    if self.lobbyScrollPointerId ~= 0 and event.TouchId ~= self.lobbyScrollPointerId then return end
		    self.lobbyScrollPointerActive = false
		    self.lobbyScrollPointerId = 0
		    log("[MafiaUIFlow] lobby scrollbar screen touch released")
	end

	method boolean IsLobbyScrollbarTouchPoint(Vector2 touchPoint)
		    -- Returns whether the screen point is inside the custom lobby scrollbar hit zone.
		    if _MafiaGameLogic == nil then return false end
		    if self.lobbyScrollTrack == nil then return false end
		    if self.lobbyScrollTrack.UITransformComponent == nil then return false end
		    local total = self:CountChatEntries(_MafiaGameLogic.ChatLog or "")
		    if total <= self.lobbyChatSlotCount then return false end
		
		    local localPos = _UILogic:ScreenToLocalUIPosition(touchPoint, self.lobbyScrollTrack.UITransformComponent)
		    local trackY = self.lobbyScrollTrack.UITransformComponent.anchoredPosition.y
		    local halfHeight = self:GetLobbyScrollThumbHalfHeight()
		    local bottomLocalY = self:GetLobbyScrollThumbBottomCenterY() - trackY - halfHeight - 20
		    local topLocalY = self:GetLobbyScrollThumbTopCenterY() - trackY + halfHeight + 20
		    return localPos.x >= -80 and localPos.x <= 80 and localPos.y >= bottomLocalY and localPos.y <= topLocalY
	end

	method void ApplyLobbyChatScrollByTouchPoint(Vector2 touchPoint, string reason)
		    -- Converts a screen touch position to a scrollbar thumb position.
		    if self.lobbyScrollTrack == nil then return end
		    if self.lobbyScrollTrack.UITransformComponent == nil then return end
		    local chatLog = ""
		    if _MafiaGameLogic ~= nil then chatLog = _MafiaGameLogic.ChatLog or "" end
		    local total = self:CountChatEntries(chatLog)
		    if total <= self.lobbyChatSlotCount then return end
		
		    local trackTransform = self.lobbyScrollTrack.UITransformComponent
		    local trackPos = trackTransform.anchoredPosition
		    local localPos = _UILogic:ScreenToLocalUIPosition(touchPoint, trackTransform)
		    local targetY = trackPos.y + localPos.y
		    self:ApplyLobbyChatScrollByThumbY(targetY, reason)
	end

	method void ApplyLobbyChatScrollByThumbY(number targetY, string reason)
		    -- Applies a scrollbar Y position to the chat list and clamps it to the available range.
		    local chatLog = ""
		    if _MafiaGameLogic ~= nil then chatLog = _MafiaGameLogic.ChatLog or "" end
		    local total = self:CountChatEntries(chatLog)
		    local maxOffset = math.max(0, total - self.lobbyChatSlotCount)
		    if maxOffset <= 0 then
		        self.lobbyChatBubbleScrollOffset = 0
		        self:UpdateLobbyChatBubbleScrollVisual(total)
		        return
		    end
		
		    local bottomY = self:GetLobbyScrollThumbBottomCenterY()
		    local topY = self:GetLobbyScrollThumbTopCenterY()
		    if topY < bottomY then topY = bottomY end
		    if targetY < bottomY then targetY = bottomY end
		    if targetY > topY then targetY = topY end
		
		    local ratio = 0
		    if topY > bottomY then
		        ratio = (targetY - bottomY) / (topY - bottomY)
		    end
		    if ratio < 0 then ratio = 0 end
		    if ratio > 1 then ratio = 1 end
		
		    local nextOffset = math.floor(ratio * maxOffset + 0.5)
		    if nextOffset < 0 then nextOffset = 0 end
		    if nextOffset > maxOffset then nextOffset = maxOffset end
		
		    self.lobbyChatBubbleScrollOffset = nextOffset
		    self:ApplyLobbyChatBubbles(chatLog)
		    log("[MafiaUIFlow] lobby scrollbar " .. tostring(reason) .. "; targetY=" .. tostring(targetY) .. " offset=" .. tostring(nextOffset) .. " total=" .. tostring(total))
	end

	method void SetLobbyChatScrollThumbY(number y)
		    -- Sets the target Y; OnUpdate lerps towards it for smooth animation.
		    self.lobbyScrollThumbTargetY = y
	end

	method number GetLobbyScrollThumbHalfHeight()
		    -- Returns the current custom thumb half-height so edge-based cursor coordinates can drive center-based UI movement.
		    if self.lobbyScrollThumb ~= nil and self.lobbyScrollThumb.UITransformComponent ~= nil then
		        return self.lobbyScrollThumb.UITransformComponent.RectSize.y / 2
		    end
		    return 50
	end

	method number GetLobbyScrollThumbBottomCenterY()
		    -- Manual editor-tuned thumb center Y at the lower limit.
		    return self.lobbyScrollThumbBottomY
	end

	method number GetLobbyScrollThumbTopCenterY()
		    -- Manual editor-tuned thumb center Y at the upper limit.
		    return self.lobbyScrollThumbTopY
	end

	method void UpdateScrollThumb(integer lineCount, string chatLog)
		    -- 메시지 수 계산 (개행 기준)
		    local msgCount = 0
		    if chatLog ~= nil and chatLog ~= "" then
		        for _ in string.gmatch(chatLog, "\n") do msgCount = msgCount + 1 end
		    end
		    -- 스크롤 필요 여부: 콘텐츠 높이 > 뷰포트 높이(450)
		    local hasOverflow = (lineCount * 26 + 24) > 450
		    log("[MafiaUIFlow] thumb update; overflow=" .. tostring(hasOverflow) .. " msgs=" .. tostring(msgCount))
	end

	method void UpdateLobbyChatBubbleScrollVisual(integer total)
		    local hasOverflow = total > self.lobbyChatSlotCount
		    if self.lobbyScrollThumb ~= nil then
		        self.lobbyScrollThumb.Enable = hasOverflow
		        if hasOverflow and self.lobbyScrollThumb.UITransformComponent ~= nil then
		            local maxOffset = math.max(1, total - self.lobbyChatSlotCount)
		            local ratio = self.lobbyChatBubbleScrollOffset / maxOffset
		            if ratio < 0 then ratio = 0 end
		            if ratio > 1 then ratio = 1 end
		            local bottomY = self:GetLobbyScrollThumbBottomCenterY()
		            local topY = self:GetLobbyScrollThumbTopCenterY()
		            if topY < bottomY then topY = bottomY end
		            local y = bottomY + (topY - bottomY) * ratio
		            self:SetLobbyChatScrollThumbY(y)
		        end
		    end
		    log("[MafiaUIFlow] lobby bubble scroll visual; overflow=" .. tostring(hasOverflow) .. " total=" .. tostring(total) .. " offset=" .. tostring(self.lobbyChatBubbleScrollOffset) .. " thumbY=" .. tostring(self.lobbyScrollThumbTargetY) .. " bottom=" .. tostring(self:GetLobbyScrollThumbBottomCenterY()) .. " top=" .. tostring(self:GetLobbyScrollThumbTopCenterY()))
	end

	method void ResolveVoteUI()
		    -- Resolves Vote entity references and wires button events.
		    if self.voteCardEntities == nil then self.voteCardEntities = {} end
		    if self.voteAvatarEntities == nil then self.voteAvatarEntities = {} end
		    if self.voteNameTexts == nil then self.voteNameTexts = {} end
		    if self.voteCircleOffEntities == nil then self.voteCircleOffEntities = {} end
		    if self.voteCircleOnEntities == nil then self.voteCircleOnEntities = {} end
		    if self.voteCardHandlers == nil then self.voteCardHandlers = {} end
		    if self.votePlayerUserIds == nil then self.votePlayerUserIds = {} end
		
		    self.votePanel = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/Vote")
		
		    local titleEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/Vote/Vote_3")
		    if titleEnt ~= nil then self.voteTitleComp = titleEnt.TextComponent end
		
		    local cardPaths = {
		        "/ui/MafiaDayHUD/Vote/Vote_4",
		        "/ui/MafiaDayHUD/Vote/Vote_4/Vote_5",
		        "/ui/MafiaDayHUD/Vote/Vote_4/Vote_6",
		        "/ui/MafiaDayHUD/Vote/Vote_4/Vote_7",
		        "/ui/MafiaDayHUD/Vote/Vote_4/Vote_8",
		        "/ui/MafiaDayHUD/Vote/Vote_4/Vote_9",
		        "/ui/MafiaDayHUD/Vote/Vote_4/Vote_10",
		        "/ui/MafiaDayHUD/Vote/Vote_4/Vote_11",
		    }
		
		    local grayCirclePaths = {
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff",
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff_3",
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff_5",
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff_6",
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff_2",
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff_1",
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff_4",
		        "/ui/MafiaDayHUD/Vote/Vote_4/VoteCircleOff_7",
		    }
		    -- slot1은 VoteCircle_8 sprite comp으로 제어; slot2~8은 VoteCircle_8의 자식 엔티티
		    local yellowChildPaths = {
		        nil,  -- slot1: voteYellowSprite (VoteCircle_8.SpriteGUIRendererComponent)
		        "/ui/MafiaDayHUD/Vote/VoteCircle_8/Vote_11",
		        "/ui/MafiaDayHUD/Vote/VoteCircle_8/Vote_9",
		        "/ui/MafiaDayHUD/Vote/VoteCircle_8/Vote_10",
		        "/ui/MafiaDayHUD/Vote/VoteCircle_8/Vote_12",
		        "/ui/MafiaDayHUD/Vote/VoteCircle_8/Vote_14",
		        "/ui/MafiaDayHUD/Vote/VoteCircle_8/Vote_13",
		        "/ui/MafiaDayHUD/Vote/VoteCircle_8/Vote_15",
		    }
		    self.voteYellowParent = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/Vote/VoteCircle_8")
		    if self.voteYellowParent ~= nil then
		        self.voteYellowSprite = self.voteYellowParent.SpriteGUIRendererComponent
		    end
		    for i = 1, 8 do
		        self.voteCircleOffEntities[i] = _EntityService:GetEntityByPath(grayCirclePaths[i])
		        if yellowChildPaths[i] ~= nil then
		            self.voteCircleOnEntities[i] = _EntityService:GetEntityByPath(yellowChildPaths[i])
		        else
		            self.voteCircleOnEntities[i] = nil
		        end
		    end
		
		    for i = 1, 8 do
		        local cardEnt = _EntityService:GetEntityByPath(cardPaths[i])
		        self.voteCardEntities[i] = cardEnt
		        if cardEnt ~= nil then
		            local avatarEnt = _EntityService:GetEntityByPath(cardPaths[i] .. "/VoteAvatar")
		            self.voteAvatarEntities[i] = avatarEnt
		            local nameEnt = _EntityService:GetEntityByPath(cardPaths[i] .. "/VoteNameText")
		            if nameEnt ~= nil then self.voteNameTexts[i] = nameEnt.TextComponent end
		            if self.voteCardHandlers[i] == nil and cardEnt.ButtonComponent ~= nil then
		                local slotIndex = i
		                self.voteCardHandlers[i] = cardEnt:ConnectEvent(ButtonClickEvent, function()
		                    self:SelectVoteTarget(slotIndex)
		                end)
		            end
		        end
		    end
		
		    local confirmEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/Vote/Vote_1")
		    if confirmEnt ~= nil then
		        self.voteConfirmEntity = confirmEnt
		        self.voteConfirmBtn = confirmEnt.ButtonComponent
		        self.voteConfirmRenderer = confirmEnt.SpriteGUIRendererComponent
		        if self.voteConfirmHandler == nil and confirmEnt.ButtonComponent ~= nil then
		            self.voteConfirmHandler = confirmEnt:ConnectEvent(ButtonClickEvent, self.HandleVoteConfirm)
		        end
		    end
		
		    local abstainEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/Vote/Vote_2")
		    if abstainEnt ~= nil then
		        self.voteAbstainEntity = abstainEnt
		        self.voteAbstainBtn = abstainEnt.ButtonComponent
		        if self.voteAbstainHandler == nil and abstainEnt.ButtonComponent ~= nil then
		            self.voteAbstainHandler = abstainEnt:ConnectEvent(ButtonClickEvent, self.HandleVoteAbstain)
		        end
		    end
		
		    local stampPaths = {
		        "/ui/MafiaDayHUD/Vote/Vote__1",
		        "/ui/MafiaDayHUD/Vote/Vote__2",
		        "/ui/MafiaDayHUD/Vote/Vote__3",
		        "/ui/MafiaDayHUD/Vote/Vote__4",
		        "/ui/MafiaDayHUD/Vote/Vote__5",
		        "/ui/MafiaDayHUD/Vote/Vote__6",
		        "/ui/MafiaDayHUD/Vote/Vote__7",
		        "/ui/MafiaDayHUD/Vote/Vote__8",
		    }
		    self.voteStampEntities = {}
		    for i, path in ipairs(stampPaths) do
		        local ent = _EntityService:GetEntityByPath(path)
		        self.voteStampEntities[i] = ent
		        if ent ~= nil then ent.Enable = false end
		    end
		
		    -- Dead 오버레이 엔티티 (Dead=슬롯1, Dead_1=슬롯2, ..., Dead_7=슬롯8)
		    if self.voteDeadEntities == nil then self.voteDeadEntities = {} end
		    local voteDeadNames = { "Dead", "Dead_1", "Dead_2", "Dead_3", "Dead_4", "Dead_5", "Dead_6", "Dead_7" }
		    for i = 1, 8 do
		        self.voteDeadEntities[i] = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/Vote/" .. voteDeadNames[i])
		        if self.voteDeadEntities[i] ~= nil then self.voteDeadEntities[i].Enable = false end
		    end
		    self:ResolveResultAnimeEntities()
		    log("[MafiaUIFlow] vote UI resolved; panel=" .. tostring(self.votePanel ~= nil))
	end

	method void PlayVoteAnime()
		    -- VoteAnime 페이드 인/아웃 후 투표 UI 표시.
		    if self:IsServer() then return end
		    if self.voteAnimeEnt == nil then
		        self.voteAnimeEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/VoteAnime")
		    end
		    if self.dayHudCenterPanelEnt == nil then
		        self.dayHudCenterPanelEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/CenterPanel")
		    end
		    if self.voteAnimeEnt == nil then
		        self:ShowVoteUI()
		        return
		    end
		    local voteStartTextEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/VoteAnime/AnimeText_1")
		    local voteStartMessages = {
		        "투표 시간이 시작되었습니다.",
		        "의심되는 사람에게 한 표를 던져주세요.",
		        "당신의 한 표가 오늘의 운명을 결정합니다.",
		        "토론은 끝났습니다. 이제 선택할 시간입니다.",
		        "진실을 가려낼 투표가 시작됩니다.",
		        "신중하게 판단하고 투표해주세요.",
		        "마을의 선택이 곧 시작됩니다.",
		        "누가 가장 수상했는지 결정해주세요.",
		    }
		    local voteStartMessage = voteStartMessages[math.random(1, #voteStartMessages)]
		    if voteStartTextEnt ~= nil and voteStartTextEnt.TextComponent ~= nil then
		        voteStartTextEnt.TextComponent.Text = voteStartMessage
		        voteStartTextEnt.Enable = true
		    end
		    self.voteAnimeEnt.Enable = true
		    local cg = self.voteAnimeEnt.CanvasGroupComponent
		    if cg ~= nil then cg.GroupAlpha = 0 end
		    self.voteAnimeAlpha   = 0
		    self.voteAnimePhase   = 1
		    self.voteAnimeTimer   = 0
		    self.voteAnimePlaying = true
		    log("[MafiaUIFlow] VoteAnime 시퀀스 시작; message=" .. voteStartMessage)
	end

	method void ResolveResultAnimeEntities()
		    -- VoteAnime_1/2/3 및 Result_1/2 엔티티와 텍스트 컴포넌트 참조 해결.
		    if self:IsServer() then return end
		    local function getTextComp(path)
		        local e = _EntityService:GetEntityByPath(path)
		        if e == nil then return nil end
		        return e.TextComponent
		    end
		    self.voteAnime1Ent      = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/VoteAnime_1")
		    self.voteAnime2Ent      = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/VoteAnime_2")
		    self.voteAnime3Ent      = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/VoteAnime_3")
		    self.voteAnime1TextComp = getTextComp("/ui/MafiaDayHUD/VoteAnime_1/AnimeText")
		    self.voteAnime2TextComp = getTextComp("/ui/MafiaDayHUD/VoteAnime_2/AnimeText")
		    self.voteAnime3TextComp = getTextComp("/ui/MafiaDayHUD/VoteAnime_3/AnimeText")
		    self.result1Ent         = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Result_1")
		    self.result2Ent         = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Result_2")
		    self.result1TextComp    = getTextComp("/ui/MafiaNightHUD/Result_1/AnimeText")
		    self.result2TextComp    = getTextComp("/ui/MafiaNightHUD/Result_2/AnimeText")
		    log("[MafiaUIFlow] ResolveResultAnimeEntities: va1=" .. tostring(self.voteAnime1Ent ~= nil)
		        .. " va2=" .. tostring(self.voteAnime2Ent ~= nil)
		        .. " r1=" .. tostring(self.result1Ent ~= nil)
		        .. " r2=" .. tostring(self.result2Ent ~= nil))
	end

	method string GetRoleFromRoleData(string checkUserId)
		    -- RoleData 문자열에서 checkUserId 의 역할 번호 문자열을 반환.
		    local roleData = _MafiaGameLogic.RoleData
		    if roleData == nil or roleData == "" then return "" end
		    local parts = self:SplitString(roleData, ",")
		    for i = 1, #parts - 1, 2 do
		        if parts[i] == checkUserId then
		            return parts[i + 1]
		        end
		    end
		    return ""
	end

	method void PrepareVoteResultAtmosphere(Entity animeEnt)
		    -- VoteResultDimBg(displayOrder 15)는 일반 낮 HUD 위에, VoteAnime_1/2/3(16~18)는 dim 위에 놓인다.
		    -- 각 VoteAnime의 네 모서리 비네트를 재생 때마다 활성화해 꼭지점 쉐딩을 확실히 보장한다.
		    if animeEnt == nil then return end
		    -- UI 원본의 VoteResultDimBg 오프셋이 중앙 100x100으로 계산되므로 런타임에 전체 화면 스트레치로 보정한다.
		    if self.voteResultDimEnt ~= nil then
		        local dimTransform = self.voteResultDimEnt.UITransformComponent
		        if dimTransform ~= nil then
		            dimTransform.AnchorsMin = Vector2(0, 0)
		            dimTransform.AnchorsMax = Vector2(1, 1)
		            dimTransform.OffsetMin = Vector2(0, 0)
		            dimTransform.OffsetMax = Vector2(0, 0)
		        end
		    end
		    local basePath = ""
		    if animeEnt == self.voteAnime1Ent then
		        basePath = "/ui/MafiaDayHUD/VoteAnime_1"
		    elseif animeEnt == self.voteAnime2Ent then
		        basePath = "/ui/MafiaDayHUD/VoteAnime_2"
		    elseif animeEnt == self.voteAnime3Ent then
		        basePath = "/ui/MafiaDayHUD/VoteAnime_3"
		    end
		    if basePath == "" then return end
		    local cornerNames = { "vgBL", "vgBR", "vgTL", "vgTR" }
		    local enabledCount = 0
		    for _, cornerName in ipairs(cornerNames) do
		        local corner = _EntityService:GetEntityByPath(basePath .. "/" .. cornerName)
		        if corner ~= nil and isvalid(corner) then
		            corner.Enable = true
		            local renderer = corner.SpriteGUIRendererComponent
		            if renderer ~= nil then renderer.Color = Color(0, 0, 0, 0.48) end
		            enabledCount = enabledCount + 1
		        end
		    end
		    log("[MafiaUIFlow] vote result atmosphere ready; fullscreen dim=0.78 vignette=" .. tostring(enabledCount) .. "/4")
	end

	method void PlayResultAnime(Entity animeEnt, any textComp, string msg, string context)
		    -- 공용 결과 애니메이션 재생: 페이드인 -> context별 홀드 -> 페이드아웃.
		    if animeEnt == nil then
		        if context == "vote" then self:HideVotePanel()
		        elseif context == "morning" then self:RefreshUI(true) end
		        return
		    end
		    if textComp ~= nil then textComp.Text = msg end
		    -- Disable any previously playing animation entity before starting a new one.
		    if self.resultAnimeEnt ~= nil and self.resultAnimeEnt ~= animeEnt then
		        self.resultAnimeEnt.Enable = false
		    end
		    -- 배경 어두움 오버레이 활성화 (context에 따라 NightHUD/DayHUD dim 선택)
		    local activeDimEnt = (context == "vote") and self.voteResultDimEnt or self.resultDimEnt
		    if activeDimEnt ~= nil then
		        activeDimEnt.Enable = true
		        local dimCg = activeDimEnt.CanvasGroupComponent
		        if dimCg ~= nil then dimCg.GroupAlpha = 0 end
		    end
		    if context == "vote" then self:PrepareVoteResultAtmosphere(animeEnt) end
		    animeEnt.Enable = true
		    local cg = animeEnt.CanvasGroupComponent
		    if cg ~= nil then cg.GroupAlpha = 0 end
		    self.resultAnimeEnt      = animeEnt
		    self.resultAnimeTextComp = textComp
		    self.resultAnimeAlpha    = 0
		    self.resultAnimePhase    = 1
		    self.resultAnimeTimer    = 0
		    self.resultAnimeContext  = context
		    self.resultAnimePlaying  = true
		    log("[MafiaUIFlow] PlayResultAnime [" .. context .. "]: " .. msg)
	end

	@ExecSpace("Client")
	method void ShowPoliceResultAnime(string targetId, boolean isMafia)
		    -- 경찰 플레이어에게만 전송되는 조사결과 애니메이션. BeginNightDoctor에서 호출.
		    -- policeResultDisplayEnt가 nil이면 ResolveNightUI로 재시도
		    if self.policeResultDisplayEnt == nil then
		        if self.nightRoot ~= nil then self:ResolveNightUI() end
		        if self.policeResultDisplayEnt == nil then
		            log("[MafiaUIFlow] ShowPoliceResultAnime: policeResultDisplayEnt nil, skipping")
		            return
		        end
		    end
		    local nickname = self:GetUserDisplayName(targetId)
		    if isMafia then
		        self.policeResultText = "조사 결과,  " .. nickname .. "  은(는) 마피아입니다!"
		    else
		        self.policeResultText = "조사 결과,  " .. nickname .. "  은(는) 시민입니다."
		    end
		    -- 조사결과 텍스트 설정
		    if self.policeResultDisplayTextComp ~= nil then
		        self.policeResultDisplayTextComp.Text = self.policeResultText
		    end
		    -- ResultDimBg(dim 오버레이) 초기화: 활성화 + GroupAlpha=0
		    if self.resultDimEnt ~= nil then
		        self.resultDimEnt.Enable = true
		        local dimCg = self.resultDimEnt.CanvasGroupComponent
		        if dimCg ~= nil then dimCg.GroupAlpha = 0 end
		    end
		    -- PoliceResultDisplay 초기화: 활성화 + GroupAlpha=0
		    self.policeResultDisplayEnt.Enable = true
		    if self.policeResultTextEnt ~= nil then self.policeResultTextEnt.Enable = true end
		    local cg = self.policeResultDisplayEnt.CanvasGroupComponent
		    if cg ~= nil then cg.GroupAlpha = 0 end
		    self.policeResultAlpha   = 0.0
		    self.policeResultPhase   = 1
		    self.policeResultTimer   = 0.0
		    self.policeResultPlaying = true
		    log("[MafiaUIFlow] ShowPoliceResultAnime: " .. self.policeResultText)
	end

	method void PlayVoteResultAnime(string executeTarget)
		    -- 투표 결과에 따라 VoteAnime_1/2/3 중 하나를 선택해 재생.
		    if self:IsServer() then return end
		    if self.voteAnime1Ent == nil then self:ResolveResultAnimeEntities() end
		    local animeEnt = nil
		    local textComp = nil
		    local msg = ""
		    if executeTarget == nil or executeTarget == "" then
		        animeEnt = self.voteAnime1Ent
		        textComp = self.voteAnime1TextComp
		        local msgs = {
		            "아무도 처형되지 않았습니다.",
		            "오늘은 무고한 시민이 살아남았습니다.",
		            "투표 결과, 아무도 처형되지 않았습니다.",
		            "이번 투표는 기권으로 끝났습니다.",
		            "마피아가 웃고 있습니다...",
		            "시민들의 논의가 끝났지만...",
		            "오늘의 투표는 무효가 되었습니다.",
		            "아직 마피아를 찾지 못했습니다.",
		            "동점으로 처형이 없습니다.",
		            "마피아가 살아남았습니다."
		        }
		        local idx = math.random(1, #msgs)
		        msg = msgs[idx]
		    else
		        local roleStr = self:GetRoleFromRoleData(executeTarget)
		        local roleNum = tonumber(roleStr) or -1
		        local roleName = "시민"
		        if roleNum == _MafiaGameLogic.ROLE_MAFIA then
		            roleName = "마피아"
		            animeEnt = self.voteAnime3Ent
		            textComp = self.voteAnime3TextComp
		        else
		            -- 투표 처형 결과에서는 경찰과 의사도 시민으로 공개한다.
		            animeEnt = self.voteAnime2Ent
		            textComp = self.voteAnime2TextComp
		        end
		        local user = _UserService.Users[executeTarget]
		        local nickname = "플레이어"
		        if user ~= nil and user.Nickname ~= nil and user.Nickname ~= "" then
		            nickname = user.Nickname
		        end
		        if roleNum == _MafiaGameLogic.ROLE_MAFIA then
		            msg = nickname .. "의 정체는 마피아였습니다! 마을에 평화가 가까워집니다."
		        else
		            msg = nickname .. "은(는) 평범한 시민이었습니다. 마피아는 웃음을 감췄습니다."
		        end
		        log("[MafiaUIFlow] vote execution role display; actualRole=" .. tostring(roleNum)
		            .. " displayedRole=" .. roleName)
		    end
		    self:PlayResultAnime(animeEnt, textComp, msg, "vote")
	end

	method void StartMorningResultAnime()
		    -- PHASE_MORNING 진입 시: 현재 활성 야간 패널을 서서히 페이드아웃 후 1초 대기,
		    -- 그다음 Result_1/2 페이드인.
		    if self:IsServer() then return end
		    -- inNight 판정을 유지하기 위해 resultAnimePlaying 먼저 설정 (phase=0이면 상태머신 무동작)
		    self.resultAnimePlaying = true
		    self.resultAnimeContext = "morning"
		    -- 현재 화면에 표시 중인 야간 패널 탐색 (DoctorAction 우선)
		    local activeEnt = nil
		    if self.nightDoctorActionEnt ~= nil and self.nightDoctorActionEnt.Enable then
		        activeEnt = self.nightDoctorActionEnt
		    elseif self.nightPoliceActionEnt ~= nil and self.nightPoliceActionEnt.Enable then
		        activeEnt = self.nightPoliceActionEnt
		    elseif self.nightMafiaActionEnt ~= nil and self.nightMafiaActionEnt.Enable then
		        activeEnt = self.nightMafiaActionEnt
		    elseif self.nightDoctorPanel ~= nil and self.nightDoctorPanel.Enable then
		        activeEnt = self.nightDoctorPanel
		    elseif self.nightPolicePanel ~= nil and self.nightPolicePanel.Enable then
		        activeEnt = self.nightPolicePanel
		    elseif self.nightMafiaPanel ~= nil and self.nightMafiaPanel.Enable then
		        activeEnt = self.nightMafiaPanel
		    end
		    if activeEnt ~= nil then
		        -- nightFadeOut 메커니즘으로 현재 패널을 서서히 어둡게 (speed=2.5 → ~0.4초 완료)
		        self.nightFadeOutEnt   = activeEnt
		        self.nightFadeOutAlpha = 1.0
		        self.nightFadingOut    = true
		    end
		    -- 1초 대기 (페이드아웃 포함 여유 시간)
		    wait(1.0)
		    -- 나머지 야간 패널 즉시 비활성화
		    if self.nightMafiaActionEnt ~= nil then self.nightMafiaActionEnt.Enable = false end
		    if self.nightPoliceActionEnt ~= nil then self.nightPoliceActionEnt.Enable = false end
		    if self.nightDoctorActionEnt ~= nil then self.nightDoctorActionEnt.Enable = false end
		    if self.nightOverlayEnt ~= nil then self.nightOverlayEnt.Enable = false end
		    if self.nightMafiaPanel ~= nil then self.nightMafiaPanel.Enable = false end
		    if self.nightPolicePanel ~= nil then self.nightPolicePanel.Enable = false end
		    if self.nightDoctorPanel ~= nil then self.nightDoctorPanel.Enable = false end
		    if self.nightMsgTextEnt ~= nil then self.nightMsgTextEnt.Enable = false end
		    -- 결과 애니메이션 엔티티 결정
		    if self.result1Ent == nil then self:ResolveResultAnimeEntities() end
		    local morningKilled = _MafiaGameLogic.MorningKilled
		    local doctorSaved   = _MafiaGameLogic.DoctorSaved
		    local animeEnt  = nil
		    local textComp  = nil
		    local msg = ""
		    if doctorSaved then
		        animeEnt = self.result2Ent
		        textComp = self.result2TextComp
		        msg = "마피아의 습격이 있었지만, 의사가 막아냈습니다!"
		    elseif morningKilled ~= nil and morningKilled ~= "" then
		        animeEnt = self.result1Ent
		        textComp = self.result1TextComp
		        local user = _UserService.Users[morningKilled]
		        local nickname = "플레이어"
		        if user ~= nil and user.Nickname ~= nil and user.Nickname ~= "" then
		            nickname = user.Nickname
		        end
		        msg = nickname .. "이(가) 마피아에 의해 사망했습니다."
		    else
		        log("[MafiaUIFlow] StartMorningResultAnime: 사망자 없음, 애니메이션 생략")
		        self.resultAnimePlaying = false
		        self.resultAnimeContext = ""
		        return
		    end
		    if animeEnt == self.result2Ent and self.result1Ent ~= nil then self.result1Ent.Enable = false end
		    if animeEnt == self.result1Ent and self.result2Ent ~= nil then self.result2Ent.Enable = false end
		    self:PlayResultAnime(animeEnt, textComp, msg, "morning")
	end

	method void ShowVoteUI()
		    -- Populates card slots with all players (dead ones disabled) and shows the Vote panel.
		    if self.votePanel == nil then self:ResolveVoteUI() end
		    if self.votePanel == nil then return end

		    -- Build the full player list from RoleData so layout stays fixed across rounds.
		    local allPlayers = {}
		    local roleData = _MafiaGameLogic.RoleData
		    if roleData ~= nil and roleData ~= "" then
		        local parts = self:SplitString(roleData, ",")
		        for i = 1, #parts, 2 do allPlayers[#allPlayers + 1] = parts[i] end
		    end
		    local totalCount = math.min(#allPlayers, 8)

		    -- Build alive set for button-enable check.
		    local aliveSet = {}
		    local aliveStr = _MafiaGameLogic.AlivePlayersList
		    if aliveStr ~= nil and aliveStr ~= "" then
		        for _, uid in ipairs(self:SplitString(aliveStr, ",")) do aliveSet[uid] = true end
		    end

		    for i = 1, 8 do self.votePlayerUserIds[i] = nil end
		    for i = 1, totalCount do self.votePlayerUserIds[i] = allPlayers[i] end

		    self:ShowYellowCircle(0)
		    for i = 1, 8 do
		        local userId  = self.votePlayerUserIds[i]
		        local cardEnt = self.voteCardEntities[i]
		        local avEnt   = self.voteAvatarEntities[i]
		        local nameTc  = self.voteNameTexts[i]
		        local circOff = self.voteCircleOffEntities[i]
		        local isAlive = (userId ~= nil) and (aliveSet[userId] == true)

		        if avEnt ~= nil then
		            if userId ~= nil then
		                local costume  = avEnt.CostumeManagerComponent
		                local renderer = avEnt.AvatarGUIRendererComponent
		                if costume ~= nil then
		                    costume.UseCustomEquipOnly  = false
		                    costume.DefaultEquipUserId  = userId
		                    costume.Enable = true
		                end
		                if renderer ~= nil then renderer.Enable = true end
		                avEnt.Enable = true
		            else
		                avEnt.Enable = false
		            end
		        end
		        if nameTc ~= nil then
		            nameTc.Text = (userId ~= nil) and self:GetUserDisplayName(userId) or ""
		            local nameColor = Color(1, 1, 1, 1)
		            if userId ~= nil and self:GetLocalPlayerRole() == _MafiaGameLogic.ROLE_MAFIA then
		                if tonumber(self:GetRoleFromRoleData(userId)) == _MafiaGameLogic.ROLE_MAFIA then
		                    nameColor = Color(1, 0.2, 0.2, 1)
		                end
		            end
		            nameTc.FontColor = nameColor
		        end
		        if circOff ~= nil then circOff.Enable = (userId ~= nil) end
		        -- Dead players keep their card visible but button is disabled.
		        if cardEnt ~= nil and cardEnt.ButtonComponent ~= nil then
		            cardEnt.ButtonComponent.Enable = isAlive
		            -- Dead 오버레이: userId가 있고 사망한 경우 표시
		            if self.voteDeadEntities ~= nil and self.voteDeadEntities[i] ~= nil then
		                self.voteDeadEntities[i].Enable = (userId ~= nil) and not isAlive
		            end
		        end
		    end

		    self:LayoutVoteGrid(totalCount)
		
		    self.voteSelectedSlot   = 0
		    self.voteAbstainSelected = false
		    self.voteSubmitted      = false
		    if self.voteAbstainBtn ~= nil then self.voteAbstainBtn.Enable = true end
		    if self.voteConfirmBtn ~= nil then self.voteConfirmBtn.Enable = false end
		    if self.voteConfirmRenderer ~= nil then self.voteConfirmRenderer:SetAlpha(0.35) end
		    -- 사망 플레이어: 투표 패널 완전 숨김 → VoteAnime + 관전 메시지만 표시
		    if self:IsLocalPlayerDead() then
		        self.voteSubmitted = true
		        if self.voteAnimeEnt == nil then
		            self.voteAnimeEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/VoteAnime")
		        end
		        if self.voteAnimeEnt ~= nil then
		            self.voteAnimeEnt.Enable = true
		            local cg = self.voteAnimeEnt.CanvasGroupComponent
		            if cg ~= nil then cg.GroupAlpha = 1.0 end
		        end
		        if self.dayHudCenterPanelEnt == nil then
		            self.dayHudCenterPanelEnt = _EntityService:GetEntityByPath("/ui/MafiaDayHUD/CenterPanel")
		        end
		        if self.dayHudCenterPanelEnt ~= nil then
		            local cg = self.dayHudCenterPanelEnt.CanvasGroupComponent
		            if cg ~= nil then cg.GroupAlpha = 0.25 end
		        end
		        if self.voteObserverTextEnt ~= nil then self.voteObserverTextEnt.Enable = true end
		        self.voteUIShown = true
		        return
		    end

		    if self.voteStampEntities ~= nil then
		        for i = 1, 8 do
		            if self.voteStampEntities[i] ~= nil then self.voteStampEntities[i].Enable = false end
		        end
		    end
		
		    local timerNum = tostring(math.max(0, math.ceil(_MafiaGameLogic.PhaseTimer)))
		    if self.voteTitleComp ~= nil then
		        self.voteTitleComp.Text = "투표  " .. timerNum
		    end
		
		    self.votePanel.Enable = true
		    self.voteUIShown = true
		    log("[MafiaUIFlow] vote panel shown; alive=" .. tostring(count))
	end

	method void LayoutVoteGrid(integer count)
		    -- Adjusts card visibility and positions for 6, 7, or 8 alive players.
		    -- Vote_4 (slot1) base pos in Vote panel: [-492.1, 115.4] (에디터 실측값)
		    -- Sibling col-spacing: 326.0.  Row-2 relative y: -260.9
		    -- Center shift for 3-col vs 4-col: COL_W/2 = 163.0
		
		    local BASE_X  = -492.1
		    local BASE_Y  =  115.4
		    local COL_W   =  326.0
		    local ROW2_Y  = -260.9
		    local SHIFT3  =  163.0  -- COL_W/2: center 3 cols within 4-col width
		
		    local slot1 = self.voteCardEntities[1]  -- Vote_4 (parent)
		    local slot5 = self.voteCardEntities[5]  -- UISprite_1 (row2 col1)
		    local slot6 = self.voteCardEntities[6]  -- UISprite_3 (row2 col2)
		    local slot7 = self.voteCardEntities[7]  -- UISprite_5 (row2 col3)
		
		    -- Reset Vote_4 to base position
		    if slot1 ~= nil and slot1.UITransformComponent ~= nil then
		        slot1.UITransformComponent.anchoredPosition = Vector2(BASE_X, BASE_Y)
		    end
		    -- Reset row-2 sibling positions (relative to Vote_4)
		    if slot5 ~= nil and slot5.UITransformComponent ~= nil then
		        slot5.UITransformComponent.anchoredPosition = Vector2(0, ROW2_Y)
		    end
		    if slot6 ~= nil and slot6.UITransformComponent ~= nil then
		        slot6.UITransformComponent.anchoredPosition = Vector2(COL_W, ROW2_Y)
		    end
		    if slot7 ~= nil and slot7.UITransformComponent ~= nil then
		        slot7.UITransformComponent.anchoredPosition = Vector2(COL_W * 2, ROW2_Y)
		    end
		
		    -- Show all slots; dead-player button disabling is handled in ShowVoteUI.
		    for i = 1, 8 do
		        local e = self.voteCardEntities[i]
		        if e ~= nil then e.Enable = (i <= count) end
		    end
		
		    if count == 6 then
		        -- 3+3: shift Vote_4 right to center row1 (hide slot4=UISprite_6)
		        if slot1 ~= nil and slot1.UITransformComponent ~= nil then
		            slot1.UITransformComponent.anchoredPosition = Vector2(BASE_X + SHIFT3, BASE_Y)
		        end
		        local slot4 = self.voteCardEntities[4]
		        if slot4 ~= nil then slot4.Enable = false end
		    elseif count == 7 then
		        -- 4+3: keep row1; center row2 with 3 cards
		        if slot5 ~= nil and slot5.UITransformComponent ~= nil then
		            slot5.UITransformComponent.anchoredPosition = Vector2(SHIFT3, ROW2_Y)
		        end
		        if slot6 ~= nil and slot6.UITransformComponent ~= nil then
		            slot6.UITransformComponent.anchoredPosition = Vector2(SHIFT3 + COL_W, ROW2_Y)
		        end
		        if slot7 ~= nil and slot7.UITransformComponent ~= nil then
		            slot7.UITransformComponent.anchoredPosition = Vector2(SHIFT3 + COL_W * 2, ROW2_Y)
		        end
		    end
		    log("[MafiaUIFlow] vote grid layout; count=" .. tostring(count))
	end

	method void SelectVoteTarget(integer slotIndex)
		    -- Enable 토글로 원형 색상 변경: VoteCircleOff↔VoteCircleOn 교차 표시.
		    log("[MafiaUIFlow] SelectVoteTarget called; slot=" .. tostring(slotIndex) .. " submitted=" .. tostring(self.voteSubmitted))
		    if self.voteSubmitted then return end
		    if self.votePlayerUserIds == nil then return end
		    local userId = self.votePlayerUserIds[slotIndex]
		    log("[MafiaUIFlow] SelectVoteTarget userId=" .. tostring(userId))
		    if userId == nil then return end
		
		    -- 기권이 선택된 상태면 해제
		    if self.voteAbstainSelected then
		        self.voteAbstainSelected = false
		        if self.voteAbstainBtn ~= nil then self.voteAbstainBtn.Enable = true end
		    end
		
		    -- 이전 카드 선택 해제: 회색 다시 보임
		    if self.voteSelectedSlot > 0 then
		        local prevOff = self.voteCircleOffEntities[self.voteSelectedSlot]
		        if prevOff ~= nil then prevOff.Enable = true end
		    end
		
		    self.voteSelectedSlot = slotIndex
		
		    -- 새 선택: 회색 숨김, 노란색 보임
		    local circOff = self.voteCircleOffEntities[slotIndex]
		    log("[MafiaUIFlow] SelectVoteTarget circOff=" .. tostring(circOff ~= nil) .. " yellowParent=" .. tostring(self.voteYellowParent ~= nil))
		    if circOff ~= nil then circOff.Enable = false end
		    self:ShowYellowCircle(slotIndex)
		
		    if self.voteConfirmBtn ~= nil then self.voteConfirmBtn.Enable = true end
		    if self.voteConfirmRenderer ~= nil then self.voteConfirmRenderer:SetAlpha(1.0) end
		    log("[MafiaUIFlow] vote target selected; slot=" .. tostring(slotIndex))
	end

	method void ShowYellowCircle(integer slotIndex)
		    -- slotIndex=0: 모든 노란 원 숨김. slotIndex=1~8: 해당 슬롯만 노란 원 표시.
		    if self.voteYellowParent == nil then return end
		    if slotIndex <= 0 then
		        self.voteYellowParent.Enable = false
		        return
		    end
		    self.voteYellowParent.Enable = true
		    if self.voteYellowSprite ~= nil then
		        self.voteYellowSprite.Enable = (slotIndex == 1)
		    end
		    for i = 2, 8 do
		        local c = self.voteCircleOnEntities[i]
		        if c ~= nil then c.Enable = (i == slotIndex) end
		    end
	end

	method void HandleVoteConfirm()
		    -- Submits the vote for the selected player or abstain.
		    if self.voteSubmitted then return end
		    if self.voteSelectedSlot <= 0 and not self.voteAbstainSelected then return end
		    local localUserId = self:GetLocalUserId()
		    if localUserId == "" then return end
		    self.voteSubmitted = true
		    if self.voteConfirmBtn ~= nil then self.voteConfirmBtn.Enable = false end
		    if self.voteConfirmRenderer ~= nil then self.voteConfirmRenderer:SetAlpha(0.35) end
		    if self.voteAbstainBtn ~= nil then self.voteAbstainBtn.Enable = false end
		    if self.voteAbstainSelected then
		        _MafiaGameLogic:SubmitVote(localUserId, "")
		        log("[MafiaUIFlow] vote confirmed: abstain")
		    else
		        if self.votePlayerUserIds == nil then return end
		        local userId = self.votePlayerUserIds[self.voteSelectedSlot]
		        if userId == nil then return end
		        _MafiaGameLogic:SubmitVote(localUserId, userId)
		        log("[MafiaUIFlow] vote confirmed; target=" .. tostring(userId))
		    end
	end

	method void HandleVoteAbstain()
		    -- 기권을 "선택" 상태로 표시 (즉시 submit 아님 — 확인 버튼으로 최종 제출).
		    log("[MafiaUIFlow] abstain clicked; submitted=" .. tostring(self.voteSubmitted))
		    if self.voteSubmitted then return end
		    -- 이전 카드 선택 해제
		    if self.voteSelectedSlot > 0 then
		        local prevOff = self.voteCircleOffEntities[self.voteSelectedSlot]
		        if prevOff ~= nil then prevOff.Enable = true end
		        self:ShowYellowCircle(0)
		        self.voteSelectedSlot = 0
		    end
		    -- 기권 선택 상태로 전환 (버튼 비활성 = 선택됨 시각 피드백)
		    self.voteAbstainSelected = true
		    if self.voteAbstainBtn ~= nil then self.voteAbstainBtn.Enable = false end
		    -- 확인 버튼 활성화 (기권 확인 가능)
		    if self.voteConfirmBtn ~= nil then self.voteConfirmBtn.Enable = true end
		    if self.voteConfirmRenderer ~= nil then self.voteConfirmRenderer:SetAlpha(1.0) end
		    log("[MafiaUIFlow] abstain selected; waiting for confirm")
	end

	method void HideVotePanel()
		    -- Hides the vote panel and resets state.
		    if self.voteStampTimerId ~= 0 then
		        _TimerService:ClearTimer(self.voteStampTimerId)
		        self.voteStampTimerId = 0
		    end
		    if self.voteStampEntities ~= nil then
		        for i = 1, 8 do
		            if self.voteStampEntities[i] ~= nil then self.voteStampEntities[i].Enable = false end
		        end
		    end
		    if self.votePanel ~= nil then self.votePanel.Enable = false end
		    -- 죽은 플레이어 관전 뷰 정리
		    if self.voteObserverTextEnt ~= nil then self.voteObserverTextEnt.Enable = false end
		    if self.dayHudCenterPanelEnt ~= nil then
		        local cg = self.dayHudCenterPanelEnt.CanvasGroupComponent
		        if cg ~= nil then cg.GroupAlpha = 1.0 end
		    end
		    self.voteUIShown = false
		    self.voteAnimePlaying = false
		    self.voteAnimePhase   = 0
		    if self.voteAnimeEnt ~= nil then self.voteAnimeEnt.Enable = false end
		    self.executionStampShown = false
		    self.voteResultPendingDelay = 0
		    self.voteResultPendingTarget = ""
		    log("[MafiaUIFlow] vote panel hidden")
	end

	method void ShowExecutionStamp(string executedUserId)
		    -- Enables the pre-placed stamp entity for the executed player's slot and fades it in.
		    if self.voteStampEntities == nil then return end

		    local targetSlot = 0
		    for i = 1, 8 do
		        if self.votePlayerUserIds[i] == executedUserId then
		            targetSlot = i
		            break
		        end
		    end
		    if targetSlot <= 0 then return end

		    local stampEntity = self.voteStampEntities[targetSlot]
		    if stampEntity == nil then return end

		    local renderer = stampEntity.SpriteGUIRendererComponent
		    self.voteStampAlpha = 0
		    if renderer ~= nil then renderer:SetAlpha(0) end
		    stampEntity.Enable = true

		    if self.voteStampTimerId ~= 0 then
		        _TimerService:ClearTimer(self.voteStampTimerId)
		    end
		    self.voteStampTimerId = _TimerService:SetTimerRepeat(function()
		        self.voteStampAlpha = self.voteStampAlpha + 0.08
		        if self.voteStampAlpha >= 1 then
		            self.voteStampAlpha = 1
		            if renderer ~= nil then renderer:SetAlpha(1) end
		            _TimerService:ClearTimer(self.voteStampTimerId)
		            self.voteStampTimerId = 0
		        else
		            if renderer ~= nil then renderer:SetAlpha(self.voteStampAlpha) end
		        end
		    end, 0.016)
		    log("[MafiaUIFlow] execution stamp shown; slot=" .. tostring(targetSlot))
	end

	method table SplitString(string str, string sep)
		    -- Splits str by sep and returns a table of substrings.
		    local result = {}
		    local startIdx = 1
		    local posStart = nil
		    local posEnd = nil
		    while startIdx <= string.len(str) do
		        posStart, posEnd = string.find(str, sep, startIdx)
		        if posStart == nil then
		            result[#result + 1] = string.sub(str, startIdx)
		            break
		        end
		        result[#result + 1] = string.sub(str, startIdx, posStart - 1)
		        startIdx = posEnd + 1
		    end
		    return result
	end

	method boolean IsLocalPlayerDead()
		    -- 로컬 플레이어가 게임 중 사망 상태인지 확인 (AlivePlayersList 기준).
		    if not _MafiaGameLogic.GameStarted then return false end
		    local localId = self:GetLocalUserId()
		    if localId == "" then return false end
		    local aliveStr = _MafiaGameLogic.AlivePlayersList or ""
		    if aliveStr == "" then return false end
		    for uid in string.gmatch(aliveStr, "[^,]+") do
		        if uid == localId then return false end
		    end
		    return true
	end

	method integer GetLocalPlayerRole()
		    -- Returns ROLE_MAFIA/POLICE/DOCTOR/CITIZEN for the local player, or -1 if unknown.
		    local localId = self:GetLocalUserId()
		    if localId == "" then return -1 end
		    local roleData = _MafiaGameLogic.RoleData
		    if roleData == nil or roleData == "" then return -1 end
		    local parts = self:SplitString(roleData, ",")
		    local i = 1
		    while i + 1 <= #parts do
		        if parts[i] == localId then
		            local r = tonumber(parts[i + 1])
		            if r ~= nil then return r end
		        end
		        i += 2
		    end
		    return -1
	end

	method table GetWinnerUserIds(integer winnerRole)
		    -- Builds the ordered userId list for the winning side from MafiaGameLogic.RoleData.
		    local result = {}
		    if _MafiaGameLogic == nil then return result end
		    local roleData = _MafiaGameLogic.RoleData
		    if roleData == nil or roleData == "" then
		        for _, uid in ipairs(_UserService.Users.Keys) do
		            if #result < 8 then result[#result + 1] = tostring(uid) end
		        end
		        return result
		    end
		    local parts = self:SplitString(roleData, ",")
		    local i = 1
		    while i + 1 <= #parts do
		        local uid = parts[i]
		        local role = tonumber(parts[i + 1])
		        local include = false
		        if winnerRole == _MafiaGameLogic.ROLE_MAFIA then
		            include = (role == _MafiaGameLogic.ROLE_MAFIA)
		        else
		            include = (role ~= _MafiaGameLogic.ROLE_MAFIA)
		        end
		        if include and uid ~= nil and uid ~= "" and #result < 8 then
		            result[#result + 1] = tostring(uid)
		        end
		        i += 2
		    end
		    return result
	end

	method void HideCitizenWinAvatarSlots()
		    -- Hides every winner-avatar slot in the citizen victory HUD.
		    if self.citizenWinAvatarEntities == nil then return end
		    for i = 1, 8 do
		        local avEnt = self.citizenWinAvatarEntities[i]
		        if avEnt ~= nil and isvalid(avEnt) then
		            avEnt.Enable = false
		            avEnt.Visible = false
		            if avEnt.AvatarGUIRendererComponent ~= nil then avEnt.AvatarGUIRendererComponent.Enable = false end
		            if avEnt.CostumeManagerComponent ~= nil then avEnt.CostumeManagerComponent.Enable = false end
		        end
		    end
	end

	method void HideMafiaWinAvatarSlots()
		    -- Hides every winner-avatar slot in the mafia victory HUD.
		    if self.mafiaWinAvatarEntities == nil then return end
		    for i = 1, 8 do
		        local avEnt = self.mafiaWinAvatarEntities[i]
		        if avEnt ~= nil and isvalid(avEnt) then
		            avEnt.Enable = false
		            avEnt.Visible = false
		            if avEnt.AvatarGUIRendererComponent ~= nil then avEnt.AvatarGUIRendererComponent.Enable = false end
		            if avEnt.CostumeManagerComponent ~= nil then avEnt.CostumeManagerComponent.Enable = false end
		        end
		    end
	end

	method void RefreshWinAvatars(integer winnerRole)
		    -- Renders winning players' avatars at the bottom of the active victory HUD.
		    if _MafiaGameLogic == nil then return end
		    local avatarEntities = self.citizenWinAvatarEntities
		    if winnerRole == _MafiaGameLogic.ROLE_MAFIA then
		        avatarEntities = self.mafiaWinAvatarEntities
		        self:HideCitizenWinAvatarSlots()
		    elseif winnerRole == _MafiaGameLogic.ROLE_CITIZEN then
		        self:HideMafiaWinAvatarSlots()
		    else
		        self:HideCitizenWinAvatarSlots()
		        self:HideMafiaWinAvatarSlots()
		        self.lastWinAvatarSignature = ""
		        return
		    end
		    if avatarEntities == nil then return end
		
		    local winnerIds = self:GetWinnerUserIds(winnerRole)
		    local count = #winnerIds
		    if count > 8 then count = 8 end
		    local signature = tostring(winnerRole) .. ":" .. table.concat(winnerIds, ",")
		    if signature == self.lastWinAvatarSignature then return end
		    self.lastWinAvatarSignature = signature
		
		    local leftCount = math.ceil(count / 2)
		    local halfGap = 36
		    local halfAvatar = 48
		    local step = 118
		    local y = -260
		
		    for i = 1, 8 do
		        local avEnt = avatarEntities[i]
		        if avEnt ~= nil and isvalid(avEnt) then
		            if i <= count then
		                local userId = winnerIds[i]
		                local isLeft = (i <= leftCount)
		                local x = 0
		                local flipX = false
		                if isLeft then
		                    local dist = leftCount - i
		                    x = -(halfGap + halfAvatar) - dist * step
		                    flipX = false
		                else
		                    local rightIndex = i - leftCount
		                    x = (halfGap + halfAvatar) + (rightIndex - 1) * step
		                    flipX = true
		                end
		                local tf = avEnt.UITransformComponent
		                if tf ~= nil then
		                    tf.anchoredPosition = Vector2(x, y)
		                    tf.RectSize = Vector2(125, 190)
		                end
		                local costume = avEnt.CostumeManagerComponent
		                local renderer = avEnt.AvatarGUIRendererComponent
		                if costume ~= nil then
		                    costume.UseCustomEquipOnly = false
		                    costume.DefaultEquipUserId = userId
		                    costume.Enable = true
		                end
		                if renderer ~= nil then
		                    renderer.Enable = true
		                    renderer.FlipX = flipX
		                end
		                avEnt.Enable = true
		                avEnt.Visible = true
		            else
		                avEnt.Enable = false
		                if avEnt.AvatarGUIRendererComponent ~= nil then avEnt.AvatarGUIRendererComponent.Enable = false end
		                if avEnt.CostumeManagerComponent ~= nil then avEnt.CostumeManagerComponent.Enable = false end
		            end
		        end
		    end
		    log("[MafiaUIFlow] win avatars refreshed; winner=" .. tostring(winnerRole) .. " count=" .. tostring(count))
	end

	method void TriggerLoadingScreen()
		    -- Intercepts LOBBY→FREE_ROAM transition: shows loading screen for 7s then reveals day HUD.
		    self.loadingActive = true
		    log("[MafiaUIFlow] TriggerLoadingScreen called; loadingRoot=" .. tostring(self.loadingRoot ~= nil))
		    if self.loadingRoot == nil then
		        self.loadingRoot = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD")
		        log("[MafiaUIFlow] loadingRoot resolve result=" .. tostring(self.loadingRoot ~= nil))
		        if self.loadingRoot ~= nil then
		            local fEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/FadeOverlay")
		            if fEnt ~= nil then self.loadingFadeOverlayComp = fEnt.SpriteGUIRendererComponent end
		            local rnEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/RoleNameText")
		            if rnEnt ~= nil then self.loadingRoleNameComp = rnEnt.TextComponent end
		            local rdEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/RoleDescText")
		            if rdEnt ~= nil then self.loadingRoleDescComp = rdEnt.TextComponent end
		            local tEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/TipText")
		            if tEnt ~= nil then self.loadingTipComp = tEnt.TextComponent end
		            local sEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/StoryText")
		            if sEnt ~= nil then self.loadingStoryComp = sEnt.TextComponent end
		        end
		    end
		    if self.loadingRoot == nil then
		        log("[MafiaUIFlow] loadingRoot nil → skip loading screen, show day HUD directly")
		        self.loadingActive = false
		        self:SetHudActive(self.dayRoot, true)
		        return
		    end
		    -- Retry component resolution in case it failed during OnBeginPlay
		    if self.loadingFadeOverlayComp == nil then
		        local fEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/FadeOverlay")
		        if fEnt ~= nil then self.loadingFadeOverlayComp = fEnt.SpriteGUIRendererComponent end
		        log("[MafiaUIFlow] loadingFadeOverlayComp retry=" .. tostring(self.loadingFadeOverlayComp ~= nil))
		    end
		    if self.loadingRoleNameComp == nil then
		        local rnEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/RoleNameText")
		        if rnEnt ~= nil then self.loadingRoleNameComp = rnEnt.TextComponent end
		    end
		    if self.loadingRoleDescComp == nil then
		        local rdEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/RoleDescText")
		        if rdEnt ~= nil then self.loadingRoleDescComp = rdEnt.TextComponent end
		    end
		    if self.loadingStoryComp == nil then
		        local sEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/StoryText")
		        if sEnt ~= nil then self.loadingStoryComp = sEnt.TextComponent end
		    end
		    if self.loadingTipComp == nil then
		        local tEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/TipText")
		        if tEnt ~= nil then self.loadingTipComp = tEnt.TextComponent end
		    end
		    local role = self:GetLocalPlayerRole()
		    local roleName = "시민"
		    local roleDesc = "토론과 추리로 마피아를 찾아내 투표로 제거하세요."
		    if _MafiaGameLogic ~= nil then
		        if role == _MafiaGameLogic.ROLE_MAFIA then
		            roleName = "마피아"
		            roleDesc = "밤마다 한 명의 시민을 제거하고, 낮에는 의심을 피하세요."
		        elseif role == _MafiaGameLogic.ROLE_POLICE then
		            roleName = "경찰"
		            roleDesc = "매 밤 한 명을 조사해 마피아 여부를 밝혀내세요."
		        elseif role == _MafiaGameLogic.ROLE_DOCTOR then
		            roleName = "의사"
		            roleDesc = "매 밤 한 명을 보호해 마피아의 공격을 막으세요."
		        end
		    end
		    -- 역할 공개 배경: 마피아만 전용 배경(BgSprite_1), 나머지는 기본 배경(BgSprite).
		    local loadingBgEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/BgSprite")
		    local loadingMafiaBgEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/BgSprite_1")
		    local isMafiaRole = (_MafiaGameLogic ~= nil and role == _MafiaGameLogic.ROLE_MAFIA)
		    if loadingBgEnt ~= nil then
		        loadingBgEnt.Enable = not isMafiaRole
		        loadingBgEnt.Visible = not isMafiaRole
		    end
		    if loadingMafiaBgEnt ~= nil then
		        loadingMafiaBgEnt.Enable = isMafiaRole
		        loadingMafiaBgEnt.Visible = isMafiaRole
		    end
		    log("[MafiaUIFlow] loading background role=" .. tostring(role)
		        .. " default=" .. tostring(not isMafiaRole)
		        .. " mafia=" .. tostring(isMafiaRole))
		    local storyPool = {
		        "우리 중에 있다",
		        "누구도 믿지 마라",
		        "진실은 하나다",
		        "밤이 깊어갈수록 의심도 깊어간다",
		        "살아남은 자만이 진실을 안다",
		        "거짓말쟁이는 항상 웃고 있다",
		        "신뢰는 가장 위험한 도박이다",
		        "마지막까지 살아남아라",
		    }
		    local tipPool = {
		        "투표 전 충분히 토론하세요",
		        "마피아는 여러 명일 수 있습니다",
		        "침묵하는 자를 조심하세요",
		        "죽은 플레이어의 말에도 귀를 기울이세요",
		        "첫 번째 투표가 게임의 흐름을 결정합니다",
		        "마피아끼리는 서로를 알고 있습니다",
		        "의심스럽다고 해서 무조건 마피아는 아닙니다",
		        "경찰의 조사 결과는 매우 소중합니다",
		        "너무 이른 폭로는 위험할 수 있습니다",
		        "팀워크보다 중요한 것은 없습니다",
		    }
		    local randomStory = storyPool[math.random(#storyPool)]
		    local randomTip = tipPool[math.random(#tipPool)]
		    if self.loadingRoleNameComp ~= nil then self.loadingRoleNameComp.Text = roleName end
		    if self.loadingRoleDescComp ~= nil then self.loadingRoleDescComp.Text = roleDesc end
		    if self.loadingStoryComp ~= nil then self.loadingStoryComp.Text = randomStory end
		    if self.loadingTipComp ~= nil then self.loadingTipComp.Text = randomTip end
		    -- Resolve loading avatar entities once per world session
		    if self.loadingAvatarEntities == nil then
		        self.loadingAvatarEntities = {}
		        for i = 1, 8 do
		            local avEnt = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD/LoadingAvatarBar/LoadingAvatar" .. tostring(i))
		            self.loadingAvatarEntities[i] = avEnt
		        end
		    end
		    -- Collect player userIds in join order (up to 8)
		    local _loadSeat = 1
		    local _loadUserIds = {}
		    for _, uid in ipairs(_UserService.Users.Keys) do
		        if _loadSeat <= 8 then _loadUserIds[_loadSeat] = tostring(uid); _loadSeat = _loadSeat + 1 end
		    end
		    local _total = _loadSeat - 1
		    -- Left/right split: odd total assigns one extra to left
		    local _leftCount = math.ceil(_total / 2)
		    -- Layout constants: center gap=60px total (30 each side), avatar pitch=100px
		    local _halfGap = 30
		    local _halfAv  = 40
		    local _step    = 100
		    for i = 1, 8 do
		        local avEnt = self.loadingAvatarEntities[i]
		        if avEnt ~= nil then
		            if i <= _total then
		                local userId = _loadUserIds[i]
		                local isLeft = (i <= _leftCount)
		                local x, flipX
		                if isLeft then
		                    -- Left group: i=1 leftmost, i=_leftCount nearest center; all face right
		                    local dist = _leftCount - i
		                    x = -(_halfGap + _halfAv) - dist * _step
		                    flipX = false
		                else
		                    -- Right group: nearest center first; all face left
		                    local rightIdx = i - _leftCount
		                    x = (_halfGap + _halfAv) + (rightIdx - 1) * _step
		                    flipX = true
		                end
		                local tf = avEnt.UITransformComponent
		                if tf ~= nil then tf.anchoredPosition = Vector2(x, 0) end
		                local costume = avEnt.CostumeManagerComponent
		                local renderer = avEnt.AvatarGUIRendererComponent
		                if costume ~= nil then
		                    costume.UseCustomEquipOnly = false
		                    costume.DefaultEquipUserId = userId
		                    costume.Enable = true
		                end
		                if renderer ~= nil then
		                    renderer.Enable = true
		                    renderer.FlipX = flipX
		                end
		                avEnt.Enable = true
		            else
		                avEnt.Enable = false
		            end
		        end
		    end
		    if self.loadingFadeOverlayComp ~= nil then
		        self.loadingFadeOverlayComp.Color = Color(0, 0, 0, 0)
		    end
		    self.loadingRoot:SetEnable(true)
		    self.loadingRoot.Visible = true
		    log("[MafiaUIFlow] loading screen shown role=" .. tostring(role))
		    wait(4.0)
		    -- fade out: FadeOverlay alpha 0 → 1
		    self:AnimateLoadingFade(0, 1, 0.5)
		    self.loadingRoot:SetEnable(false)
		    self.loadingRoot.Visible = false
		    self.loadingActive = false
		    self:SetHudActive(self.dayRoot, true)
		    log("[MafiaUIFlow] loading screen done, day HUD active")
	end

	method void AnimateLoadingFade(number fromAlpha, number toAlpha, number duration)
		    -- Steps FadeOverlay alpha from fromAlpha to toAlpha over duration seconds.
		    if self.loadingFadeOverlayComp == nil then return end
		    local steps = 20
		    local stepTime = duration / steps
		    local alphaDelta = (toAlpha - fromAlpha) / steps
		    local current = fromAlpha
		    for i = 1, steps do
		        current = current + alphaDelta
		        local clamped = math.max(0, math.min(1, current))
		        self.loadingFadeOverlayComp.Color = Color(0, 0, 0, clamped)
		        wait(stepTime)
		    end
		    self.loadingFadeOverlayComp.Color = Color(0, 0, 0, toAlpha)
	end

	method table GetNightTargets(integer role)
		    -- Returns list of userId strings that are valid targets for the given role.
		    local localId = self:GetLocalUserId()
		    local aliveStr = _MafiaGameLogic.AlivePlayersList
		    if aliveStr == nil or aliveStr == "" then return {} end
		    local aliveIds = self:SplitString(aliveStr, ",")
		
		    if role == _MafiaGameLogic.ROLE_MAFIA then
		        -- Build set of mafia userIds from RoleData to exclude them
		        local mafiaSet = {}
		        local roleData = _MafiaGameLogic.RoleData
		        if roleData ~= nil and roleData ~= "" then
		            local parts = self:SplitString(roleData, ",")
		            local j = 1
		            while j + 1 <= #parts do
		                if tonumber(parts[j + 1]) == _MafiaGameLogic.ROLE_MAFIA then
		                    mafiaSet[parts[j]] = true
		                end
		                j += 2
		            end
		        end
		        local result = {}
		        for _, uid in ipairs(aliveIds) do
		            if not mafiaSet[uid] then result[#result + 1] = uid end
		        end
		        return result
		    else
		        -- Police: exclude self; Doctor: include self
		        local result = {}
		        for _, uid in ipairs(aliveIds) do
		            if role == _MafiaGameLogic.ROLE_DOCTOR or uid ~= localId then
		                result[#result + 1] = uid
		            end
		        end
		        return result
		    end
	end

	method void ResolveNightUI()
		    -- Resolves entity references for all three night panels and wires button events.
		    if self.nightRoot == nil then return end
		
		    self.nightMafiaPanel = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Mafia")
		    self.nightPolicePanel = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Police")
		    self.nightDoctorPanel = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Doctor")
		
		    -- Title text components (for timer display)
		    local m1 = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Mafia/Mafia_1")
		    local p1 = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Police/Police_1")
		    local d1 = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Doctor/Doctor_1")
		    self.nightMafiaTitleComp  = (m1 ~= nil) and m1.TextComponent or nil
		    self.nightPoliceTitleComp = (p1 ~= nil) and p1.TextComponent or nil
		    self.nightDoctorTitleComp = (d1 ~= nil) and d1.TextComponent or nil
		
		    -- Confirm buttons
		    self.nightMafiaConfirmEnt  = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Mafia/Mafia_4")
		    self.nightPoliceConfirmEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Police/Police_3")
		    self.nightDoctorConfirmEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Doctor/Doctor_3")
		
		    -- Mafia hide-modal button
		    self.nightMafiaHideEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Mafia/Mafia_6")
		    self.nightMafiaHide2Ent = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Mafia/Mafia_15")
		    self.nightMafiaRestore3Ent = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/CenterPanel/MafiaChat/Mafia_3")
		
		    -- Card slot paths per role
		    local mafiaSlotPaths = {
		        "/ui/MafiaNightHUD/Mafia/Mafia_5",
		        "/ui/MafiaNightHUD/Mafia/Mafia_5/Mafia_6",
		        "/ui/MafiaNightHUD/Mafia/Mafia_5/Mafia_7",
		        "/ui/MafiaNightHUD/Mafia/Mafia_5/Mafia_8",
		        "/ui/MafiaNightHUD/Mafia/Mafia_5/Mafia_9",
		        "/ui/MafiaNightHUD/Mafia/Mafia_5/Mafia_10",
		    }
		    local mafiaCircleOffNames = { "UISprite", "UISprite_1", "UISprite_2", "UISprite_3", "UISprite_4", "UISprite_5" }
		    local mafiaCircleNames    = { "UISprite_1", "UISprite_2", "UISprite_3", "UISprite_4", "UISprite_5", "UISprite_6" }
		    local policeSlotPaths = {
		        "/ui/MafiaNightHUD/Police/Police_4",
		        "/ui/MafiaNightHUD/Police/Police_4/Police_5",
		        "/ui/MafiaNightHUD/Police/Police_4/Police_6",
		        "/ui/MafiaNightHUD/Police/Police_4/Police_7",
		        "/ui/MafiaNightHUD/Police/Police_4/Police_8",
		        "/ui/MafiaNightHUD/Police/Police_4/Police_9",
		        "/ui/MafiaNightHUD/Police/Police_4/Police_10",
		    }
		    local policeCircleOffNames = { "UISprite_6", "UISprite_7", "UISprite_8", "UISprite_9", "UISprite_10", "UISprite_11", "UISprite_12" }
		    local policeCircleNames    = { "UISprite_7", "UISprite_8", "UISprite_9", "UISprite_10", "UISprite_11", "UISprite_12", "UISprite_13" }
		    local doctorSlotPaths = {
		        "/ui/MafiaNightHUD/Doctor/Doctor_4",
		        "/ui/MafiaNightHUD/Doctor/Doctor_4/Doctor_5",
		        "/ui/MafiaNightHUD/Doctor/Doctor_4/Doctor_6",
		        "/ui/MafiaNightHUD/Doctor/Doctor_4/Doctor_7",
		        "/ui/MafiaNightHUD/Doctor/Doctor_4/Doctor_8",
		        "/ui/MafiaNightHUD/Doctor/Doctor_4/Doctor_9",
		        "/ui/MafiaNightHUD/Doctor/Doctor_4/Doctor_10",
		        "/ui/MafiaNightHUD/Doctor/Doctor_4/Doctor_11",
		    }
		    -- Doctor 슬롯 circle/circleOff: 각 슬롯의 UISprite 이름이 NightCircle/NightCircleOff가 아닌 UISprite_N 형태
		    -- 작은 번호 = 회색(Off), 큰 번호 = 노란색(On)
		    local doctorCircleOffNames = { "UISprite", "UISprite_7", "UISprite_8", "UISprite_9", "UISprite_10", "UISprite_11", "UISprite_12", "UISprite_13" }
		    local doctorCircleNames    = { "UISprite_7", "UISprite_8", "UISprite_9", "UISprite_10", "UISprite_11", "UISprite_12", "UISprite_13", "UISprite_14" }
		
		    local function resolveSlots(paths, cards, avatars, names, circles, circlesOff, handlers, role)
		        for i, sp in ipairs(paths) do
		            local card = _EntityService:GetEntityByPath(sp)
		            cards[i] = card
		            if card ~= nil then
		                local av = _EntityService:GetEntityByPath(sp .. "/NightAvatar")
		                local nt = _EntityService:GetEntityByPath(sp .. "/NightNameText")
		                local nc  = _EntityService:GetEntityByPath(sp .. "/NightCircle")
		                local nco = _EntityService:GetEntityByPath(sp .. "/NightCircleOff")
		                avatars[i]    = av
		                names[i]      = (nt ~= nil) and nt.TextComponent or nil
		                circles[i]    = nc
		                circlesOff[i] = nco
		                local slotIdx = i
		                local r = role
		                if handlers[i] == nil and card.ButtonComponent ~= nil then
		                    handlers[i] = card:ConnectEvent(ButtonClickEvent, function()
		                        self:SelectNightTarget(r, slotIdx)
		                    end)
		                end
		            end
		        end
		    end

		    resolveSlots(mafiaSlotPaths,  self.nightMafiaCards,  self.nightMafiaAvatars,  self.nightMafiaNames,  self.nightMafiaCircles,  self.nightMafiaCirclesOff,  self.nightMafiaHandlers,  _MafiaGameLogic.ROLE_MAFIA)
		    -- Mafia circle/circleOff는 NightCircle/NightCircleOff 대신 UISprite_N 이름으로 별도 해결
		    for i, sp in ipairs(mafiaSlotPaths) do
		        self.nightMafiaCirclesOff[i] = _EntityService:GetEntityByPath(sp .. "/" .. mafiaCircleOffNames[i])
		        self.nightMafiaCircles[i]    = _EntityService:GetEntityByPath(sp .. "/" .. mafiaCircleNames[i])
		    end
		    resolveSlots(policeSlotPaths, self.nightPoliceCards, self.nightPoliceAvatars, self.nightPoliceNames, self.nightPoliceCircles, self.nightPoliceCirclesOff, self.nightPoliceHandlers, _MafiaGameLogic.ROLE_POLICE)
		    -- Police circle/circleOff는 NightCircle/NightCircleOff 대신 UISprite_N 이름으로 별도 해결
		    for i, sp in ipairs(policeSlotPaths) do
		        self.nightPoliceCirclesOff[i] = _EntityService:GetEntityByPath(sp .. "/" .. policeCircleOffNames[i])
		        self.nightPoliceCircles[i]    = _EntityService:GetEntityByPath(sp .. "/" .. policeCircleNames[i])
		    end
		    resolveSlots(doctorSlotPaths, self.nightDoctorCards, self.nightDoctorAvatars, self.nightDoctorNames, self.nightDoctorCircles, self.nightDoctorCirclesOff, self.nightDoctorHandlers, _MafiaGameLogic.ROLE_DOCTOR)
		    -- Doctor circle/circleOff는 NightCircle/NightCircleOff 대신 UISprite_N 이름으로 별도 해결
		    for i, sp in ipairs(doctorSlotPaths) do
		        self.nightDoctorCirclesOff[i] = _EntityService:GetEntityByPath(sp .. "/" .. doctorCircleOffNames[i])
		        self.nightDoctorCircles[i]    = _EntityService:GetEntityByPath(sp .. "/" .. doctorCircleNames[i])
		    end

		    -- Confirm button events
		    if self.nightMafiaConfirmEnt ~= nil and self.nightMafiaConfirmEnt.ButtonComponent ~= nil and self.nightConfirmMafiaHandler == nil then
		        self.nightConfirmMafiaHandler = self.nightMafiaConfirmEnt:ConnectEvent(ButtonClickEvent, function()
		            self:SubmitNightChoice(_MafiaGameLogic.ROLE_MAFIA)
		        end)
		    end
		    if self.nightPoliceConfirmEnt ~= nil and self.nightPoliceConfirmEnt.ButtonComponent ~= nil and self.nightConfirmPoliceHandler == nil then
		        self.nightConfirmPoliceHandler = self.nightPoliceConfirmEnt:ConnectEvent(ButtonClickEvent, function()
		            self:SubmitNightChoice(_MafiaGameLogic.ROLE_POLICE)
		        end)
		    end
		    if self.nightDoctorConfirmEnt ~= nil and self.nightDoctorConfirmEnt.ButtonComponent ~= nil and self.nightConfirmDoctorHandler == nil then
		        self.nightConfirmDoctorHandler = self.nightDoctorConfirmEnt:ConnectEvent(ButtonClickEvent, function()
		            self:SubmitNightChoice(_MafiaGameLogic.ROLE_DOCTOR)
		        end)
		    end
		    if self.nightMafiaHideEnt ~= nil and self.nightMafiaHideEnt.ButtonComponent ~= nil and self.nightHideHandler == nil then
		        self.nightHideHandler = self.nightMafiaHideEnt:ConnectEvent(ButtonClickEvent, function()
		            self:MinimizeMafiaPanel()
		        end)
		    end
		    if self.nightMafiaHide2Ent ~= nil and self.nightMafiaHide2Ent.ButtonComponent ~= nil and self.nightHide2Handler == nil then
		        self.nightHide2Handler = self.nightMafiaHide2Ent:ConnectEvent(ButtonClickEvent, function()
		            self:MinimizeMafiaPanel()
		        end)
		    end
		    if self.nightMafiaRestore3Ent ~= nil and self.nightMafiaRestore3Ent.ButtonComponent ~= nil and self.nightRestore3Handler == nil then
		        self.nightRestore3Handler = self.nightMafiaRestore3Ent:ConnectEvent(ButtonClickEvent, function()
		            self:RestoreMafiaPanel()
		        end)
		    end
		
		    -- NightOverlay 엔티티 해결 (비활동 플레이어 대기 화면)
	    self.nightOverlayEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/NightOverlay")
	    -- NightMsgText: 메이플체 대기 멘트 텍스트 (displayOrder=107, 액션 이미지 위에 렌더)
	    self.nightMsgTextEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/NightMsgText")
	    self.nightOverlayTextComp = (self.nightMsgTextEnt ~= nil) and self.nightMsgTextEnt.TextComponent or nil
	    if self.nightOverlayTextComp ~= nil then
	        self.nightOverlayTextComp.FontSize = 35
	        log("[MafiaUIFlow] Night action text font size set to 35")
	    end
	    -- 역할별 액션 이미지 엔티티
	    self.nightMafiaActionEnt  = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/MafiaAction")
	    self.nightPoliceActionEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/PoliceAction")
	    self.nightDoctorActionEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/DoctorAction")
	    -- 마피아 채팅 패널 엔티티
	    self.nightMafiaChatPanelEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/CenterPanel/MafiaChat")
	    -- Night Dead 오버레이 엔티티 조회 (Dead_1=슬롯1, Dead_2=슬롯2, ...)
	    if self.nightMafiaDeadEntities == nil then self.nightMafiaDeadEntities = {} end
	    for i = 1, 6 do
	        self.nightMafiaDeadEntities[i] = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Mafia/Dead_" .. tostring(i))
	        if self.nightMafiaDeadEntities[i] ~= nil then self.nightMafiaDeadEntities[i].Enable = false end
	    end
	    if self.nightPoliceDeadEntities == nil then self.nightPoliceDeadEntities = {} end
	    for i = 1, 7 do
	        self.nightPoliceDeadEntities[i] = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/Police/Dead_" .. tostring(i))
	        if self.nightPoliceDeadEntities[i] ~= nil then self.nightPoliceDeadEntities[i].Enable = false end
	    end
	    if self.nightDoctorDeadEntities == nil then self.nightDoctorDeadEntities = {} end
	    local resolvedDoctorDeadCount = 0
	    for i = 1, 8 do
	        self.nightDoctorDeadEntities[i] = _EntityService:GetEntityByPath(doctorSlotPaths[i] .. "/Dead_" .. tostring(i))
	        if self.nightDoctorDeadEntities[i] ~= nil then self.nightDoctorDeadEntities[i].Enable = false end
	        if self.nightDoctorDeadEntities[i] ~= nil then resolvedDoctorDeadCount = resolvedDoctorDeadCount + 1 end
	    end
	    log("[MafiaUIFlow] Doctor dead overlays resolved=" .. tostring(resolvedDoctorDeadCount) .. "/8")
	    -- 경찰 조사결과 표시 오버레이 (루트 레벨, ResultDimBg 위)
	    if self.policeResultDisplayEnt ~= nil then
	        self.policeResultDisplayEnt.Enable = false
	    end
	    if self.policeResultTextEnt ~= nil then self.policeResultTextEnt.Enable = false end
	    do
	        local textEnt = _EntityService:GetEntityByPath("/ui/MafiaNightHUD/PoliceResultText")
	        self.policeResultDisplayTextComp = (textEnt ~= nil) and textEnt.TextComponent or nil
	    end
	    log("[MafiaUIFlow] night UI resolved")
	end

	method void ShowNightPanel()
		    -- 활성 서브페이즈에서 나의 역할이 활동 역할인지 확인 후 패널 결정
		    local localRole = self:GetLocalPlayerRole()
		    local subPhase = _MafiaGameLogic.NightSubPhase
		    local activeRole = -1
		    if subPhase == _MafiaGameLogic.PHASE_NIGHT_MAFIA then
		        activeRole = _MafiaGameLogic.ROLE_MAFIA
		    elseif subPhase == _MafiaGameLogic.PHASE_NIGHT_POLICE then
		        activeRole = _MafiaGameLogic.ROLE_POLICE
		    elseif subPhase == _MafiaGameLogic.PHASE_NIGHT_DOCTOR then
		        activeRole = _MafiaGameLogic.ROLE_DOCTOR
		    end
		    local isDead = self:IsLocalPlayerDead()
		    -- 사망한 플레이어: 현재 활동 역할의 패널을 관전 모드(읽기 전용)로 표시
		    local panelRole = (localRole == activeRole) and localRole or -1
		    if isDead and activeRole ~= -1 then
		        panelRole = activeRole
		    end

		    -- 마피아 채팅: 마피아 단계일 때 마피아 역할이거나 사망 플레이어면 표시 (사망자는 입력 불가)
		    if self.nightMafiaChatPanelEnt ~= nil then
		        local showMafiaChat = (subPhase == _MafiaGameLogic.PHASE_NIGHT_MAFIA) and (localRole == _MafiaGameLogic.ROLE_MAFIA or isDead)
		        self.nightMafiaChatPanelEnt.Enable = showMafiaChat
		    end

		    -- 이전 패널 모두 숨기기
		    if self.nightMafiaPanel ~= nil then self.nightMafiaPanel.Enable = false end
		    if self.nightPolicePanel ~= nil then self.nightPolicePanel.Enable = false end
		    if self.nightDoctorPanel ~= nil then self.nightDoctorPanel.Enable = false end
		    if self.nightOverlayEnt ~= nil then self.nightOverlayEnt.Enable = false end
		    if self.nightMafiaActionEnt ~= nil then self.nightMafiaActionEnt.Enable = false end
		    if self.nightPoliceActionEnt ~= nil then self.nightPoliceActionEnt.Enable = false end
		    if self.nightDoctorActionEnt ~= nil then self.nightDoctorActionEnt.Enable = false end
		    if self.nightMsgTextEnt ~= nil then self.nightMsgTextEnt.Enable = false end

		    self.nightManuallyHidden = false
		    self.nightActiveRole = panelRole
		    self.nightSelectedSlot = 0
		    self.nightSubmitted = false

		    -- 비활동 역할 또는 시민: NightOverlay 대기 화면 표시
		    if panelRole == -1 then
		        if self.nightOverlayEnt ~= nil then
		            self.nightOverlayEnt.Enable = true
		        end
		        -- 서브페이즈에 맞는 액션 이미지 — enable 설정 & CanvasGroup alpha 초기화
		        if self.nightMafiaActionEnt ~= nil then
		            self.nightMafiaActionEnt.Enable = (subPhase == _MafiaGameLogic.PHASE_NIGHT_MAFIA)
		            local cg = self.nightMafiaActionEnt.CanvasGroupComponent
		            if cg ~= nil then cg.GroupAlpha = 0 end
		        end
		        if self.nightPoliceActionEnt ~= nil then
		            self.nightPoliceActionEnt.Enable = (subPhase == _MafiaGameLogic.PHASE_NIGHT_POLICE)
		            local cg = self.nightPoliceActionEnt.CanvasGroupComponent
		            if cg ~= nil then cg.GroupAlpha = 0 end
		        end
		        if self.nightDoctorActionEnt ~= nil then
		            self.nightDoctorActionEnt.Enable = (subPhase == _MafiaGameLogic.PHASE_NIGHT_DOCTOR)
		            local cg = self.nightDoctorActionEnt.CanvasGroupComponent
		            if cg ~= nil then cg.GroupAlpha = 0 end
		        end
		        -- 페이드인 시작
		        self.nightActionAlpha = 0
		        self.nightFadingIn = true
		        -- 대기 멘트 텍스트
		        if self.nightMsgTextEnt ~= nil then
		            self.nightMsgTextEnt.Enable = true
		            if self.nightOverlayTextComp ~= nil then
		                self.nightOverlayTextComp.Text = self.nightOverlayMsg
		                self.nightOverlayTextComp.FontColor = Color(0.909, 0.835, 0.627, 0)
		            end
		        end
		        self.nightUIShown = true
		        log("[MafiaUIFlow] night: waiting overlay; localRole=" .. tostring(localRole) .. " subPhase=" .. tostring(subPhase))
		        return
		    end

		    local maxSlots = 0
		    local cards      = nil
		    local avatars    = nil
		    local names      = nil
		    local circles    = nil
		    local circlesOff = nil
		    local playerIds  = nil
		    local deadEntities = nil
		    local confirmEnt = nil

		    if panelRole == _MafiaGameLogic.ROLE_MAFIA then
		        if self.nightMafiaPanel == nil then return end
		        self.nightMafiaPanel.Enable = true
		        local cgMafia = self.nightMafiaPanel.CanvasGroupComponent
		        if cgMafia ~= nil then cgMafia.GroupAlpha = 0 end
		        self.nightActionAlpha = 0
		        self.nightFadingIn = true
		        maxSlots    = 6
		        cards       = self.nightMafiaCards
		        avatars     = self.nightMafiaAvatars
		        names       = self.nightMafiaNames
		        circles     = self.nightMafiaCircles
		        circlesOff  = self.nightMafiaCirclesOff
		        playerIds   = self.nightMafiaPlayerIds
		        confirmEnt  = self.nightMafiaConfirmEnt
		        deadEntities = self.nightMafiaDeadEntities
		    elseif panelRole == _MafiaGameLogic.ROLE_POLICE then
		        if self.nightPolicePanel == nil then return end
		        self.nightPolicePanel.Enable = true
		        local cgPolice = self.nightPolicePanel.CanvasGroupComponent
		        if cgPolice ~= nil then cgPolice.GroupAlpha = 0 end
		        self.nightActionAlpha = 0
		        self.nightFadingIn = true
		        maxSlots    = 7
		        cards       = self.nightPoliceCards
		        avatars     = self.nightPoliceAvatars
		        names       = self.nightPoliceNames
		        circles     = self.nightPoliceCircles
		        circlesOff  = self.nightPoliceCirclesOff
		        playerIds   = self.nightPolicePlayerIds
		        confirmEnt  = self.nightPoliceConfirmEnt
		        deadEntities = self.nightPoliceDeadEntities
		    elseif panelRole == _MafiaGameLogic.ROLE_DOCTOR then
		        if self.nightDoctorPanel == nil then return end
		        self.nightDoctorPanel.Enable = true
		        local cgDoctor = self.nightDoctorPanel.CanvasGroupComponent
		        if cgDoctor ~= nil then cgDoctor.GroupAlpha = 0 end
		        self.nightActionAlpha = 0
		        self.nightFadingIn = true
		        maxSlots    = 8
		        cards       = self.nightDoctorCards
		        avatars     = self.nightDoctorAvatars
		        names       = self.nightDoctorNames
		        circles     = self.nightDoctorCircles
		        circlesOff  = self.nightDoctorCirclesOff
		        playerIds   = self.nightDoctorPlayerIds
		        confirmEnt  = self.nightDoctorConfirmEnt
		        deadEntities = self.nightDoctorDeadEntities
		    else
		        return
		    end
		
		    -- Clickable targets for this role.
		    -- 사망 여부 확인을 위한 생존자 셋
		    local aliveSetNight = {}
		    local aliveStrNight = _MafiaGameLogic.AlivePlayersList
		    if aliveStrNight ~= nil and aliveStrNight ~= "" then
		        for _, uid in ipairs(self:SplitString(aliveStrNight, ",")) do
		            aliveSetNight[uid] = true
		        end
		    end
		    local targets = self:GetNightTargets(panelRole)
		    local targetSet = {}
		    for _, uid in ipairs(targets) do targetSet[uid] = true end

		    -- All players except self (keep layout fixed even when someone dies).
		    -- For mafia panel: also exclude fellow mafia players.
		    local localId = self:GetLocalUserId()
		    local mafiaExcludeSet = {}
		    if panelRole == _MafiaGameLogic.ROLE_MAFIA then
		        local rd = _MafiaGameLogic.RoleData
		        if rd ~= nil and rd ~= "" then
		            local rp = self:SplitString(rd, ",")
		            for j = 1, #rp, 2 do
		                if tonumber(rp[j+1]) == _MafiaGameLogic.ROLE_MAFIA then
		                    mafiaExcludeSet[rp[j]] = true
		                end
		            end
		        end
		    end
		    local allDisplay = {}
		    local roleData = _MafiaGameLogic.RoleData
		    if roleData ~= nil and roleData ~= "" then
		        local parts = self:SplitString(roleData, ",")
		        for i = 1, #parts, 2 do
		            local uid = parts[i]
		            if (uid ~= localId or panelRole == _MafiaGameLogic.ROLE_DOCTOR) and not mafiaExcludeSet[uid] then allDisplay[#allDisplay + 1] = uid end
		        end
		    end
		    for i = 1, maxSlots do playerIds[i] = nil end
		    local count = math.min(#allDisplay, maxSlots)
		    for i = 1, count do playerIds[i] = allDisplay[i] end

		    -- 슬롯 채우기
		    for i = 1, maxSlots do
		        local uid       = playerIds[i]
		        local card      = cards[i]
		        local av        = avatars[i]
		        local nt        = names[i]
		        local circle    = circles[i]
		        local circleOff = (circlesOff ~= nil) and circlesOff[i] or nil

		        if card ~= nil then
		            local hasUser = (uid ~= nil)
		            local isTarget = hasUser and (targetSet[uid] == true)
		            if card.ButtonComponent ~= nil then
		                -- Enable only if this player is a valid target; dead players stay visible but unclickable.
		                card.ButtonComponent.Enable = isTarget
		                -- Dead 오버레이: 슬롯에 플레이어가 있고 생존자 목록에 없으면 사망 표시
		                local isDead = (uid ~= nil) and (aliveSetNight[uid] ~= true)
		                if deadEntities ~= nil and deadEntities[i] ~= nil then
		                    deadEntities[i].Enable = isDead
		                end
		            end
		            if av ~= nil then
		                if hasUser then
		                    local costume = av.CostumeManagerComponent
		                    local renderer = av.AvatarGUIRendererComponent
		                    if costume ~= nil then
		                        costume.UseCustomEquipOnly = false
		                        costume.DefaultEquipUserId = uid
		                        costume.Enable = true
		                    end
		                    if renderer ~= nil then renderer.Enable = true end
		                    av.Enable = true
		                else
		                    av.Enable = false
		                end
		            end
		            if nt ~= nil then
		                nt.Text = (uid ~= nil) and self:GetUserDisplayName(uid) or ""
		                local nameColor = Color(1, 1, 1, 1)
		                if uid ~= nil and self:GetLocalPlayerRole() == _MafiaGameLogic.ROLE_MAFIA then
		                    if tonumber(self:GetRoleFromRoleData(uid)) == _MafiaGameLogic.ROLE_MAFIA then
		                        nameColor = Color(1, 0.2, 0.2, 1)
		                    end
		                end
		                nt.FontColor = nameColor
		            end
		            -- 기본값: 회색 원(Off) 표시, 노란 원(On) 숨김
		            if circleOff ~= nil then circleOff.Enable = true end
		            if circle    ~= nil then circle.Enable    = false end
		        end
		    end

		    -- 확인 버튼: 엔티티는 표시, 클릭만 비활성(카드 선택 후 활성화)
		    if confirmEnt ~= nil and confirmEnt.ButtonComponent ~= nil then
		        confirmEnt.ButtonComponent.Enable = false
		    end

		    -- 사망 플레이어: 선택 잠금 + 채팅 입력 비활성
		    if isDead then
		        self.nightSubmitted = true
		        if self.nightChatInput ~= nil then
		            self.nightChatInput.Entity.Enable = false
		        end
		    end

		    local timer = tostring(math.max(0, math.ceil(_MafiaGameLogic.PhaseTimer)))
		    self:UpdateNightTimer(timer)

		    self.nightUIShown = true
		    log("[MafiaUIFlow] night panel shown; panelRole=" .. tostring(panelRole) .. " isDead=" .. tostring(isDead))
	end

	method void UpdateNightTimer(string timerStr)
		    -- Updates the title text to show role name + remaining timer.
		    local localRole = self:GetLocalPlayerRole()
		    if localRole == _MafiaGameLogic.ROLE_MAFIA and self.nightMafiaTitleComp ~= nil then
		        self.nightMafiaTitleComp.Text = "마피아  " .. timerStr
		    elseif localRole == _MafiaGameLogic.ROLE_POLICE and self.nightPoliceTitleComp ~= nil then
		        self.nightPoliceTitleComp.Text = "경찰  " .. timerStr
		    elseif localRole == _MafiaGameLogic.ROLE_DOCTOR and self.nightDoctorTitleComp ~= nil then
		        self.nightDoctorTitleComp.Text = "의사  " .. timerStr
		    end
	end

	method void RefreshNight()
		    -- Called every frame-batch during PHASE_NIGHT.
		    self:ResolvePhaseChatContext("MafiaNightHUD")
		    local nightChatLog = _MafiaGameLogic.MafiaChatLog or ""
		    if nightChatLog ~= self.lastNightChatLog then
		        self.lastNightChatLog = nightChatLog
		        self.lobbyChatBubbleScrollOffset = 0
		        self:HideLobbyRawChatLog()
		        self:ApplyLobbyChatBubbles(nightChatLog)
		    end
		    -- 서브페이즈 변화 감지: 변경 시 패널 재표시 + 랜덤 멘트 선택
		    local currentSubPhase = _MafiaGameLogic.NightSubPhase
		    if currentSubPhase ~= self.lastNightSubPhase then
		        self.lastNightSubPhase = currentSubPhase
		        -- 현재 활성 엔티티를 찾아 페이드아웃 시작
		        if not self.nightFadingOut then
		            local prevEnt = nil
		            if self.nightMafiaActionEnt ~= nil and self.nightMafiaActionEnt.Enable then
		                prevEnt = self.nightMafiaActionEnt
		            elseif self.nightPoliceActionEnt ~= nil and self.nightPoliceActionEnt.Enable then
		                prevEnt = self.nightPoliceActionEnt
		            elseif self.nightDoctorActionEnt ~= nil and self.nightDoctorActionEnt.Enable then
		                prevEnt = self.nightDoctorActionEnt
		            elseif self.nightMafiaPanel ~= nil and self.nightMafiaPanel.Enable then
		                prevEnt = self.nightMafiaPanel
		            elseif self.nightPolicePanel ~= nil and self.nightPolicePanel.Enable then
		                prevEnt = self.nightPolicePanel
		            elseif self.nightDoctorPanel ~= nil and self.nightDoctorPanel.Enable then
		                prevEnt = self.nightDoctorPanel
		            end
		            if prevEnt ~= nil then
		                local cg = prevEnt.CanvasGroupComponent
		                self.nightFadeOutAlpha = (cg ~= nil) and cg.GroupAlpha or 1.0
		                self.nightFadeOutEnt = prevEnt
		                self.nightFadingOut = true
		            end
		        end
		        self.nightUIShown = false
		        self.nightManuallyHidden = false
		        local msgs21 = { "마피아들이 움직인다..", "오늘 밤의 희생양은 누구?...", "마피아가 타깃을 고르고 있습니다...", "검은 손길이 누군가를 향합니다...", "마피아가 결정을 내리고 있습니다...", "밤의 사냥꾼들이 먹잇감을 노립니다...", "어둠 속에서 마피아가 속삭입니다...", "마피아의 칼날이 누군가를 향해...", "오늘 밤의 피해자가 정해지고 있습니다...", "아무도 모르게, 마피아가 움직입니다." }
		        local msgs22 = { "형사가 수사를 시작합니다...", "경찰이 용의자를 조사하고 있습니다...", "탐정의 시선이 용의자에게 꽂힙니다...", "경찰이 마피아의 냄새를 맡습니다...", "형사의 수첩에 이름이 기록됩니다...", "용의자를 색출하는 시간...", "경찰의 직감이 발동합니다...", "진실을 향한 추적이 시작됩니다...", "오늘 밤, 경찰이 마피아를 찾아낼까요...", "단 한 명, 진실을 쫓고 있습니다." }
		        local msgs23 = { "의사가 누군가를 지키러 나섭니다...", "치료의 손길이 필요한 누군가가 있습니다...", "의사의 선택이 오늘 밤을 바꿉니다...", "하얀 가운의 수호자가 움직입니다...", "생명을 지키는 의사의 시간...", "의사가 마피아보다 한 발 앞서갑니다...", "누군가를 살릴 기회, 의사에게 달렸습니다...", "의사가 오늘 밤 누구를 구할까요...", "의사의 손이 생명을 살립니다...", "두려움 속에서도 의사는 나아갑니다." }
		        local msgs0  = { "어둠이 마을을 덮습니다...", "긴 밤이 시작되었습니다.", "숨소리조차 들리지 않는 적막함...", "마을 사람들은 각자의 방에 숨었습니다.", "밤이 깊어갈수록 진실이 드러날 것입니다.", "어둠 속에서 운명이 결정됩니다.", "바람 소리만이 마을을 메우고 있습니다.", "이 밤이 끝나면 모든 것이 달라질 것입니다.", "누군가는 이 밤을 기다렸습니다.", "조용한 밤 뒤에 폭풍이 옵니다." }
		        local pool = msgs0
		        if currentSubPhase == _MafiaGameLogic.PHASE_NIGHT_MAFIA then pool = msgs21
		        elseif currentSubPhase == _MafiaGameLogic.PHASE_NIGHT_POLICE then pool = msgs22
		        elseif currentSubPhase == _MafiaGameLogic.PHASE_NIGHT_DOCTOR then pool = msgs23
		        end
		        self.nightOverlayMsg = pool[math.random(1, #pool)]
		    end
		    -- 투표결과 애니메이션(VoteAnime_2/3) 페이드아웃 시작(phase==3) 전까지 야간 패널 표시 대기
		    -- → phase 3 진입 시점부터 crossfade 되어 야간 패널이 서서히 나타남
		    local voteAnimBlocking = self.resultAnimePlaying
		        and self.resultAnimeContext == "vote"
		        and self.resultAnimePhase < 3
		    -- 경찰 조사결과 애니메이션 재생 중에는 ShowNightPanel 호출 차단 (DoctorAction이 겹치지 않도록)
		    local policeResultBlocking = self.policeResultPlaying
		    if not self.nightUIShown and not self.nightManuallyHidden and not self.nightFadingOut and not voteAnimBlocking and not policeResultBlocking then
		        if self.nightMafiaPanel == nil then self:ResolveNightUI() end
		        self:ShowNightPanel()
		    else
		        local timer = tostring(math.max(0, math.ceil(_MafiaGameLogic.PhaseTimer)))
		        self:UpdateNightTimer(timer)
		    end
	end

	method void SelectNightTarget(integer role, integer slotIndex)
		    -- Handles card click: deselect previous, select new, enable confirm button.
		    if self.nightSubmitted then return end
		    if role ~= self.nightActiveRole then return end
		    -- 로컬 플레이어가 이 역할이 아니면 선택 불가 (관찰자 보호)
		    if role ~= self:GetLocalPlayerRole() then return end
		
		    local cards      = nil
		    local circles    = nil
		    local circlesOff = nil
		    local playerIds  = nil
		    local confirmEnt = nil

		    if role == _MafiaGameLogic.ROLE_MAFIA then
		        cards = self.nightMafiaCards; circles = self.nightMafiaCircles; circlesOff = self.nightMafiaCirclesOff
		        playerIds = self.nightMafiaPlayerIds; confirmEnt = self.nightMafiaConfirmEnt
		    elseif role == _MafiaGameLogic.ROLE_POLICE then
		        cards = self.nightPoliceCards; circles = self.nightPoliceCircles; circlesOff = self.nightPoliceCirclesOff
		        playerIds = self.nightPolicePlayerIds; confirmEnt = self.nightPoliceConfirmEnt
		    elseif role == _MafiaGameLogic.ROLE_DOCTOR then
		        cards = self.nightDoctorCards; circles = self.nightDoctorCircles; circlesOff = self.nightDoctorCirclesOff
		        playerIds = self.nightDoctorPlayerIds; confirmEnt = self.nightDoctorConfirmEnt
		    else return end

		    local uid = playerIds[slotIndex]
		    if uid == nil then return end

		    -- Deselect previous: 노란 원 숨기고 회색 원 다시 표시
		    if self.nightSelectedSlot > 0 then
		        local prev    = (circles    ~= nil) and circles[self.nightSelectedSlot]    or nil
		        local prevOff = (circlesOff ~= nil) and circlesOff[self.nightSelectedSlot] or nil
		        if prev    ~= nil then prev.Enable    = false end
		        if prevOff ~= nil then prevOff.Enable = true  end
		    end

		    self.nightSelectedSlot = slotIndex

		    -- Select new: 회색 원 숨기고 노란 원 표시
		    local circle    = (circles    ~= nil) and circles[slotIndex]    or nil
		    local circleOff = (circlesOff ~= nil) and circlesOff[slotIndex] or nil
		    if circle    ~= nil then circle.Enable    = true  end
		    if circleOff ~= nil then circleOff.Enable = false end

		    -- Enable confirm button (클릭 활성화)
		    if confirmEnt ~= nil and confirmEnt.ButtonComponent ~= nil then
		        confirmEnt.ButtonComponent.Enable = true
		    end
		    log("[MafiaUIFlow] night target selected; role=" .. tostring(role) .. " slot=" .. tostring(slotIndex))
	end

	method void SubmitNightChoice(integer role)
		    -- Sends the selected target to the server and locks the panel.
		    if self.nightSubmitted then return end
		    if self.nightSelectedSlot <= 0 then return end
		    -- 로컬 플레이어 역할이 맞지 않으면 제출 거부
		    if role ~= self:GetLocalPlayerRole() then return end
		
		    local playerIds = nil
		    local confirmEnt = nil
		
		    if role == _MafiaGameLogic.ROLE_MAFIA then
		        playerIds = self.nightMafiaPlayerIds; confirmEnt = self.nightMafiaConfirmEnt
		    elseif role == _MafiaGameLogic.ROLE_POLICE then
		        playerIds = self.nightPolicePlayerIds; confirmEnt = self.nightPoliceConfirmEnt
		    elseif role == _MafiaGameLogic.ROLE_DOCTOR then
		        playerIds = self.nightDoctorPlayerIds; confirmEnt = self.nightDoctorConfirmEnt
		    else return end
		
		    local targetId = playerIds[self.nightSelectedSlot]
		    if targetId == nil or targetId == "" then return end
		
		    local localId = self:GetLocalUserId()
		    if localId == "" then return end
		
		    self.nightSubmitted = true
		    if confirmEnt ~= nil and confirmEnt.ButtonComponent ~= nil then
		        confirmEnt.ButtonComponent.Enable = false
		    end
		
		    if role == _MafiaGameLogic.ROLE_MAFIA then
		        _MafiaGameLogic:MafiaChooseTarget(localId, targetId)
		    elseif role == _MafiaGameLogic.ROLE_POLICE then
		        _MafiaGameLogic:PoliceInvestigate(localId, targetId)
		    elseif role == _MafiaGameLogic.ROLE_DOCTOR then
		        _MafiaGameLogic:DoctorProtect(localId, targetId)
		    end
		    log("[MafiaUIFlow] night submitted; role=" .. tostring(role) .. " target=" .. tostring(targetId))
	end

	method void MinimizeMafiaPanel()
		    -- 마피아 선택 패널만 숨기고 채팅 화면(MafiaNightHUD 기본 뷰) 노출.
		    -- 선택 상태(nightSelectedSlot, nightSubmitted)는 유지.
		    if self.nightMafiaPanel ~= nil then self.nightMafiaPanel.Enable = false end
		    self.nightManuallyHidden = true
		    log("[MafiaUIFlow] mafia panel minimized → chat view")
	end
	method void RestoreMafiaPanel()
		    -- 최소화된 마피아 패널 복원.
		    if self.nightMafiaPanel ~= nil then self.nightMafiaPanel.Enable = true end
		    self.nightManuallyHidden = false
		    log("[MafiaUIFlow] mafia panel restored")
	end


	method void HideNightPanel()
		    -- Hides all night panels and resets state.
		    if self.nightMafiaPanel ~= nil then self.nightMafiaPanel.Enable = false end
		    if self.nightPolicePanel ~= nil then self.nightPolicePanel.Enable = false end
		    if self.nightDoctorPanel ~= nil then self.nightDoctorPanel.Enable = false end
		    self.nightUIShown = false
		    self.nightSelectedSlot = 0
		    self.nightSubmitted = false
		    self.nightActiveRole = -1
		    self.lastNightSubPhase = -1
		    log("[MafiaUIFlow] night panel hidden")
	end

end
