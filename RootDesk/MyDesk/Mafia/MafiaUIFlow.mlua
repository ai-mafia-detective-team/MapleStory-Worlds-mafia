	method void HandleSettingsBgmTrackTouch(UITouchDownEvent event)
		    local ref = self.settingsBgmTrackParent
		    if ref == nil then ref = self.settingsBgmTrack end
		    self.settingBgmVolume = self:CalculateSettingsTrackValue(event.TouchPoint, ref, self.settingBgmVolume)
		    self:RefreshSettingsVisual()
		    log("[MafiaUIFlow] settings bgm=" .. tostring(self.settingBgmVolume))
	end

	method void HandleSettingsSfxTrackTouch(UITouchDownEvent event)
		    local ref = self.settingsSfxTrackParent
		    if ref == nil then ref = self.settingsSfxTrack end
		    self.settingSfxVolume = self:CalculateSettingsTrackValue(event.TouchPoint, ref, self.settingSfxVolume)
		    self:RefreshSettingsVisual()
		    log("[MafiaUIFlow] settings sfx=" .. tostring(self.settingSfxVolume))
	end

	method void HandleSettingsBgmTrackDrag(UITouchDragEvent event)
		    local ref = self.settingsBgmTrackParent
		    if ref == nil then ref = self.settingsBgmTrack end
		    self.settingBgmVolume = self:CalculateSettingsTrackValue(event.TouchPoint, ref, self.settingBgmVolume)
		    self:RefreshSettingsVisual()
	end

	method void HandleSettingsSfxTrackDrag(UITouchDragEvent event)
		    local ref = self.settingsSfxTrackParent
		    if ref == nil then ref = self.settingsSfxTrack end
		    self.settingSfxVolume = self:CalculateSettingsTrackValue(event.TouchPoint, ref, self.settingSfxVolume)
		    self:RefreshSettingsVisual()
	end

	method integer CalculateSettingsTrackValue(Vector2 touchPoint, Entity trackEntity, integer fallbackValue)
		    if trackEntity == nil or trackEntity.UITransformComponent == nil then return fallbackValue end
		    local transform = trackEntity.UITransformComponent
		    local localPos = _UILogic:ScreenToLocalUIPosition(touchPoint, transform)
		    local width = transform.RectSize.x
		    if width <= 0 then return fallbackValue end
		    local ratio = (localPos.x + width * 0.5) / width
		    if ratio < 0 then ratio = 0 end
		    if ratio > 1 then ratio = 1 end
		    local value = math.floor(ratio * 10 + 0.5) * 10
		    if value < 0 then value = 0 end
		    if value > 100 then value = 100 end
		    return value
	end

	method void HandleSettingsResolutionPrev()
		    if self.settingResolutionOptions == nil then self.settingResolutionOptions = {"1280 × 720", "1600 × 900", "1920 × 1080"} end
		    self.settingResolutionIndex = self.settingResolutionIndex - 1
		    if self.settingResolutionIndex < 1 then self.settingResolutionIndex = #self.settingResolutionOptions end
		    self:RefreshSettingsVisual()
	end

	method void HandleSettingsResolutionNext()
		    if self.settingResolutionOptions == nil then self.settingResolutionOptions = {"1280 × 720", "1600 × 900", "1920 × 1080"} end
		    self.settingResolutionIndex = self.settingResolutionIndex + 1
		    if self.settingResolutionIndex > #self.settingResolutionOptions then self.settingResolutionIndex = 1 end
		    self:RefreshSettingsVisual()
	end

	method void HandleSettingsFullscreen()
		    self.settingScreenMode = 1
		    self:RefreshSettingsVisual()
	end

	method void HandleSettingsWindow()
		    self.settingScreenMode = 2
		    self:RefreshSettingsVisual()
	end

	method void HandleSettingsBorderless()
		    self.settingScreenMode = 3
		    self:RefreshSettingsVisual()
	end

	method void RefreshSettingsVisual()
		    if self.settingResolutionOptions == nil then self.settingResolutionOptions = {"1280 × 720", "1600 × 900", "1920 × 1080"} end
		    if self.settingResolutionIndex < 1 then self.settingResolutionIndex = 3 end
		    if self.settingResolutionIndex > #self.settingResolutionOptions then self.settingResolutionIndex = #self.settingResolutionOptions end
		    if self.settingsBgmValueText ~= nil then self.settingsBgmValueText.Text = tostring(self.settingBgmVolume) end
		    if self.settingsSfxValueText ~= nil then self.settingsSfxValueText.Text = tostring(self.settingSfxVolume) end
		    if self.settingsResolutionValueText ~= nil then self.settingsResolutionValueText.Text = self.settingResolutionOptions[self.settingResolutionIndex] end
		    self:RefreshSettingsModeText(self.settingsFullscreenText, self.settingScreenMode == 1)
		    self:RefreshSettingsModeText(self.settingsWindowText, self.settingScreenMode == 2)
		    self:RefreshSettingsModeText(self.settingsBorderlessText, self.settingScreenMode == 3)
		    self:UpdateSettingsThumb(self.settingsBgmThumb, self.settingsBgmTrackParent, self.settingsBgmTrack, self.settingBgmVolume)
		    self:UpdateSettingsThumb(self.settingsSfxThumb, self.settingsSfxTrackParent, self.settingsSfxTrack, self.settingSfxVolume)
	end

	method void UpdateSettingsThumb(Entity thumb, Entity trackParent, Entity trackButton, integer volume)
		    -- Moves the slider thumb and the interactive track button to match the given volume (0-100).
		    if thumb == nil or thumb.UITransformComponent == nil then return end
		    local halfRange = 178.932
		    local ratio = volume / 100.0
		    local thumbX = -halfRange + ratio * halfRange * 2.0
		    local pos = thumb.UITransformComponent.anchoredPosition
		    thumb.UITransformComponent.anchoredPosition = Vector2(thumbX, pos.y)
		    if trackButton ~= nil and trackButton.UITransformComponent ~= nil and trackParent ~= nil and trackParent.UITransformComponent ~= nil then
		        local parentX = trackParent.UITransformComponent.anchoredPosition.x
		        local btnPos = trackButton.UITransformComponent.anchoredPosition
		        trackButton.UITransformComponent.anchoredPosition = Vector2(parentX + thumbX, btnPos.y)
		    end
	end

	method void RefreshSettingsModeText(any textComponent, boolean selected)
		    if textComponent == nil then return end
		    if selected then
		        textComponent.FontColor = Color(1, 0.78, 0.22, 1)
		    else
		        textComponent.FontColor = Color(1, 0.88, 0.66, 1)
		    end
	end

	method void ApplyGameSettings()
		    local resolutionText = "1920 × 1080"
		    if self.settingResolutionOptions ~= nil and self.settingResolutionOptions[self.settingResolutionIndex] ~= nil then
		        resolutionText = self.settingResolutionOptions[self.settingResolutionIndex]
		    end
		    local modeText = "전체화면"
		    if self.settingScreenMode == 2 then modeText = "창모드" end
		    if self.settingScreenMode == 3 then modeText = "테두리 없음" end
		    log("[MafiaUIFlow] settings saved bgm=" .. tostring(self.settingBgmVolume)
		        .. " sfx=" .. tostring(self.settingSfxVolume)
		        .. " resolution=" .. tostring(resolutionText)
		        .. " screenMode=" .. tostring(modeText)
		        .. " runtimeApply=pending-api")
	end

	method boolean IsSettingsTouchInside(Vector2 touchPoint)
		    if self.settingsPanel == nil or self.settingsPanel.UITransformComponent == nil then return false end
		    local localPos = _UILogic:ScreenToLocalUIPosition(touchPoint, self.settingsPanel.UITransformComponent)
		    return math.abs(localPos.x) <= 415 and math.abs(localPos.y) <= 470
	end

