@Logic
script MafiaGameLogic extends Logic

	property boolean DebugMode = true

	property number LOBBY_MIN_TIME = 5.0

	property number LobbyTimer = 0.0

	property integer PHASE_LOBBY = 0

	property integer PHASE_FREE_ROAM = 1

	property integer PHASE_NIGHT = 2

	property integer PHASE_MORNING = 3

	property integer PHASE_MEETING = 4

	property integer PHASE_MEETING_RESULT = 5

	property integer PHASE_GAME_OVER = 6

	property integer ROLE_CITIZEN = 0

	property integer ROLE_MAFIA = 1

	property integer ROLE_POLICE = 2

	property integer ROLE_DOCTOR = 3

	property integer MAX_PLAYERS = 8

	property integer MIN_PLAYERS = 6

	@Sync
	property string RoomTitle = "커닝시티 마피아"

	@Sync
	property boolean IsPrivateRoom = true

	@Sync
	property string RoomPassword = ""

	@Sync
	property integer RoomMaxPlayers = 8

	@Sync
	property integer MafiaPlayerCount = 2

	property number FREE_ROAM_TIME = 10.0

	property number NIGHT_TIME = 10.0

	property number MORNING_TIME = 5.0

	property number MEETING_TIME = 15.0

	property number RESULT_TIME = 5.0

	@Sync
	property integer CurrentPhase = 0

	@Sync
	property number PhaseTimer = 0.0

	@Sync
	property number MaxPhaseTime = 0.0

	@Sync
	property integer DayCount = 0

	@Sync
	property integer WinnerRole = -1

	@Sync
	property boolean PoliceResult = false

	@Sync
	property string ExecuteTarget = ""

	@Sync
	property string MorningKilled = ""

	property integer LocalPlayerRole = -1

	@Sync
	property string RoleData = ""

	@Sync
	property string AlivePlayersList = ""

	@Sync
	property string VoteStatusList = ""

	@Sync
	property string ChatLog = ""

	@Sync
	property integer LobbyPlayerCount = 0

	@Sync
	property integer ReadyCount = 0

	@Sync
	property string ReadyStatusList = ""

	property boolean GameStarted = false

	property number InternalTimer = 0.0

	property string MafiaTarget = ""

	property string DoctorTarget = ""

	property string PoliceTarget = ""

	property table playerRoles = nil

	property table playerAlive = nil

	property table playerRooms = nil

	property table botIds = nil

	property table voteCount = nil

	property table voteSubmitted = nil

	property table readyPlayers = nil

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		    self.playerRoles   = {}
		    self.playerAlive   = {}
		    self.playerRooms   = {}
		    self.botIds        = {}
		    self.voteCount     = {}
		    self.voteSubmitted = {}
		    self.readyPlayers   = {}
		
		    self.MafiaTarget   = ""
		    self.DoctorTarget  = ""
		    self.PoliceTarget  = ""
		    self.GameStarted   = false
		    self.InternalTimer = 0.0
		    self.CurrentPhase  = self.PHASE_LOBBY
		    self.WinnerRole    = -1
		    self.DayCount      = 0
		    self.LobbyPlayerCount = 0
		    self.ReadyCount = 0
		    self.ReadyStatusList = ""
		    self.RoomTitle = "커닝시티 마피아"
		    self.IsPrivateRoom = true
		    self.RoomPassword = ""
		    self.MAX_PLAYERS = 8
		    self.RoomMaxPlayers = 8
		    self.MafiaPlayerCount = 2
		    log("[Mafia] 寃뚯엫 濡쒖쭅 珥덇린???꾨즺. DebugMode=" .. tostring(self.DebugMode))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		    if self.CurrentPhase == self.PHASE_LOBBY then
		        self:CheckLobbyStart(delta)
		    elseif self.GameStarted and self.InternalTimer > 0.0 then
		        self.InternalTimer = self.InternalTimer - delta
		        self.PhaseTimer    = self.InternalTimer
		        if self.InternalTimer <= 0.0 then
		            self.PhaseTimer = 0.0
		            self:OnPhaseEnd()
		        end
		    end
	end

	@ExecSpace("ServerOnly")
	method void CheckLobbyStart(number delta)
		    if self.GameStarted then return end
		    self:CheckNewLobbyPlayers()
		    self:UpdateReadyStatusList()
		    if self:AllLobbyPlayersReady() then
		        self:StartGame()
		    end
	end

	@ExecSpace("Server")
	method void SetReady(string userId, boolean ready)
		    if self.CurrentPhase ~= self.PHASE_LOBBY or self.GameStarted then return end
		    local exists = false
		    for _, uid in ipairs(_UserService.Users.Keys) do
		        if tostring(uid) == userId then exists = true; break end
		    end
		    if not exists then return end
		    self.readyPlayers[userId] = ready
		    self:UpdateReadyStatusList()
		    log("[Lobby] ready: " .. userId .. " -> " .. tostring(ready) ..
		        " (" .. tostring(self.ReadyCount) .. "/" .. tostring(self.LobbyPlayerCount) .. ")")
		    if self:AllLobbyPlayersReady() then
		        log("[Lobby] all players ready; starting day phase")
		        self:StartGame()
		    end
	end

	@ExecSpace("ServerOnly")
	method void UpdateReadyStatusList()
		    local parts = {}
		    local keys = _UserService.Users.Keys
		    self.LobbyPlayerCount = #keys
		    for _, uid in ipairs(keys) do
		        local id = tostring(uid)
		        if self.readyPlayers[id] == true then
		            parts[#parts + 1] = id
		        end
		    end
		    self.ReadyCount = #parts
		    self.ReadyStatusList = table.concat(parts, ",")
	end

	@ExecSpace("ServerOnly")
	method boolean AllLobbyPlayersReady()
		    local count = #(_UserService.Users.Keys)
		    local minimum = self.MIN_PLAYERS
		    if self.DebugMode then minimum = 1 end
		    if count < minimum then return false end
		    if count > self.MAX_PLAYERS then return false end
		    for _, uid in ipairs(_UserService.Users.Keys) do
		        if self.readyPlayers[tostring(uid)] ~= true then return false end
		    end
		    return count > 0
	end

	@ExecSpace("Server")
	method void SetRoomSettings(string roomTitle, boolean isPrivate, string password, integer maxPlayers, integer mafiaCount)
		    if self.CurrentPhase ~= self.PHASE_LOBBY or self.GameStarted then return end
		    if roomTitle == nil or roomTitle == "" then roomTitle = "커닝시티 마피아" end
		    if string.len(roomTitle) > 20 then roomTitle = string.sub(roomTitle, 1, 20) end
		    if password == nil then password = "" end
		    if string.len(password) > 16 then password = string.sub(password, 1, 16) end
		    if maxPlayers ~= 6 and maxPlayers ~= 7 and maxPlayers ~= 8 then maxPlayers = 8 end
		    if mafiaCount ~= 1 and mafiaCount ~= 2 and mafiaCount ~= 3 then mafiaCount = 2 end

		    self.RoomTitle = roomTitle
		    self.IsPrivateRoom = isPrivate
		    self.RoomPassword = password
		    self.MAX_PLAYERS = maxPlayers
		    self.RoomMaxPlayers = maxPlayers
		    self.MafiaPlayerCount = mafiaCount
		    log("[Lobby] room settings saved title=" .. roomTitle ..
		        " private=" .. tostring(isPrivate) ..
		        " max=" .. tostring(maxPlayers) ..
		        " mafia=" .. tostring(mafiaCount))
	end

	-- LOBBY: ?덈줈 ?낆옣???뚮젅?댁뼱瑜?媛먯??댁꽌 ?쒖꽌?濡?諛?諛곗젙 + ?붾젅?ы듃
	@ExecSpace("ServerOnly")
	method void CheckNewLobbyPlayers()
		    local floors = {"RoomSpawn_1", "RoomSpawn_2", "RoomSpawn_3", "RoomSpawn_4",
		                    "RoomSpawn_5", "RoomSpawn_6", "RoomSpawn_7", "RoomSpawn_8"}
		    local keys = _UserService.Users.Keys
		    for _, uid in ipairs(keys) do
		        if self.playerRooms[uid] == nil then
		            local playerEnt = _UserService:GetUserEntityByUserId(uid)
		            if playerEnt ~= nil then
		                self:AssignLobbyRoom(uid)
		                local roomId = self.playerRooms[uid]
		                if roomId ~= nil and roomId >= 1 and roomId <= 8 then
		                    local floorEnt = _EntityService:GetEntityByPath("/maps/map01/" .. floors[roomId])
		                    if floorEnt ~= nil then
		                        _TeleportService:TeleportToEntity(playerEnt, floorEnt)
		                        log("[Lobby] ?낆옣 諛곗젙: " .. uid .. " ??諛?" .. roomId)
		                    end
		                end
		            end
		        end
		    end
	end

	@ExecSpace("ServerOnly")
	method void SetPhase(integer phase, number duration)
		    self.CurrentPhase  = phase
		    self.InternalTimer = duration
		    self.PhaseTimer    = duration
		    self.MaxPhaseTime  = duration
		    log("[Mafia] ?섏씠利?" .. phase .. " duration=" .. duration)
	end

	@ExecSpace("ServerOnly")
	method void OnPhaseEnd()
		    if self.CurrentPhase == self.PHASE_FREE_ROAM then
		        self:BeginNight()
		    elseif self.CurrentPhase == self.PHASE_NIGHT then
		        self:BeginMorning()
		    elseif self.CurrentPhase == self.PHASE_MORNING then
		        self:BeginMeeting()
		    elseif self.CurrentPhase == self.PHASE_MEETING then
		        self:BeginMeetingResult()
		    elseif self.CurrentPhase == self.PHASE_MEETING_RESULT then
		        self:CheckWinAndContinue()
		    end
	end

	@ExecSpace("ServerOnly")
	method void StartGame()
		    if self.GameStarted then return end
		    self.GameStarted = true
		    self.DayCount    = 1
		    if self.DebugMode then self:AddBots() end
		    self:AssignRoles()
		    self:AssignRooms()
		    self:TeleportPlayersToRooms()
		    local allUsers = self:GetAllUserIds()
		    local roleParts = {}
		    for _, uid in ipairs(allUsers) do
		        local r = self.playerRoles[uid]
		        if r ~= nil then
		            roleParts[#roleParts + 1] = uid
		            roleParts[#roleParts + 1] = tostring(r)
		        end
		    end
		    self.RoleData = table.concat(roleParts, ",")
		    self:UpdateAlivePlayersList()
		    self:SetPhase(self.PHASE_FREE_ROAM, self.FREE_ROAM_TIME)
		    log("[Mafia] 寃뚯엫 ?쒖옉!")
	end

	@ExecSpace("ServerOnly")
	method void AssignRoles()
		    local users = self:GetAllUserIds()
		    local n = #users
		    local roles = {}
		    local mafiaCount = math.min(self.MafiaPlayerCount, n)
		    for i = 1, mafiaCount do roles[i] = self.ROLE_MAFIA end
		    local nextIndex = mafiaCount + 1
		    if nextIndex <= n then roles[nextIndex] = self.ROLE_POLICE; nextIndex = nextIndex + 1 end
		    if nextIndex <= n then roles[nextIndex] = self.ROLE_DOCTOR; nextIndex = nextIndex + 1 end
		    for i = nextIndex, n do roles[i] = self.ROLE_CITIZEN end
		    -- 7??湲곗?: 留덊뵾?? 寃쎌같1 ?섏궗1 ?쒕?3
		    for i = n, 2, -1 do
		        local j = _UtilLogic:RandomIntegerRange(1, i)
		        local tmp = roles[i]; roles[i] = roles[j]; roles[j] = tmp
		    end
		    self.playerRoles = {}
		    self.playerAlive = {}
		    for i, uid in ipairs(users) do
		        self.playerRoles[uid] = roles[i]
		        self.playerAlive[uid] = true
		        log("[Mafia] ??븷 諛곗젙: " .. uid .. " -> " .. roles[i])
		    end
	end

	@ExecSpace("ServerOnly")
	method void AssignRooms()
		    local users = self:GetAllUserIds()
		    local n = #users
		    local rooms = {}
		    for i = 1, n do rooms[i] = i end
		    for i = n, 2, -1 do
		        local j = _UtilLogic:RandomIntegerRange(1, i)
		        local tmp = rooms[i]; rooms[i] = rooms[j]; rooms[j] = tmp
		    end
		    self.playerRooms = {}
		    for i, uid in ipairs(users) do
		        self.playerRooms[uid] = rooms[i]
		        log("[Mafia] 諛?諛곗젙: " .. uid .. " -> " .. rooms[i])
		    end
	end

	@ExecSpace("ServerOnly")
	method void BeginNight()
		    self.MafiaTarget  = ""
		    self.DoctorTarget = ""
		    self.PoliceTarget = ""
		    self.PoliceResult = false
		    self:TeleportPlayersToRooms()
		    self:SetPhase(self.PHASE_NIGHT, self.NIGHT_TIME)
	end

	@ExecSpace("ServerOnly")
	method void BeginMorning()
		    local killed = ""
		    local mafiaTarget = self.MafiaTarget
		    if mafiaTarget == "" then
		        local mafiaId = self:GetPlayerByRole(self.ROLE_MAFIA)
		        if mafiaId ~= "" then
		            mafiaTarget = self:GetRandomAliveExcept(mafiaId)
		        end
		    end
		    if mafiaTarget ~= "" then
		        if self.DoctorTarget == mafiaTarget then
		            log("[Mafia] ?섏궗 蹂댄샇: " .. mafiaTarget)
		        else
		            killed = mafiaTarget
		            self:KillPlayer(killed)
		        end
		    end
		    self.MorningKilled = killed
		    self:SetPhase(self.PHASE_MORNING, self.MORNING_TIME)
		    log("[Mafia] ?꾩묠. ?щ쭩=" .. killed)
	end

	@ExecSpace("ServerOnly")
	method void BeginMeeting()
		    self.voteCount     = {}
		    self.voteSubmitted = {}
		    self.VoteStatusList = ""
		    self.ExecuteTarget = ""
		    local users = self:GetAllUserIds()
		    for _, uid in ipairs(users) do
		        if self.playerAlive[uid] then
		            self.voteCount[uid] = 0
		        end
		    end
		    self.DayCount = self.DayCount + 1
		    self:SetPhase(self.PHASE_MEETING, self.MEETING_TIME)
	end

	@ExecSpace("Server")
	method void RequestSkipToMeeting(string requesterId)
		    if self.CurrentPhase ~= self.PHASE_FREE_ROAM then return end
		    log("[Mafia] skip requested by " .. tostring(requesterId))
		    self:BeginMeeting()
	end

	@ExecSpace("Server")
	method void SubmitVote(string voterId, string targetId)
		    if self.CurrentPhase ~= self.PHASE_MEETING then return end
		    if self.voteSubmitted[voterId] ~= nil then return end
		    -- ?ㅽ궢(targetId="")? ?앹〈 ?щ? 泥댄겕 ?놁씠 ?덉슜
		    if targetId ~= "" and not self.playerAlive[targetId] then return end
		    local recorded = (targetId ~= "") and targetId or "skip"
		    self.voteSubmitted[voterId] = recorded
		    if targetId ~= "" then
		        self.voteCount[targetId] = (self.voteCount[targetId] or 0) + 1
		    end
		    self:UpdateVoteStatusList()
		    log("[Mafia] ?ы몴: " .. voterId .. " -> " .. recorded)
		    if self:AllVoted() then
		        self.InternalTimer = 0.0
		        self:BeginMeetingResult()
		    end
	end

	@ExecSpace("ServerOnly")
	method void UpdateVoteStatusList()
		    local parts = {}
		    for uid, _ in pairs(self.voteSubmitted) do
		        parts[#parts + 1] = uid
		    end
		    self.VoteStatusList = table.concat(parts, ",")
	end

	@ExecSpace("ServerOnly")
	method boolean AllVoted()
		    local users = self:GetAllUserIds()
		    for _, uid in ipairs(users) do
		        if self.playerAlive[uid] and self.voteSubmitted[uid] == nil then
		            return false
		        end
		    end
		    return true
	end

	@ExecSpace("ServerOnly")
	method void BeginMeetingResult()
		    local maxVotes = 0
		    local maxUser  = ""
		    local tie      = false
		    for uid, v in pairs(self.voteCount) do
		        if v > maxVotes then
		            maxVotes = v; maxUser = uid; tie = false
		        elseif v == maxVotes and v > 0 then
		            tie = true
		        end
		    end
		    if not tie and maxUser ~= "" and maxVotes > 0 then
		        self.ExecuteTarget = maxUser
		        self:KillPlayer(maxUser)
		        log("[Mafia] 泥섑삎: " .. maxUser)
		    else
		        self.ExecuteTarget = ""
		        log("[Mafia] 泥섑삎 ?놁쓬 (?숈젏)")
		    end
		    self:SetPhase(self.PHASE_MEETING_RESULT, self.RESULT_TIME)
	end

	@ExecSpace("ServerOnly")
	method void CheckWinAndContinue()
		    local mafiaAlive   = 0
		    local citizenAlive = 0
		    local users = self:GetAllUserIds()
		    for _, uid in ipairs(users) do
		        if self.playerAlive[uid] then
		            local role = self.playerRoles[uid]
		            if role == self.ROLE_MAFIA then
		                mafiaAlive = mafiaAlive + 1
		            else
		                citizenAlive = citizenAlive + 1
		            end
		        end
		    end
		    if mafiaAlive == 0 then
		        self.WinnerRole = self.ROLE_CITIZEN
		        self:SetPhase(self.PHASE_GAME_OVER, 0.0)
		        log("[Mafia] ?쒕? ?밸━")
		    elseif mafiaAlive >= citizenAlive then
		        self.WinnerRole = self.ROLE_MAFIA
		        self:SetPhase(self.PHASE_GAME_OVER, 0.0)
		        log("[Mafia] 留덊뵾???밸━")
		    else
		        self:BeginNight()
		    end
	end

	@ExecSpace("ServerOnly")
	method void KillPlayer(string userId)
		    self.playerAlive[userId] = false
		    self:UpdateAlivePlayersList()
		    log("[Mafia] ?щ쭩: " .. userId)
	end

	@ExecSpace("ServerOnly")
	method void UpdateAlivePlayersList()
		    local parts = {}
		    local users = self:GetAllUserIds()
		    for _, uid in ipairs(users) do
		        if self.playerAlive[uid] then
		            parts[#parts + 1] = uid
		        end
		    end
		    self.AlivePlayersList = table.concat(parts, ",")
	end

	@ExecSpace("Server")
	method void MafiaChooseTarget(string mafiaId, string targetId)
		    if self.CurrentPhase ~= self.PHASE_NIGHT then return end
		    if self.playerRoles[mafiaId] ~= self.ROLE_MAFIA then return end
		    self.MafiaTarget = targetId
		    log("[Mafia] 留덊뵾????? " .. targetId)
	end

	@ExecSpace("Server")
	method void PoliceInvestigate(string policeId, string targetId)
		    if self.CurrentPhase ~= self.PHASE_NIGHT then return end
		    if self.playerRoles[policeId] ~= self.ROLE_POLICE then return end
		    self.PoliceTarget = targetId
		    self.PoliceResult = (self.playerRoles[targetId] == self.ROLE_MAFIA)
		    log("[Mafia] 寃쎌같 議곗궗: " .. targetId .. " 留덊뵾??" .. tostring(self.PoliceResult))
	end

	@ExecSpace("Server")
	method void DoctorProtect(string doctorId, string targetId)
		    if self.CurrentPhase ~= self.PHASE_NIGHT then return end
		    if self.playerRoles[doctorId] ~= self.ROLE_DOCTOR then return end
		    self.DoctorTarget = targetId
		    log("[Mafia] ?섏궗 蹂댄샇: " .. targetId)
	end

	@ExecSpace("Server")
	method void RestartGame()
		    self.GameStarted     = false
		    self.InternalTimer   = 0.0
		    self.LobbyTimer      = 0.0
		    self.WinnerRole      = -1
		    self.ExecuteTarget   = ""
		    self.MorningKilled   = ""
		    self.DayCount        = 0
		    self.MafiaTarget     = ""
		    self.DoctorTarget    = ""
		    self.PoliceTarget    = ""
		    self.playerRoles   = {}
		    self.playerAlive   = {}
		    self.playerRooms   = {}
		    self.botIds        = {}
		    self.voteCount     = {}
		    self.voteSubmitted = {}
		    self.readyPlayers   = {}
		    self.RoleData        = ""
		    self.VoteStatusList  = ""
		    self.ChatLog         = ""
		    self.LobbyPlayerCount = 0
		    self.ReadyCount = 0
		    self.ReadyStatusList = ""
		    self:ResetLocalRole()
		    self:SetPhase(self.PHASE_LOBBY, 0.0)
		    self:TeleportAllToLobbyRooms()
		    log("[Mafia] restart")
	end

	@ExecSpace("ServerOnly")
	method void TeleportPlayersToRooms()
		    local roomFloors = {}
		    roomFloors[1] = "RoomSpawn_1"
		    roomFloors[2] = "RoomSpawn_2"
		    roomFloors[3] = "RoomSpawn_3"
		    roomFloors[4] = "RoomSpawn_4"
		    roomFloors[5] = "RoomSpawn_5"
		    roomFloors[6] = "RoomSpawn_6"
		    roomFloors[7] = "RoomSpawn_7"
		    roomFloors[8] = "RoomSpawn_8"
		    local users = self:GetAllUserIds()
		    for _, uid in ipairs(users) do
		        if string.sub(uid, 1, 4) ~= "Bot_" and self.playerAlive[uid] then
		            local playerEntity = _UserService:GetUserEntityByUserId(uid)
		            if playerEntity ~= nil then
		                local roomId = self.playerRooms[uid]
		                if roomId ~= nil then
		                    local floorName = roomFloors[roomId]
		                    if floorName ~= nil then
		                        local floorEntity = _EntityService:GetEntityByPath("/maps/map01/" .. floorName)
		                        if floorEntity ~= nil then
		                            _TeleportService:TeleportToEntity(playerEntity, floorEntity)
		                            log("[Mafia] 諛??붾젅?ы듃: " .. uid .. " -> " .. floorName)
		                        end
		                    end
		                end
		            end
		        end
		    end
	end

	@ExecSpace("ServerOnly")
	method table GetAllUserIds()
		    local list = {}
		    local keys = _UserService.Users.Keys
		    for _, uid in ipairs(keys) do list[#list + 1] = uid end
		    for _, bid in ipairs(self.botIds) do list[#list + 1] = bid end
		    return list
	end

	@ExecSpace("ServerOnly")
	method string GetPlayerByRole(integer role)
		    local users = self:GetAllUserIds()
		    for _, uid in ipairs(users) do
		        if self.playerRoles[uid] == role and self.playerAlive[uid] then
		            return uid
		        end
		    end
		    return ""
	end

	@ExecSpace("ServerOnly")
	method string GetRandomAliveExcept(string excludeId)
		    local aliveList = {}
		    local users = self:GetAllUserIds()
		    for _, uid in ipairs(users) do
		        if uid ~= excludeId and self.playerAlive[uid] then
		            aliveList[#aliveList + 1] = uid
		        end
		    end
		    if #aliveList == 0 then return "" end
		    return aliveList[_UtilLogic:RandomIntegerRange(1, #aliveList)]
	end

	@ExecSpace("ServerOnly")
	method void AddBots()
		    self.botIds = {}
		    local realCount = #(_UserService.Users.Keys)
		    local needed    = self.MAX_PLAYERS - realCount
		    for i = 1, needed do
		        local botId = "Bot_" .. i
		        self.botIds[#self.botIds + 1] = botId
		        log("[Mafia] 遊?異붽?: " .. botId)
		    end
	end

	@ExecSpace("ServerOnly")
	method string GetRoleName(integer role)
		    if role == self.ROLE_MAFIA      then return "mafia"
		    elseif role == self.ROLE_POLICE then return "寃쎌같"
		    elseif role == self.ROLE_DOCTOR then return "?섏궗"
		    else return "?쒕?" end
	end

	-- 諛?踰덊샇濡?洹?諛⑹뿉 諛곗젙???뚮젅?댁뼱 UID 諛섑솚 (?놁쑝硫?"")
	@ExecSpace("ServerOnly")
	method string GetPlayerByRoom(integer roomIndex)
		    for uid, room in pairs(self.playerRooms) do
		        if room == roomIndex then return uid end
		    end
		    return ""
	end

	-- ?대씪?댁뼵?멸? 諛?踰덊샇瑜??좏깮?댁꽌 諛??됰룞 ?쒖텧
	-- actorId: ?됰룞?섎뒗 ?뚮젅?댁뼱 UID, targetRoom: ?좏깮??諛?踰덊샇 (1~6)
	@ExecSpace("Server")
	method void SubmitNightAction(string actorId, integer targetRoom)
		    if self.CurrentPhase ~= self.PHASE_NIGHT then
		        log("[Mafia] SubmitNightAction: 諛ㅼ씠 ?꾨떂")
		        return
		    end
		    local role = self.playerRoles[actorId]
		    if role == nil then return end
		    local targetId = self:GetPlayerByRoom(targetRoom)
		    if targetId == "" then
		        log("[Mafia] SubmitNightAction: 諛?" .. targetRoom .. " ???뚮젅?댁뼱 ?놁쓬")
		        return
		    end
		    if role == self.ROLE_MAFIA then
		        self:MafiaChooseTarget(actorId, targetId)
		    elseif role == self.ROLE_POLICE then
		        self:PoliceInvestigate(actorId, targetId)
		    elseif role == self.ROLE_DOCTOR then
		        self:DoctorProtect(actorId, targetId)
		    end
		    log("[Mafia] SubmitNightAction: " .. actorId .. " ??븷=" .. role .. " 諛?" .. targetRoom .. " ???" .. targetId)
	end

	-- LOBBY: 鍮?諛?踰덊샇 諛섑솚 (?놁쑝硫?-1)
	@ExecSpace("ServerOnly")
	method integer FindEmptyRoom()
		    local used = {}
		    for uid, room in pairs(self.playerRooms) do
		        used[room] = true
		    end
		    for i = 1, 8 do
		        if not used[i] then return i end
		    end
		    return -1
	end

	-- LOBBY: ?뚮젅?댁뼱?먭쾶 鍮?諛?諛곗젙
	@ExecSpace("ServerOnly")
	method void AssignLobbyRoom(string userId)
		    if self.playerRooms[userId] ~= nil then return end
		    local roomId = self:FindEmptyRoom()
		    if roomId < 1 then
		        log("[Lobby] 鍮?諛??놁쓬: " .. userId)
		        return
		    end
		    self.playerRooms[userId] = roomId
		    log("[Lobby] " .. userId .. " ??諛?" .. roomId)
	end

	-- LOBBY: 諛곗젙??諛?踰덊샇 諛섑솚 (?놁쑝硫?-1)
	@ExecSpace("ServerOnly")
	method integer GetLobbyRoom(string userId)
		    local room = self.playerRooms[userId]
		    if room == nil then return -1 end
		    return room
	end

	-- LOBBY: ?꾩옱 ?묒냽 以?紐⑤뱺 ?뚮젅?댁뼱瑜??먯떊??諛⑹쑝濡??붾젅?ы듃
	@ExecSpace("ServerOnly")
	method void TeleportAllToLobbyRooms()
		    local floors = {"RoomSpawn_1", "RoomSpawn_2", "RoomSpawn_3", "RoomSpawn_4",
		                    "RoomSpawn_5", "RoomSpawn_6", "RoomSpawn_7", "RoomSpawn_8"}
		    local keys = _UserService.Users.Keys
		    for _, uid in ipairs(keys) do
		        self:AssignLobbyRoom(uid)
		        local roomId = self.playerRooms[uid]
		        if roomId ~= nil and roomId >= 1 and roomId <= 8 then
		            local floorEnt = _EntityService:GetEntityByPath("/maps/map01/" .. floors[roomId])
		            local playerEnt = _UserService:GetUserEntityByUserId(uid)
		            if floorEnt ~= nil and playerEnt ~= nil then
		                _TeleportService:TeleportToEntity(playerEnt, floorEnt)
		                log("[Lobby] ?붾젅?ы듃: " .. uid .. " ??" .. floors[roomId])
		            end
		        end
		    end
	end

	-- ?대씪?댁뼵?멸? 梨꾪똿 硫붿떆吏 ?꾩넚 (FREE_ROAM / MEETING ?섏씠利덉뿉?쒕쭔 ?덉슜)
	@ExecSpace("Server")
	method void SendChat(string userId, string message)
		    if self.CurrentPhase ~= self.PHASE_LOBBY and
		       self.CurrentPhase ~= self.PHASE_FREE_ROAM and
		       self.CurrentPhase ~= self.PHASE_MEETING then return end
		    if message == nil or message == "" then return end
		    -- 硫붿떆吏 湲몄씠 ?쒗븳 (100??
		    if string.len(message) > 100 then
		        message = string.sub(message, 1, 100)
		    end
		    -- ?뺤떇: "userId\t硫붿떆吏" 以꾨뱾??"\n"?쇰줈 援щ텇, 理쒓렐 20以??좎?
		    local entry = userId .. "\t" .. message
		    if self.ChatLog == "" then
		        self.ChatLog = entry
		    else
		        local lines = {}
		        for line in string.gmatch(self.ChatLog, "[^\n]+") do
		            lines[#lines + 1] = line
		        end
		        lines[#lines + 1] = entry
		        if #lines > 20 then
		            table.remove(lines, 1)
		        end
		        self.ChatLog = table.concat(lines, "\n")
		    end
		    log("[Chat] " .. userId .. ": " .. message)
	end

	@ExecSpace("Client")
	method void ResetLocalRole()
		    self.LocalPlayerRole = -1
	end

end
