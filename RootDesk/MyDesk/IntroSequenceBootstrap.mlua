@Component
script IntroSequenceBootstrap extends Component

	property integer timerId = 0

	property number elapsed = 0

	property boolean attached = false

	property number startupLoadingSeconds = 0.8

	property Entity startupLoadingRoot = nil

	method void OnBeginPlay()
		-- Shows the loading HUD first, then starts the intro sequence when UI entities are ready.
		if _RoomService:IsInstanceRoom() then
			log("[IntroSequenceBootstrap] skipped in instance room roomKey=" .. tostring(_RoomService.RoomKey))
			return
		end
		log("[IntroSequenceBootstrap] OnBeginPlay")
		self.elapsed = 0
		self.attached = false
		self:ShowStartupLoading()
		
		if self.timerId > 0 then
			_TimerService:ClearTimer(self.timerId)
			self.timerId = 0
		end
		
		self.timerId = _TimerService:SetTimerRepeat(function()
			self.elapsed = self.elapsed + 0.1
		
			if self.elapsed < self.startupLoadingSeconds then
				self:ShowStartupLoading()
				return
			end
		
			self:HideStartupLoading()
			self:TryAttach()
		
			if self.attached == true or self.elapsed >= 5 then
				if self.timerId > 0 then
					_TimerService:ClearTimer(self.timerId)
					self.timerId = 0
				end
		
				if self.attached == false then
					log_warning("[IntroSequenceBootstrap] /ui/UI_IntroSequence was not found")
				end
			end
		end, 0.1)
	end

	method void ShowStartupLoading()
		-- Covers the map immediately so Play starts from a loading screen, not raw map view.
		self:HideEntityByPath("/ui/UI_Lobby")
		self:HideEntityByPath("/ui/UI_NicknameSetup")
		self:HideEntityByPath("/ui/MafiaLobbyHUD")
		self:HideEntityByPath("/ui/MafiaDayHUD")
		self:HideEntityByPath("/ui/MafiaNightHUD")
		self:HideEntityByPath("/ui/MafiaCitizenWinHUD")
		self:HideEntityByPath("/ui/MafiaMafiaWinHUD")
		
		if self.startupLoadingRoot == nil or isvalid(self.startupLoadingRoot) == false then
			self.startupLoadingRoot = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD")
		end
		if self.startupLoadingRoot ~= nil and isvalid(self.startupLoadingRoot) then
			self.startupLoadingRoot:SetEnable(true)
			self.startupLoadingRoot.Visible = true
		end
		
		self:SetTextByPath("/ui/MafiaLoadingHUD/RoleLabelText", "LOADING")
		self:SetTextByPath("/ui/MafiaLoadingHUD/RoleNameText", "커닝시티 마피아")
		self:SetTextByPath("/ui/MafiaLoadingHUD/RoleDescText", "게임 화면을 불러오는 중입니다.")
		self:SetTextByPath("/ui/MafiaLoadingHUD/StoryText", "")
		self:SetTextByPath("/ui/MafiaLoadingHUD/TipText", "잠시 후 인트로가 시작됩니다.")
	end

	method void HideStartupLoading()
		-- Hides the startup loading HUD right before the intro logo sequence takes over.
		if self.startupLoadingRoot == nil or isvalid(self.startupLoadingRoot) == false then
			self.startupLoadingRoot = _EntityService:GetEntityByPath("/ui/MafiaLoadingHUD")
		end
		if self.startupLoadingRoot ~= nil and isvalid(self.startupLoadingRoot) then
			self.startupLoadingRoot:SetEnable(false)
			self.startupLoadingRoot.Visible = false
		end
	end

	method void HideEntityByPath(string path)
		-- Hides unrelated UI roots during the startup loading cover.
		local entity = _EntityService:GetEntityByPath(path)
		if entity == nil or isvalid(entity) == false then return end
		entity:SetEnable(false)
		entity.Visible = false
	end

	method void SetTextByPath(string path, string text)
		-- Applies startup loading labels when the target text entity exists.
		local entity = _EntityService:GetEntityByPath(path)
		if entity == nil or isvalid(entity) == false then return end
		if entity.TextComponent ~= nil then
			entity.TextComponent.Text = text
		end
	end

	method void TryAttach()
		-- Adds IntroSequenceController to /ui/UI_IntroSequence when it exists.
		local intro = _EntityService:GetEntityByPath("/ui/UI_IntroSequence")
		if intro == nil or isvalid(intro) == false then
			return
		end
		
		intro:SetEnable(true)
		
		local existing = intro:GetComponent("script.IntroSequenceController")
		if existing == nil then
			intro:AddComponent("script.IntroSequenceController")
			log("[IntroSequenceBootstrap] IntroSequenceController attached")
		else
			log("[IntroSequenceBootstrap] IntroSequenceController already exists")
		end
		
		self.attached = true
	end

	method void OnEndPlay()
		-- Clears polling when play mode ends.
		if self.timerId > 0 then
			_TimerService:ClearTimer(self.timerId)
			self.timerId = 0
		end
	end

end